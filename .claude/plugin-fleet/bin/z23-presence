#!/bin/sh
# Copyright 2026 Rhett Creighton. Licensed under Apache-2.0.
# Post this live session's presence row with `z23 fleet steer presence`, so the
# fleet brief counts it for 900 s. Called by the plugin's hooks:
#   z23-presence start   session start (records the start time, posts)
#   z23-presence beat    after a tool use; posts at most once per 300 s
#   z23-presence end     session end (posts phase=completed at once)
# Hook JSON on stdin supplies session_id. Environment: Z23_PRESENCE_ROLE (default
# claude-<first 8 of session_id>), Z23_PRESENCE_TASK (default claude-session),
# Z23_PRESENCE_SOURCE (default claude), Z23_BIN (a z23 or z23-dev to use).
# Never fails the session: it exits 0 and says at most one line on stderr.
mode=${1:-beat}
dir=${XDG_STATE_HOME:-$HOME/.local/state}/z23-presence
interval=300

sid=; [ -t 0 ] || sid=$(head -c 65536 2>/dev/null | grep -o '"session_id" *: *"[A-Za-z0-9_-]*"' | head -n 1 | cut -d '"' -f 4)
[ -n "$sid" ] || sid=${CLAUDE_SESSION_ID:-$PPID}
short=$(printf '%s' "$sid" | tr -cd 'A-Za-z0-9' | cut -c1-8)
role=${Z23_PRESENCE_ROLE:-claude-$short}
mkdir -p "$dir" 2>/dev/null || exit 0
start_file=$dir/$short.started
beat_file=$dir/$short.beat
now=$(date +%s)

if [ "$mode" = beat ] && [ -f "$beat_file" ]; then
    last=$(cat "$beat_file" 2>/dev/null)
    case $last in ''|*[!0-9]*) last=0 ;; esac
    [ $((now - last)) -lt $interval ] && exit 0
fi
[ -f "$start_file" ] || date -u +%Y-%m-%dT%H:%M:%SZ > "$start_file" 2>/dev/null
started=$(cat "$start_file" 2>/dev/null)
phase=active
[ "$mode" = end ] && phase=completed

root=${CLAUDE_PROJECT_DIR:-$PWD}
for bin in ${Z23_BIN:-} "$(command -v z23 2>/dev/null)" "$root/build/bin/z23" \
           "$(command -v z23-dev 2>/dev/null)" "$root/build/bin/z23-dev"; do
    [ -n "$bin" ] && [ -x "$bin" ] || continue
    out=$("$bin" fleet steer presence --role="$role" --phase="$phase" \
        --task="${Z23_PRESENCE_TASK:-claude-session}" --session="s$short" \
        --started="$started" --source="${Z23_PRESENCE_SOURCE:-claude}" \
        --pid="$PPID" </dev/null 2>&1) && {
        [ "$mode" = end ] && rm -f "$beat_file" "$start_file" || echo "$now" > "$beat_file"
        exit 0
    }
    case $out in *PRESENCE_*) echo "z23-presence: $out" | head -n 1 >&2; exit 0 ;; esac
done
echo 'z23-presence: no z23 binary could post presence (is z23 on PATH?)' >&2
exit 0
