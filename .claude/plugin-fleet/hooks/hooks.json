{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "z23 fleet steer presence --hook=start >/dev/null", "timeout": 15 } ] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "z23 fleet steer presence --hook=beat >/dev/null", "timeout": 15 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "z23 fleet steer presence --hook=end >/dev/null", "timeout": 15 } ] }
    ]
  }
}
