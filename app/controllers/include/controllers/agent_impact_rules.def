/* The strict-C23 Windows acceptance programs that live under lib/test/src.
 * NOTHING EXECUTES THESE. Every one is a per-test SOURCES row in the catalog
 * lib/platform/tests/windows_acceptance.mk, and the only thing that reads
 * that catalog is check-windows-acceptance, which mingw-cross-LINKS each
 * program and (with Wine absent) never runs one. A cross-link is not an
 * execution. None of them defines a registered group function either --
 * checked against every ZCL_TEST_GROUP row in tools/dev/test_group_catalog.def
 * -- so no t-fast-exact run can reach them. check-windows-acceptance is also
 * absent from LINT_FAST_GATES, so the push gate's lint-fast rung does not see
 * them; only a full `make lint` does. Closing the gap for any one of these
 * means adding a native lib/test/src case for the POSIX arm of the code it
 * refuses on, the way test_file_ops_copy.c was split out of
 * file_ops_copy_windows_acceptance.c. Enumerated rather than globbed on
 * purpose: a NEW program dropped in here must trip the fail-closed refusal
 * and get its own reasoning, not inherit lint-only silence. */
AGENT_IMPACT_RULE("lib/test/src/boot_auto_install_bundle_windows_refusal_acceptance.c|lib/test/src/boot_export_windows_refusal_acceptance.c|lib/test/src/build_fabric_worker_windows_refusal_acceptance.c|lib/test/src/bundle_exporter_windows_refusal_acceptance.c|lib/test/src/codeindex_build_refusal_acceptance.c|lib/test/src/consensus_bundle_marker_windows_acceptance.c|lib/test/src/consensus_export_fd_io_refusal_acceptance.c|lib/test/src/consensus_export_output_seal_refusal_acceptance.c|lib/test/src/consensus_install_windows_refusal_acceptance.c|lib/test/src/consensus_state_install_runtime_windows_refusal_acceptance.c|lib/test/src/consensus_state_publication_cas_windows_refusal_acceptance.c|lib/test/src/file_ops_copy_windows_acceptance.c|lib/test/src/hotswap_elf_probe_refusal_acceptance.c|lib/test/src/log_level_acceptance.c|lib/test/src/mint_anchor_export_windows_refusal_acceptance.c|lib/test/src/mint_anchor_preflight_windows_refusal_acceptance.c|lib/test/src/os_binary_slots_refusal_acceptance.c|lib/test/src/package_lifecycle_store_windows_refusal_acceptance.c|lib/test/src/pagelocker_acceptance.c|lib/test/src/rng_acceptance.c|lib/test/src/rom_bundle_admission_refusal_acceptance.c|lib/test/src/sd_notify_unsupported_acceptance.c|lib/test/src/snapshot_candidate_output_refusal_acceptance.c|lib/test/src/snapshot_export_refusal_acceptance.c|lib/test/src/snapshot_install_activate_refusal_acceptance.c|lib/test/src/stale_lock_capability_acceptance.c|lib/test/src/ui_host_transport_windows_acceptance.c|lib/test/src/utxo_recovery_ldb_copy_windows_refusal_acceptance.c|lib/test/src/wallet_recovery_directory_windows_acceptance.c|lib/test/src/wallet_restore_windows_refusal_acceptance.c|lib/test/src/workpool_windows_acceptance.c|lib/test/src/zcode_benchmark_executor_windows_refusal_acceptance.c", "make_lint_gates")

