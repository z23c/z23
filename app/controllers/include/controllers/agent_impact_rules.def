/* Lane: published build identity (peer build identity on the wire).
 * ONE slice: the advertised subversion and its reader (msg_version.c +
 * net/version.h), the getpeerinfo field that republishes what each peer
 * said, and the two groups that pin the contract — net_handshake_adversarial
 * owns "absent/malformed is unknown and is never penalised", peer_lifecycle
 * owns "what we publish is the baked source identity". Change any one of
 * them and a node can start advertising a build it is not running, or a
 * peer's silence can start costing it something.
 *
 * tools/deploy_verify.sh rides the same rule because it is the one consumer
 * OUTSIDE the network layer that reads the advertised string as data: it had
 * a frozen grep for the exact pre-change "/ZClassic23:0.1.0/", so the first
 * stamped build to be deployed would have failed its own deploy gate from a
 * file nobody in this lane had touched. Its acceptance set and what
 * msg_version_user_agent() emits are one contract; the make_lint_gates case
 * in lint_gate_deploy_contracts.c is where that contract is asserted, and it
 * must move with the format. */
AGENT_IMPACT_RULE("lib/net/src/msg_version.c|lib/net/include/net/version.h|app/controllers/src/network_controller.c|tools/deploy_verify.sh|lib/test/src/lint_gate_deploy_contracts.c|lib/test/src/test_net_handshake_adversarial.c|lib/test/src/test_peer_lifecycle.c|lib/test/src/test_syncdiag_network.c", "net_handshake_adversarial peer_lifecycle net syncdiag_rpc make_lint_gates")
/* The doctrine page an agent reads before it decides whether to act or ask,
 * plus the entry point that links it. Doc-only, but it is contract text: the
 * doc gates check its links, its inline paths, and its claims. */
AGENT_IMPACT_RULE("docs/CODE_FEARLESSLY.md|AGENTS.md", "make_lint_gates")
/* LANE source-identity-authority: the deploy freshness authority and the two
 * questions its key name conflates. `source_id_sha256` names both "what
 * source tree was this BINARY built from" (baked into the executable,
 * identical from every working directory) and "what source tree is in this
 * DIRECTORY right now" (different in every checkout). Only the first is a
 * freshness answer; reading the second under its name passes a stale daemon
 * whose own checkout happens to look current. These files move together
 * because they are the one reader, its two consumers, and the constant they
 * all resolve to: change the reader's admission rule without re-running the
 * group and a deploy check can start comparing a directory to a daemon with
 * nothing looking. Mapped so an edit here can never reach the push gate
 * having run zero test groups. */
AGENT_IMPACT_RULE("tools/scripts/source_identity_lib.sh|tools/deploy_verify.sh|lib/util/src/clientversion.c|lib/util/include/util/clientversion.h|app/controllers/src/agent_runtime_controller.c|lib/test/src/test_source_identity_authority.c", "source_identity_authority make_lint_gates")
/* LANE anti-flake / load-independent verdicts. A test graded on wall-clock
 * duration reports on the MACHINE, not the code — measured on this tree, the
 * same commit and binary FAILED at 48s under a 32-worker run and PASSED at
 * 64.0s standalone. Three things move together here and none of them can be
 * changed safely alone:
 *   * the two fixture/driver pairs whose verdicts are now count-graded rather
 *     than clock-graded (a fixture that publishes state on a wall clock, and
 *     a driver whose deadline must never cut off the observation the verdict
 *     needs — MIN_SAMPLES);
 *   * the two PROGRESS watchdogs that replaced total-duration ceilings, one
 *     per-gate-script and one per-test-group. They bound SILENCE, so a slow
 *     or saturated box keeps passing and a real wedge is still reported —
 *     as a wedge, distinctly from a failed assertion;
 *   * the lint gate that refuses NEW clock-graded assertions, plus its closed
 *     allowlist.
 * Mapped so an edit to any of them re-runs the groups that would notice a
 * regression, instead of reaching the push gate having run nothing. */
AGENT_IMPACT_RULE("tools/lint/check_no_wallclock_assertion.sh|tools/lint/wallclock_assertion_allowlist.txt|tools/scripts/fresh-boot-weld-prove.sh|tools/scripts/fresh-boot-weld-prove-selftest.sh|lib/test/src/lint_gate_helpers.c|lib/test/src/lint_gate_selftests.h|lib/test/src/lint_gate_hygiene_selftests.c|lib/test/src/test_parallel.c|lib/test/src/test_binary_ab_fallback.c|lib/test/src/test_self_backtrace.c|lib/test/src/test_onion_bootstrap.c|tools/dev/build-epoch-selftest.sh|tools/dev/checkout-lock-selftest.sh", "make_lint_gates binary_ab_fallback self_backtrace onion_bootstrap")
/* LANE reproducible-build: the flag that makes a compile repeat, the gate that
 * keeps it wired, and the end-to-end proof that a second builder gets the same
 * bytes. They move together because each one is half of the same claim: a node
 * announces its source id on the wire, and that announcement is only checkable
 * if the same source rebuilds to the same binary. Removing the per-TU random
 * seed without the gate, or narrowing the proof script without the lint gate
 * noticing, would leave the claim standing with nothing behind it. Mapped to
 * the lint-gate group that owns the Makefile-vs-docs parity assertions. */
AGENT_IMPACT_RULE("tools/scripts/repro_build.sh|tools/scripts/repro-verify.sh|tools/lint/check_tu_random_seed.sh|docs/DEFENSIVE_CODING.md", "make_lint_gates")
/* LANE peer-memory: a node that has EVER met this network must be able to get
 * back on it without a hardcoded seed. The addrman store and its on-disk
 * format, the anchor set the dial scheduler writes the moment the healthy
 * outbound set changes, the bootstrap path that decides whether the shipped
 * seed list is still needed, and the test that holds all three to account.
 * They move together because they encode ONE claim: self-measured experience
 * outranks hearsay. Changing the record format without the group is how onion
 * peers silently stopped being persisted at all; changing the bootstrap gate
 * without it is how a node quietly goes back to depending on a seed array
 * whose only entry may already be dead. */
AGENT_IMPACT_RULE("lib/net/src/addrman.c|lib/net/src/addrman_codec.c|lib/net/src/addrman_internal.h|lib/net/include/net/addrman.h|lib/net/src/anchor_peers.c|lib/net/include/net/anchor_peers.h|lib/net/src/connman.c|lib/net/src/connman_dialer.c|lib/net/include/net/connman.h|lib/test/src/test_peer_memory.c", "peer_memory anchor_peers addrman_rebalance addrman_integrity net")

/* LANE params-fetch: obtaining the ~777 MB of zk PROVING parameters from the
 * peer network instead of from a web host. The pin table is the trust root —
 * ceremony-published lengths and SHA-256 digests, plus a chunk Merkle root
 * derived from them — and the verifier, the wire commands, the dispatch-table
 * rows that expose those commands, and the adversarial test all encode the
 * same claim: a peer supplies candidate bytes and nothing else. Changing the
 * chunk size or the Merkle construction in params_fetch.c invalidates every
 * pinned root, and changing params_service.c can widen what an unverified
 * peer is allowed to make this node do; neither may land without the group
 * that recomputes the pins from the real files and replays the refusals. */
AGENT_IMPACT_RULE("lib/sapling/src/params_fetch.c|lib/sapling/src/params_fetch_session.c|lib/sapling/src/params_fetch_internal.h|lib/sapling/include/sapling/params_fetch.h|lib/net/src/params_service.c|lib/net/include/net/params_service.h|lib/net/src/msgprocessor.c|lib/test/src/test_params_fetch.c", "params_fetch")

/* LANE source-identity-q1q2: the ratchet that stops a working-tree
 * (directory-derived) source_id_sha256 reading from being published under
 * the bare Q1-shaped key a baked-build identity uses, and from being read
 * positionally out of an agentbuild response where the schema-anchored
 * zcl_agentbuild_v2_top_source_id reader (tools/scripts/source_identity_lib.sh)
 * applies. The gate script and its shrink-only baseline move together: a
 * baseline edit with no gate change, or a gate change with no baseline
 * update, is exactly how this ratchet would rust shut silently. */
AGENT_IMPACT_RULE("tools/lint/check_source_identity_authority.sh|tools/lint/source_identity_authority_baseline.txt", "make_lint_gates")
/* LANE outparam-init: the gate that keeps a caller's free from walking a stale
 * value, its closed allowlist, and the three call sites hardened by the sweep
