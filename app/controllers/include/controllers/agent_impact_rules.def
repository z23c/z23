AGENT_IMPACT_RULE("core/chainparams/src/chainparams.c|lib/net/src/connman.c|lib/net/src/onion_directory.c|lib/net/include/net/onion_service.h|lib/test/src/test_seed_bootstrap_doors.c", "seed_bootstrap_doors")
/* LANE params-sovereignty: the boundary between validating shielded proofs
 * and creating them. The compiled-in verifying keys, the generator that
