AGENT_IMPACT_RULE("lib/test/src/test_running_image_positioned.c", "running_image_positioned make_lint_gates")
AGENT_IMPACT_RULE("lib/test/src/test_socket_resolve.c", "socket_resolve make_lint_gates")
AGENT_IMPACT_RULE("lib/test/src/test_private_link_no_clobber.c", "private_link_no_clobber make_lint_gates")
AGENT_IMPACT_RULE("lib/test/src/test_replay_receipt_root.c", "replay_receipt_root make_lint_gates")
AGENT_IMPACT_RULE("lib/test/src/test_file_ops_copy.c", "file_ops_copy make_lint_gates")
AGENT_IMPACT_RULE("lib/test/src/test_boot_refusal_identity.c", "boot_refusal_identity make_lint_gates")
AGENT_IMPACT_RULE("lib/test/src/test_boot_shutdown_marker_persistence.c", "boot_shutdown_marker_persistence make_lint_gates")

