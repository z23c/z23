AGENT_IMPACT_RULE("lib/test/fuzz_seeds/ARTIFACT_VERDICTS.txt|lib/test/fuzz_seeds/p2p/*|lib/test/fuzz_seeds/*/*.bin", "make_lint_gates")
/* LANE: generic-repo / no-designated-fleet. Operator mesh state is local and
 * untracked; the only tracked things under deploy/devfleet/ are the operator
 * guide and the .example templates. .gitignore is what keeps a stray copy of
 * a box's onion address, ports or heartbeat from coming back, and the lint
 * gates read both the deploy tree and the root file list, so a change to
 * either must run them. */
AGENT_IMPACT_RULE(".gitignore|deploy/devfleet/*|deploy/devfleet/*.example", "make_lint_gates")

/* LANE referee-retirement audit (2026-08-26). The mesh_observation surface is
 * what REPLACED the box that used to judge the other boxes: instead of one
 * machine grading the fleet and publishing a scalar verdict, every node
 * publishes only what IT observed and any reader folds those records against
 * its own validated chain. The rule above maps that surface's service sources,
 * its two controllers and its two test files. It does not map the two places
 * that decide whether the surface exists on a running node at all:
 *
 *   - config/src/boot_network_monitor.c and its header hold the ONLY
 *     registration of the sampler and of the reader-side collector
 *     (boot_register_mesh_observation_service). They matched only the
 *     network_monitor rule, so an edit that unregistered either half ran
 *     network_monitor and condition_engine and never touched mesh_observation
 *     or mesh_observation_compose.
 *   - app/controllers/include/controllers/diagnostics_dumpers_network.def is
 *     where mesh_observation_dump_state_json and
 *     mesh_observation_compose_dump_state_json are published to readers. It
 *     matched the generic diagnostics_*.def rule (syncdiag_rpc, rpc,
 *     make_lint_gates) — the registry shape was covered, the mesh behaviour
 *     behind it was not.
 *
 * Registration and publication ARE the replacement: a reader that cannot
 * collect anything falls back to trusting somebody else's conclusion, which is
 * the authority that was just removed. Both mesh groups therefore ride the
 * wiring, not only the implementation. */
AGENT_IMPACT_RULE("config/src/boot_network_monitor.c|config/include/config/boot_network_monitor.h|app/controllers/include/controllers/diagnostics_dumpers_network.def", "mesh_observation mesh_observation_compose network_monitor syncdiag_rpc make_lint_gates")
/* [lane: docs/work + tools/dev cruft purge] The work-directory index and every
 * page it lists. check_markdown_links.sh scans ALL tracked Markdown and fails
 * on a relative link that does not resolve, and docs/work/README.md is the
 * index that must name every tracked file in this directory — so deleting or
 * renaming a page here breaks the gate from a file nobody edited. Only a
 * handful of individual docs/work pages were mapped before (fast-path,
 * fail-safe-architecture, UX_PLAN, WIRE_COMPILE_CACHE), which meant a lane
 * that retired any OTHER page could take a green targeted run and a red
 * `make lint`. The whole directory maps to the lint group for that reason. */
AGENT_IMPACT_RULE("docs/work/README.md|docs/work/*.md|docs/work/*/*.md|docs/experiments/*.md", "make_lint_gates")
/* Lane: stranger-join docs (docs/JOIN.md, GETTING_STARTED, README, commons
 * quickstart). These four pages are the whole path a person with one fresh
 * clone and no contacts follows to get a node onto the network, so a change
 * to any of them is a claim about behavior the lint gates check (doc accuracy,
 * link targets, and the public-docs-stay-generic rules). GETTING_STARTED.md is
 * already mapped above for its build/ops role; the other three had no rule at
 * all, which meant a doc edit could reach the push gate having run zero test
 * groups. */
AGENT_IMPACT_RULE("docs/JOIN.md|docs/README.md|docs/C23_COMMONS_QUICKSTART.md", "make_lint_gates")
/* LANE corpus-operator-paths: committed files carry no local filesystem
 * path, operator username, or hostname. The two producers that used to write
 * an absolute package-store datadir into tracked evidence (corpus_census's
 * scopes.def parser and package_factory's corpus registration + report), the
 * def they read and write, and the ratchet gate that backstops every other
 * route a path could take into a commit. They move together: relaxing the
 * label rule in one producer while the other still refuses a path splits the
 * def format in half, and a baseline edited without re-running the gate is
 * how a shrink-only ledger silently starts growing. */
AGENT_IMPACT_RULE("tools/corpus_census.c|tools/package_factory.c|corpus/scopes.def|tools/lint/check_no_operator_paths.sh|tools/lint/operator_paths_baseline.txt", "make_lint_gates")

/* LANE: deploy-docs-truth. The shipped unit and its env template both told a
 * new operator that a node without an env file "falls back to DNS seeds".
 * chainparams sets nSeeds = 0 at both call sites, so no hostname is ever
 * resolved and no certificate authority is ever consulted — that is a
 * foundational property of this project, and a deployment file that misstates
 * it teaches the opposite. The .env.example templates were mapped to no rule
 * at all, so an edit to one could reach the push gate having run nothing. */
AGENT_IMPACT_RULE("deploy/*.env.example|deploy/examples/*.env.example", "make_lint_gates")

/* LANE: no-unattended-publish. The gate that keeps a background loop from
 * writing to the shared remote. Its scan set is derived from git ls-files, so
 * it covers scripts it has never been told about — which also means its own
 * correctness depends on the lint driver and the gate library, not just on
 * itself. Its selftest plants both forbidden shapes, so an edit that hollows
 * the gate trips the same group that proves it. */
AGENT_IMPACT_RULE("tools/lint/check_no_unattended_publish.sh", "make_lint_gates")
AGENT_IMPACT_RULE("tools/lint/check_standalone_tools_link.sh", "make_lint_gates")
/* [lane: public-docs-truth] docs/ARCHITECTURE_DIAGRAMS.md, ARCH_QUEST_BOARD.md,
 * and DEVELOPING.md carried no impact rule at all — a change to any of them
 * could reach the push gate having run zero test groups, the exact
