/* Per-domain dumpstate subsystem descriptors: P2P transport, peer/address management, ROM artifact seeding/fetching, onion serving, and network-facing observability
 *
 * Split from diagnostics_dumpers.def (see that file's aggregator
 * comment for the shared #include contract). Data-only: no macro
 * definitions or include guards belong in this file. */

    DIAG_PROJECTION("bbf_discovery", boot_bundle_fetch_discovery_dump_state_json,
                    "instant-on bundle-fetch peer-directory discovery: last "
                    "quorum outcome (reached / degraded_single_seed / "
                    "no_quorum_fell_open_to_ibd) + seed_count/responded_count",
                    "config/src/boot_bundle_fetch.c",
                    "lib/test/src/test_boot_bundle_fetch.c"),
    DIAG_LOCAL("explorer", explorer_dump_state_json,
               "clearnet block-explorer frontend: https_started/port/deferred, "
               "TLS cert_path + cert_present/key_present at <datadir>/ssl, "
               "onion_enabled + onion_address. Diagnoses why the explorer is "
               "or isn't serving on clearnet"),
    DIAG_CHAIN("quorum_oracle", quorum_oracle_dump_state_json,
               "multi-source quorum oracle: per-source vote stats + last verdict",
               "app/services/src/quorum_oracle_service.c", DIAG_TEST_DEFAULT),
    DIAG_CHAIN("peer_lifecycle", peer_lifecycle_dump_state_json,
               "P2P peer lifecycle attempts, handshakes, timeouts, and rejects by address/source",
               "lib/net/src/peer_lifecycle.c",
               "lib/test/src/test_peer_lifecycle.c"),
    DIAG_CHAIN("connman", connman_diag_dump_state_json,
               "connection manager: outbound/inbound counts + diversity, the "
               "addnode dial ledger (lifetime + per-index backoff/tcp+"
               "protocol failures/retired), reactor admission + "
               "message-cycle counters, the net.outbound_floor supervisor "
               "contract, an addrman size/new/tried pointer, and a "
               "per-source dial-attempt-outcome rollup; zcl23_db names its "
               "single scheduler owner, handshake gate, scheduled dials, "
               "and backoff/policy skips",
               "app/controllers/src/diagnostics_connman.c",
               "lib/test/src/test_syncdiag_operator.c"),
    DIAG_CHAIN("addrman", addrman_diag_dump_state_json,
               "address manager (peers.dat): new/tried table sizes, bucket "
               "occupancy, address-index health, and a live-vs-dead "
               "candidate tally (addr_info_is_terrible per used entry)",
               "app/controllers/src/diagnostics_connman.c",
               "lib/test/src/test_syncdiag_operator.c"),
    DIAG_LOCAL("network_monitor", network_monitor_dump_state_json,
               "reachable-network chain view: modal tip, max height, our delta, fork clusters"),
    DIAG_CHAIN("netsplit", network_monitor_netsplit_dump_state_json,
               "SUSPECTED_NETSPLIT: are we on the minority side of a split? "
               "Three signals — peer tip disagreement at our height with our "
               "own tip injected (needs >= 2 DISTINCT address groups, so one "
               "peer or one group can never raise it), block-arrival rate vs "
               "the tip's nBits-implied difficulty (implied_hashrate_ratio_"
               "milli; 1000 == arriving exactly as this chain's own difficulty "
               "predicts), and tip staleness. The verdict needs the peer "
               "signal AND a local corroborator — peer testimony alone is "
               "never enough",
               "app/services/src/network_monitor_netsplit.c",
               "lib/test/src/test_netsplit_detector.c"),
    DIAG_SERVICE("network_census", network_crawler_dump_state_json,
                 "whole-network observatory (opt-in crawler): enabled/running, "
                 "addresses_known, census_rows, probed_last_round, reachable_count, "
                 "onion/clearnet split, version histogram (top-N), height "
                 "distribution (modal/max/min/spread), and a whole-network "
                 "eclipse_suspected signal + evidence (our modal vs network modal)",
                 "app/services/src/network_crawler.c",
                 "lib/test/src/test_network_crawler.c"),
    DIAG_LOCAL("network", network_dump_state_json,
               "network rollup: what the node knows about the ZClassic "
               "network in one call — connman {wired, connected_peers, "
               "outbound_healthy, addrman_size}, messaging (channel readiness "
               "+ ZMSG received/accepted/duplicate/ACK totals + last-event "
               "timestamps), "
               "peer_floor (the "
               "net.outbound_floor supervisor contract: registered, "
               "healthy_outbound, last_tick_age_us, deadline_secs, "
               "ticks_run, stall_fires), chain_view (network_monitor: "
               "modal/max height, our delta, fork clusters), census "
               "(network_census: reachable count, version histogram, "
               "onion/clearnet split, eclipse_suspected + evidence), "
               "tip_comparison (our height vs. peer-modal and "
               "network-modal height), and peer_lifecycle connect/"
               "handshake/timeout/reject counters. Rolls up existing "
               "dumpers only — computes nothing new"),
    DIAG_ENTRY("telemetry_ontology", telemetry_ontology_dump_state_json,
               "field-level MEANING for the network telemetry the other "
               "reports emit: per field, what it counts, a machine-evaluable "
               "healthy range, what an unhealthy value implies, and the exact "
               "next command — plus a question index that maps an operator "
               "question ('do I have any peer that completed a handshake?') "
               "to the one command that answers it. Static build data, so it "
               "answers with no node state and is fetched separately from "
               "values; the routine dumps do not carry it",
               "diagnostic", "runtime", "lib/util/src/telemetry_ontology.c",
               "static_build_constant", "cheap",
               "a covered subsystem name, a bare field name, or 'questions'",
               "peer_lifecycle", "pre_handshake_disconnects",
               "lib/test/src/test_telemetry_ontology.c", false),
    DIAG_LOCAL("transport", net_transport_dump_state_json,
               "per-peer P2P transport: plaintext vs noise_xx (Noise_XX "
               "encrypted), handshake state, and frame counters; names + "
               "counts plaintext peers so a default-off node is explicit"),
    DIAG_LOCAL("omniscience", omniscience_dump_state_json,
               "capstone network-omniscience verdict: time_to_first_peer_us, "
               "handshaked_peers vs peer_floor, census_age_s, per-index "
               "completeness {name, cursor, target, lag, enabled, blocker} "
               "against reducer H*, worst_lag, and a single verdict string "
               "(omniscient / blocked:<index>@<height> / degraded:<layer>)"),
    DIAG_SERVICE("topology", topology_store_dump_state_json,
                 "P2P topology graph (who advertises whom): bounded "
                 "edge_count/cap, distinct_observers, "
                 "distinct_advertised_nodes, top_advertised in-degree "
                 "top-10, and the most recent crawler sweep summary "
                 "(nodes_contacted/reachable, edges_seen, new_nodes)",
                 "lib/storage/src/topology_store.c",
                 "lib/test/src/test_topology_store.c"),
    DIAG_SERVICE("ibd_throttle", ibd_throttle_dump_state_json,
                 "IBD throttle: token-bucket state, acquired/blocked counts, total wait time",
                 "app/services/src/ibd_throttle.c", DIAG_TEST_DEFAULT),
    DIAG_SERVICE("rom_seed", rom_seed_dump_state_json,
                 "ROM artifact seeding (free/capped P2P delivery of the "
                 "consensus-state bundle + header seed): registered artifacts "
                 "(kind, size, digest, chunks), chunks/bytes served, unique "
                 "peers served, current bytes/sec vs per-peer + global caps, "
                 "enabled flag",
                 "lib/net/src/rom_seed.c",
                 "lib/test/src/test_rom_seed.c"),
    DIAG_SERVICE("rom_fetch", rom_fetch_dump_state_json,
                 "ROM artifact fetching (the CLIENT half of "
                 "docs/ROM_DELIVERY.md): last fetch attempt (peer, filename, "
                 "size, chunks done, ok/fail + detail), in_progress flag, and "
                 "cumulative attempts/successes/failures/bytes-installed. "
                 "Download + content-verify only; activation stays with the "
                 "unified installer.",
                 "lib/net/src/rom_fetch.c",
                 "lib/test/src/test_rom_fetch.c"),
    DIAG_ENTRY("tip_agreement", tip_agreement_dump_state_json,
               "REPORTER ONLY — the OFF-HOST tip-hash agreement ledger on "
               "disk (the only parity evidence here that is not 127.0.0.1): "
               "per last sample, the height compared, OUR tip hash, the modal "
               "REMOTE tip hash, how many DISTINCT remote hosts backed that "
               "mode, how many disagreed, and the control in force. "
               "Independence is answered BEFORE any verdict: too few distinct "
               "remote hosts reports insufficient_independent_peers, never "
               "agreement. It grades nothing — "
               "tools/scripts/tip_agreement_judge.sh is the judge",
               "chain_or_network", "service",
               "app/services/src/tip_agreement_watch.c",
               "filesystem_snapshot", "bounded_lookup",
               "'last' for the last sample only, or empty for the whole report",
               "last", "",
               "lib/test/src/test_tip_agreement_watch.c", false),
    DIAG_SERVICE("rom_seed_policy", rom_seed_policy_dump_state_json,
                 "free-tier ROM/sync-artifact seeding policy (docs/ROM_DELIVERY.md): "
                 "enabled, bandwidth/concurrency caps, generosity-boost window, "
                 "consensus-preempt signal, and live upload counters. Deliberately "
                 "a DIFFERENT subsystem than the seed engine's own `rom_seed` "
                 "artifact registry, so the two can never collide.",
                 "lib/net/src/rom_seed_policy.c",
                 "lib/test/src/test_rom_seed_policy.c"),
    DIAG_SERVICE("rom_seed_ledger", rom_seed_ledger_dump_state_json,
                 "free-tier ROM/sync-artifact serve-log ledger: open flag, row "
                 "count, and the retention cap it prunes to.",
                 "lib/net/src/rom_seed_ledger.c",
                 "lib/test/src/test_rom_seed_ledger.c"),
    DIAG_SERVICE("file_service", file_service_dump_state_json,
                 "P2P file-market server: running/port/datadir_set, "
                 "server_workers + worker_threads_started, client connection "
                 "backlog (client_queue_len/cap), served-data manifest "
                 "(have_manifest/manifest_chunks/manifest_height), and the "
                 "per-IP admission table (active_ips/concurrent_serves/cap)",
                 "lib/net/src/file_service.c",
                 "lib/test/src/test_file_service_pow_gate.c"),
    DIAG_SERVICE("market_moderation", market_moderation_dump_state_json,
                 "per-node marketplace listing moderation (view filtering "
                 "ONLY — no network bans, no deletion): active immutable "
                 "profile (general-audience.v1 default / open-view opt-in), "
                 "available profiles, datadir/policy-file binding, and live "
                 "local review_state counts (unreviewed/reviewed_ok/"
                 "sensitive). Hidden offers stay stored, served, tradable",
                 "app/services/src/market_moderation_service.c",
                 "lib/test/src/test_file_market_moderation.c"),
    DIAG_SERVICE("zswap_yardsale", zswap_dump_state_json,
                 "atomic ZSLP/ZCL swap yardsale (signed for-sale-by-owner "
                 "zswapquote gossip ads; a cache of remembered signs, never "
                 "a market or book): cache_size/cap, wires_seen, ads "
                 "stored/deduped/pruned/evicted, dropped invalid/expired/"
                 "rate-limited ingress counters, oldest/newest live expiry, "
                 "per-peer clamp window",
                 "lib/zswap/src/zswap_yardsale.c",
                 "lib/test/src/test_zswap_yardsale.c"),
    DIAG_SERVICE("messaging", messaging_dump_state_json,
                 "ZMSG channels: controller_wired/db_open/network_available, "
                 "p2p_channel_available (always; plaintext on the wire), "
                 "transport_telemetry_wired, received/accepted/duplicate/ACK "
                 "totals + last-event timestamps, "
                 "onchain_channel_ready (Sapling prover params loaded), "
                 "in-memory inbox_store_count/cap, and onchain_memo_max_bytes",
                 "app/controllers/src/messaging_controller.c",
                 DIAG_TEST_DEFAULT),
    DIAG_SERVICE("onion_ratelimit", onion_ratelimit_dump_state_json,
                 "onion-service request admission: per-tier {static, cheap, "
                 "expensive} cap_per_sec/spent_this_window/admitted_total/"
                 "denied_total/saturated_streak_secs/clear_streak_secs, "
                 "expensive_escalated + escalate_total/deescalate_total/"
                 "escalate_sustain_secs/deescalate_clear_secs, and the client "
                 "puzzle's live puzzle_bits_now/puzzle_rate_ewma_milli plus "
                 "puzzle_required/passed/failed_total",
                 "lib/net/src/onion_ratelimit.c",
                 "lib/test/src/test_net.c"),
