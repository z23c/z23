/* Per-domain dumpstate subsystem descriptors: the reducer/fold pipeline and chain catch-up: stage cursors, header/body acquisition, validation, UTXO application, refold/mint, and sync health
 *
 * Split from diagnostics_dumpers.def (see that file's aggregator
 * comment for the shared #include contract). Data-only: no macro
 * definitions or include guards belong in this file. */

    DIAG_ENTRY("chain_evidence", diag_chain_evidence_dump_state_json,
               "native chain evidence: tips, cursors, evidence flags, reconciliation reason",
               "chain_or_network", "service",
               "app/controllers/src/diagnostics_chain_evidence.c",
               "in_process_snapshot", "projection_summary",
               "health_reason for the bounded authority verdict",
               "health_reason", NULL, DIAG_TEST_DEFAULT, true),
    DIAG_ENTRY("chain_evidence_controller",
               diag_chain_evidence_dump_state_json,
               "native chain evidence controller: tips, snapshot anchor, evidence, contradiction reason",
               "chain_or_network", "service",
               "app/controllers/src/diagnostics_chain_evidence.c",
               "in_process_snapshot", "projection_summary", NULL, NULL,
               NULL, DIAG_TEST_DEFAULT, true),
    DIAG_ENTRY("bundle_staleness", bundle_staleness_dump_state_json,
               "fast-sync starter-pack freshness: seed height, block_index presence, network-tip gap, catch-up estimate, remint recommendation",
               "diagnostic", "service", DIAG_OWNER_LOCAL,
               "filesystem_snapshot", "bounded_lookup", NULL, NULL, NULL,
               DIAG_TEST_DEFAULT, true),
    DIAG_CHAIN("oracle", DIAG_REFERENCE_ORACLE_DUMPER,
               DIAG_REFERENCE_ORACLE_DESC,
               DIAG_REFERENCE_ORACLE_OWNER,
               DIAG_TEST_DEFAULT),
    DIAG_SERVICE("header_probe", header_probe_dump_state_json,
                 DIAG_HEADER_PROBE_DESC,
                 "app/services/src/header_probe.c", DIAG_TEST_DEFAULT),
    DIAG_SERVICE("header_band", diag_header_band_dump_state_json,
                 "header band backfill: derived island root, current getheaders anchor, remaining span, and blocker state",
                 "app/controllers/src/diagnostics_block_index.c",
                 "lib/test/src/test_block_index_integrity.c"),
    DIAG_SERVICE("header_range_sched", header_range_scheduler_dump_state_json,
                 "range-parallel header acquisition: partitioned range, per-span assignment/completion counts, and assign/reassign/timeout stats",
                 "app/services/src/header_range_scheduler.c",
                 "lib/test/src/test_header_range_sched.c"),
    DIAG_SERVICE("utxo_parity", utxo_parity_dump_state_json,
                 "standing UTXO-set parity vs reference commitment at the finalized frontier: checks/matches/mismatches, finalized_frontier, last_checked_height, source name+exact flag",
                 "app/services/src/utxo_parity_service.c",
                 DIAG_TEST_DEFAULT),
    DIAG_SERVICE("legacy_mirror", legacy_mirror_sync_dump_state_json,
                 DIAG_LEGACY_MIRROR_DESC,
                 "app/services/src/legacy_mirror_sync_service.c",
                 DIAG_TEST_DEFAULT),
    DIAG_SERVICE("block_intake", controller_block_intake_dump_state_json,
                 "P2P block intake queue: async catch-up worker state, depth/capacity, backpressure saturation, accepted/retryable/rejected/drop counters",
                 "app/controllers/src/block_intake_json.c",
                 DIAG_TEST_DEFAULT),
    DIAG_CHAIN("oracle_policy", oracle_policy_dump_state_json,
               "oracle policy: disagreement state machine (NORMAL / HALTED / PANIC)",
               "app/services/src/oracle_policy.c", DIAG_TEST_DEFAULT),
    DIAG_SERVICE("rolling_anchor", rolling_anchor_dump_state_json,
                 "rolling SHA3 anchor extension: runtime windows past compile-time prefix",
                 "app/services/src/rolling_anchor_service.c",
                 DIAG_TEST_DEFAULT),
    DIAG_LOCAL("mint_preflight", boot_mint_anchor_preflight_dump_state_json,
               "last -mint-anchor producer preflight run (run_all): "
               "have_report, all_ok, per-check {name,ok,why,remedy} — "
               "datadir_lock_acquirable, legacy_block_index_covers_anchor, "
               "bodies_present_sampled, disk_headroom, "
               "no_leftover_interrupted_run_artifacts, "
               "fold_inram_memory_estimate"),
    DIAG_JOB("refold", refold_progress_dump_state_json,
             "refold/mint mode: in_progress + from_anchor cached flags, compiled trusted_anchor, "
             "durable progress.kv keys (durable_in_progress/from_anchor), from_anchor_target_tip",
             "app/jobs/src/refold_progress.c", DIAG_TEST_DEFAULT),
    DIAG_JOB("pv_lookahead", pv_lookahead_dump_state_json,
             "cross-height shielded-proof pre-verification pool (offline mint fold; "
             "live/replay under -pv-lookahead): "
             "running, workers, window, queue_depth, cache_hits/misses/hit_rate, "
             "verdicts_produced, throughput_blk_per_sec, supervised/supervisor_child_id",
             "app/jobs/src/pv_lookahead.c", "lib/test/src/test_pv_lookahead.c"),
    DIAG_SERVICE("block_prefetch", block_prefetch_dump_state_json,
                 "block-body read-ahead worker (default OFF): warms the page "
                 "cache for [cursor+lead, +window) ahead of the leading fold "
                 "stage. running/nowait_probe, window/lead/warm_frontier, "
                 "hits/warmed/nowait_misses/resident_rate, bytes, "
                 "resolve_gaps/read_fails/passes, lru_count/lru_bytes, "
                 "warm_blk_per_sec, supervised/supervisor_child_id",
                 "lib/storage/src/block_prefetch.c",
                 "lib/test/src/test_block_prefetch.c"),
    DIAG_JOB("psc", psc_dump_state_json,
             "parallel state compiler audit (opt-in; producer re-mints / full "
             "audits): last psc_audit_run verdict comparing the order-independent "
             "parallel transparent-UTXO fold to the durable coins_kv set — "
             "has_run/ran/match, range, parallel/durable sha3 + count, supply, "
             "k_workers/s_shards, compile_us, us_per_block, reject_kind. Never "
             "writes consensus state; idle-safe (has_run=false before first audit)",
             "app/jobs/src/psc_audit.c", "lib/test/src/test_psc_real_range.c"),
    DIAG_JOB("rom_compile", rom_compile_status_dump_state_json,
             "ROM compilation fold progress: active/mode/height/target/percent/"
             "rate_blk_s/eta, the eight reducer stages' live step_us_ewma with "
             "bottleneck_stage, the layer ladder (rom_checkpoint/"
             "sealed_history/sealed_base_receipt/delta/tip_ring), and "
             "shielded_import (anchor+nullifier activation cursors, "
             "utxo_apply.{anchor,nullifier}_backfill_gap blocker state, "
             "durable imported anchor/nullifier row counts, and "
             "utxo_apply_next_height so the -import-complete-shielded "
             "import->resume transition is observable). Idle-node-safe: "
             "when no fold is active this reports the steady-state ladder, not "
             "an error",
             "app/jobs/src/rom_compile_status.c",
             "lib/test/src/test_rom_compile_status.c"),
    DIAG_STAGE("reducer_frontier", reducer_frontier_dump_state_json,
               "reducer L0 authority: H*, served_floor, stage cursors (each "
               "one carrying above_hstar / heights_above_hstar / trust, so a "
               "cursor that has consumed unverified heights cannot be read as "
               "a better height than H*), "
               "success-checked frontiers, coins frontier, first "
               "validate_headers blocker + repair owner, and rewind_bases "
               "(every currently-available self-verified rewind base — "
               "compiled checkpoint, sealed coins_sha3 ring slots, finalized "
               "utxo_sha3 — each with height/self_derived, plus the nearest "
               "one's O(delta) distance from H*)",
               "app/jobs/src/reducer_frontier_dump.c",
               "lib/test/src/test_reducer_frontier.c"),
    DIAG_STAGE("header_admit", header_admit_stage_dump_state_json,
               "header_admit stage: cursor, counters, last admit",
               "app/jobs/src/header_admit_stage.c", "lib/test/src/test_stage.c"),
    DIAG_STAGE("validate_headers", validate_headers_stage_dump_state_json,
               "validate_headers stage: cursor, pool stats, pass/fail counters",
               "app/jobs/src/validate_headers_stage.c", "lib/test/src/test_stage.c"),
    DIAG_STAGE("body_fetch", body_fetch_stage_dump_state_json,
               "body_fetch stage: cursor, observed/skipped counters, last advance",
               "app/jobs/src/body_fetch_stage.c", "lib/test/src/test_stage.c"),
    DIAG_STAGE("body_persist", body_persist_dump_state_json,
               "body_persist stage: cursor, verification counters, log rows",
               "app/jobs/src/body_persist_stage.c", "lib/test/src/test_stage.c"),
    DIAG_STAGE("reducer_stage_profile", reducer_stage_profile_dump_state_json,
               "versioned body_persist + script_validate subphase timings and work counters",
               "lib/sync/src/reducer_stage_profile.c", "lib/test/src/test_stage.c"),
    DIAG_STAGE("script_validate", script_validate_dump_state_json,
               "script_validate stage: cursor, script counters, log rows",
               "app/jobs/src/script_validate_stage_dump.c", "lib/test/src/test_stage.c"),
    DIAG_STAGE("proof_validate", proof_validate_dump_state_json,
               "proof_validate stage: cursor, proof counters, log rows",
               "app/jobs/src/proof_validate_stage_dump.c", "lib/test/src/test_stage.c"),
    DIAG_STAGE("utxo_apply", utxo_apply_dump_state_json,
               "utxo_apply stage: cursor, UTXO delta counters, log rows",
               "app/jobs/src/utxo_apply_stage_dump.c", "lib/test/src/test_stage.c"),
    DIAG_JOB("batch_commit", utxo_apply_batch_commit_dump_state_json,
             "utxo_apply kernel outer-batch COMMIT telemetry: total_commits, "
             "last/ewma/max commit_us, a rolling ring average, and the last "
             "batch's height range + row count — turns a slow fsync / "
             "degraded WAL into visible data instead of a silent stall",
             "app/jobs/src/utxo_apply_batch_commit.c",
             "lib/test/src/test_utxo_apply_stage.c"),
    DIAG_LOCAL("reducer_drive", reducer_drive_dump_state_json,
               "synchronous reducer/mint drive: active, label, age_us, "
               "watchdog_threshold_secs, last_watchdog_fire_unix, "
               "utxo_apply_cursor vs. the lagging coins_applied_height "
               "(the -fold-inram batching gap)"),
    DIAG_LOCAL("sync_rate", sync_rate_below_floor_dump_state_json,
               "sync-rate SLO watchdog (sync_rate_below_floor condition): "
               "current/floor fold-throughput bps (x1000 fixed point), "
               "below_floor_streak vs. consecutive_ticks_required, "
               "pending_work gate, and the episode-start snapshot "
               "(observed/floor bps, network_tip, log_head, dominant "
               "blocker) at the moment the blocker last fired"),
    DIAG_STAGE("tip_finalize", tip_finalize_dump_state_json,
               "tip_finalize stage: cursor, finalize counters, log rows",
               "app/jobs/src/tip_finalize_stage.c", "lib/test/src/test_stage.c"),
    DIAG_JOB("coin_backfill", coin_backfill_dump_state_json,
             "frontier coin backfill: last result, scan cursor, refusal latches",
             "app/jobs/src/stage_repair_coin_backfill_util.c",
             DIAG_TEST_DEFAULT),
    DIAG_SERVICE("chain_advance_coordinator", block_source_policy_dump_state_json,
                 "canonical chain-advance source scoring: P2P, snapshot, local import, mirror fallback",
                 "app/services/src/block_source_policy_status.c",
                 "lib/test/src/test_block_source_policy.c"),
    DIAG_CONDITION("chain_tip_watchdog", chain_tip_watchdog_dump_state_json,
                   "tip-stuck overlord: highest_tip, age_secs since last advance, escalation level + fire counts",
                   "app/services/src/chain_tip_watchdog.c", DIAG_TEST_DEFAULT),
    DIAG_ENTRY("validation_pack", invariant_sentinel_dump_state_json,
               "fail-loud validation pack: HOLD latch, per-connect "
               "linkage + coinbase-label checks, authority-pair "
               "self-check, window sweep, commitment audit, seed "
               "gate, mirror divergence locator",
               "diagnostic", "condition",
               "app/services/src/invariant_sentinel.c",
               "in_process_snapshot", "cheap", NULL, NULL, NULL,
               DIAG_TEST_DEFAULT, true),
    DIAG_SERVICE("bg_validation", bg_validation_dump_state_json,
                 "background historical-proof re-verification: state, "
                 "verified/chain height, sigs+proofs verified, "
                 "blocks_per_sec, script-verify skips",
                 "app/services/src/bg_validation_dump.c", DIAG_TEST_DEFAULT),
    DIAG_SERVICE("sync_monitor", sync_monitor_dump_state_json,
                 "sync watchdog: recovery counters + last recovery detail, "
                 "local header-refill recovery sub-state",
                 "app/services/src/sync_monitor.c", DIAG_TEST_DEFAULT),
    DIAG_LOCAL("gap_fill", gap_fill_dump_state_json,
               "IBD gap-fill worker: running, pass/enqueue/idle/corrupt-walk + timeout-sweep counters, last tip/window bounds"),
    DIAG_LOCAL("consensus_reject_index", consensus_reject_index_dump_state_json,
               "hash-keyed ring of recent consensus tx/block rejections: running, total/count/capacity, recent {hash,kind,dos,ts_us,reason}"),
    DIAG_LOCAL("mirror_divergence", mirror_divergence_dump_state_json,
               "mirror hash-disagreement bisect locator: last_locate_unix, last_first_div, probes_last_run, divergence_latched, pending record"),
    DIAG_LOCAL("nullifier_backfill", nullifier_backfill_dump_state_json,
               "owner-gated C-3 nullifier gap backfill: durable activation/resume cursors, derived status, gap_blocker_active"),
    DIAG_LOCAL("shielded_gap_remedy", shielded_gap_remedy_dump_state_json,
               "CONTAINED verify-only remedy surface for the shielded-history wedge "
               "(utxo_apply.anchor_backfill_gap / nullifier_backfill_gap): gap "
               "state + the NAMED owner-run import command + copy-prove step + "
               "containment verdict (auto_execute always false; refuses_live off a "
               "-COPY- datadir)"),
    DIAG_LOCAL("publication_cas",
               consensus_state_publication_cas_dump_state_json,
               "contained consensus-state publication CAS: latest decision (ADMIT/typed refusal), "
               "bound artifact/chain/source/epoch digests, bundle H/hash, expected frontier H/hash, decision digest"),
    DIAG_LOCAL("bundle_exporter", bundle_exporter_dump_state_json,
               "standing live consensus-state bundle exporter: "
               "session_open/qualified, degradation_reason, "
               "last_export_height/time/duration, exports_ok/failed, "
               "every_blocks, keep, generations present, last_refusal"),
    DIAG_LOCAL("sovereign_promotion", sovereign_promotion_dump_state_json,
               "background assisted-to-sovereign promotion: tier detection, "
               "phase, seam height/commitments, rederive progress, duty "
               "cycle, MATCH/MISMATCH verdict state"),
    DIAG_SERVICE("sync_shadow", sync_shadow_dump_state_json,
                 "pure sync-kernel SHADOW observer (sync/sync_reduce.h): per "
                 "lifecycle-point observed/agree/allowlisted/mismatch counters "
                 "plus a bounded ring of recent genuine mismatches. Observability "
                 "ONLY — the reference snapshot-sync FSM stays authoritative; "
                 "`authoritative:false` and any non-zero total_mismatches is a "
                 "LOUD signal that the kernel and reference diverged.",
                 "lib/net/src/sync_shadow.c",
                 "lib/test/src/test_sync_shadow.c"),
    DIAG_SERVICE("checkpoint_ladder", checkpoint_ladder_dump_state_json,
                 "checkpoint ladder verifier: the compiled sealed keystone (the "
                 "one `bound` trust root) plus on-disk candidate rung artifacts "
                 "from <datadir>/checkpoint_rungs/, each reported as "
                 "{height, bound, trust(baked|candidate_unbaked), "
                 "verdict(verified|unverifiable|MISMATCH), detail}. Checks "
                 "self-consistency, strictly-increasing height/non-decreasing "
                 "chainwork, and byte-for-byte reproduction of the keystone at "
                 "its own height; a MISMATCH raises the PERMANENT typed blocker "
                 "checkpoint_ladder.mismatch. Candidate rungs are "
                 "self-attestation, never elevated to trusted.",
                 "lib/storage/src/checkpoint_ladder.c",
                 "lib/test/src/test_consensus_state_snapshot_export.c"),
    DIAG_SERVICE("fast_sync", fast_sync_dump_state_json,
                 "fast-sync snapshot serving state: the UTXO-root offer cache "
                 "(valid/utxo_count/version/root) and the pre-serialized "
                 "snapshot cache (sha3_valid/utxo_count/version/buf_resident/"
                 "buf_bytes/num_chunks/sha3) that back zsnapshot offers + "
                 "chunk serving. The PoW gate + rate limiter are caller-owned "
                 "structs, not part of this whole-subsystem snapshot",
                 "lib/net/src/fast_sync.c",
                 "lib/test/src/test_fast_sync.c"),
