# Sky Combat seed: the checkout files the game build reads that live outside
# apps/skycombat, copied byte for byte into the seeded package (app seed).
# One "<repo path> <tree path>" per line; the tree keeps the repo layout so
# the package entrypoint (Makefile, including skycombat.mk) uses the same -I
# paths as the repo's game section. Keep this list equal to the
# non-apps/skycombat lines of `make print-game-closure`, plus raylib's
# license and provenance: app seed refuses a tree whose print-app-closure
# names a file the tree does not hold.

# Trimmed raylib (vendor/raylib/SOURCE): sources, headers, license.
vendor/raylib/LICENSE vendor/raylib/LICENSE
vendor/raylib/SOURCE vendor/raylib/SOURCE
vendor/raylib/SHA256SUMS vendor/raylib/SHA256SUMS
vendor/raylib/src/config.h vendor/raylib/src/config.h
vendor/raylib/src/external/RGFW/RGFW.h vendor/raylib/src/external/RGFW/RGFW.h
vendor/raylib/src/external/RGFW/deps/minigamepad.h vendor/raylib/src/external/RGFW/deps/minigamepad.h
vendor/raylib/src/external/fix_win32_compatibility.h vendor/raylib/src/external/fix_win32_compatibility.h
vendor/raylib/src/external/glad.h vendor/raylib/src/external/glad.h
vendor/raylib/src/external/rprand.h vendor/raylib/src/external/rprand.h
vendor/raylib/src/external/stb_image_resize2.h vendor/raylib/src/external/stb_image_resize2.h
vendor/raylib/src/external/stb_perlin.h vendor/raylib/src/external/stb_perlin.h
vendor/raylib/src/external/win32_clipboard.h vendor/raylib/src/external/win32_clipboard.h
vendor/raylib/src/platforms/rcore_desktop_rgfw.c vendor/raylib/src/platforms/rcore_desktop_rgfw.c
vendor/raylib/src/raylib.h vendor/raylib/src/raylib.h
vendor/raylib/src/raymath.h vendor/raylib/src/raymath.h
vendor/raylib/src/rcamera.h vendor/raylib/src/rcamera.h
vendor/raylib/src/rcore.c vendor/raylib/src/rcore.c
vendor/raylib/src/rgestures.h vendor/raylib/src/rgestures.h
vendor/raylib/src/rlgl.h vendor/raylib/src/rlgl.h
vendor/raylib/src/rmodels.c vendor/raylib/src/rmodels.c
vendor/raylib/src/rshapes.c vendor/raylib/src/rshapes.c
vendor/raylib/src/rtext.c vendor/raylib/src/rtext.c
vendor/raylib/src/rtextures.c vendor/raylib/src/rtextures.c

