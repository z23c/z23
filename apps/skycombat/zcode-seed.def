# Sky Combat seed: the checkout files the game build reads that live outside
# apps/skycombat, copied byte for byte into the seeded package (app seed).
# One "<repo path> <tree path>" per line; the tree keeps the repo layout so
# the package entrypoint (Makefile, including skycombat.mk) uses the same -I
# paths as the repo's game section. Keep this list equal to the
# non-apps/skycombat lines of `make print-game-closure`, plus the license
# and provenance of raylib, vendor/x11 and vendor/xdl: app seed refuses a
# tree whose print-app-closure names a file the tree does not hold.

# Trimmed raylib (vendor/raylib/SOURCE): sources, headers, license.
vendor/raylib/LICENSE vendor/raylib/LICENSE
vendor/raylib/SOURCE vendor/raylib/SOURCE
vendor/raylib/SHA256SUMS vendor/raylib/SHA256SUMS
vendor/raylib/src/config.h vendor/raylib/src/config.h
