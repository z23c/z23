/* Copyright 2026 Rhett Creighton - Apache License 2.0
 * Purpose: the Windows manifest and version resource linked into z23-wallet.exe. */
#include <winver.h>
/* Neutral language, like the mingw-w64 default manifest: the resource merge
 * keeps this one and drops the default, so the binary carries one manifest. */
LANGUAGE 0, 0
1 24 "z23wallet.manifest"
LANGUAGE 0x09, 0x01
VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Z23 contributors"
      VALUE "FileDescription", "Z23 Wallet"
      VALUE "FileVersion", "0.1.0.0"
      VALUE "InternalName", "z23-wallet"
      VALUE "LegalCopyright", "Apache License 2.0"
      VALUE "OriginalFilename", "z23-wallet.exe"
      VALUE "ProductName", "Z23 Wallet"
      VALUE "ProductVersion", "0.1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
