/* ---- CAP_WALLET ---- */
ZCL_CAPABILITY_SYMBOL("ed25519_secret_key_from_seed", CAP_WALLET,
    "Derives the onion service identity key. Not spending material, but "
    "this table has one class for secret key material and a long lived "
    "identity key belongs behind a declaration.")
ZCL_CAPABILITY_SYMBOL("PEM_read_PrivateKey", CAP_WALLET,
    "Moves a private key from a stream into memory.")
ZCL_CAPABILITY_SYMBOL("PEM_write_bio_PrivateKey", CAP_WALLET,
    "Serialises a private key out of memory, which is the first half of "
    "losing it.")
ZCL_CAPABILITY_SYMBOL("PKCS5_PBKDF2_HMAC", CAP_WALLET,
    "Turns a passphrase into a key. The passphrase side is what makes "
    "this key reach rather than arithmetic.")
ZCL_CAPABILITY_SYMBOL("secp256k1_ecdsa_sign", CAP_WALLET,
    "Signing is spending.")
ZCL_CAPABILITY_SYMBOL("secp256k1_ecdsa_sign_recoverable", CAP_WALLET,
    "Signing is spending.")
ZCL_CAPABILITY_SYMBOL("secp256k1_ec_pubkey_create", CAP_WALLET,
    "Takes a secret key as input. The parse and serialize calls on the "
    "public side are harmless; this one is not.")
ZCL_CAPABILITY_SYMBOL("secp256k1_ec_seckey_tweak_add", CAP_WALLET,
    "Operates on a secret key. The pubkey twin of this call is "
    "harmless.")
ZCL_CAPABILITY_SYMBOL("secp256k1_ec_seckey_verify", CAP_WALLET,
    "Operates on a secret key, so it can only appear where one is held.")
ZCL_CAPABILITY_SYMBOL("SSL_CTX_check_private_key", CAP_WALLET,
    "Handles the server private key. The certificate side twins are "
    "CAP_NETWORK, because a certificate is public.")
ZCL_CAPABILITY_SYMBOL("SSL_CTX_use_PrivateKey_file", CAP_WALLET,
    "Reads the server private key off disk and installs it, so it is "
    "both an FS_READ and a key reach; the key half is the one worth "
    "declaring.")
ZCL_CAPABILITY_SYMBOL("SSL_use_PrivateKey", CAP_WALLET,
    "Installs private key material on a single connection.")
ZCL_CAPABILITY_SYMBOL("X509_check_private_key", CAP_WALLET,
    "Compares a certificate against a private key, so a key must be in "
    "hand.")
ZCL_CAPABILITY_SYMBOL("X509_sign", CAP_WALLET,
    "Signs with a private key, unlike the rest of the X509 family, "
    "which only shapes a public structure.")

