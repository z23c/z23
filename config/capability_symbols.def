ZCL_CAPABILITY_SYMBOL("setenv", CAP_PROCESS,
    "Mutates the block a later exec inherits, which is how PATH and the "
    "loader variables get chosen.")
ZCL_CAPABILITY_SYMBOL("setpgid", CAP_PROCESS,
    "Process group control, the other half of daemonising a spawned "
    "child.")
ZCL_CAPABILITY_SYMBOL("setsid", CAP_PROCESS,
    "Detaches from the controlling terminal, which only a program that "
