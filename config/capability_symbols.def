/* ---- CAP_PROCESS ---- */
ZCL_CAPABILITY_SYMBOL("clearenv", CAP_PROCESS,
    "Empties the block a later exec inherits. Classed with setenv, which "
    "mutates it, rather than with getenv, which only reads it: this table "
