ZCL_CAPABILITY_SYMBOL("waitpid", CAP_PROCESS,
    "Only reachable in code that already forked. Kept in the class so "
    "the spawn set stays complete and countable.")
ZCL_CAPABILITY_SYMBOL("wait4", CAP_PROCESS,
    "Same reach as waitpid, with resource accounting attached. Kept in "
    "the class for the same reason: the spawn set must stay complete.")
ZCL_CAPABILITY_SYMBOL("waitid", CAP_PROCESS,
    "Same reach as waitpid. Reached only from tools/package_verify.c, "
    "which supervises the child that performs a reproduction build.")

