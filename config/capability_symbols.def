/* ---- CAP_PRIVILEGE ---- */
ZCL_CAPABILITY_SYMBOL("csops", CAP_PRIVILEGE,
    "The operation number is invisible to nm and spans code-signing "
    "inspection and process policy mutation; the restrictive class wins.")
ZCL_CAPABILITY_SYMBOL("grantpt", CAP_PRIVILEGE,
    "Grants the current process access to a pseudo-terminal slave by "
    "changing kernel-managed ownership and permissions.")
ZCL_CAPABILITY_SYMBOL("ioctl", CAP_PRIVILEGE,
    "The request code is invisible to nm and spans terminal settings, "
    "network interface configuration and arbitrary device control, so "
    "the restrictive class is the only honest one.")
ZCL_CAPABILITY_SYMBOL("prctl", CAP_PRIVILEGE,
    "Covers no-new-privs, the dumpable flag and seccomp installation.")
ZCL_CAPABILITY_SYMBOL("sched_setscheduler", CAP_PRIVILEGE,
    "A real time policy needs CAP_SYS_NICE, so this call changes what "
    "the process is allowed to ask of the scheduler. Contrast "
    "pthread_setaffinity_np, which changes only where it runs.")
ZCL_CAPABILITY_SYMBOL("setgid", CAP_PRIVILEGE, "")
ZCL_CAPABILITY_SYMBOL("setgroups", CAP_PRIVILEGE, "")
ZCL_CAPABILITY_SYMBOL("setrlimit", CAP_PRIVILEGE,
    "Raising a soft limit changes what this process may do, which is "
    "the class definition verbatim. The reading half, getrlimit, is "
    "harmless.")
ZCL_CAPABILITY_SYMBOL("setuid", CAP_PRIVILEGE, "")
ZCL_CAPABILITY_SYMBOL("sqlite3_db_config", CAP_PRIVILEGE,
    "The option id is invisible to nm and includes the load extension "
    "switch and the defensive mode switches, so this one call can widen "
    "what the connection is allowed to do.")
ZCL_CAPABILITY_SYMBOL("sqlite3_set_authorizer", CAP_PRIVILEGE,
    "Installs the connection permission hook, and with a null callback "
    "removes every restriction a previous caller set.")
ZCL_CAPABILITY_SYMBOL("syscall", CAP_PRIVILEGE,
    "Defeats symbol level classification entirely, because the syscall "
    "number is a runtime value and no class here can bind it. It is "
    "banned separately at source level by check-capability-closure.")
ZCL_CAPABILITY_SYMBOL("unlockpt", CAP_PRIVILEGE,
    "Changes the kernel pseudo-terminal lock state so its slave can be "
    "opened by another process.")
ZCL_CAPABILITY_SYMBOL("unshare", CAP_PRIVILEGE,
    "Creates new namespaces, which is authority over what the process "
    "can see.")

