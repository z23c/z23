ZCL_COMMAND_READY_COMMAND(
    "app.market.offer", "app.market", "", "Announce a file for sale",
    "Builds the canonical chunk manifest from a private local file, mints or "
    "loads the owner-controlled seller signing key (encrypted under the "
    "wallet metadata DEK, same custody as purchase plans), binds a fresh "
    "wallet Sapling payee address, signs the self-authenticating "
    "zfileoffer.v1 contract, persists it, binds the private content for paid "
    "chunk serving, and floods the exact signed wire from the origin. A "
    "first call without confirm:true hashes and prices the file without "
    "mutating anything; only the confirmed call persists, binds, and "
    "announces. Requires -externalip so the signed endpoint is reachable. "
    "Re-commit of the same live offer replays idempotently without "
    "re-announcing. The private filepath is absent from results and logs.", 0,
    "market,offer,sell", "zcl.app_market_offer.input.v1",
    "zcl.app_market_offer_result.v1", "filepath,price_per_mb_zat,confirm", "",
