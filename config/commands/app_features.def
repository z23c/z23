/* Both swap leaves are READY. Neither moves funds: swap_initiate /
 * swap_participate mint an HTLC contract row (secret, redeem script, P2SH
 * address) and persist it — the operator funds the returned P2SH address
 * separately, and settlement is swap_redeem / swap_refund. locktime_blocks is
 * a DURATION from the current tip; swap_locktime_to_absolute fails closed on a
 * non-ZCL chain or an unknown tip rather than minting a contract whose CLTV
 * would already be refundable. */

ZCL_COMMAND_READY_COMMAND(
    "app.swap.initiate", "app.swap", "", "Initiate an atomic swap",
    "Plan/commit HTLC mint: without confirm, a non-mutating plan; with "
    "confirm:true, the freshly minted contract from swap_initiate at call "
    "time (stage=committed) — a generated secret and its SHA-256 hash, the "
    "97-byte redeem script, and the P2SH address to fund. No funds move: this "
    "call broadcasts nothing, and the swap only becomes live once you pay the "
    "returned p2sh_address. locktime is stored as an absolute CLTV height "
    "(tip + locktime_blocks); ZCL chain only.", 0,
    "swap,zswp,initiate", "zcl.app_swap_initiate.input.v1",
    "zcl.app_swap_contract.v1",
    "wallet_scope,my_address,counter_address,amount,locktime_blocks,chain,confirm", "",
    "z23 app swap initiate --input='{\"my_address\":\"t1..\",\"counter_address\":\"t1..\",\"amount\":1,\"locktime_blocks\":20,\"confirm\":true}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE, ZCL_COMMAND_RISK_WALLET,
    ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_WALLET_REQUEST, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_swap_initiate)

ZCL_COMMAND_READY_COMMAND(
    "app.swap.participate", "app.swap", "", "Participate in an atomic swap",
    "Plan/commit counter-HTLC mint: without confirm, a non-mutating plan; "
    "with confirm:true, the counter-contract from swap_participate at call "
    "time (stage=committed) built against the initiator's secret_hash, with "
    "no secret of its own. No funds move — fund the returned p2sh_address to "
    "activate it. Pass a locktime_blocks SHORTER than the initiator's; it is "
    "stored as an absolute CLTV height (tip + locktime_blocks), ZCL chain "
    "only.", 0,
    "swap,zswp,participate", "zcl.app_swap_participate.input.v1",
    "zcl.app_swap_contract.v1",
    "wallet_scope,my_address,counter_address,amount,locktime_blocks,secret_hash,chain,confirm",
    "",
    "z23 app swap participate --input='{\"my_address\":\"t1..\",\"counter_address\":\"t1..\",\"amount\":1,\"locktime_blocks\":10,\"secret_hash\":\"<64hex>\",\"confirm\":true}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE, ZCL_COMMAND_RISK_WALLET,
    ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_WALLET_REQUEST, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_swap_participate)
