ZCL_COMMAND_READY_COMMAND(
    "app.market.moderation.profile.set", "app.market.moderation.profile",
    "", "Set this node's listing-visibility profile",
    "Exact plan/commit over the node's own moderation profile, persisted "
    "to <datadir>/market/moderation.v1. mode=plan mints a plan_token bound "
    "to the current active profile and the target; mode=commit requires "
    "that token (STALE_PLAN after any concurrent change). Boot default is "
    "the immutable general-audience.v1 (unreviewed and sensitive offers are "
    "kept but neither listed nor served from here); open-view is the named "
    "opt-in showing and hosting everything ingested. This is the SERVE leg "
    "only — relay is a separate rule with its own default, set by "
    "app.market.moderation.relay.set, and this command never moves it. A "
    "local decision that binds no other node and never touches consensus.", 0,
    "market,moderation,profile,set,policy",
    "zcl.app_market_moderation_profile_set.input.v1",
    "zcl.market_moderation_profile_set.v1",
    "profile,mode,plan_token", "profile,mode",
    "z23 app market moderation profile set --input='{\"profile\":\"open-view\",\"mode\":\"plan\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
