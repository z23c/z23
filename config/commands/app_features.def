    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_bridge_command)

ZCL_COMMAND_READY_COMMAND(
    "app.messaging.send", "app.messaging", "", "Send a message",
    "Plan/commit ZMSG send over one of two channels: p2p writes the serialized "
    "message straight to a connected peer's socket (free, no funds move, "
    "plaintext on the wire until v2 transport is negotiated); onchain composes "
    "a shielded Sapling-memo z_sendmany, which SPENDS the dust output plus fee "
    "and needs the Sapling prover ready. Without confirm, a non-mutating plan "
    "whose spends_funds flag says which of the two this call would be; with "
    "confirm:true, the stored msg_id plus the peer id or broadcast txid "
    "(stage=committed, status=sent).", 0,
    "messaging,zmsg,send", "zcl.app_message_send.input.v1",
    "zcl.app_message_send_result.v1",
    "message,channel,peer_id,to,from_address,reply_to,confirm", "",
    "z23 app messaging send --input='{\"channel\":\"p2p\",\"peer_id\":1,\"message\":\"hi\",\"confirm\":true}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE, ZCL_COMMAND_RISK_APP_WRITE,
    ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_P2P_TOPIC, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_message_send)

ZCL_COMMAND_PLANNED_COMMAND(
    "app.messaging.send-named", "app.messaging", "", "Send a message to a ZCL Name",
    "Will resolve the ZCL Name and deliver the message once an outbound "
    "delivery path exists; today the handler is unbound and fails closed with "
    "exit 3 rather than reporting a delivery that cannot happen.", 0,
    "messaging,zmsg,send,name", "zcl.app_message_send_named.input.v1",
    "zcl.app_message_send_result.v1", "name,message,confirm", "name",
    "z23 app messaging send-named --input='{\"name\":\"alice\",\"message\":\"hi\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE, ZCL_COMMAND_RISK_APP_WRITE,
    ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_P2P_TOPIC, ZCL_COMMAND_TRAIT_NONE,
    "needs an outbound delivery path before it can be exposed natively: "
    "rpc_msg_send_named (messaging_controller.c) resolves the name, calls "
    "zmsg_store_add + db_zmsg_save, and answers status=queued, but nothing in "
    "the tree ever drains that store onto a peer socket — no writer sends "
    "MSG_ZMSG for a stored message, so the queue has no consumer and the "
    "message is never delivered. Use app messaging send with an explicit "
    "peer_id, whose write to the peer socket is real")

ZCL_COMMAND_READY_COMMAND(
    "app.messaging.read", "app.messaging", "", "Mark a message read",
    "The read receipt for one message: msg_id echoed back with status=read "
    "after msg_read flipped the bit in both the in-memory ZMSG store and the "
    "SQLite row at call time. It returns the receipt only — the message body "
    "is not part of msg_read's answer, so read the content from app messaging "
    "inbox. An unknown msg_id is not an error: the mark is idempotent.", 0,
    "messaging,zmsg,read", "zcl.app_message_read.input.v1",
    "zcl.app_message_read_result.v1", "msg_id", "msg_id",
    "z23 app messaging read --input='{\"msg_id\":\"<64hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE, ZCL_COMMAND_RISK_APP_WRITE,
    ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW, ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_P2P_TOPIC, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_message_read)

