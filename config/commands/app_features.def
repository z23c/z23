/* ZCL built-in application features, mounted under the `app` root (the frozen
 * root set stays at seven: status/core/app/dev/ops/discover/code). These are the
 * native command surface for names (ZNAM), ZSLP tokens, messaging (ZMSG), the
 * file market, and cross-chain atomic swaps.
 *
 * Read leaves are READY and dispatch through zcl_native_bridge_command
 * (body functions in app/controllers/src/app_native_handlers.c, bound in
 * tools/command/native_command.c's g_bridge_tools[]/g_bridge_native_body[]).
 *
 * The WRITE leaves split on one question: does the backing RPC actually finish
 * the job its summary promises?
 *
 *   READY — the ZNAM writes, ZMSG send/read, and the two swap contract mints.
 *   Each backing handler builds, signs, admits and relays its own transaction
 *   (or writes to the peer socket / flips the read bit), so the native leaf is
 *   a typed front door onto finished work. Handlers live in
 *   app/controllers/src/app_write_native_handlers.c; every value-moving leaf
 *   honours its declared ZCL_COMMAND_CONFIRM_PLAN_COMMIT — a first call
 *   without confirm:true returns a non-mutating plan, only the confirmed call
 *   broadcasts — and a backing RPC that succeeds WITHOUT doing the job (a ZNAM
 *   write answering status="ready" because the node carries no wallet) is
 *   reported BLOCKED, never PASSED.
 *
 *   PLANNED — the two whose backing RPC stops short of its own summary. Each
 *   availability_reason below names the exact missing code path, not a generic
 *   "not implemented"; opening a native door onto them would mint a PASSED
 *   reply for work the node never performs.
 *
 * Consumer defines ZCL_COMMAND_*. */

/* Branch summaries are deliberately terse single words: they render inside the
 * parent `app` branch menu, which is bounded by ZCL_COMMAND_BRANCH_BUDGET and
 * already carries six longer-summary children (auth/account/list/inspect/
 * protocols/invoke). Keeping these short keeps the `app` menu well under
 * budget (verified in test_native_api_contract's per-branch menu sweep). */
ZCL_COMMAND_BRANCH("app.names", "app", "Names", ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("app.tokens", "app", "Tokens", ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("app.messaging", "app", "Messaging", ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("app.market", "app", "Market", ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("app.market.content", "app.market", "Seller content",
                   ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("app.market.purchase", "app.market", "Buyer purchase",
                   ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("app.market.moderation", "app.market", "Moderation",
                   ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("app.market.moderation.profile", "app.market.moderation",
                   "Profiles", ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("app.market.moderation.relay", "app.market.moderation",
                   "Relay rule", ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("app.market.moderation.review", "app.market.moderation",
                   "Review marks", ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("app.store", "app", "Store", ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("app.shop", "app", "Shop", ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("app.shop.want", "app.shop", "Buyer wants",
                   ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("app.shop.want.fulfill", "app.shop.want", "Fulfillments",
                   ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("app.swap", "app", "Swaps", ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("app.qr", "app", "QR", ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("app.presentation", "app", "Native presentation",
                   ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("app.blog", "app", "Blog", ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("app.payments", "app", "Payments", ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("app.payments.zpay", "app.payments", "ZPAY",
                   ZCL_COMMAND_LAYER_APP)

/* ── ZPAY Sapling-memo payment envelopes ────────────────────────── */

ZCL_COMMAND_READY_READ(
    "app.payments.zpay.compose", "app.payments.zpay", "",
    "Compose an anonymous canonical ZPAY Sapling memo",
    "Deterministically encodes one complete ZPAY v1 invoice, payment, or "
    "receipt envelope from explicit network, clock, nonce, request, invoice, "
    "asset, and commitment fields. Returns the exact 512-byte memo_hex for "
    "core.wallet.shielded.send. It never reads a wallet, signs an identity, "
    "or broadcasts; optional ZID signing is deliberately unavailable because "
    "identity seeds must not enter agent command context.",
    ZCL_COMMAND_RESULT_BUDGET, "payments,zpay,sapling,memo,compose,invoice",
    "zcl.app_zpay_compose.input.v1", "zcl.app_zpay_memo.v1",
    "network,message_type,created_at,expires_at,nonce,request_id,invoice_digest,asset,amount_commitment,reply_ref",
    "network,message_type,created_at,expires_at,nonce,request_id,invoice_digest,asset,amount_commitment",
    "z23 app payments zpay compose --input='<obj>'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_PUBLIC, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_TINY, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_NONE,
    ZCL_COMMAND_TRAIT_DETERMINISTIC | ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_zpay_compose)

ZCL_COMMAND_READY_READ(
    "app.payments.zpay.inspect", "app.payments.zpay", "",
    "Decode, authenticate, and policy-check one ZPAY Sapling memo",
    "Strictly decodes an exact 512-byte ZPAY memo, verifies any embedded ZID "
    "document against the caller-supplied clock, and reports whether its "
    "network and lifetime are current. A malformed, wrong-network, expired, "
    "or invalidly signed memo is never upgraded to a payment fact.",
    ZCL_COMMAND_RESULT_BUDGET, "payments,zpay,sapling,memo,inspect,verify",
    "zcl.app_zpay_inspect.input.v1", "zcl.app_zpay_envelope.v1",
    "memo_hex,network,now_unix", "memo_hex,network,now_unix",
    "z23 app payments zpay inspect --input='<obj>'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_PUBLIC, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_TINY, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_NONE,
    ZCL_COMMAND_TRAIT_DETERMINISTIC | ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_zpay_inspect)

ZCL_COMMAND_READY_COMMAND(
    "app.qr.show", "app.qr", "", "Show a payload as a native QR window",
    "Launches a portable C QR window through the warm same-binary presentation "
    "host, retaining the detached reviewed child as a portable fallback. The "
    "bounded payload crosses only length-framed local IPC or framed stdin, "
    "never argv, environment, node transport, or logs. The native result "
    "does not echo it; explicit output=text returns the complete deterministic "
    "companion when it fits, otherwise a bounded payload page with exact page "
    "count, without launching a window. The "
    "window copies with C, closes with Escape/Q, and uses an integer-scaled "
    "four-module quiet zone for reliable scanning. RGFW and the QR encoder are "
    "pinned permissive source in this repository.", 0,
    "qr,display,popup,payment,uri,presentation", "zcl.app_qr_show.input.v1",
    "zcl.app_qr_show.v1", "payload,title,output,page", "payload",
    "z23 app qr show 'zclassic:t1...?amount=0.01'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_DISPLAY_ONLY,
    zcl_native_handle_qr_show)

ZCL_COMMAND_READY_COMMAND(
    "app.presentation.show", "app.presentation", "",
    "Show a bounded renderer-neutral model in a native C23 window",
    "Validates a closed visual document, encodes it without structure padding, "
    "and submits it to a warm same-binary display-only host. Status, tables, "
    "progress, charts, timelines, code diffs, and evidence graphs return after "
    "the first native blit; a later non-interactive model with the same "
    "request_id replaces that display-only view. Choices and exact-root "
    "confirmations return only a numbered action ID or dismissal. Bounded "
    "forms additionally return at most four exact ID/value pairs only on "
    "Submit. A bounded canvas returns one selected point ID and normalized "
    "x/y coordinates only on Submit. Cancel and dismissal return none. The full "
    "node must independently recheck policy and plan/commit state before "
    "acting. The host receives no wallet, Internet, datadir, package, "
    "publication, deployment, or consensus authority. Set output=text to "
    "receive the complete deterministic plain-text companion when it fits; "
    "oversized documents return one bounded page and exact page count, and an "
    "optional zero-based page selects another page. No window is opened.", 0,
    "presentation,native,status,progress,diff,evidence,agent",
    "zcl.app_presentation_show.input.v1", "zcl.app_presentation_show.v1",
    "kind,request_id,title,summary,exact_root,items,actions,output,page",
    "kind,request_id,title",
    "z23 app presentation show --input='<bounded-model>'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_DISPLAY_ONLY,
    zcl_native_handle_presentation_show)

