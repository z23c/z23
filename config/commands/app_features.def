ZCL_COMMAND_READY_COMMAND(
    "app.market.purchase.plan", "app.market.purchase", "",
    "Reserve one exact paid chunk range",
    "Loads an authenticated network-bound offer, prices one exact chunk range "
    "with integer arithmetic, mints an encrypted buyer credential and canonical "
    "Sapling memo, then atomically reserves recipient value plus the wallet's "
    "maximum fee. Requires a current identity-bound custody snapshot and a "
    "caller idempotency key. Source and seller addresses, memo, credential, "
    "paths, and keys are absent from the result and logs. This mutates only the "
    "durable reservation; it does not broadcast or download bytes.", 0,
    "market,buy,purchase,payment,plan,reservation,idempotent",
    "zcl.app_market_purchase_plan.input.v1", "zcl.market_purchase.v1",
    "wallet_scope,offer_id,source_address,chunk_start,chunks_paid,idempotency_key",
    "wallet_scope,offer_id,source_address,chunk_start,chunks_paid,idempotency_key",
    "printf '%s' '{\"wallet_scope\":\"dev\",\"offer_id\":\"<64hex>\",\"source_address\":\"<owned-address>\",\"chunk_start\":0,\"chunks_paid\":1,\"idempotency_key\":\"lab-001\"}' | z23 app market purchase plan --input=-",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_WALLET, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_WALLET_REQUEST, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_market_purchase_plan)

ZCL_COMMAND_READY_COMMAND(
    "app.market.purchase.commit", "app.market.purchase", "",
    "Commit one exact reserved market payment",
    "Requires the explicit wallet scope, durable plan ID, and confirm:true. "
