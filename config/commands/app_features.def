ZCL_COMMAND_READY_COMMAND(
    "app.market.moderation.relay.set", "app.market.moderation.relay",
    "", "Set this node's offer-relay rule",
    "Exact plan/commit over the node's own RELAY rule, persisted to "
    "<datadir>/market/moderation.v1 alongside, and independent of, the "
    "serve profile — setting one leg never moves the other, and their plan "
    "tokens are not interchangeable. Boot default is relay-all.v1: forward "
    "every valid offer announcement. Relaying passes on a POINTER, not "
    "content, so gating it by default would cut an honest seller's reach to "
    "one hop and hand discovery to whoever has operators awake. "
    "relay-reviewed-only.v1 is the opt-in that forwards only offers this "
    "node marked reviewed_ok; refusals stay counted, never silently "
    "dropped. A local decision that binds no other node and never touches "
    "consensus.", 0,
    "market,moderation,relay,gossip,set,policy",
    "zcl.app_market_moderation_relay_set.input.v1",
    "zcl.market_moderation_relay_set.v1",
    "relay_rule,mode,plan_token", "relay_rule,mode",
    "z23 app market moderation relay set --input='{\"relay_rule\":\"relay-reviewed-only.v1\",\"mode\":\"plan\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_P2P_TOPIC, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_market_moderation_relay_set)

ZCL_COMMAND_READY_COMMAND(
    "app.market.moderation.review.set", "app.market.moderation.review", "",
    "Mark one offer's local review_state",
    "The node's OWN curation mark on one signed offer: sets the local-only "
