/* ── generic ZANC digest anchors ─────────────────────────────────── */
ZCL_COMMAND_BRANCH("core.anchor", "core",
                   "Generic ZANC digest-anchor composition and inspection",
                   ZCL_COMMAND_LAYER_CORE)
ZCL_COMMAND_READY_READ(
    "core.anchor.compose", "core.anchor", "",
    "Compose one canonical generic ZANC digest anchor",
    "Validates an explicit SHA2-256 or SHA3-256 digest and optional public "
    "label, then returns the exact standard-relay ZANC OP_RETURN plus the "
    "op_return_hex fragment accepted by core.wallet.transaction.raw.create. "
    "It is deterministic and never reads a file, wallet, key, or node; "
    "funding, signing, and broadcast remain separate owner-only steps.", 0,
    "anchor,zanc,digest,op_return,compose,transaction",
    "zcl.core_anchor_compose.input.v1", "zcl.core_anchor_compose.v1",
    "digest,hash_type,label", "digest",
    "z23 core anchor compose --digest=<64hex> --label=release@1",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_PUBLIC, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_TINY, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_NONE,
    ZCL_COMMAND_TRAIT_DETERMINISTIC | ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_core_anchor_compose)
ZCL_COMMAND_READY_READ(
    "core.anchor.inspect", "core.anchor", "",
    "Strictly decode one canonical ZANC OP_RETURN",
    "Parses exact OP_RETURN script hex through the production ZANC codec and "
    "returns its version, hash algorithm, digest, label, and size. Malformed, "
    "non-canonical, trailing, wrong-tag, or oversize bytes fail closed. It "
    "never reads a wallet or changes chain state.", 0,
    "anchor,zanc,digest,op_return,inspect,decode",
    "zcl.core_anchor_inspect.input.v1", "zcl.core_anchor_inspect.v1",
    "op_return_hex", "op_return_hex",
    "z23 core anchor inspect <op_return_hex>",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_PUBLIC, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_TINY, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_NONE,
    ZCL_COMMAND_TRAIT_DETERMINISTIC | ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_core_anchor_inspect)

/* ── epoch (Bounded Node keystone) ─────────────────────────────────
 * The OP_RETURN catalog's incremental digest-chain commits every overlay
 * record the chain has ever carried; one ZANC anchor per epoch commits
 * the whole overlay state in ~40 bytes. v1: no service, no auto-broadcast
 * — anchoring spends fees and stays an operator decision. Label semantics
 * (shared with dumpstate zepoch): "zepoch@<H>", H = catalog cursor height
 * the digest was read at; an anchor covers epoch E = tip/1000 when
 * H >= E*1000. */
ZCL_COMMAND_BRANCH("core.epoch", "core",
                   "Epoch anchors: commit the overlay catalog digest on-chain",
                   ZCL_COMMAND_LAYER_CORE)
ZCL_COMMAND_READY_READ(
    "core.epoch.status", "core.epoch", "",
    "Catalog digest, epoch position, and anchor presence",
    "The OP_RETURN catalog state read from the datadir's node.db at call "
    "time (works on a stopped or copied datadir): tip (cursor) height, "
    "catalog digest hex, catalog row count, the current epoch "
    "(height/1000) and blocks into it, and whether a ZANC anchor labeled "
    "zepoch@<H> with H inside the current epoch already exists (with its "
    "label/txid/height/confirmations/digest and a digest_match flag). A "
    "missing anchor comes with the exact next command to run.", 0,
    "epoch,anchor,catalog,digest,status,zepoch",
    "zcl.core_epoch_status.input.v1", "zcl.core_epoch_status.v1",
    "datadir", "",
    "z23 core epoch status",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_SCOPE_OFFLINE_COPY,
    ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_CHAIN_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_core_epoch_status)
ZCL_COMMAND_READY_COMMAND(
    "core.epoch.anchor", "core.epoch", "",
    "Anchor the current catalog digest on-chain (spends a fee)",
    "Builds a ZANC anchor (SHA3, label zepoch@<tip>) committing the "
    "current OP_RETURN catalog digest. With a live node: dispatches the "
    "wallet compose+broadcast through anchor_publish and returns the txid "
    "(the node itself returns op_return_hex when no wallet is loaded). "
    "With no live node: returns op_return_hex plus the exact next step. "
    "Never runs on a timer — every anchor is an explicit operator "
    "decision.", 0,
    "epoch,anchor,commit,broadcast,zepoch,fee",
    "zcl.core_epoch_anchor.input.v1", "zcl.core_epoch_anchor.v1",
