    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_core_identity_list)

/* ── core.zdir.* — the on-chain node directory, WRITE side ──────────
 * A ZDIR record says one thing: "this v3 onion hostname is a node, and
 * this t-address paid for saying so." Every node folds confirmed records
 * out of block history into its onion_directory projection and may dial
 * them, so this is how a node stops being invisible to strangers without
 * asking any seed operator for permission. A row is a HINT ABOUT WHERE TO
 * LOOK, never proof of who is there: the directory only ever ADDS dial
 * candidates alongside DNS seeds, fixed seeds and addrman, and has no path
 * to exclude a peer. With a live node these dispatch the wallet
 * compose+broadcast through the zdir_* RPCs; with no live node (or no
 * wallet) they return op_return_hex for the operator to include. There is
 * no transfer leaf on purpose — ZDIR command byte 3 is reserved and
 * zdir_parse rejects it, so handing a hostname to another operator is
 * deregister by the current owner then register by the new one. Never on a
 * timer — publishing spends a fee and stays an operator decision. */
ZCL_COMMAND_BRANCH("core.zdir", "core",
                   "On-chain node directory: announce and retire onion hostnames",
                   ZCL_COMMAND_LAYER_CORE)
ZCL_COMMAND_READY_READ(
    "core.zdir.guide", "core.zdir", "",
    "How to find Z23 nodes from the chain, without seed IPs",
    "The on-chain onion directory is the stranger's front door: list "
    "hostnames the chain has already paid to announce, then dial them. "
    "It is a hint about where to look, never proof of who is there, and "
    "never a host allowlist. Extra input is refused.",
    ZCL_COMMAND_LIST_BUDGET,
    "zdir,directory,onion,guide,discover,peer,decentralized",
    "zcl.core_zdir_guide.input.v1", "zcl.core_zdir_guide.v1", "", "",
    "z23 core zdir guide",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_PUBLIC, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_TINY,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE,
    ZCL_COMMAND_TRAIT_DETERMINISTIC | ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_core_zdir_guide)
ZCL_COMMAND_READY_READ(
    "core.zdir.list", "core.zdir", "",
    "Active onion hostnames folded from confirmed ZDIR records",
    "One page of active onion_directory rows, senior registration first. "
    "Each row is a hostname and height — a dial hint from the chain, not "
    "an IP and not an owner address. An absent node.db is an empty "
    "directory, not a seed list.", ZCL_COMMAND_LIST_BUDGET,
    "zdir,directory,onion,list,discover,peer",
    "zcl.core_zdir_list.input.v1", "zcl.core_zdir_list.v1",
    "datadir", "",
    "z23 core zdir list",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_SCOPE_OFFLINE_COPY,
    ZCL_COMMAND_AUTH_PUBLIC, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_CHAIN_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_core_zdir_list)
ZCL_COMMAND_READY_COMMAND(
    "core.zdir.register", "core.zdir", "",
    "Announce a v3 onion hostname on-chain as a node (spends a fee)",
    "Prepares the exact signed ZDIR REGISTER transaction under explicit "
    "custody, optionally binding --pubkey=<64hex>. The plan atomically "
    "reserves its input and maximum fee; commit publishes the durable bytes "
    "once. Tor-v3 validation and ownership preflight run before reservation. "
    "A row with no owner remains immutable and no timer invokes this leaf.", 0,
    "zdir,directory,onion,register,announce,publish,peer,discovery,broadcast,fee",
    "zcl.core_zdir_register.input.v2", "zcl.core_zdir_register.v2",
    "wallet_scope,hostname,pubkey,idempotency_key,plan_id,confirm,datadir", "wallet_scope",
    "z23 core zdir register --input='{\"wallet_scope\":\"dev\",\"hostname\":\"<56base32>.onion\",\"idempotency_key\":\"zdir-register-1\"}'",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_WALLET, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_core_zdir_register)
ZCL_COMMAND_READY_COMMAND(
    "core.zdir.deregister", "core.zdir", "",
    "Retire an onion hostname from the on-chain directory (spends a fee)",
    "Prepares the exact owner-funded ZDIR DEREGISTER transaction after "
