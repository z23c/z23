ZCL_COMMAND_READY_COMMAND(
    "core.identity.revoke", "core.identity", "",
    "Retire an anchored master key with no successor (spends a fee)",
    "Prepares an exact owner-funded ZID\\0 REVOKE transaction, preserving "
