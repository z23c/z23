    "same bytes once; stale wallet, tip, or snapshot state fails closed.", 0,
    "identity,zid,anchor,publish,master,key,broadcast,fee",
    "zcl.core_identity_anchor.input.v2", "zcl.core_identity_anchor.v2",
    "wallet_scope,pubkey,idempotency_key,plan_id,confirm,datadir", "wallet_scope",
