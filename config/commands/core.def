    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_WALLET, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_core_identity_anchor)
ZCL_COMMAND_READY_COMMAND(
    "core.identity.rotate", "core.identity", "",
    "Rotate an anchored master key to a successor (spends a fee)",
    "Prepares an exact owner-funded ZID\\0 ROTATE transaction, preserving "
    "the existing projection preflight while atomically reserving its input "
    "and maximum fee. Commit publishes the durable plan exactly once.", 0,
    "identity,zid,rotate,successor,master,key,broadcast,fee",
    "zcl.core_identity_rotate.input.v2", "zcl.core_identity_anchor.v2",
    "wallet_scope,pubkey,new_pubkey,idempotency_key,plan_id,confirm,datadir", "wallet_scope",
    "z23 core identity rotate --input='{\"wallet_scope\":\"dev\",\"pubkey\":\"<64hex>\",\"new_pubkey\":\"<64hex>\",\"idempotency_key\":\"zid-rotate-1\"}'",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_WALLET, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
