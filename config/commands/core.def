ZCL_COMMAND_READY_READ(
    "core.identity.list", "core.identity", "",
    "Page the anchored identities, newest anchor first",
    "One page of the zid_identities projection read from the datadir's "
    "node.db, newest anchor height first: --limit (default 25, capped at "
