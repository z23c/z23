/* ── identity (sovereign master keys) ──────────────────────────────
 * The chain-rooted answer to "whose key is this, and is it still live?".
 * Reads resolve the zid_identities projection (app/models/src/
 * zid_identity.c), fed from confirmed chain data by both identity feeds
 * (app/models/src/explorer_index_zid.c): the dedicated ZID\0 OP_RETURN
 * overlay and the ZNAM "zid" text-record convention. Writes build that
 * same overlay: with a live node they dispatch the wallet compose +
 * broadcast through the identity_* RPCs; with no live node (or no wallet)
 * they return op_return_hex for the operator to include. Never on a
 * timer — anchoring spends a fee and stays an operator decision. */
ZCL_COMMAND_BRANCH("core.identity", "core",
                   "Sovereign identities: resolve and anchor master keys",
                   ZCL_COMMAND_LAYER_CORE)
ZCL_COMMAND_READY_READ(
    "core.identity.resolve", "core.identity", "",
    "Resolve one master key by pubkey or ZNAM name",
    "The identity row the chain says exists for a 32-byte ed25519 master "
    "key, read from the datadir's node.db at call time (works on a "
    "stopped or copied datadir): pubkey, name, anchor_txid, "
    "anchor_height, updated_height, status (active/rotated/revoked), "
    "successor (set exactly when rotated), owner_address, and source "
    "(zid_overlay or znam_text). Select with --pubkey=<64hex> or "
    "--name=<znam name>, never both. A key with no anchor row is a hard "
    "KEY_NOT_ANCHORED and an unknown name a hard NAME_NOT_FOUND — an "
    "unanchored key is a real answer, not an empty one.", 0,
    "identity,zid,resolve,pubkey,anchor,master,key,name",
    "zcl.core_identity_resolve.input.v1", "zcl.core_identity_resolve.v1",
    "pubkey,name,datadir", "pubkey",
    "z23 core identity resolve --pubkey=<64hex>",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_SCOPE_OFFLINE_COPY,
    ZCL_COMMAND_AUTH_PUBLIC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_CHAIN_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_core_identity_resolve)
ZCL_COMMAND_READY_COMMAND(
