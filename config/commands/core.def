    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_WALLET_REQUEST, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_bridge_command)
ZCL_COMMAND_READY_COMMAND(
    "core.wallet.backup.now", "core.wallet.backup", "",
    "Take a wallet backup now",
    "Plan/commit: without confirm, a plan naming the exposure and "
    "whether WALLET_BACKUP_PASSWORD is set, writing nothing; with "
    "confirm:true, the outcome and path of an on-demand wallet backup "
    "written by the running node's walletbackupnow at call time "
    "(stage=committed, created true once the file is on disk).", 0,
    "wallet,backup,now",
    "zcl.wallet_backup_now.input.v2", "zcl.wallet_backup.v1",
    "confirm,password", "",
    "z23 core wallet backup now",
    /* CONFIRM_PLAN_COMMIT, not CONFIRM_NONE. This exports EVERY key at once
     * into a file that is plaintext unless WALLET_BACKUP_PASSWORD happens to
     * be set — a strictly larger disclosure than export-key, which has
     * always demanded confirmation for one key. The periodic background
     * service is unaffected: it calls wallet_backup_now() directly. */
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_EFFECT_MUTATE, ZCL_COMMAND_RISK_WALLET,
    ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_WALLET_REQUEST, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_wallet_backup_now)
ZCL_COMMAND_READY_COMMAND(
    "core.wallet.backup.decrypt", "core.wallet.backup", "",
    "Decrypt an encrypted wallet backup file",
    "Plan/commit over the WBE1 decrypt that used to be reachable only "
    "through the undocumented --decrypt-wallet-backup argv mode: "
    "without confirm, the source and destination paths and whether a "
    "password is available, writing nothing; with confirm:true, "
    "decrypted is true once the plaintext SQLite file is on disk. Runs "
    "in-process and needs no running node. The password comes from "
    "the password input or WALLET_BACKUP_PASSWORD.", 0,
    "wallet,backup,decrypt,restore,recovery",
    "zcl.wallet_backup_decrypt.input.v1", "zcl.wallet_backup_decrypt.v1",
    "from,to,password,confirm", "from",
    "z23 core wallet backup decrypt --input='{\"from\":"
    "\"~/wallet_backups/wallet_backup_1.sqlite.enc\",\"to\":\"/tmp/wb.sqlite\"}'",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_EFFECT_MUTATE, ZCL_COMMAND_RISK_WALLET,
    ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_WALLET_REQUEST, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_wallet_backup_decrypt)
ZCL_COMMAND_READY_COMMAND(
    "core.wallet.restore", "core.wallet", "",
    "Restore a wallet backup into a datadir",
    "Plan/commit merge of a backup file's wallet tables into "
    "<datadir>/node.db. The plan half runs the whole merge in a "
    "transaction and rolls it back, so its per-table counts (rows in "
    "the backup, rows that would land, rows that would collide with an "
    "existing row, rows the schema would reject) are exactly what the "
    "commit does. Collision policy is keep-existing: a row whose "
    "primary key is already in the target is never overwritten. "
    "Refuses with DATADIR_LOCKED while a node holds the datadir. "
    "Needs no running node; merging rows rebuilds no derived state, so "
    "next_steps names the rescans that do.", ZCL_COMMAND_LIST_BUDGET,
    "wallet,restore,recovery,backup,merge",
    "zcl.wallet_restore.input.v1", "zcl.wallet_restore.v1",
    "from,datadir,password,confirm", "from",
    "z23 core wallet restore --from=<backup.sqlite>",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_EFFECT_MUTATE, ZCL_COMMAND_RISK_WALLET,
    ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_WALLET_REQUEST, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_wallet_restore)
/* ── recovery phrase ───────────────────────────────────────────────
 * The twelve words a wallet is born with. There is deliberately no leaf
 * that prints an existing wallet's phrase — the node stores only the seed
 * the words derive, the words cannot be worked back out of it, and a
 * command that could reprint them would turn one read of node.db into the
 * loss of every coin in it. Both leaves run offline against a datadir. */
ZCL_COMMAND_BRANCH("core.wallet.recovery", "core.wallet",
                   "Recovery phrase (the twelve words)",
                   ZCL_COMMAND_LAYER_CORE)
ZCL_COMMAND_READY_READ(
    "core.wallet.recovery.status", "core.wallet.recovery", "",
    "Can this wallet be rebuilt from its words",
    "Whether a datadir's wallet descends from a recovery phrase, read "
    "offline from <datadir>/node.db at call time and answered by "
    "derivation, not by a stored flag. recoverable_from_phrase true means "
    "the twelve words written down when the wallet was created bring every "
    "one of its keys back; the phrase itself is NEVER shown, here or "
    "anywhere, because only the key material it derives is stored and the "
    "words cannot be worked back out of it. A wallet created before "
    "recovery phrases answers false and is sent to file backup instead. "
    "seed_state names WHICH kind of seed the wallet holds, because 'there "
    "is no seed' and 'there is a seed I could not decrypt' are opposite "
    "answers: an encrypted wallet that cannot be opened here is refused "
    "with WALLET_LOCKED and told to unlock and retry, never told it "
    "predates recovery phrases. "
    "Answering it reads and decrypts the wallet's keys, so on an "
    "encrypted-at-rest wallet this takes seconds, not milliseconds, and "
    "reports budget_exceeded. node.db is opened strictly read-only, so this "
    "cannot create, migrate or quarantine the datadir it is aimed at — and "
    "it aims at the running node's datadir when the caller names none, so "
    "name one. NO_NODE_DB (no wallet made here yet) and NODE_DB_UNREADABLE "
    "are separate answers; neither is ever reported as ok. Still refuses "
    "with DATADIR_LOCKED while a node holds the datadir, because a wallet "
    "being migrated underneath is not a wallet to answer about.", 0,
    "wallet,recovery,phrase,seed,mnemonic,backup",
    "zcl.wallet_recovery_status.input.v1", "zcl.wallet_recovery_status.v1",
    "datadir", "",
    "z23 core wallet recovery status",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_OWNER,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_WALLET_REQUEST, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_wallet_recovery_status)
ZCL_COMMAND_READY_COMMAND(
    "core.wallet.recovery.restore", "core.wallet.recovery", "",
    "Rebuild a wallet from its recovery phrase",
    /* KEEP THIS UNDER BUDGET. This text is only readable through
     * `discover describe`, and that renderer caps a leaf's whole document at
     * ZCL_COMMAND_SPEC_BUDGET; over it, the document does not render at all
     * and this warning becomes invisible. check-describe-budget holds the
     * line. Trim here — never raise the budget. */
    "Plan/commit rebuild of a whole wallet from the recovery phrase alone "
    "into an EMPTY datadir — the disaster case where the machine and the "
    "backup file are both gone. These words restore your money in "
    "Z23 only. They will not work in Electrum, on a hardware wallet, "
    "or in any other wallet software; a phrase from elsewhere opens a "
    "different EMPTY wallet here with no error at all. datadir is REQUIRED "
    "and has NO default: this installs spending keys and the master seed, "
    "and a default would have aimed that at the running node's own datadir. "
    "The plan half shows the first transparent and shielded addresses the "
    "words open, so you can check one against memory before committing; it "
    "creates nothing and reads an existing target read-only. The commit "
    "rebuilds the keys by the BIP44 gap-limit convention — derive until 20 "
    "consecutive unused addresses, asking this datadir's own chain what was "
    "used, never a fixed count, because the first address a wallet hands "
    "out is index 100. With no chain to consult it derives the standard "
    "lookahead and says so, as does a scan that hits its 1000-per-chain "
    "ceiling. Needs no running node. Same at-rest rule as node wallet "
    "creation: set ZCL_WALLET_PASSPHRASE to encrypt the keys, or "
    "ZCL_ALLOW_PLAINTEXT_WALLET=1 to accept plaintext, else "
    "WALLET_AT_REST_UNDECIDED; node.db is left mode 0600. An existing "
    "node.db is read strictly READ-ONLY: a damaged one is refused with "
    "NODE_DB_UNREADABLE, never renamed aside or replaced. REFUSES with "
    "DATADIR_LOCKED while a node holds the datadir or another recovery is "
    "writing it, and WALLET_ALREADY_PRESENT if a wallet is already there. "
    "Pass the words as phrase, or set ZCL_RECOVERY_PHRASE to keep them out "
    "of shell history; they are never logged or echoed back. Keys come "
    "back, history does not — next_steps names the rescans that rebuild "
    "it.", ZCL_COMMAND_LIST_BUDGET,
    "wallet,recovery,phrase,seed,mnemonic,restore",
    "zcl.wallet_recovery_restore.input.v1", "zcl.wallet_recovery_restore.v1",
    "phrase,datadir,confirm", "",
    "z23 core wallet recovery restore "
    "--input='{\"datadir\":\"/tmp/recovered\"}'",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_EFFECT_MUTATE, ZCL_COMMAND_RISK_WALLET,
    ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_WALLET_REQUEST, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_wallet_recovery_restore)
