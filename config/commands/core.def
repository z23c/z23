    "reserved atomically; commit publishes the durable bytes once. The row "
    "history remains on-chain and there is deliberately no transfer stub.", 0,
    "zdir,directory,onion,deregister,retire,withdraw,peer,discovery,broadcast,fee",
    "zcl.core_zdir_deregister.input.v2", "zcl.core_zdir_register.v2",
    "wallet_scope,hostname,idempotency_key,plan_id,confirm,datadir", "wallet_scope",
    "z23 core zdir deregister --input='{\"wallet_scope\":\"dev\",\"hostname\":\"<56base32>.onion\",\"idempotency_key\":\"zdir-deregister-1\"}'",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_WALLET, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
