    ZCL_COMMAND_TRAIT_IDEMPOTENT | ZCL_COMMAND_TRAIT_DEV_ONLY,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_dev_ff)

ZCL_COMMAND_BRANCH("dev.publication", "dev",
                   "Inspect asynchronous proven-source publication",
                   ZCL_COMMAND_LAYER_DEV)
ZCL_COMMAND_BRANCH("dev.publication.mirror", "dev.publication",
                   "Record optional non-authoritative mirror evidence",
                   ZCL_COMMAND_LAYER_DEV)

ZCL_COMMAND_READY_READ(
    "dev.publication.status", "dev.publication", "",
    "Show one durable proof-to-publication job",
    "The immutable ZVCS source, proof and generation roots bound by one "
    "publication job, its durable local queue membership, and truthful "
    "blockers for workspace, exact signed provider evidence, replication and "
    "optional mirror phases. "
    "This read grants no publication, signing, network, wallet or acceptance "
    "authority.", 0,
    "dev,publication,status,zvcs,proof,queue",
    "zcl.dev_publication_status_input.v1",
    "zcl.dev_publication_status.v1", "job_root", "job_root",
    "z23-dev dev publication status --input='"
    "{\"job_root\":\"<64-lowercase-hex>\"}'",
    ZCL_COMMAND_LAYER_DEV, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_READ,
    ZCL_COMMAND_TRAIT_IDEMPOTENT | ZCL_COMMAND_TRAIT_DEV_ONLY,
    ZCL_COMMAND_TRANSPORT_NATIVE,
    zcl_native_handle_dev_publication_status)

ZCL_COMMAND_DEV_COMMAND(
    "dev.publication.advance", "dev.publication", "",
    "Advance one proven-source job to its next durable blocker",
    "Appends or reuses one immutable local scheduling receipt for the exact "
    "job. WAITING_ACCEPTANCE performs no package action. Once the existing "
    "accepted-work owner reports the exact PROVEN root produced by "
    "zcode work accept, the background worker "
    "builds one root-addressed ZVCS-blob to content.v2 chunk mapping set: "
    "only cache misses read source bytes, and the receipt reports scanned "
    "bytes plus new and reused chunks. The default response is human-first "
    "and root-free; details=true exposes bound roots, receipts, and metrics. "
    "It performs no release signature, "
    "network, wallet, Git or canonical-node action. A separately verified "
    "provider record may advance the same append-only job without granting "
    "network authority, and cannot substitute "
    "for the existing PROVEN-work publisher.", 0,
    "dev,publication,advance,receipt,resume,idempotent",
    "zcl.dev_publication_advance_input.v1",
    "zcl.dev_publication_advance.v1",
    "job_root,datadir,workspace,action_id,details", "job_root",
    "z23-dev dev publication advance --input='"
    "{\"job_root\":\"<64-lowercase-hex>\"}'",
    ZCL_COMMAND_EFFECT_MUTATE, ZCL_COMMAND_RISK_DEV_MUTATION,
    ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_OWNER,
    ZCL_COMMAND_MODE_SYNC, ZCL_COMMAND_LATENCY_BACKGROUND,
    ZCL_COMMAND_COST_MODERATE, ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL, ZCL_COMMAND_CAP_DEV_STATE_WRITE,
    ZCL_COMMAND_TRAIT_DEV_ONLY | ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_dev_publication_advance,
    "publication scheduling receipts require a dev checkout",
    "z23-dev dev publication status")

ZCL_COMMAND_DEV_COMMAND(
    "dev.publication.collect", "dev.publication", "",
    "Bind independent storage and source-reproduction evidence",
    "Loads the exact provider-announced package target from one immutable "
    "publication job, asks the authenticated local node for verified "
    "STORAGE_ACK records, and appends one receipt only after locally "
    "rechecking canonical wires, network genesis, validity windows, "
    "signatures, package root, and distinct provider/owner groups. At least "
    "two storage ACKs are required. It then discovers one signed "
    "SOURCE_REPRODUCTION_ACK that binds the exact source and package roots "
    "and requires a signer lineage and owner group distinct from the "
    "publisher and storage witnesses. It never signs, publishes, spends, "
    "deploys, infers physical off-host independence, or grants human "
    "acceptance authority.", 0,
    "dev,publication,storage-ack,reproduction,p2p,collect,evidence",
    "zcl.dev_publication_status_input.v1",
    "zcl.dev_publication_collect.v1", "job_root", "job_root",
    "z23-dev dev publication collect --input='"
    "{\"job_root\":\"<64-lowercase-hex>\"}'",
    ZCL_COMMAND_EFFECT_MUTATE, ZCL_COMMAND_RISK_DEV_MUTATION,
    ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_OWNER,
    ZCL_COMMAND_MODE_SYNC, ZCL_COMMAND_LATENCY_FOREGROUND,
    ZCL_COMMAND_COST_MODERATE, ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_WRITE | ZCL_COMMAND_CAP_CHAIN_READ |
        ZCL_COMMAND_CAP_P2P_TOPIC,
    ZCL_COMMAND_TRAIT_DEV_ONLY | ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_dev_publication_collect,
    "publication evidence collection requires the dev-only ZVCS receipt writer",
    "z23-dev dev publication status")

ZCL_COMMAND_DEV_COMMAND(
    "dev.publication.mirror.record", "dev.publication.mirror", "",
    "Record optional declared GitHub mirror evidence",
    "Creates or reuses one immutable local receipt only after the existing "
    "job has a verified provider-announced workspace. It copies the exact "
    "ZVCS, source identity, proof, release, workspace and provider roots from "
    "that chain and optionally binds an opaque Git object ID. It never invokes "
    "Git, GitHub, a network or an API; absence or refusal remains "
    "mirror_pending and never blocks development or P2P publication.", 0,
    "dev,publication,mirror,github,receipt,optional",
    "zcl.dev_publication_mirror_record_input.v1",
    "zcl.dev_publication_mirror_record.v1", "job_root,git_oid", "job_root",
    "z23-dev dev publication mirror record --input='"
    "{\"job_root\":\"<64-lowercase-hex>\","
    "\"git_oid\":\"<optional-40-or-64-lowercase-hex>\"}'",
    ZCL_COMMAND_EFFECT_MUTATE, ZCL_COMMAND_RISK_DEV_MUTATION,
    ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_OWNER,
    ZCL_COMMAND_MODE_SYNC, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL, ZCL_COMMAND_CAP_DEV_STATE_WRITE,
    ZCL_COMMAND_TRAIT_DEV_ONLY | ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_dev_publication_mirror_record,
    "optional mirror receipts require a dev checkout",
    "z23-dev dev publication mirror record")

ZCL_COMMAND_DEV_READ(
    "dev.verify-change", "dev", "",
    "Compile affected code and run mapped focused proofs with compact output",
    "A fresh changed-scope verification: exact compile_commands.json recipes "
    "for changed C translation units (source-wide compile fallback for header "
    "or build-graph edits), mapped focused tests, and lint-fast. Full logs are "
    "retained under build/verify-change; failures return one dense first-error "
    "capsule.", 0,
    "dev,verify,change,affected,focused,concise", "zcl.command.empty_input.v1",
    "zcl.dev_verify_change.v1", "", "",
    "z23-dev dev verify-change", ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OWNER,
    ZCL_COMMAND_LATENCY_BACKGROUND, ZCL_COMMAND_COST_HIGH,
    ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_PROCESS_EXEC | ZCL_COMMAND_CAP_TEST_RUN,
    ZCL_COMMAND_TRAIT_IDEMPOTENT | ZCL_COMMAND_TRAIT_DEV_ONLY,
    zcl_native_handle_dev_verify_change,
    "changed-scope verification requires the dev-only process executor",
    "make dev-bin, then z23-dev dev verify-change")

