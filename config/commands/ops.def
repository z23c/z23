    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_ops_state)

/* The discovery half of ops.state. ops.state requires a subsystem name and
 * fails MISSING_SUBSYSTEM without one, so an agent that does not already know
 * the names had no typed way to learn them — only the legacy flat
 * `z23 statecatalog` shim, or reading diagnostics_dumpers.def out of a
 * source tree a release binary does not carry. Same catalog, one renderer
 * (diag_rpc_statecatalog); node-free, because the registry is compiled in. */
ZCL_COMMAND_READY_READ(
    "ops.statecatalog", "ops", "", "State subsystem catalog",
    "Every subsystem `ops state` accepts, from the in-binary diagnostics "
    "registry. With no input: `count` and the COMPLETE `names` list, which "
    "is what you need to call ops state at all and is never truncated. Add "
    "subsystem=<name> for that one descriptor in full (description, owner "
    "file, state class, freshness, cost, accepted key forms, owning test), "
    "or limit (default 5, max 5) with a zero-based page for a window of "
    "descriptors — a window drops `names`, since the whole catalog cannot "
    "fit one response and a silently clipped catalog would read as 'that "
    "subsystem does not exist'. Node-free — the registry is compiled into "
    "the binary, so this answers with the node stopped, unlike ops state.",
    ZCL_COMMAND_LIST_BUDGET,
    "statecatalog,subsystems,catalog,dumpstate,discover,state,list",
    "zcl.ops_statecatalog.input.v1", "zcl.ops_statecatalog.v1",
    "subsystem,limit,page", "",
    "z23 ops statecatalog",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_ops_statecatalog)

ZCL_COMMAND_READY_READ(
    "ops.selftest", "ops", "", "Self-test",
    "A node-free sweep of the in-binary command catalog for static "
    "well-formedness defects (pass/fail/skip counts and each failure's path and "
    "reason); complete over every catalog leaf.", 0,
    "selftest,self-test,registry,contract,smoke", "zcl.command.empty_input.v1",
    "zcl.ops_selftest.v1", "", "", "z23 ops selftest",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_CHAIN_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_ops_selftest)

/* Operator-UX diagnostics live under the existing ops.debug branch — a new
 * top-level ops.* branch would push the ops menu over its 1600-byte budget
 * (ZCL_COMMAND_BRANCH_BUDGET; proven by test_branch_menus_shallow). The
 * bare-root aliases (`z23 explain sync`, `z23 profile`) are
 * the primary invocation surface, so the canonical path barely shows. */
ZCL_COMMAND_BRANCH("ops.debug", "ops", "Diagnostics",
                   ZCL_COMMAND_LAYER_OPS)
ZCL_COMMAND_READY_READ(
    "ops.debug.explain", "ops.debug", "explain,ops.explain",
    "Explain a subsystem in plain prose",
    "A plain-prose explanation of one subsystem (sync, blockers, health, …) "
    "generated from live node state at call time; narrative, not a stable "
    "machine schema.", 0,
    "explain,sync,blockers,health,why,diagnose,prose",
    "zcl.ops_explain.input.v1", "zcl.ops_explain.v1", "topic", "topic",
    "z23 explain sync",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_CHAIN_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_ops_explain)

ZCL_COMMAND_READY_READ(
    "ops.debug.meaning", "ops.debug", "meaning,ops.meaning",
    "What a telemetry field means, and which report answers a question",
    "The field-level ontology for network telemetry read straight out of the "
    "binary: per field its unit, a machine-evaluable healthy range, what an "
    "unhealthy value implies and the next command; plus the question index "
    "that routes an operator question to the one report that answers it. "
    "Static build data, identical on every node, and answered with NO running "
    "node — which is exactly the case where the meaning is needed most.",
    ZCL_COMMAND_LIST_BUDGET,
    "meaning,ontology,field,semantics,healthy,range,units,question,ask,which,"
    "telemetry,explain,handshake,peer,why",
    "zcl.ops_meaning.input.v1", "zcl.ops_meaning.v1",
    /* No positional key: all three inputs are genuinely optional (a bare call
     * returns the whole table), and positional == handler-required in the
     * generated contract. */
    "subsystem,name,question", "",
    "z23 meaning --name=pre_handshake_disconnects",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_CHAIN_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_ops_meaning)

