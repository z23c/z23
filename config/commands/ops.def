ZCL_COMMAND_PLANNED_COMMAND(
    "ops.recovery.rebuild", "ops.recovery", "",
    "Rebuild recent chain state",
    "Will rebuild recent chain state to the requested depth and report the new "
    "cursor; the plan/commit handshake is not wired, so the leaf fails closed "
