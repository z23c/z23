    ZCL_COMMAND_LATENCY_BACKGROUND, ZCL_COMMAND_COST_HIGH,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_CHAIN_READ, ZCL_COMMAND_TRAIT_NONE,
    "recovery rebuild plan/commit handshake is a Wave 2.2 deliverable")
