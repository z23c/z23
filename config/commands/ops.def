ZCL_COMMAND_PLANNED_COMMAND(
    "ops.config.reload", "ops.config", "", "Reload runtime configuration",
    "Will reload runtime configuration and report which keys changed; the "
    "reload binding is not wired, so the leaf fails closed today.", 0,
    "config,reload", "zcl.command.empty_input.v1", "zcl.ops_config_reload.v1",
    "", "", "z23 ops config reload",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_CORE_RECOVERY, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_CHAIN_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    "config-reload binding is a Wave 2.2 deliverable")

ZCL_COMMAND_BRANCH("ops.recovery", "ops", "Recovery ops",
                   ZCL_COMMAND_LAYER_OPS)
ZCL_COMMAND_READY_READ(
    "ops.recovery.status", "ops.recovery", "", "Refold and recovery progress",
    "The current refold/recovery cursor and progress read live from the node; "
    "reflects the in-flight rebuild state at call time.", 0,
    "recovery,refold,status,rebuild", "zcl.command.empty_input.v1",
    "zcl.recovery_status.v1", "", "", "z23 ops recovery status",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_CHAIN_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
