/* ── Seller fulfillment claims (docs/work/SHOP_COMMAND.md, slice E) ──
 * Signed answers to buyer wants, bound to directly hashed CAS bytes.
 * Optional receipts are independently re-verified. There is deliberately
 * no award, escrow, payment, ZCL movement, or ZC23 issuance in this slice. */

ZCL_COMMAND_READY_COMMAND(
    "app.shop.want.fulfill.post", "app.shop.want.fulfill", "",
    "Post a signed fulfillment claim",
    "Build, sign, verify and persist one zcl.shop.fulfill.v1 claim for an "
    "open want. artifact_root is SHA3-256 of the delivered bytes and "
    "content_root is their single-object content.v2 CAS manifest; both are "
    "re-derived from this datadir. Optional build/fuzz/benchmark receipt "
    "ids are re-verified against approved workers, canonical signatures, "
    "successful actions, or the admitted ZCODE benchmark-result authority. "
    "Their association is seller-signature-bound and is not misreported as "
    "typed-root equality with the raw artifact hash. Without confirm:true this is "
    "a non-mutating plan. No award, payment, ZCL movement or ZC23 issuance.",
    ZCL_COMMAND_LIST_BUDGET,
    "shop,want,fulfill,seller,artifact,cas,evidence,receipt,post",
    "zcl.shop_fulfill_post.input.v1", "zcl.shop_fulfill_post.v1",
    "want_id,seller_secret,artifact_root,content_root,build_receipt_id,"
    "fuzz_receipt_id,bench_receipt_id,expires_unix,nonce,issued_unix,"
    "now_unix,datadir,confirm",
    "want_id,seller_secret,artifact_root,content_root,expires_unix,nonce,"
    "issued_unix",
    "z23 app shop want fulfill post --input='{\"want_id\":\"ab01...\","
    "\"seller_secret\":\"cd02...\",\"artifact_root\":\"ef03...\","
    "\"content_root\":\"1204...\",\"expires_unix\":1780003600,"
    "\"nonce\":7,\"issued_unix\":1780000000}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_shop_want_fulfill_post)

ZCL_COMMAND_READY_READ(
    "app.shop.want.fulfill.list", "app.shop.want.fulfill", "",
    "Compare fulfillment evidence for one want",
    "List active claims for one want (or include expired/withdrawn rows with "
    "all:true), newest first. Each row re-verifies its signature, direct "
    "artifact hash, CAS manifest, and claimed receipts so operators compare "
    "facts rather than seller assertions. Mutates nothing and awards nobody.",
    ZCL_COMMAND_LIST_BUDGET,
    "shop,want,fulfill,compare,artifact,evidence,receipt,list",
    "zcl.shop_fulfill_list.input.v1", "zcl.shop_fulfill_list.v1",
    "want_id,datadir,now_unix,all,profile", "want_id",
    "z23 app shop want fulfill list --input='{\"want_id\":\"ab01...\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_shop_want_fulfill_list)

