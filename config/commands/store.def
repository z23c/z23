/* Store BUYER leaves, mounted under the `app` root. These are the buying
 * half of the store: browse what a store sells, place an order, pay it with
 * a shielded payment carrying the order's memo, watch it, and collect the
 * file. Until these existed the only possible buyer was a person with a
 * browser, because the order form carries a CSRF token and an anti-abuse
 * puzzle that JavaScript solved.
 *
 * Every leaf proxies one already-complete node RPC (storebuy_*, bound in
 * app/controllers/src/store_buyer_controller.c, doing its work in
 * app/services/src/store_buyer.c). The work has to happen inside the node:
 * placing an order mints a one-time Sapling payment address and paying it
 * spends, and a CLI process has neither a wallet nor an open database.
 *
 * Handlers: app/controllers/src/store_buyer_native_handlers.c.
 * Consumer defines ZCL_COMMAND_*. */

/* The `app.store` BRANCH is declared once, with every other app.* branch, in
 * config/commands/app_features.def. It is deliberately not repeated here: two
 * ZCL_COMMAND_BRANCH rows for one path register the same branch twice, and
 * because the two rows live in different files the merge that brings them
 * together is textually clean — nothing warns you. The merchant leaves
 * (app.store.list-product, app.store.products) sit next to that declaration;
 * the buyer leaves are below. */

ZCL_COMMAND_READY_READ(
    "app.store.catalog", "app.store", "", "List what the store sells",
    "Every active product this node's store offers, read live at call time: "
    "id, name, access token, price in zatoshi, tokens minted per purchase, "
    "and whether a downloadable file is attached. has_file false means a "
    "purchase of it can never be collected as bytes.",
    ZCL_COMMAND_LIST_BUDGET,
    "store,catalog,products,buy",
    "zcl.command.empty_input.v1", "zcl.store_catalog.v1", "", "",
    "z23 app store catalog",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_store_catalog)

ZCL_COMMAND_READY_COMMAND(
    "app.store.order", "app.store", "", "Place an order for a product",
    "The placed order's purchase id, merchant order id, one-time payment "
    "z-address, the memo that binds a payment to it, and the amount owed. "
    "Goes through the store's real order route, so the CSRF token, the "
    "proof-of-work puzzle and the pending-order caps all apply; refused by "
    "name on mainnet or for an unknown product. Placing the same order twice "
    "returns the existing purchase rather than a second obligation.", 0,
    "store,order,buy,purchase",
    "zcl.store_order.input.v1", "zcl.store_order.v1",
    "product_id,customer_address,output_path,payment_kind", "",
    "z23 app store order --input='{\"product_id\":1,"
    "\"customer_address\":\"t1...\",\"output_path\":\"/tmp/bought.bin\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_store_order)

ZCL_COMMAND_READY_COMMAND(
    "app.store.pay", "app.store", "", "Pay a placed order",
    "Plan/commit shielded payment for one purchase: without confirm, a "
    "non-mutating plan naming the purchase, amount and funding address plus "
    "the commit next-action; with confirm:true, the submitted operation id. "
    "The payment carries the order memo, which is what lets the merchant "
    "bind it to this order and no other. Refused by name, before any value "
    "moves, on mainnet, with no Sapling proving backend, when the node's "
    "spend guard is closed, when funds cannot cover it, and when the "
    "purchase was already paid.", 0,
    "store,pay,shielded,purchase",
    "zcl.store_pay.input.v1", "zcl.store_pay.v1",
    "purchase_id,from_address,confirm", "",
    "z23 app store pay --input='{\"purchase_id\":1,"
    "\"from_address\":\"t1...\",\"confirm\":true}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_WALLET, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_HIGH,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_WALLET_REQUEST, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_store_pay)

ZCL_COMMAND_READY_READ(
    "app.store.purchases", "app.store", "",
    "Show purchases and what is still owed",
    "With purchase_id: that one purchase, re-checked against the merchant's "
    "current view — its stage advances to paid once the merchant credits the "
    "order — plus the confirmed amount, the tip height it was measured at, "
    "and whether it is ready to collect. Without one: every purchase this "
    "node has made, newest first, and how many are still unfinished. A "
    "purchase paid but not collected shows here rather than disappearing.",
    ZCL_COMMAND_LIST_BUDGET,
    "store,purchases,orders,status",
    "zcl.store_purchases.input.v1", "zcl.store_purchases.v1",
    "purchase_id", "purchase_id",
    "z23 app store purchases",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_store_purchases)

ZCL_COMMAND_READY_COMMAND(
    "app.store.collect", "app.store", "", "Download a purchase you paid for",
    "The written path, byte count and verified SHA3-256 of a paid "
    "purchase's file, fetched through the store's token gate. The bytes are "
    "hashed against the product's content hash BEFORE anything is written: "
    "a mismatch is reported as HASH_MISMATCH and writes nothing at all, and "
    "a verified file lands by rename so an interrupted download never leaves "
    "a partial file behind. Re-polls the merchant first, so a purchase paid "
    "before a restart collects without a separate status call.", 0,
    "store,collect,download,file",
    "zcl.store_collect.input.v1", "zcl.store_collect.v1",
    "purchase_id,output_path", "purchase_id",
    "z23 app store collect --input='{\"purchase_id\":1,"
    "\"output_path\":\"/tmp/bought.bin\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_store_collect)

/* ── Shop orchestration (docs/work/SHOP_COMMAND.md, slice B) ──────────
 * The storefront side of the store: one plan/commit command that composes
 * the persistent onion identity, wallet custody, the store schema, and
 * the directory announcement into "your shop is live", and one read leaf
 * that renders the same verification block with every gap named.
 *
 * WHY THE LIST BUDGET AND NOT THE RESULT DEFAULT. The plan reply carries
 * the snapshot, the verification block, every named gap WITH its full
 * remedy string (the wallet custody recipe alone is ~430 bytes), and the
 * seven plan steps; measured at ~2.8 KB on a fresh datadir and growing
 * with every gap that names a remedy, it rides close enough to the
 * 4096-byte RESULT default that the next long remedy would tip it over —
 * and an over-budget reply here is an EMPTY RESPONSE_BUDGET_EXCEEDED
 * rather than a truncation, exactly the wrong answer at the feature's
 * front door (bare `app shop init`). Held honest by test_shop's budget
 * regression, which serializes the bare plan through the real registry
 * into the CLI's own out-buffer size (ZCL_COMMAND_LIST_BUDGET + 1). */

ZCL_COMMAND_READY_COMMAND(
    "app.shop.init", "app.shop", "", "Initialize a live private shop",
    "Takes this node from \"has a store table\" to a live private shop in "
    "one command. Without confirm:true, a non-mutating plan naming every "
    "check, every unmet prerequisite, and the commit input. The commit "
    "refuses by name on a plaintext or absent wallet (with the exact "
    "credential recipe — never silently minting plaintext keys) and on a "
    "stub-Tor build (with the make tor-full remedy); otherwise it ensures "
    "the persistent onion identity (minted once, reused after), provisions "
    "an optional --input products.json through the existing store loader, "
    "ensures the store schema, registers \"shop\" on the node's "
    "/directory.json apps row, and prints the verification block: the "
    "onion /store URL, product count, wallet and discovery state, and the "
    "buyer's next command. Idempotent: re-running reuses the identity and "
    "never double-announces.", ZCL_COMMAND_LIST_BUDGET,
    "shop,init,store,onion,storefront,directory",
    "zcl.shop_init.input.v1", "zcl.shop_init.v1",
    "confirm,input,datadir", "",
    "z23 app shop init --input='{\"confirm\":true,\"input\":\"/data/products.json\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_shop_init)

ZCL_COMMAND_READY_READ(
    "app.shop.status", "app.shop", "", "Show this node's shop posture",
    "The shop verification block on demand, read-only: Tor build and "
    "persistent-identity state (with the address re-derived from the "
    "identity seed), wallet at-rest posture, store schema version and "
    "product count, products.json presence, and the /directory.json apps "
    "announcement state. Every unmet prerequisite is a named gap carrying "
    "the exact command or flag that fixes it — never a silent partial. "
    "Mutates nothing.", ZCL_COMMAND_LIST_BUDGET,
    "shop,status,store,onion,storefront,directory",
    "zcl.command.empty_input.v1", "zcl.shop_status.v1",
    "datadir", "",
    "z23 app shop status",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_shop_status)

/* ── Publisher evidence readout (docs/work/SHOP_COMMAND.md, slice C) ──
 * The provable-facts table for one ZCODE publisher key: each row is a fact
 * the node can prove from records under <datadir>/zcode, carrying its
 * evidence class and counting window; absent evidence reads "no_record"
 * (or "unavailable" when no data source exists at all), never a zero and
 * never an adjective. Read-only: the collectors are the same scans the
 * package leaves already run. */

ZCL_COMMAND_READY_READ(
    "app.shop.reputation", "app.shop", "",
    "Show the provable evidence for a publisher",
    "The evidence table for one ZCODE publisher key (the publisher column "
    "of zcode package search): signed releases and packages published, "
    "days first observed in this node's store, reproductions across "
    "distinct build receipts (receipts carry no signer identity — distinct "
    "recorded build events, nothing more), distinct signature-verified "
    "attestation signer keys, dependent packages from root-committed "
    "dependency declarations, and simulated reward settlements. Every row "
    "states its evidence class and window; absent evidence reads "
    "'no_record', classes with no data source read 'unavailable' — never "
    "a zero and never an adjective the records cannot prove. Mutates "
    "nothing.", ZCL_COMMAND_LIST_BUDGET,
    "shop,reputation,evidence,publisher,reproduction,attestation",
    "zcl.shop_reputation.input.v1", "zcl.shop_reputation.v1",
    "publisher,datadir,now_unix", "publisher",
    "z23 app shop reputation --input='{\"publisher\":\"02ab...\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_shop_reputation)

/* ── Buyer-posted wants (docs/work/SHOP_COMMAND.md, slice D) ──────────
 * The demand-side mirror of the signed offer: a buyer posts "I will pay
 * amount_zatoshi for a digital result satisfying these objectively
 * checkable criteria" — a signed, discoverable WANT advertisement with
 * terms and an expiry, NOT an escrow and NOT a payment channel (ZC23/ZCL
 * value transfer stays simulation/plan-only). The signed shape clones
 * zswap_quote.v1 with the terms reversed; storage is the shop_wants
 * projection (schema v66), and listing rides the same per-node community
 * content moderation visibility rule as moderated market offers. P2P
 * relay of the signed wire and fulfillment/award are the follow-ups.
 * Handlers: app/controllers/src/shop_native_want.c. */

ZCL_COMMAND_READY_COMMAND(
    "app.shop.want.post", "app.shop.want", "", "Post a buyer want",
    "Build, sign (Ed25519, key re-derived from buyer_secret), verify and "
    "persist one shop_want.v1 on this node's board: amount_zatoshi of "
    "declared terms, 1..1024 bytes of objectively checkable criteria, an "
    "optional spec_hash committing an external spec document, and an "
    "explicit expiry at most 30 days out. Without confirm:true, a "
    "non-mutating plan rendering the exact signed document and its id; "
    "the commit persists it (idempotent on want_id). Refused by name on "
    "bad terms, an issuance that drifts from the node clock, an "
    "already-expired window, or a missing node.db.",
    ZCL_COMMAND_LIST_BUDGET,
    "shop,want,bounty,buyer,demand,criteria,post",
    "zcl.shop_want_post.input.v1", "zcl.shop_want_post.v1",
    "buyer_secret,amount_zatoshi,criteria,spec_hash,expires_unix,nonce,"
    "issued_unix,now_unix,datadir,confirm",
    "buyer_secret,amount_zatoshi,criteria,expires_unix",
    "z23 app shop want post --input='{\"buyer_secret\":\"ab01...\","
    "\"amount_zatoshi\":500000,\"criteria\":\"a CSV of every ZCL block "
    "hash 0..100, sha3-verified\",\"expires_unix\":1780000000,"
    "\"confirm\":true}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_shop_want_post)

ZCL_COMMAND_READY_READ(
    "app.shop.want.list", "app.shop.want", "",
    "Browse this node's want board",
    "The open wants this node stores (expired and cancelled rows filtered "
    "unless all:true), newest first, each with its id, buyer pubkey, "
    "declared amount, criteria preview (truncated — status carries the "
    "full text) and expiry. Visibility rides the node's active community "
    "content moderation profile exactly as moderated market offers: the "
    "default general-audience.v1 shows reviewed_ok wants only, open-view "
    "shows everything; hidden wants are counted in hidden_by_profile, "
    "never deleted. profile overrides the active profile for the call. "
    "Mutates nothing.", ZCL_COMMAND_LIST_BUDGET,
    "shop,want,bounty,buyer,demand,list,board,moderation",
    "zcl.shop_want_list.input.v1", "zcl.shop_want_list.v1",
    "datadir,now_unix,profile,all", "",
    "z23 app shop want list",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
