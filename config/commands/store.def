    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_shop_want_fulfill_status)

ZCL_COMMAND_READY_COMMAND(
    "app.shop.want.fulfill.withdraw", "app.shop.want.fulfill", "",
    "Withdraw a fulfillment you signed",
    "Key-checked local withdrawal: seller_secret must derive the Ed25519 "
    "pubkey in the signed claim. The wire remains stored as evidence and "
    "only local withdrawn_unix changes. Without confirm:true this is a "
    "non-mutating plan; repeat commits are idempotent. No value moves.",
    ZCL_COMMAND_LIST_BUDGET,
    "shop,want,fulfill,seller,withdraw,cancel",
    "zcl.shop_fulfill_withdraw.input.v1", "zcl.shop_fulfill_withdraw.v1",
    "fulfill_id,seller_secret,datadir,now_unix,confirm",
    "fulfill_id,seller_secret",
    "z23 app shop want fulfill withdraw --input='{\"fulfill_id\":\"ab01...\","
    "\"seller_secret\":\"cd02...\",\"confirm\":true}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_shop_want_fulfill_withdraw)

