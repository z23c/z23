ZCL_COMMAND_READY_COMMAND(
    "vault.intent.plan", "vault.intent", "",
    "Persist an exact encrypted transaction plan",
    "Accepts 1..50 effects with strict decimal-string ZCL amounts and requires "
    "a durable idempotency_key for every route. Transparent fan-out uses "
    "route=transparent and omits from. Sapling plans require from=<exact "
    "owned source address> and route=private (z-to-z), shield (t-to-z), "
    "unshield (z-to-t), or mixed (both recipient pools); a mismatched route "
    "fails closed. Returns a "
    "ten-minute plan_id, digest, exact effects and maximum fee, tip/money "
    "anchor, confirmation policy, and an explicit privacy warning. "
    "Recipient details are encrypted under the wallet metadata DEK at rest; "
    "the sensitive effects body is accepted only with --input=-. Planning "
    "fails closed unless custody is encrypted/unlocked, persistence and "
    "sovereign-chain checks pass, and a fully verified encrypted wallet "
    "backup is under 24 hours old. Private/mixed planning also proves the "
    "source, witnesses, keys, recipients and Sapling prover can build without "
    "admitting or relaying the candidate.", 0,
    "vault,intent,plan,effects,fee,privacy,idempotent,mixed,sapling",
    "zcl.vault_intent_plan.input.v1", "zcl.vault_intent_plan.v1",
    "wallet_scope,route,from,effects,idempotency_key", "wallet_scope,effects,idempotency_key",
    "printf '%s' '{\"wallet_scope\":\"dev\",\"route\":\"transparent\",\"idempotency_key\":\"payment-001\",\"effects\":[{\"asset\":\"ZCL\",\"to\":\"t1...\",\"amount\":\"0.01\"}]}' | z23 vault intent plan --input=-",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_WALLET, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OWNER,
    ZCL_COMMAND_MODE_SYNC, ZCL_COMMAND_LATENCY_BACKGROUND,
    ZCL_COMMAND_COST_HIGH, ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_WALLET_REQUEST, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_vault_intent_plan)

ZCL_COMMAND_READY_COMMAND(
    "vault.intent.fanout-plan", "vault.intent", "",
    "Prepare private self-custody outputs for parallel transactions",
    "Creates 2..50 fresh durable wallet-owned transparent destinations and "
    "atomically reserves one exact transparent fanout plan after a current "
    "encrypted-backup preflight. Each output is "
    "recipient_value_zat plus maximum_fee_zat, so it can later fund one "
    "independent transaction at the requested ceiling. A required durable "
    "idempotency_key makes retries return the same plan and rejects a changed "
    "shape. Output contains only aggregate counts, zatoshi values, plan id and "
    "digest: generated addresses, selected inputs, endpoints and paths never "
    "leave the wallet. This command never signs, broadcasts, commits, or "
    "automatically rebalances; the owner must take a fresh encrypted backup "
    "containing the new destinations, then separately call vault.intent.commit "
    "after reviewing the plan. All normal wallet "
    "encryption, backup, sovereignty, custody, reserve and lab-cap gates apply.",
    0,
    "vault,intent,fanout,liquidity,utxo,parallel,idempotent,private-address",
    "zcl.vault_intent_fanout_plan.input.v1",
    "zcl.vault_intent_fanout_plan.v1",
    "wallet_scope,recipient_value_zat,maximum_fee_zat,concurrency,idempotency_key",
    "wallet_scope,recipient_value_zat,maximum_fee_zat,concurrency,idempotency_key",
    "z23 vault intent fanout-plan --input='{\"wallet_scope\":\"dev\",\"recipient_value_zat\":1000,\"maximum_fee_zat\":10000,\"concurrency\":10,\"idempotency_key\":\"parallel-lab-001\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_WALLET, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OWNER,
    ZCL_COMMAND_MODE_SYNC, ZCL_COMMAND_LATENCY_BACKGROUND,
    ZCL_COMMAND_COST_HIGH, ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_WALLET_REQUEST, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_vault_intent_fanout_plan)

ZCL_COMMAND_READY_COMMAND(
    "vault.intent.commit", "vault.intent", "",
