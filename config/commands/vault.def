    "before relay. A crash resumes those same bytes; repeated calls return the "
    "original txid and never double-pay. No operation_id is exposed.", 0,
    "vault,intent,commit,idempotent,txid,relay",
    "zcl.vault_intent_commit.input.v1", "zcl.vault_intent_commit.v1",
    "wallet_scope,plan_id,confirm", "wallet_scope,plan_id,confirm",
    "z23 vault intent commit --input='{\"wallet_scope\":\"dev\",\"plan_id\":\"<64hex>\",\"confirm\":true}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_WALLET, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OWNER,
    ZCL_COMMAND_MODE_SYNC, ZCL_COMMAND_LATENCY_FOREGROUND,
    ZCL_COMMAND_COST_HIGH, ZCL_COMMAND_CONFIRM_IDEMPOTENCY,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_WALLET_REQUEST, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_vault_intent_commit)

ZCL_COMMAND_READY_COMMAND(
    "vault.intent.submit", "vault.intent", "",
    "Queue an exact durable plan and return immediately",
    "Requires wallet_scope, plan_id and confirm:true. Returns operation_id "
    "immediately; operation_id is deliberately the durable plan_id, so "
    "vault.intent.status is the one status authority rather than a second job "
    "ledger. A node restart requeues a planned ASYNC_QUEUED intent, duplicate "
    "submissions share one in-process worker, transient non-current money state "
    "waits fail-closed, and the normal commit path still revalidates identity, "
    "snapshot, exact effects, fee, reservation and raw bytes before relay.", 0,
    "vault,intent,submit,async,operation,queue,restart,idempotent",
    "zcl.vault_intent_submit.input.v1", "zcl.vault_intent_submit.v1",
    "wallet_scope,plan_id,confirm", "wallet_scope,plan_id,confirm",
    "z23 vault intent submit --input='{\"wallet_scope\":\"dev\",\"plan_id\":\"<64hex>\",\"confirm\":true}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_WALLET, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OWNER,
    ZCL_COMMAND_MODE_SYNC, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_CONFIRM_IDEMPOTENCY,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_WALLET_REQUEST, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_vault_intent_submit)

