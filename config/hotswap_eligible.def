/* Tier-1 hot-swap eligibility manifest (DEV-ONLY surface).
 *
 * Consumer must define:
 *   HOTSWAP_ELIGIBLE(path) HOTSWAP_PROBE(tool)
 *
 * `path` is the repo-relative .c translation unit and `tool` is one
 * non-destructive command leaf owned by that TU. Its canonical input, expected
 * schema, and byte budget live in hotswap_probe_cases.def. Keep the pair on
 * one line: this file is the single source of truth consumed by the native
 * planner, shell watcher, demo, loader allowlist, and lint gates.
 *
 * A translation unit listed here may be recompiled into a generation .so
 * (`make hotswap-so FILES=...`) and dlopen'd into a RUNNING dev node to
 * re-point its atomic command-leaf slots with no restart. See
 * docs/work/HOTSWAP.md and ZCL_HOTSWAP_EXPORT_LEAVES in
 * lib/hotswap/include/hotswap/hotswap.h.
 *
 * Two lint gates keep this list honest (both wired into `make lint`, both
 * self-tested in lib/test/src/test_make_lint_gates.c):
 *
 *   check-hotswap-eligible-scope   Every path must be an app-layer surface,
 *       NEVER under lib/consensus, lib/validation, lib/storage, lib/net,
 *       lib/coins, or app/jobs (reducer stages) — consensus/state code is
 *       never hot-swappable, not even in dev.
 *
 *   check-hotswap-static-state     Every listed TU must define NO mutable
 *       file-scope statics: a generation .so gets its own zero-initialized
 *       copy of any such static and would lose the live process state. The
 *       resident half (atomic provider slot, boot-populated main_state, ...)
 *       lives in a sibling NON-eligible trampoline TU. A file-scope static
 *       that is provably swap-safe may be annotated on the SAME line with an
 *       allowlist marker comment reading  hotswap-static-ok: <reason>.
 *
 * Keep this DATA ONLY (no C tokens beyond the macro invocations). */

/* native.leaves provider class: the native command bridge in
 * tools/command/native_command.c. Each TU below invokes
 * ZCL_HOTSWAP_EXPORT_LEAVES(k_leaves, ...) inside `#ifdef ZCL_HOTSWAP_GEN`,
 * staging {dotted_leaf_path, trampoline} pairs — a trampoline calls
 * zcl_native_bridge_run(request, <this TU's freshly-compiled body fn>,
 * reply), the same composition the resident bridge already uses.
 * The resident native command router dispatches the manifest's declared,
 * host-owned probe case before committing the batch. */
HOTSWAP_ELIGIBLE("app/controllers/src/status_native_handlers.c") HOTSWAP_PROBE("core.status")
HOTSWAP_ELIGIBLE("app/controllers/src/wallet_native_handlers.c") HOTSWAP_PROBE("core.wallet.address.list")
HOTSWAP_ELIGIBLE("app/controllers/src/net_native_handlers.c") HOTSWAP_PROBE("core.network.peers.incidents")
HOTSWAP_ELIGIBLE("app/controllers/src/meta_native_handlers.c") HOTSWAP_PROBE("ops.metrics")
HOTSWAP_ELIGIBLE("app/controllers/src/chain_native_handlers.c") HOTSWAP_PROBE("core.consensus.utxo.audit")
HOTSWAP_ELIGIBLE("app/controllers/src/app_native_handlers.c") HOTSWAP_PROBE("app.names.list")
HOTSWAP_ELIGIBLE("app/controllers/src/metaverse_controller.c") HOTSWAP_PROBE("metaverse.property.list")
HOTSWAP_ELIGIBLE("app/controllers/src/diagnostics_native_handlers.c") HOTSWAP_PROBE("ops.logs")
HOTSWAP_ELIGIBLE("app/controllers/src/ops_native_handlers.c") HOTSWAP_PROBE("ops.debug.dash.summary")

/* Wave 2 of the swappable surface: read-only STORE, WALLET-SECURITY and
 * STATUS-JOURNEY projections. Each of these files also owns leaves that
 * mutate; those are absent from the file's row in hotswap_swappable.def and
 * the loader refuses to re-point a leaf that is not on the row. */
HOTSWAP_ELIGIBLE("app/controllers/src/store_buyer_native_handlers.c") HOTSWAP_PROBE("app.store.catalog")
HOTSWAP_ELIGIBLE("app/controllers/src/wallet_security_native_handlers.c") HOTSWAP_PROBE("core.wallet.security.status")
HOTSWAP_ELIGIBLE("app/controllers/src/status_journey_native_handler.c") HOTSWAP_PROBE("status")

/* Wave 3: read-only ACCOUNT, MODERATION-POSTURE, ROM-DIAGNOSTIC and SHOP
 * projections. None of these reads or renders block or transaction bytes;
 * they project app-layer records and this node's own operating posture. */
HOTSWAP_ELIGIBLE("app/controllers/src/account_controller.c") HOTSWAP_PROBE("app.account.list")
HOTSWAP_ELIGIBLE("app/controllers/src/market_moderation_native_handler.c") HOTSWAP_PROBE("app.market.moderation.status")
HOTSWAP_ELIGIBLE("app/controllers/src/rom_fetch_controller.c") HOTSWAP_PROBE("ops.debug.rom_fetch.status")
HOTSWAP_ELIGIBLE("app/controllers/src/rom_seed_controller.c") HOTSWAP_PROBE("ops.debug.rom_seed.status")
HOTSWAP_ELIGIBLE("app/controllers/src/shop_native_handler.c") HOTSWAP_PROBE("app.shop.status")

/* Wave 4: read-only MARKETPLACE, SHOP and WALLET-LOOKUP projections. */
HOTSWAP_ELIGIBLE("app/controllers/src/market_purchase_native_handler.c") HOTSWAP_PROBE("app.market.purchase.guide")
HOTSWAP_ELIGIBLE("app/controllers/src/shop_native_want.c") HOTSWAP_PROBE("app.shop.want.list")
HOTSWAP_ELIGIBLE("app/controllers/src/shop_native_fulfill.c") HOTSWAP_PROBE("app.shop.want.fulfill.list")
HOTSWAP_ELIGIBLE("app/controllers/src/shop_native_reputation.c") HOTSWAP_PROBE("app.shop.reputation")
HOTSWAP_ELIGIBLE("app/controllers/src/wallet_recovery_native_handlers.c") HOTSWAP_PROBE("core.wallet.recovery.status")

/* Still reload-required (NOT eligible), by design:
 *   - REST (app/controllers/src/api_controller_routes.c) and diagnostics
 *     (diagnostics_registry.c) use independent provider atomics that cannot
 *     join a single immutable-snapshot commit.
 *   - diagnostics_registry.c holds mutable file-scope statics
 *     (g_state_subsystems_csv, non-const p_state[]).
 * Re-enable REST/diagnostics only behind one unified resident provider table. */

/* The PURE decision leaf — and the only row here whose declared probe is
 * computable IN-PROCESS: no running node, no datadir, no RPC, no wall-clock.
 * Every row above is an RPC front door whose module trampoline calls
 * zcl_native_bridge_run() into a body that issues a loopback RPC, so
 * probe-before-publish for those rows needs a resident node and correctly
 * refuses at stage=probe without one. This row is the hermetic case: its body
 * answers from `args` plus compiled-in constants, so the identical gauntlet
 * runs to completion in a throwaway CLI process. See
 * app/controllers/src/policy_native_handlers.c. */
HOTSWAP_ELIGIBLE("app/controllers/src/policy_native_handlers.c") HOTSWAP_PROBE("zcode.package.policy.limits")
