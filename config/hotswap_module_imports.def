HOTSWAP_MODULE_IMPORT("zcl_json_value_to_body", "JSON")

/* ── LOG ───────────────────────────────────────────────────────────────────
 * Observability and build identity. Write-only into the log stream plus one
 * read of the configured level; nothing flows back out of the node. */
HOTSWAP_MODULE_IMPORT("zcl_build_commit", "LOG")
HOTSWAP_MODULE_IMPORT("zcl_log_emit_at", "LOG")
HOTSWAP_MODULE_IMPORT("zcl_log_level_get", "LOG")

/* ═══ NODE ENTRY POINTS — the reviewed part ════════════════════════════════
 * Everything below resolves into the RESIDENT node image. Each row is a door
 * a mounted module can walk through. See the group notes in the header. */

/* ── NODE_COMMAND ──────────────────────────────────────────────────────────
 * How a leaf is invoked and how it answers: the RPC bridge, the typed argument
 * builder, reply/result construction, datadir + stdin accessors, and the
 * per-controller failure helpers. `node_rpc_call` is the widest door here — it
 * dispatches an arbitrary RPC method by NAME — and it is allowed only because
 * the leaf reaching it is independently pinned READY + EFFECT_READ by
 * config/hotswap_swappable.def. */
HOTSWAP_MODULE_IMPORT("node_rpc_call", "NODE_COMMAND")
HOTSWAP_MODULE_IMPORT("node_rpc_call_at_deadline", "NODE_COMMAND")
HOTSWAP_MODULE_IMPORT("node_rpc_call_deadline", "NODE_COMMAND")
HOTSWAP_MODULE_IMPORT("rpc_arg_builder_init", "NODE_COMMAND")
HOTSWAP_MODULE_IMPORT("rpc_arg_builder_push_int", "NODE_COMMAND")
HOTSWAP_MODULE_IMPORT("rpc_arg_builder_push_real", "NODE_COMMAND")
HOTSWAP_MODULE_IMPORT("rpc_arg_builder_push_str", "NODE_COMMAND")
HOTSWAP_MODULE_IMPORT("rpc_arg_builder_push_value", "NODE_COMMAND")
HOTSWAP_MODULE_IMPORT("rpc_arg_builder_to_json", "NODE_COMMAND")
HOTSWAP_MODULE_IMPORT("shf_fail", "NODE_COMMAND")
HOTSWAP_MODULE_IMPORT("wnh_call_rpc", "NODE_COMMAND")
HOTSWAP_MODULE_IMPORT("wnh_fail", "NODE_COMMAND")
HOTSWAP_MODULE_IMPORT("zcl_command_authority_name", "NODE_COMMAND")
HOTSWAP_MODULE_IMPORT("zcl_command_reply_add_next", "NODE_COMMAND")
HOTSWAP_MODULE_IMPORT("zcl_command_reply_fail", "NODE_COMMAND")
HOTSWAP_MODULE_IMPORT("zcl_native_bridge_ensure_rpc", "NODE_COMMAND")
HOTSWAP_MODULE_IMPORT("zcl_native_bridge_run", "NODE_COMMAND")
HOTSWAP_MODULE_IMPORT("zcl_native_command_datadir", "NODE_COMMAND")
HOTSWAP_MODULE_IMPORT("zcl_native_input_was_stdin", "NODE_COMMAND")
HOTSWAP_MODULE_IMPORT("zcl_result_make", "NODE_COMMAND")

/* ── NODE_STATUS ───────────────────────────────────────────────────────────
 * Read-only projections and their formatters. These OBSERVE. A swapped
 * generation here can misreport what an operator sees, which is precisely why
 * the leaves that use them are read-only and why chain block/transaction
 * rendering is denied outright in config/hotswap_denied_leaves.def. */
