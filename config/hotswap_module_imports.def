/* THE DEVICE-DRIVER CONTRACT — what a hot-swap module .so may IMPORT.
 *
 * Consumer must define:
 *   HOTSWAP_MODULE_IMPORT(symbol, group)
 *
 * symbol  A dynamic symbol name EXACTLY as it appears in a module's `.dynsym`
 *         UNDEFINED set, with any `@GLIBC_x.y.z` version suffix REMOVED. The
 *         version half is deliberately not part of the contract: a glibc bump
 *         renames `strtol@GLIBC_2.17` to `__isoc23_strtol@GLIBC_2.38` and that
 *         is a toolchain fact, not a widening of reach. The NAME is what says
 *         what the module can touch.
 * group   One of the closed set below. It is the REASON the symbol is allowed;
 *         a row with no defensible group does not belong in this file.
 *
 * ── WHY THIS FILE EXISTS ───────────────────────────────────────────────────
 * A Tier-2 hot-swap module is a .so compiled from ONE shape-leaf TU and
 * dlopen'd into the LIVE node's address space. Every other body it calls is
 * resolved out of the resident image at load time. That makes the module's
 * UNDEFINED symbol set its complete, mechanically-derivable interface to the
 * node — a device-driver contract in the literal sense: the set of node
 * entry points a mounted module can reach.
 *
 * That contract already existed in practice and was enforced NOWHERE. Nothing
 * stopped a controller edit from adding one `#include` and quietly acquiring
 * a call into the reducer, the coins view, the wallet spend path, or the
 * chain state — the module would still compile, still pass every existing
 * hot-swap gate (they check the TU's PATH, its leaves' READY/read-only spec,
 * its mutable statics, and the sealed-core pin — none of them look at what it
 * LINKS AGAINST), and still mount. The reach would grow with no diff a
 * reviewer could see as a reach change, because the change is one #include
 * and a call.
 *
 * So the import set is declared here and gated by
 * `check-hotswap-module-imports` (tools/lint/check_hotswap_module_imports.sh),
 * which reads the UNDEFINED symbols out of every built module .so and refuses
 * any name absent from this file. Widening the contract is now an explicit,
 * reviewable edit to a data file with a rationale column.
 *
 * ── WHAT THIS FILE IS NOT ──────────────────────────────────────────────────
 * It is NOT an authority and NOT a runtime admission input. It is a BUILD-TIME
 * lint contract over artifacts a developer produced. An attacker who can write
 * a module .so can also write this file. What it buys is the thing an attacker
 * model cannot give you: a mounted module's reach cannot grow by accident, and
 * it cannot grow deliberately without a line in a reviewed data file saying so.
 * Runtime admission stays where it is — `hotswap_module_admit()`, the sealed
 * `core_seal_root` pin, the fd-pinned artifact digest.
 *
 * ── THE GROUPS, AND WHICH ONE TO ACTUALLY THINK ABOUT ─────────────────────
 *   TOOLCHAIN     Compiler/linker-emitted weak hooks the module never wrote:
 *                 `__gmon_start__`, `_ITM_*TMCloneTable`, `__cxa_finalize`.
 *                 Present in every -shared object gcc emits. Zero reach.
 *   LIBC          Plain glibc: allocation, string/mem, stdio on a FILE the
 *                 module owns, `getenv`, `qsort`, `_chk` fortify variants,
 *                 `__stack_chk_fail`. Reach into the NODE: none — a module
 *                 that calls `malloc` learns nothing about the chain. These
 *                 rows exist so the gate has a complete picture, not because
 *                 anybody must approve `strlen`.
 *   JSON          The in-tree JSON document helpers (`json_*`,
 *                 `zcl_json_value_to_body`). A command leaf's whole output is
 *                 a JSON document, so this is the module's RETURN PATH. Pure
 *                 value manipulation over a caller-owned tree; it reaches no
 *                 node state.
 *   LOG           `zcl_log_emit_at`, `zcl_log_level_get`, `zcl_build_commit`.
 *                 Observability and build identity. Write-only into the log
 *                 stream; reads nothing back out of the node.
 *
 *   Everything below this line is a REAL NODE ENTRY POINT, and this is the
 *   part a reviewer has to think about. Each of these resolves to resident
 *   node code, so each is a door a mounted module can walk through. The test
 *   for a NEW row is not "does it link" — it is: could a swapped generation
 *   calling this MISREPORT or MUTATE something a reader trusts?
 *
 *   NODE_COMMAND  Native-command plumbing: the RPC bridge (`node_rpc_call*`,
 *                 `zcl_native_bridge_*`), the typed argument builder
 *                 (`rpc_arg_builder_*`), reply/result construction
 *                 (`zcl_command_reply_*`, `zcl_result_make`), the datadir and
 *                 stdin accessors, and the per-controller `wnh_*`/`shf_*`
 *                 failure helpers. This is HOW a leaf is invoked and how it
 *                 answers. `node_rpc_call` is the widest door in the file: it
 *                 dispatches an arbitrary RPC method by NAME, so the effect
 *                 ceiling of this group is the effect ceiling of the RPC
 *                 surface, not of the leaf. It is allowed because the leaf
 *                 that reaches it is itself gated READY + EFFECT_READ by
 *                 config/hotswap_swappable.def, and because removing it would
 *                 mean no controller could be hot-swapped at all.
 *   NODE_STATUS   Read-only projections and their formatters: status/brief
 *                 readiness facts, blocker summaries and causal priority, boot
 *                 stage, postmortem listing, peer-incident derivation,
 *                 Prometheus metric rendering, self-heal counters, sync
 *                 benchmark receipts, agent audit/broker renderers. These
 *                 OBSERVE. A swapped generation here can misreport what the
 *                 operator sees — which is exactly why the leaves that use
 *                 them are read-only and why block/transaction rendering is
 *                 denied outright in config/hotswap_denied_leaves.def.
 *   NODE_DB       The node database: `node_db_open_runtime`/`_close`, the
 *                 read-only wrappers (`zcl_native_node_db_*_readonly`), the
 *                 app-domain row accessors (`db_*`), `store_ensure_schema`,
 *                 and three raw `sqlite3_*` entry points. THIS GROUP IS NOT
 *                 UNIFORMLY READ-ONLY: `db_*_save`, `db_shop_want_mark_*`,
 *                 `db_shop_fulfill_mark_withdrawn` and
 *                 `db_shop_want_set_review_state` WRITE. They are here because
 *                 they are what the shop/market controller TUs already import;
 *                 the read-only property is enforced one level up, by the
 *                 leaf-spec gates, not by this list. Adding a row here that
 *                 mutates CONSENSUS state (coins, chain, reducer) would be a
 *                 different thing entirely and must be refused.
 *   NODE_UTIL    Stateless helpers with no node state behind them: hex and
 *                 fixed-point codecs, `arith_uint256_get_hex`, `memory_cleanse`,
 *                 the monotonic/wall clocks, `path_check_url_arg`,
 *                 `chain_params_select` (selects a compiled-in parameter
 *                 table; it does not change chain state), SHA3-256, Ed25519
 *                 keypair, Sapling address decode, `thread_registry_spawn`.
 *   NODE_HOTSWAP  The module's own scaffolding: the service-handle
 *                 acquire/release/generation triple a module uses to pin a
 *                 resident service across a swap, the resident-policy dispatch
 *                 notes, and `zcl_alloc_fault_should_fail` (the allocation
 *                 fault-injection hook, dev builds only).
 *   NODE_APP     App-domain read/verify services behind swappable controller
 *                 leaves: shop want/fulfill sealing and verification, market
 *                 moderation and purchase views, ROM fetch/seed/journal, VCS
 *                 package manifest/index/attestation/reward, ZNAM/ZSLP asset
 *                 views, onion identity/service accessors, principal and authz
 *                 role tables, wallet recovery status. Same warning as
 *                 NODE_DB: a handful of these are not pure readers
 *                 (`rom_fetch_download*`, `rom_seed_policy_set_enabled`,
 *                 `onion_identity_ensure`, `wallet_recovery_run`,
 *                 `auth_login_verify`). They are recorded because modules
 *                 built from those TUs really do import them; the leaf-effect
 *                 gates, not this file, keep them off a swappable leaf.
 *
 * ── HOW THE INITIAL CONTENTS WERE DERIVED ──────────────────────────────────
 * Mechanically, from the artifacts — not from anyone's idea of what a module
 * ought to need:
 *
 *   for f in build/hotswap/*.so; do nm -D --undefined-only "$f"; done \
 *     | awk '{print $NF}' | sed 's/@.*$//' | LC_ALL=C sort -u
 *
 * over every module .so present (93 artifacts spanning several build
 * generations), which is why the file starts truthful and the gate is green
 * on day one. It is a CEILING, not a wish list: shrinking it is always safe,
 * growing it is the reviewed act.
 *
 * ── ADDING A ROW ───────────────────────────────────────────────────────────
 * Append it under its group, keep the group blocks sorted, and say in the
 * commit message which door you opened and why the leaf behind it still
 * cannot misreport or mutate anything a reader trusts. If the honest answer
 * is "it can", the fix is to not import it — move the call into the resident
 * and reach it through an existing NODE_COMMAND door.
 *
 * Keep this DATA ONLY (no C tokens beyond the macro invocations). */

/* ── TOOLCHAIN ─────────────────────────────────────────────────────────────
 * Emitted by gcc/ld into every -shared object; weak-undefined, resolved to
 * nothing when absent. Nobody wrote these calls and they reach no node state. */
HOTSWAP_MODULE_IMPORT("_ITM_deregisterTMCloneTable", "TOOLCHAIN")
HOTSWAP_MODULE_IMPORT("_ITM_registerTMCloneTable", "TOOLCHAIN")
HOTSWAP_MODULE_IMPORT("__cxa_finalize", "TOOLCHAIN")
HOTSWAP_MODULE_IMPORT("__gmon_start__", "TOOLCHAIN")

/* ── LIBC ──────────────────────────────────────────────────────────────────
 * Plain glibc. Allocation, string/memory, stdio over a FILE the module opened
 * itself, environment lookup, sorting, and the fortify (`_chk`) / stack-guard
 * variants gcc substitutes at -D_FORTIFY_SOURCE. Zero reach into node state:
 * a module that calls `strlen` learns nothing about the chain. Listed so the
 * gate can see a module's WHOLE import set, not because `memcpy` needs a
 * reviewer. */
HOTSWAP_MODULE_IMPORT("__ctype_b_loc", "LIBC")
HOTSWAP_MODULE_IMPORT("__errno_location", "LIBC")
HOTSWAP_MODULE_IMPORT("__fprintf_chk", "LIBC")
HOTSWAP_MODULE_IMPORT("__isoc23_strtol", "LIBC")
HOTSWAP_MODULE_IMPORT("__isoc23_strtoll", "LIBC")
HOTSWAP_MODULE_IMPORT("__isoc23_strtoull", "LIBC")
HOTSWAP_MODULE_IMPORT("__memcpy_chk", "LIBC")
HOTSWAP_MODULE_IMPORT("__snprintf_chk", "LIBC")
HOTSWAP_MODULE_IMPORT("__stack_chk_fail", "LIBC")
HOTSWAP_MODULE_IMPORT("__vsnprintf_chk", "LIBC")
HOTSWAP_MODULE_IMPORT("calloc", "LIBC")
HOTSWAP_MODULE_IMPORT("close", "LIBC")
HOTSWAP_MODULE_IMPORT("closedir", "LIBC")
HOTSWAP_MODULE_IMPORT("fclose", "LIBC")
HOTSWAP_MODULE_IMPORT("feof", "LIBC")
HOTSWAP_MODULE_IMPORT("fgetc", "LIBC")
HOTSWAP_MODULE_IMPORT("fopen", "LIBC")
HOTSWAP_MODULE_IMPORT("fread", "LIBC")
HOTSWAP_MODULE_IMPORT("free", "LIBC")
HOTSWAP_MODULE_IMPORT("fstat", "LIBC")
HOTSWAP_MODULE_IMPORT("getenv", "LIBC")
HOTSWAP_MODULE_IMPORT("lstat", "LIBC")
HOTSWAP_MODULE_IMPORT("malloc", "LIBC")
HOTSWAP_MODULE_IMPORT("memcmp", "LIBC")
HOTSWAP_MODULE_IMPORT("memcpy", "LIBC")
HOTSWAP_MODULE_IMPORT("memset", "LIBC")
HOTSWAP_MODULE_IMPORT("open", "LIBC")
HOTSWAP_MODULE_IMPORT("opendir", "LIBC")
HOTSWAP_MODULE_IMPORT("pthread_join", "LIBC")
HOTSWAP_MODULE_IMPORT("qsort", "LIBC")
HOTSWAP_MODULE_IMPORT("read", "LIBC")
HOTSWAP_MODULE_IMPORT("readdir", "LIBC")
HOTSWAP_MODULE_IMPORT("snprintf", "LIBC")
HOTSWAP_MODULE_IMPORT("stat", "LIBC")
HOTSWAP_MODULE_IMPORT("stderr", "LIBC")
HOTSWAP_MODULE_IMPORT("strchr", "LIBC")
HOTSWAP_MODULE_IMPORT("strcmp", "LIBC")
HOTSWAP_MODULE_IMPORT("strdup", "LIBC")
HOTSWAP_MODULE_IMPORT("strerror", "LIBC")
HOTSWAP_MODULE_IMPORT("strlen", "LIBC")
HOTSWAP_MODULE_IMPORT("strncmp", "LIBC")
HOTSWAP_MODULE_IMPORT("strnlen", "LIBC")
HOTSWAP_MODULE_IMPORT("strstr", "LIBC")
HOTSWAP_MODULE_IMPORT("strtod", "LIBC")
HOTSWAP_MODULE_IMPORT("strtok", "LIBC")

/* ── JSON ──────────────────────────────────────────────────────────────────
 * The in-tree JSON document helpers. A command leaf's entire output is a JSON
 * document, so this group is the module's RETURN PATH. Pure value manipulation
 * over a tree the caller owns; touches no node state. */
HOTSWAP_MODULE_IMPORT("json_at", "JSON")
HOTSWAP_MODULE_IMPORT("json_copy", "JSON")
HOTSWAP_MODULE_IMPORT("json_free", "JSON")
HOTSWAP_MODULE_IMPORT("json_get", "JSON")
HOTSWAP_MODULE_IMPORT("json_get_bool", "JSON")
HOTSWAP_MODULE_IMPORT("json_get_int", "JSON")
HOTSWAP_MODULE_IMPORT("json_get_real", "JSON")
HOTSWAP_MODULE_IMPORT("json_get_str", "JSON")
HOTSWAP_MODULE_IMPORT("json_init", "JSON")
HOTSWAP_MODULE_IMPORT("json_is_null", "JSON")
HOTSWAP_MODULE_IMPORT("json_push_back", "JSON")
HOTSWAP_MODULE_IMPORT("json_push_kv", "JSON")
HOTSWAP_MODULE_IMPORT("json_push_kv_bool", "JSON")
HOTSWAP_MODULE_IMPORT("json_push_kv_int", "JSON")
HOTSWAP_MODULE_IMPORT("json_push_kv_real", "JSON")
HOTSWAP_MODULE_IMPORT("json_push_kv_str", "JSON")
