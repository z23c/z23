/* ── NODE_UTIL ─────────────────────────────────────────────────────────────
 * Stateless helpers with no node state behind them: hex/fixed-point codecs,
 * uint256 hex rendering, `memory_cleanse`, the monotonic and wall clocks, URL
 * argument validation, compiled-in chain-parameter selection (it selects a
 * table; it does not change chain state), SHA3-256, Ed25519 keypair, Sapling
 * address decode, and the thread-registry spawn wrapper. */
HOTSWAP_MODULE_IMPORT("HexStr", "NODE_UTIL")
HOTSWAP_MODULE_IMPORT("IsHex", "NODE_UTIL")
