/* ── NODE_DB ───────────────────────────────────────────────────────────────
 * The node database: open/close, the read-only wrappers, app-domain row
 * accessors, schema ensure, and three raw sqlite3 entry points.
 * NOT UNIFORMLY READ-ONLY — `db_*_save`, `db_shop_want_mark_cancelled`,
 * `db_shop_fulfill_mark_withdrawn` and `db_shop_want_set_review_state` write.
 * The read-only property is enforced one level up by the leaf-spec gates, not
 * by this list. A future row that mutates CONSENSUS state (coins, chain,
 * reducer) is a different kind of thing and must be refused here. */
HOTSWAP_MODULE_IMPORT("app_runtime_node_db", "NODE_DB")
