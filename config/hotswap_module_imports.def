/* ── NODE_HOTSWAP ──────────────────────────────────────────────────────────
 * The module's own scaffolding: the service-handle acquire/release/generation
 * triple used to pin a resident service across a swap, the resident-policy
 * dispatch notes, and the dev-only allocation fault-injection hook. */
HOTSWAP_MODULE_IMPORT("zcl_alloc_fault_should_fail", "NODE_HOTSWAP")
