    "app/services/src/zcode_c23_corpus_service.c",
    "lib/vcs/src/zcode_c23_corpus_objects.c lib/vcs/src/zcode_c23_corpus_shard.c lib/vcs/src/zcode_c23_productivity_receipt.c")
