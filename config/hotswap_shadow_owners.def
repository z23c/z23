/* Pure implementation members compiled into the candidate service itself.
 * Unlike authority shells these bytes execute in HOT_SHADOW, so they must pass
 * the same no-state/no-effects lint as the service. */
HOTSHADOW_SERVICE_MEMBERS(
    "app/services/src/zcode_workspace_view_service.c",
    "lib/vcs/src/zcode_workspace_manifest.c")
HOTSHADOW_SERVICE_MEMBERS(
    "app/services/src/zcode_c23_economics_service.c",
    "lib/vcs/src/zcode_commons_economics.c lib/vcs/src/zcode_epoch_schedule.c lib/vcs/src/zcode_claim_epoch.c")
