/* THE HARD LINE — swappable-module allowlist for the REAL module ABI.
 *
 * Consumer must define:
 *   HOTSWAP_SWAPPABLE(source_tu, leaves)
 *
 * source_tu  The shape-leaf translation unit that owns the leaves. It MUST be a
 *            controller / view / condition — a shape LEAF. It may NEVER be a
 *            reducer stage, consensus validation, the storage engine, a
 *            supervisor, or any state root. This is what makes activation safe.
 *            ONE row per source file: a module .so is compiled from exactly one
 *            TU and re-points every leaf in `leaves` in ONE all-or-nothing
 *            registry batch.
 * leaves     Space-separated canonical command-leaf paths owned by source_tu.
 *            Every entry MUST be declared with ZCL_COMMAND_READY_READ in
 *            the config/commands catalog (READY + read-only). hotswap_module_admit()
 *            refuses at runtime any leaf absent from its own file's list, and
 *            the command-registry batch commit independently re-checks
 *            READY + EFFECT_READ + non-alias for every leaf. A leaf may appear
 *            under exactly ONE source_tu (globally unique).
 *
 * Widening this list widens BATCH SIZE, never authority: an added leaf still
 * has to be a READY read-only leaf of an already-admitted shape-leaf TU, still
 * activates only on the dev datadir behind -hotswap-activate +
 * ZCL_HOTSWAP_ACTIVATE=1, and still has to survive probe-before-publish. To add
 * one: append it here AND add its trampoline to that TU's
 * `#ifdef ZCL_HOTSWAP_MODULE_GEN` leaf table.
 *
 * Three things enforce the hard line and must never disagree:
 *   - check-hotswap-swappable-shape (make lint): fails if any source_tu
 *     resolves under a forbidden root (core/, lib/consensus/, lib/validation/,
 *     lib/storage/, lib/net/, lib/coins/, lib/chain/, lib/mining/, app/jobs/,
 *     lib/kernel/, lib/supervisor/, app/supervisors/) or is not under an
 *     allowed shape folder (app/controllers/, app/views/, app/conditions/);
 *     and fails if any leaf is not declared ZCL_COMMAND_READY_READ in
 *     the config/commands catalog, or is claimed by two source files.
 *   - check-hotswap-static-state (make lint): scans the UNION of this file's
 *     source_tu column and config/hotswap_eligible.def for mutable file-scope
 *     statics (a module .so gets its own zero-initialized copy).
 *   - hotswap_module_admit() (runtime): #includes this file to build the
 *     compiled allowlist consulted before any dlopen'd module is published.
 *
 * Both gates are self-tested with seeded-violation fixtures in
 * lib/test/src/test_make_lint_gates.c.
 *
 * Keep this DATA ONLY (no C tokens beyond the macro invocations). */

/* Read-only status / sync-diagnosis / operator-timeline projections. All seven
 * leaves tolerate empty args and surface field failures as nested
 * "<field>_error" keys, never a top-level "error" — so the probe dispatch
 * succeeds. core.status stays the declared probe. */
HOTSWAP_SWAPPABLE("app/controllers/src/status_native_handlers.c",
                  "core.status core.status.brief core.sync.diagnose core.sync.blockers ops.timeline ops.diagnose ops.postmortem.list ops.debug.dash.kpi")
/* Read-only peer-incident and onion-health projections (controller leaves). */
HOTSWAP_SWAPPABLE("app/controllers/src/net_native_handlers.c",
                  "core.network.peers.incidents core.network.onion.health")
/* Read-only operator metrics projections. core.consensus.report renders a
 * Prometheus counter table (metrics_prometheus_consensus_report_json) — an
 * observability VIEW of consensus, never a consensus rule. */
HOTSWAP_SWAPPABLE("app/controllers/src/meta_native_handlers.c",
                  "ops.metrics core.consensus.report")
/* Read-only WALLET projections: this wallet's addresses, its own unspent
 * outputs, and its own transaction history. No signing, no spend, no keystore
 * mutation — wallet WRITE leaves stay resident. */
HOTSWAP_SWAPPABLE("app/controllers/src/wallet_native_handlers.c",
                  "core.wallet.address.list core.wallet.utxo.list core.wallet.transaction.list core.wallet.transaction.get core.wallet.shielded.balance core.wallet.shielded.notes")
/* Read-only UTXO drift-audit projection (controller leaf; an audit VIEW, not
 * consensus validation — validation/state roots stay unswappable).
 * DELIBERATELY WITHHELD from this row, though both are ZCL_COMMAND_READY_READ
 * and would pass every gate: core.chain.block.get and
 * core.chain.transaction.get. They render block and transaction bytes, i.e.
 * they sit on the block/transaction path. Read-only is not the test there; the
 * standing rule is that anything one cannot argue is off the consensus path is
 * not eligible. Admitting them needs an explicit owner decision, not a lint
 * pass. */
HOTSWAP_SWAPPABLE("app/controllers/src/chain_native_handlers.c",
                  "core.consensus.utxo.audit")
/* Read-only app-layer index/catalog projections: ZNAM names, ZSLP tokens,
 * messaging inbox, market listings, cross-chain swap views. */
HOTSWAP_SWAPPABLE("app/controllers/src/app_native_handlers.c",
                  "app.names.list app.names.resolve app.tokens.list app.messaging.inbox app.market.list app.market.status app.market.content.list app.swap.chains app.swap.list")
/* Parsing, authorization and log I/O stay resident. The swappable body owns
 * request composition only and is qualified with a fixed one-row log case. */
HOTSWAP_SWAPPABLE("app/controllers/src/diagnostics_native_handlers.c",
                  "ops.logs core.storage.query")
/* Read-only operator rollup dashboards. Four leaves forward a no-argument
 * read-only node RPC verbatim; selfheal renders a counter snapshot. Every body
 * is defined in this same TU, so a swap genuinely recompiles all five. */
HOTSWAP_SWAPPABLE("app/controllers/src/ops_native_handlers.c",
                  "ops.debug.dash.snapshot ops.debug.dash.summary ops.debug.dash.milestone ops.debug.dash.mirror ops.debug.dash.selfheal")
/* Project-neutral App/Metaverse property projection. The owner has no state;
 * its pure service/view/codec/adapter closure is one reloadable island. */
HOTSWAP_SWAPPABLE("app/controllers/src/metaverse_controller.c",
                  "metaverse.agent.status metaverse.agent.money metaverse.agent.liquidity metaverse.agent.audit metaverse.property.list metaverse.property.show")
/* The pure decision leaf. Its body and the frozen policy table it reads are
 * both inside this module's island, so a re-pointed dispatch enters freshly
 * compiled code; the resident counters it reports live in the NON-island
 * sibling app/controllers/src/policy_native_resident.c and are imported from
 * the -rdynamic host at dlopen, so the swap never clones process state. */
HOTSWAP_SWAPPABLE("app/controllers/src/policy_native_handlers.c",
                  "zcode.package.policy.limits")
