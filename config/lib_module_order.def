/* Copyright 2026 Rhett Creighton - Apache License 2.0
 *
 * lib_module_order — the ONE declaration of which lib/ modules exist and in
 * what LINK ORDER. Rank is position: the first line is rank 1, and a module
 * may reference only STRICTLY LOWER ranks. There are no numbers in this file
 * to keep in sync; the order IS the rank.
 *
 * This file declares both the SET and the RANK, and it is the only place
 * either is written down. Everything else derives from it:
 *
 *   Makefile                              LIB_MODULES := $(shell sed ... )
 *                                         — every lib/ source glob and -I flag
 *   tools/lint/repo_shape.sh              ZCL_LIB_MODULES[], for the gates
 *   lib/codeindex/src/codeindex_group.c   k_lib_modules[], an X-macro paste
 *
 * It used to be a third copy of a set the Makefile and the scanner each kept
 * by hand, checked against each other. Deleting those copies removes the
 * cross-check they provided, so the check moved to the one witness that is
 * still independent of this file: the lib/ tree itself. A lib/<mod>/ directory
 * exists whether or not anyone declared it, and both
 * tools/scripts/check_lib_module_order.sh and test_codeindex.c case 6 compare
 * this file's set against it. Rank has no such witness — no build step needs
 * it, so no build step can police it — which is why the gate also enforces the
 * rank rule against the MEASURED link graph (tools/dev/module-linkgraph.sh).
 *
 * A module missing from this file is not a lint warning, it is a module
 * missing from the build.
 *
 * How the order was derived — re-measured 2026-08-29 on today's tree, and
 * re-derivable at any time with two commands:
 *   make build-only -j"$(nproc)"          # the ONLY tree the gate measures
 *   tools/dev/module-linkgraph.sh --fas --obj-root build/obj
 * The graph is 248 lib->lib edges over the 46 lib modules that have any edge
 * at all (lib/presentation has none), with 40 strongly-connected components
 * of which two are non-trivial: {metrics sync validation net rpc storage} and
 * {util health}. The sequence below leaves 4 back edges, and that is OPTIMAL,
 * not merely good: --fas solves each component exactly (minimum feedback arc
 * set decomposes over components) and reports the floor as 3 + 1 = 4, so no
 * reordering of this file can do better. Deleting those 4 and running `tsort`
 * over the residue confirms it is acyclic. lib/script sat in the big
 * component until 2026-08-29, when the unused zcashconsensus C-ABI shim — the
 * TU that carried script's entire upward reach — was deleted. The 4 are
 * grandfathered in
 * tools/scripts/lib_module_order_baseline.txt and the gate ratchets: the
 * baseline may only shrink, and shrinking it now requires BREAKING A CYCLE,
 * not reordering.
 *
 * Every number in this comment is output of the two commands above, not
 * inherited from an earlier measurement. Re-run them before editing the order,
 * and replace the numbers with what you actually see.
 *
 * Adding a module: put it at the LOWEST rank that keeps the gate green
 * (i.e. below everything it references). Never reorder to make a violation
 * disappear without re-running the tool — the baseline is the record of what
 * we owe, and moving a module to hide an edge just relabels the debt.
 *
 * Not listed here: lib/test (the test runner is not part of the production
 * link order; the Makefile builds it from its own variable).
 */

/* Leaf utilities and low-level building blocks. lib/base is the sink — the
 * logging / allocation / result vocabulary every other module speaks. */
LIB_MODULE("base")
/* The install front door's release-pin judgement. It references NOTHING
 * in-tree — not even base — because the same objects are also linked into the
 * standalone bootstrap binary that a stranger's machine runs before anything
 * has been verified, and every edge added here is another translation unit
 * that has to be honest in that context too. Ranked above base only so base
 * keeps its documented place as the sink. */
LIB_MODULE("install")
/* Scalar FIPS-202 primitives depend only on base.  Crypto owns optional
 * batched acceleration and reaches down through sha3/sha3.h. */
LIB_MODULE("sha3")
/* BM25 ranked retrieval and its immutable experiment roots. Depends on base,
 * sha3, and the C math library, so directly above sha3 is its lowest legal
 * rank. Nothing below it (base, install, sha3) references retrieval. */
LIB_MODULE("retrieval")
/* Canonical source-universe and contextual ontology objects plus the bounded
 * IO-free evaluator. Depends only on base and sha3; application services own
 * extraction, CAS, projections, clocks and policy. */
LIB_MODULE("ontology")
/* A proof receipt: one claim that a named test group reached a named verdict
 * over an exactly identified source tree, in the fixed form it travels in.
 * Depends on base and sha3 and NOTHING else — deliberately. It does not sign
 * and knows no identity: a caller hands the canonical bytes to zid_doc_sign,
 * which is why this sits at rank 5 instead of above lib/zid. It also does not
 * COMPUTE a verdict vector; it carries one a caller measured. */
LIB_MODULE("receipt")
/* Bounded wire cursors depend only on base fixed-width byte helpers. */
LIB_MODULE("codec")
/* Verdict vectors, their digest, the four-bucket classifier and the
 * determinism receipt. Depends only on base, sha3 and codec — all strictly
 * lower ranks — and deliberately on nothing that knows what a test IS: it
 * consumes the runner's transcript, so it can never grow an opinion about
 * which group deserves to pass. */
LIB_MODULE("determinism")
LIB_MODULE("primitives")
LIB_MODULE("support")
LIB_MODULE("json")
/* The engine-dispatch harness's pure half: the vendor registry, the request
 * document, the hardened response decoder, the file envelope, the key holder,
 * and the verdict. Depends only on base and json — it deliberately carries no
 * transport, so that nothing here can put a TLS-client or trust-store symbol
 * into a Z23 object file (test_cold_join_sovereign.c P2). The socket lives in
 * tools/engine_unit.c, which is compiled straight to an executable. */
LIB_MODULE("engine")
/* Standalone Commons demo core depends on base, codec, and json. */
LIB_MODULE("commons_demo")
LIB_MODULE("encoding")
/* Deterministic positional astronomy: one exact fixed-grid numeric type,
 * CORDIC trigonometry over it, and birth-chart assembly. It is ranked with
 * the leaf utilities because it references NOTHING — not even lib/base. That
 * is deliberate rather than incidental: the module's whole claim is that a
 * chart is a pure function of its input bits, and a dependency on logging,
 * allocation or a clock would be a way for the answer to differ between two
 * nodes. It links libc only, and not libm. */
LIB_MODULE("astro")
/* Bounded native bitmap windows. The public API is platform-neutral; the
 * vendored RGFW implementation is private to lib/presentation. */
LIB_MODULE("presentation")
LIB_MODULE("overlay")
LIB_MODULE("platform")
/* An append-only file whose history cannot be edited quietly: every frame
 * is SHA3-linked to the one before it, seeded from the file header. It reads
 * and writes only through the lib/platform file seam, so it ranks directly
 * above it, and it holds no key material — a chain proves nothing was edited,
 * never who wrote it. */
LIB_MODULE("chainlog")
/* The claim register: what actually makes a model produce good, proven C23,
 * recorded so that a claim cannot be entered without saying how it could be
 * shown wrong. It references base and sha3 (low), engine for the verdict
 * enum it counts (rank above), and chainlog for durability — so directly
 * above chainlog is its LOWEST legal rank, not merely a convenient one. It
 * is not part of lib/metaverse: metaverse models sovereign digital property
 * (identity, grants, receipts) and reaches none of engine or chainlog, and
 * folding a development-process register into it would raise metaverse's
 * dependency set to carry something that shares no type with it. */
LIB_MODULE("science")
LIB_MODULE("core")
LIB_MODULE("crypto")
LIB_MODULE("zid")
LIB_MODULE("noise")
LIB_MODULE("bloom")

/* The foundation hub. Almost everything above it depends on util; util's one
 * remaining upward reach is util -> health (4 symbols), one of the 4
 * grandfathered back edges. */
LIB_MODULE("util")
LIB_MODULE("sapling")
LIB_MODULE("crypto_registry")
LIB_MODULE("event")
LIB_MODULE("keys")

/* Consensus state, the chain index, transport and observability. Six of these
 * — metrics sync validation net rpc storage — are one strongly connected
 * component, so 3 of the 4 back edges necessarily live in here. lib/script
 * sat in that component too until the 2026-08-29 zcashconsensus purge removed
 * its only upward reach. */
LIB_MODULE("coins")
LIB_MODULE("chain")
LIB_MODULE("sync")
LIB_MODULE("metrics")
LIB_MODULE("script")
LIB_MODULE("storage")
LIB_MODULE("validation")
LIB_MODULE("net")
LIB_MODULE("rpc")
LIB_MODULE("health")

/* Application-facing subsystems. */
LIB_MODULE("wallet")
LIB_MODULE("framework")

/* On-chain overlays and the top of the stack. */
LIB_MODULE("zslp")
LIB_MODULE("zswap")
LIB_MODULE("znam")
LIB_MODULE("zanc")
LIB_MODULE("zdir")
LIB_MODULE("vcs")
LIB_MODULE("metaverse")
/* lib/session is the CONFINED-AGENT boundary (the broker, its wire protocol,
 * its grant translation and its audit chain), which is why it ranks here,
 * above lib/metaverse: the broker translates a wire frame into a canonical
 * metaverse action and asks metaverse_grant_check() to rule on it, rather
 * than keeping a second opinion about what an action means.
 *
 * It used to sit at rank 11, below everything, because it also held the Noise
 * handshake and the session record layer — which lib/net calls, and lib/net
 * ranks 25. One module doing both jobs could not be ranked correctly for
 * either: below net for the transport, above metaverse for the broker. The
 * Noise half moved to lib/noise (rank 11, where this line used to be) and
 * lib/net now depends on that, so both halves rank where they belong and no
 * back edge was created in either direction. */
LIB_MODULE("session")
LIB_MODULE("sim")
LIB_MODULE("policy")
LIB_MODULE("mining")
LIB_MODULE("kernel")
LIB_MODULE("hotswap")
LIB_MODULE("codeindex")
LIB_MODULE("fingerprint")
/* Reads the code index and reports one module's inventory, so it must rank
 * above lib/codeindex. It references nothing else that is not already below
 * codeindex (base, sha3), so last is also its lowest legal rank. */
LIB_MODULE("territory")
/* Reads the artifacts this build already writes (the generated capability
 * inventory, the registered test catalog, the Makefile lint-gate list, the
 * determinism ratchet baseline) plus lib/territory's index-derived counts, and
 * appends one canonical frame per run to a lib/chainlog log. It therefore
 * ranks above codeindex, territory and chainlog, which is last — and last is
 * also its lowest legal rank. */
LIB_MODULE("kpi")
