/* VAULT — 20 never_remote leaves.
 *
 * The custody surface. Every leaf here is spend authority, a spend plan, or the
 * grant machinery that authorizes spends. vault.session.create / .list /
 * .revoke drive struct db_agent_session
 * (app/models/include/models/agent_session.h) — the very model
 * docs/work/REMOTE_COMMAND_CHANNEL.md proposes to borrow the SHAPE of. Borrow
 * the shape; never expose the spend instance. A remote caller who could mint a
 * vault session could mint itself money authority, which is the one failure
 * this whole table exists to make unreachable. */
REMOTE_COMMAND_CLASS("vault.list", REMOTE_CLASS_NEVER, "")
