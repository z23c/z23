/* ── owner_capability ─────────────────────────────────────────────── */
REMOTE_COMMAND_CLASS("dev.hotswap.probe", REMOTE_CLASS_OWNER_CAPABILITY,
    "verify-only half of the fleet dev loop: dlopen, ABI-validate, self-test, never commit. Blast radius is one dev-lane process that keeps serving its previous generation on any failure.")
REMOTE_COMMAND_CLASS("dev.hotswap.apply", REMOTE_CLASS_OWNER_CAPABILITY,
    "the fleet dev loop's activation step, and the reason this channel exists. The capability must name this leaf explicitly and expire. Remote class only SUBTRACTS authority: hotswap_activation_authorized() still requires -hotswap-activate, ZCL_HOTSWAP_ACTIVATE=1 and the dev datadir, and still refuses the canonical datadir, after the remote check has passed.")
REMOTE_COMMAND_CLASS("zcode.workspace.source.bundle.fetch", REMOTE_CLASS_OWNER_CAPABILITY,
    "lets a remote node converge to a named source root by pulling and verifying it ITSELF. source_bundle_fetch() accepts nothing that vcs_source_bundle_verify() does not match against the caller-supplied root, so the capability grants go-find-these-bytes, never trust-these-bytes.")
REMOTE_COMMAND_CLASS("ops.logs", REMOTE_CLASS_OWNER_CAPABILITY,
    "a bounded log read is the second thing a fleet driver needs and the first thing that leaks: log bodies carry operator paths, peer addresses and datadir names. Bounded and useful, so not never_remote; leaky, so never read_only.")
REMOTE_COMMAND_CLASS("ops.debug.bundle", REMOTE_CLASS_OWNER_CAPABILITY,
    "a bounded diagnostic capture over several subsystems at once. Same reasoning as ops.logs: genuinely needed across a fleet, too broad to hand out without the capability naming it.")
REMOTE_COMMAND_CLASS("getnodelog", REMOTE_CLASS_OWNER_CAPABILITY,
    "the agent-contract log read. Same leak surface as ops.logs and classified identically.")
REMOTE_COMMAND_CLASS("eventlog", REMOTE_CLASS_OWNER_CAPABILITY,
    "the agent-contract event-log read. Bodies can quote operator paths and peer identity; bounded, but named-capability only.")

/* ── never_remote ─────────────────────────────────────────────────── */

/* ROOT — 1 never_remote leaf.
 *
 * `z23 status` is the money front door. Its projection is custody-authoritative
 * — spendable, pending and reserved amounts — and it declares
 * ZCL_COMMAND_CAP_WALLET_REQUEST for exactly that reason. The chain-only read a
 * fleet driver actually wants is core.status.brief, promoted to read_only
 * above. */
REMOTE_COMMAND_CLASS("status", REMOTE_CLASS_NEVER, "")

/* CORE — 68 never_remote leaves.
 *
 * What is left in `core` after the status, sync and network projections
 * promoted above is one of five things.
 *
 *   Consensus. core.consensus.block.invalidate / .reconsider mutate this
 *   node's view of the chain; core.consensus.producer-session.retire and
 *   core.epoch.anchor mutate producer and epoch state; utxo.commitment,
 *   utxo.audit and mmb hand back consensus commitments that a caller will
 *   treat AS the chain. AGENTS.md makes consensus inviolable and puts it above
 *   every convenience this channel exists to provide.
 *
 *   Raw chain and database content rather than a posture projection —
 *   core.chain.block.get, core.chain.transaction.get, core.chain.mempool.list,
 *   core.storage.query, core.storage.query.offline, core.storage.integrity.
 *   The P2P protocol already serves blocks to anyone who asks, with its own
 *   bounds; core.storage.query is arbitrary query authority over the node
 *   database, which is the general-purpose primitive a typed channel exists to
 *   refuse.
 *
 *   Unbounded or work-starting calls. core.node.bootwait and core.chain.wait.*
 *   block until something happens, which turns one remote call into a held
 *   resource; core.mining.benchmark burns CPU on request.
 *
 *   Sovereign identity and directory state — core.identity.anchor / .rotate /
 *   .revoke / .resolve / .list, core.zdir.*, core.anchor.compose / .inspect,
 *   core.epoch.status / .verify. These name and re-key who this node IS. An
 *   identity a remote caller can rotate is not sovereign.
 *
 *   Wallet custody — every core.wallet.* leaf, INCLUDING its reads. Balances,
 *   addresses, shielded notes, UTXO lists and backup posture are precisely what
 *   a stolen capability would enumerate before attempting a spend, and
 *   core.wallet.address.export-key is key export outright. */
REMOTE_COMMAND_CLASS("core.wallet.security.status", REMOTE_CLASS_NEVER, "")
REMOTE_COMMAND_CLASS("core.wallet.security.encrypt", REMOTE_CLASS_NEVER, "")
REMOTE_COMMAND_CLASS("core.wallet.security.unlock", REMOTE_CLASS_NEVER, "")
REMOTE_COMMAND_CLASS("core.wallet.security.lock", REMOTE_CLASS_NEVER, "")
