/* METAVERSE — 23 never_remote leaves.
 *
 * Simulation-only economics — AGENTS.md priority P4, explicitly "no live ZC23
 * token economics today". Nothing here answers an operational question about a
 * machine, and several leaves move simulated value. A surface that is not yet
 * real is the worst thing to grant remote authority over, because there is no
 * operational experience to say what a wrong call costs. */
REMOTE_COMMAND_CLASS("metaverse.agent.status", REMOTE_CLASS_NEVER, "")
