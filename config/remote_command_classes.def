/* DEV — 43 never_remote leaves (dev.hotswap.probe and dev.hotswap.apply are
 * owner_capability above; they are the only two).
 *
 * The dev branch drives a checkout. It compiles (ZCL_COMMAND_CAP_COMPILER),
 * executes processes (CAP_PROCESS_EXEC), runs tests (CAP_TEST_RUN), writes
 * source (CAP_CHECKOUT_WRITE), activates generations (CAP_DEV_ACTIVATE) and
 * reverts version control. A remote caller holding any one of those holds
 * arbitrary code execution on the box by construction — which is exactly the
 * unbounded authority the shell was rejected for.
 *
 * Its READS are refused too, and not out of excess caution: dev.test.run,
 * dev.test.sim, dev.verify-change and dev.agent.test are *_READ macros that
 * execute the dev toolchain against a working tree, and dev.ff, dev.drive
 * and dev.loop.* read and steer a live build loop. The remote path to another
 * node's source is source-by-hash (zcode.workspace.source.bundle.fetch),
 * which the target verifies itself.
 *
 * The two hot-swap leaves are the deliberate, individually-named exception,
 * argued at their rows above. */
REMOTE_COMMAND_CLASS("dev.status", REMOTE_CLASS_NEVER, "")
