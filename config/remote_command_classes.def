/* ZSES — 2 never_remote leaves.
 *
 * Session invites mint and accept the credential that lets another party act.
 * Minting an authority THROUGH the channel that authority would then be used on
 * is a bootstrap loop: the owner must create the first credential out of band,
 * at the machine, or the whole chain of trust closes on itself. */
REMOTE_COMMAND_CLASS("zses.invite.create", REMOTE_CLASS_NEVER, "")
REMOTE_COMMAND_CLASS("zses.invite.accept", REMOTE_CLASS_NEVER, "")

/* AGENT-CONTRACT METHODS — 8 never_remote.
 *
 * The remaining flat methods from
 * app/controllers/include/controllers/agent_contracts.def.
 *
 * dbquery is arbitrary SQL against the node database and dumpstate is arbitrary
 * subsystem introspection. Both are general-purpose primitives whose blast
 * radius is decided by the caller's string rather than by this table — which is
 * precisely the property that disqualified a shell, and it is not improved by
 * arriving over a typed frame.
 *
 * agentbuild, agenttest, agentcopyprove, agentimpact, proofbundle and refold
 * compile, execute or re-derive state on the target. */
REMOTE_COMMAND_CLASS("agentbuild", REMOTE_CLASS_NEVER, "")
