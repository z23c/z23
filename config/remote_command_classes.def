/* APP — 93 never_remote leaves.
 *
 * The app layer is accounts, authentication, names, tokens, messaging,
 * markets, storefronts, shops and atomic swaps. Every leaf here either moves
 * value, changes who may act as this node, or publishes on this node's behalf.
 *
 * The reads are not exempt and that is the interesting half.
 * app.market.purchase.status and app.messaging.inbox return the operator's own
 * private commerce and correspondence; app.account.list and app.account.show
 * enumerate the principals a later capability could target; app.auth.challenge
 * and app.auth.verify are the authentication surface itself, and a channel
 * that let a caller drive another node's authentication would be lending it
 * this node's voice. app.presentation.* renders for a human sitting at the
 * machine and has no remote meaning at all. */
REMOTE_COMMAND_CLASS("app.auth.challenge", REMOTE_CLASS_NEVER, "")
REMOTE_COMMAND_CLASS("app.auth.verify", REMOTE_CLASS_NEVER, "")
