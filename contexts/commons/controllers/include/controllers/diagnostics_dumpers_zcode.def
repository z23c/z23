/* Per-domain dumpstate subsystem descriptors: ZCODE package store and related VCS-hosting state
 *
 * Split from diagnostics_dumpers.def (see that file's aggregator
 * comment for the shared #include contract). Data-only: no macro
 * definitions or include guards belong in this file. */

    DIAG_ENTRY("zcode_store", vcs_package_store_dump_state_json,
               "ZCODE package store (local, -packagehost): quota pool "
               "budgets/usage for pins/hot/rare/staging, tracked packages, "
               "CAS chunk count, evictions_total, gc_orphans_total, "
               "quota_rejects_total, releases_total (persisted release "
               "envelopes on disk), last_release_accept/last_release_id "
               "(slice 3 publication outcome, in-memory); enabled=false "
               "when hosting is off",
               "runtime", "runtime", "contexts/commons/modules/vcs/src/package_store.c",
               "in_process_snapshot", "cheap",
               "64-hex package root, or empty for store-wide totals",
               "9f91360a486a1291533cad369861c371d4b5bc0682748ee768755c730f574eba",
               NULL,
               "tests/harness/src/test_zcode_store.c", false),

    DIAG_RUNTIME("zcode_work", vcs_zcode_work_node_dump_state_json,
               "bounded local package-work capacity: enabled, total slots, "
               "active slots, available slots, and up to 8 fresh verified "
               "peer capabilities with explicit truncation; signer keys are "
               "fingerprinted and no request, signature, or key data leaves "
               "the process",
               "contexts/commons/modules/vcs/src/zcode_work_node.c",
               "tests/harness/src/test_zcode_dev_objects.c"),

    DIAG_ENTRY("zcode_dht", boot_zcode_dht_dump_state_json,
               "Noise-bound read-only ZCODE DHT: enablement reason, stable "
               "local node ID, fixed bounds, authenticated/cold contact "
               "counts, query and probe counts, frame accept/reject counters, "
               "persistence state, and bounded last error; never exposes key "
               "material, delegation documents, or peer addresses",
               "runtime", "runtime", "engine/composition/src/boot_zcode_dht.c",
               "in_process_snapshot", "cheap", "empty or status", NULL,
               NULL, "tests/harness/src/test_zcode_dht_service.c", false),

    DIAG_ENTRY("zcode_swarm", vcs_package_swarm_status_dump_state_json,
               "ZCODE package swarm engine: whether the node-global engine "
               "is present, peer count, active download count, and bounded "
               "per-peer served/fetched bytes; enabled=false and present="
               "false when hosting is off; never exposes keys, wallet "
               "material, or datadir paths",
               "runtime", "runtime", "contexts/commons/modules/vcs/src/package_swarm_status.c",
               "in_process_snapshot", "cheap", NULL, NULL, NULL,
               "tests/harness/src/test_zcode_store.c", false),

    DIAG_ENTRY("zcode_swarm_receipts",
               boot_zcode_swarm_receipt_dump_state_json,
               "ZCODE package swarm dual-signed receipts: whether the "
               "receipt session is armed, a short local pubkey prefix, "
               "settled peer count, and bounded per-peer settled/"
               "have_remote flags; enabled=false and present=false when "
               "hosting is off or identity is unavailable; never exposes "
               "secrets, wallet material, or datadir paths",
               "runtime", "runtime",
               "engine/composition/src/boot_zcode_swarm_receipt.c",
               "in_process_snapshot", "cheap", NULL, NULL, NULL,
               "tests/harness/src/test_zcode_store.c", false),
