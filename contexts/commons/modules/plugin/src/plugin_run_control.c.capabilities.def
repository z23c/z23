ZCL_MODULE_CAPABILITY("contexts/commons/modules/plugin/src/plugin_run_control.c", CAP_FS_WRITE|CAP_NETWORK, "reads host-call frames from and writes replies to the confined plugin's inherited control socket; closing that descriptor on a framing violation is the descriptor-write reach")
