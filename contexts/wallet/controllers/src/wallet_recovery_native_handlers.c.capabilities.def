ZCL_MODULE_CAPABILITY("contexts/wallet/controllers/src/wallet_recovery_native_handlers.c", CAP_FS_READ|CAP_FS_WRITE|CAP_PRIVILEGE, "standard output is moved to standard error (dup, dup2, close, fflush) so it holds only the reply; core dumps are disabled (setrlimit, prctl) so the phrase cannot reach a core file")
