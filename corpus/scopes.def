scope zclassic23/examples | kind human | spdx Apache-2.0 | src examples/
scope zclassic23/ports | kind human | spdx Apache-2.0 | src ports/
scope zclassic23/src | kind human | spdx Apache-2.0 | src src/
scope zclassic23/tests-fixtures | kind human | spdx Apache-2.0 | src tests/
scope zclassic23/tools | kind human | spdx Apache-2.0 | src tools/

# ── shared test suite (lib/test remainder after per-lib claims) ─────
scope zclassic23/lib-test-shared | kind human | spdx Apache-2.0 | tests lib/test/

# ── libraries ───────────────────────────────────────────────────────
