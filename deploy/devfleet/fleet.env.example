# Mesh identity + reachability for tools/dev/fleet-identity.sh.
#
# Copy to ~/.config/zclassic23-fleetsync/fleet.env, mode 0600, and edit.
# NEVER committed. Only this .example template is tracked.
#
# `tools/dev/fleet-identity.sh init` writes this file for you with a fresh
# random salt; write it by hand only if you know why.

# Salt applied to every stored identity value, on your own machine, so a pin
# file cannot be matched against internet scan data to locate a box. Rotating
# it renames every box and invalidates every pin you hold.
ZCL_FLEET_ID_SALT=<64 hex characters>

# One ssh destination per box label, uppercased, '-' becoming '_'. A box with
# no entry here is assumed to be the machine you are running the tool on.
# ZCL_FLEET_<LABEL>_ADDR=<ssh destination>
