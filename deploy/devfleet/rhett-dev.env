BOX=rhett-dev
DEVFLEET_DATADIR=/home/rhett/.zclassic-c23-devfleet
DEVFLEET_PORT=8055
DEVFLEET_RPCPORT=18255
DEVFLEET_FLAGS="-operator-lane=test -listen -tor -onion-persist -txindex -showmetrics=0"
PROD_UNIT=zclassic23.service
PROD_BIN=/home/rhett/.local/bin/zclassic23-live
# Owner-authorized automatic production update. Restarting production resets
# any running soak clock; flip to manual to stage builds without restarting.
RESTART_PROD=auto
PUSH_HEARTBEAT_SECONDS=1800
