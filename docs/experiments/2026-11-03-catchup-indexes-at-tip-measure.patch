+/* Measurement harness for docs/experiments/2026-11-03-catchup-indexes-at-tip.md:
+ * catch-up pass rate in turbo mode and with node.db's indexes kept. */
+enum { NB_BLOCKS = 60000, NB_TXS = 8, NB_OUTS = 4 };
+
+static void nb_p2pkh(struct script *s, uint32_t tag)
+{
+    s->size = 25;
+    s->data[0] = 0x76;
+    s->data[1] = 0xa9;
+    s->data[2] = 0x14;
+    memset(s->data + 3, 0x5a, 20);
+    memcpy(s->data + 3, &tag, sizeof(tag));
+    s->data[23] = 0x88;
+    s->data[24] = 0xac;
+}
+
+static bool nb_make_block(struct block *b, int h, const struct uint256 *prev,
+                          struct uint256 *carry)
+{
+    block_init(b);
+    b->header.nVersion = 4;
+    b->header.nTime = 1700000000u + (uint32_t)h;
+    b->header.nBits = 0x2000ffffu;
+    b->header.hashPrevBlock = *prev;
+    b->vtx = calloc(NB_TXS, sizeof(struct transaction)); // raw-alloc-ok:bench
+    if (!b->vtx)
+        return false;
+    b->num_vtx = NB_TXS;
+    for (int t = 0; t < NB_TXS; t++) {
+        struct transaction *tx = &b->vtx[t];
+        transaction_init(tx);
+        if (!transaction_alloc(tx, 1, NB_OUTS))
+            return false;
+        tx->vin[0].sequence = 0xffffffffu;
+        if (t == 0) {
+            tx->vin[0].script_sig.size = 4;
+            memcpy(tx->vin[0].script_sig.data, &h, 4);
+        } else {
+            tx->vin[0].prevout.hash = *carry;
+            tx->vin[0].prevout.n = 0;
+        }
+        for (int o = 0; o < NB_OUTS; o++) {
+            tx->vout[o].value = 1000 + o;
+            nb_p2pkh(&tx->vout[o].script_pub_key,
+                     (uint32_t)((h * NB_TXS + t) * NB_OUTS + o));
+        }
+        transaction_compute_hash(tx);
+        *carry = tx->hash;
+    }
+    b->header.hashMerkleRoot = b->vtx[0].hash;
+    return true;
+}
+
+struct nb_chain {
+    struct uint256 *hashes;
+    struct block_index *slots;
+    struct active_chain ac;
+};
+
+static bool nb_build_chain(struct nb_chain *c, const char *dir)
+{
+    char blocks[512];
+    snprintf(blocks, sizeof(blocks), "%s/blocks", dir);
+    mkdir(blocks, 0755);
+    unsigned char msg_start[4] = {0x24, 0xe9, 0x27, 0x64};
+    c->hashes = calloc(NB_BLOCKS + 1, sizeof(*c->hashes)); // raw-alloc-ok:bench
+    c->slots = calloc(NB_BLOCKS + 1, sizeof(*c->slots)); // raw-alloc-ok:bench
+    if (!c->hashes || !c->slots)
+        return false;
+    active_chain_init(&c->ac);
+    struct uint256 prev = {.data = {0x01}}, carry = {0};
+    for (int h = 1; h <= NB_BLOCKS; h++) {
+        struct block b;
+        struct disk_block_pos pos;
+        disk_block_pos_init(&pos);
+        bool ok = nb_make_block(&b, h, &prev, &carry) &&
+                  write_block_to_disk(&b, &pos, dir, msg_start);
+        if (ok)
+            block_get_hash(&b, &c->hashes[h]);
+        block_free(&b);
+        if (!ok)
+            return false;
+        prev = c->hashes[h];
+        c->slots[h].nHeight = h;
+        c->slots[h].nStatus = BLOCK_HAVE_DATA;
+        c->slots[h].nFile = pos.nFile;
+        c->slots[h].nDataPos = pos.nPos;
+        c->slots[h].phashBlock = &c->hashes[h];
+        if (!active_chain_install_tip_slot(&c->ac, &c->slots[h]))
+            return false;
+    }
+    return true;
+}
+
+static void nb_time_walk(const char *label, const char *db_root, int walk,
+                         struct node_db *ndb, struct nb_chain *c,
+                         const char *dir)
+{
+    int64_t t0 = platform_time_monotonic_ms();
+    int res = node_db_catchup_service_run(ndb, &c->ac, NULL, dir);
+    int64_t ms = platform_time_monotonic_ms() - t0;
+    printf("catchup-bench: db=%s mode=%s walk=%d blocks=%d ms=%lld "
+           "blk_per_s=%.0f indexes=%d\n", db_root, label, walk, res,
+           (long long)ms, ms > 0 ? res * 1000.0 / (double)ms : 0.0,
+           ndc_secondary_index_count(ndb));
+    fflush(stdout);
+}
+
+static void nb_run_mode(const char *label, struct nb_chain *c,
+                        const char *dir, const char *db_root,
+                        struct main_state *ms)
+{
+    char db_dir[600], path[700];
+    snprintf(db_dir, sizeof(db_dir), "%s/db-%s", db_root, label);
+    mkdir(db_dir, 0700);
+    snprintf(path, sizeof(path), "%s/node.db", db_dir);
+    struct node_db ndb;
+    if (!node_db_open(&ndb, path))
+        return;
+    struct app_runtime_context rt = {.main_state = ms};
+    app_runtime_set_current(ms ? &rt : NULL);
+    node_db_catchup_lock_guard_test_reset();
+    nb_time_walk(label, db_root, 1, &ndb, c, dir);
+    (void)node_db_state_delete(&ndb, "sync_projection_tip_height");
+    nb_time_walk(label, db_root, 2, &ndb, c, dir);
+    app_runtime_set_current(NULL);
+    node_db_close(&ndb);
+}
+
+/* NDC_BENCH_DIR holds the generated block files; the node.db for each mode
+ * goes under NDC_BENCH_DIR and, when set, under NDC_BENCH_DB_DIR too. */
+static void ndc_bench_catchup_modes(void)
+{
+    const char *dir = getenv("NDC_BENCH_DIR");
+    const char *disk = getenv("NDC_BENCH_DB_DIR");
+    if (!dir)
+        return;
+    struct nb_chain c = {0};
+    int64_t t0 = platform_time_monotonic_ms();
+    bool built = nb_build_chain(&c, dir);
+    printf("catchup-bench: built=%d blocks=%d txs=%d outs=%d ms=%lld\n",
+           built, NB_BLOCKS, NB_TXS, NB_OUTS,
+           (long long)(platform_time_monotonic_ms() - t0));
+    struct main_state at_tip;
+    struct block_index tip;
+    bool tipped = ndc_at_tip_main_state(&at_tip, &tip);
+    const char *roots[2] = {dir, disk};
+    for (int r = 0; built && tipped && r < 2; r++) {
+        if (!roots[r])
+            continue;
+        nb_run_mode("turbo", &c, dir, roots[r], NULL);
+        nb_run_mode("indexes-kept", &c, dir, roots[r], &at_tip);
+    }
+    main_state_free(&at_tip);
+    active_chain_free(&c.ac);
+    free(c.slots);
+    free(c.hashes);
+}
