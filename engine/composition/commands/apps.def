    ZCL_COMMAND_AUTH_PUBLIC, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_APP_MANIFEST_READ,
    ZCL_COMMAND_TRAIT_DETERMINISTIC | ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_app_inspect)

ZCL_COMMAND_COMPAT_READ(
    "app.protocols", "app", "appprotocols", "List App protocol contracts",
    "The wire and event protocol contracts each installed App declares, read "
    "from the node; enumerates every registered App protocol at call time.",
    ZCL_COMMAND_LIST_BUDGET,
    "protocols,events,p2p,wire", "zcl.command.empty_input.v1",
    "zcl.app_protocols.v1", "", "", "z23 app protocols",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_PUBLIC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_ALL_NODE, ZCL_COMMAND_CAP_CHAIN_READ,
    ZCL_COMMAND_TRANSPORT_NATIVE | ZCL_COMMAND_TRANSPORT_RPC,
    "z23 appprotocols")

/* Semantic chain-transaction discovery.  This is deliberately separate from
 * core.wallet.transaction.list, which lists one wallet's transaction history. */
ZCL_COMMAND_BRANCH("app.transaction-types", "app",
                   "Discover every semantic ZCL transaction shape and its safe workflow",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_READ(
    "app.transaction-types.list", "app.transaction-types", "",
    "List base, overlay, composite, process-only, contained, and planned transaction types",
    "The compile-time semantic transaction catalog: exact builder/commit/inspect "
    "commands, chain encoding, privacy, network policy, current proof level, "
    "and transaction-lab case for every known Z23 transaction shape. "
    "Discovery only; this leaf grants no wallet or broadcast authority.",
    ZCL_COMMAND_EXTENDED_LIST_BUDGET,
    "transactions,catalog,zcl,znam,zslp,zcode,sapling,htlc",
    "zcl.command.empty_input.v1", "zcl.transaction_types.index.v2", "", "",
    "z23 app transaction-types list",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_PUBLIC, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_TINY, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_APP_MANIFEST_READ,
    ZCL_COMMAND_TRAIT_DETERMINISTIC | ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_transaction_types_list)

ZCL_COMMAND_READY_READ(
    "app.transaction-types.show", "app.transaction-types", "",
    "Inspect one semantic ZCL transaction type and its safe workflow",
    "One exact catalog entry selected by type: its availability, chain encoding, "
    "builder/commit/inspect commands, component commands, network containment, "
    "proof level, and focused test group. Discovery only; it cannot spend.", 0,
    "transactions,catalog,type,workflow", "zcl.transaction_type_ref.input.v1",
    "zcl.transaction_type.v2", "type", "type",
    "z23 app transaction-types show --type=znam_register",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_PUBLIC, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_TINY, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_APP_MANIFEST_READ,
    ZCL_COMMAND_TRAIT_DETERMINISTIC | ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_transaction_type_show)

ZCL_COMMAND_READY_READ(
    "app.transaction-types.guide", "app.transaction-types", "",
    "Get one AI-ready transaction workflow with exact command contracts",
    "Joins one semantic transaction type to the live native command registry. "
    "Returns role-labeled builder, commit, component, and inspection contracts "
    "with exact schemas, allowed keys, examples, risk, authority, confirmation "
    "mode, and a fail-closed execution decision. Discovery only; it cannot "
    "create a plan, authorize a wallet, sign, or broadcast.",
    ZCL_COMMAND_EXTENDED_LIST_BUDGET,
    "transactions,catalog,type,workflow,ai,schema,plan,commit",
    "zcl.transaction_type_ref.input.v1", "zcl.transaction_type_guide.v1",
    "type", "type",
    "z23 app transaction-types guide --type=znam_register",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_PUBLIC, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_TINY, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_APP_MANIFEST_READ,
    ZCL_COMMAND_TRAIT_DETERMINISTIC | ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_transaction_type_guide)

ZCL_COMMAND_READY_READ(
    "app.transaction-types.command", "app.transaction-types", "",
    "Reverse-map one native command to every transaction workflow it can serve",
    "Joins one exact native command leaf to every semantic transaction type "
    "that names it as builder, plan, commit, alternate route, component, or "
    "inspection. An unmapped leaf is explicitly unclassified and is never "
    "claimed to be off-chain merely because the catalog lacks a row. Returns "
    "only registry and compile-time catalog facts; it grants no wallet or "
    "broadcast authority.",
    ZCL_COMMAND_LIST_BUDGET,
    "transactions,catalog,command,reverse,workflow,ai,audit",
    "zcl.transaction_command_ref.input.v1", "zcl.transaction_command.v1",
    "path", "path",
    "z23 app transaction-types command core.wallet.transaction.send",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_PUBLIC, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_TINY, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_APP_MANIFEST_READ,
    ZCL_COMMAND_TRAIT_DETERMINISTIC | ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_transaction_command)

ZCL_COMMAND_READY_READ(
    "app.transaction-types.wire", "app.transaction-types", "",
    "List every consensus transaction wire era and script-processing bucket",
    "The finite source-derived wire catalog: legacy v1/v2, Overwinter v3, "
    "Sapling v4, their shielded proof/component gates, all standard output "
    "script classes plus the nonstandard consensus bucket, and the generic "
    "opaque-memo/unknown-OP_RETURN paths. This complements semantic workflows "
    "without pretending arbitrary scripts or future application tags are a "
    "finite list. Discovery only; it cannot construct or broadcast.",
    ZCL_COMMAND_LIST_BUDGET,
    "transactions,wire,version,overwinter,sapling,sprout,script,op_return",
    "zcl.command.empty_input.v1", "zcl.transaction_wire_catalog.v1", "", "",
    "z23 app transaction-types wire",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_PUBLIC, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_TINY, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_APP_MANIFEST_READ,
    ZCL_COMMAND_TRAIT_DETERMINISTIC | ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_transaction_wire_catalog)

ZCL_COMMAND_READY_READ(
    "app.transaction-types.micro-lab", "app.transaction-types", "",
    "Inspect the checked 100-transaction micro-lab campaign or one numbered slot",
    "The compile-time mainnet-micro-100-v1 plan: 100 exact 1,000-zatoshi "
