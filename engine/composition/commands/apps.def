ZCL_COMMAND_READY_COMMAND(
    "app.open", "app", "", "Open app",
    "Opens a desktop app or game by name or alias, e.g. skycombat, sky or "
    "airplane for the Sky Combat airplane game (see app list). Requires a "
    "desktop session, then either reports the verified running copy "
    "(already_open: a pid whose executable and start time match; raise is "
    "delivered by SIGUSR1 only to an app that declares raise support, else "
    "unsupported_by_app) or spawns the "
    "program with no shell, detached, logging to ~/.local/state/z23/apps, "
    "and waits up to 15 s for its ready marker (opened: pid, ready_ms, "
    "executable, sha256, log). A refusal names its stage: unknown_app, "
    "not_installed, no_desktop, config_refused, spawn_failed, exited_early "
    "(exit code and log tail) or not_ready (still running, pid given). "
    "Launch arguments come only from this binary and the operator's apps.tsv. "
    "With copy, opens an explicitly saved version using its app.build "
    "env_root, dependency_root, image_sha3 and record_id. Requires "
    "accept_execution:true and an adopted or trusted received copy. "
    "Verifies the saved tree and exact built image without changing newer edits. "
    "Name-only open uses the kept selection when one exists and revalidates it.",
    0, "apps,launch,open,play,desktop,window,game,games,skycombat,"
    "sky-combat,airplane",
    "zcl.app_open.input.v1", "zcl.app_open.v1",
    "name,copy,version,datadir,env_root,dependency_root,image_sha3,record_id,accept_execution", "name",
    "z23 app open skycombat",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_PUBLIC, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_MAINTENANCE, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_PROCESS_EXEC, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_app_open)

