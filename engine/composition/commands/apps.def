ZCL_COMMAND_BRANCH("app.invoke", "app", "Invoke a manifest-owned App route",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_COMMAND(
    "app.tasks", "app", "", "Save and reopen your local tasks",
    "Lists, adds, edits, completes, reopens, deletes or undoes task contents in "
    "an isolated private app database. Omit datadir to use private per-user app storage; "
    "an explicit datadir opens your existing task data. Headless changes require expected_revision "
    "from the last read; stale writes refuse. Actions open and new show a native "
    "task editor with background saving; open shows the task list or selects task_id. "
    "Closing saves the latest valid draft and a failed save keeps it open. "
    "Saved is returned only after durable "
    "commit. Undo survives closing and reopening. Program selection never "
    "replaces user task data. Optional preview_root, preview_receipt and preview_program "
    "select an installed program; the native Updates panel asks permission before confined "
    "execution. Keep checks current data, and Go back tests the previous program against "
    "current tasks and undo. Previously kept programs may render current task copies.", 0,
    "tasks,edit,save,undo", "zcl.task_document.input.v1", "zcl.task_document.v1",
    "datadir,app,action,expected_revision,task_id,title,preview_root,preview_receipt,preview_program", "action,datadir",
    "z23 app tasks open",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_BACKGROUND, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_PROCESS_EXEC, 0, zcl_native_handle_task_document)

ZCL_COMMAND_READY_COMMAND(
    "app.invoke.package", "app.invoke", "", "Run an explicitly accepted installed resident app",
    "Binds an exact installed package receipt and artifact digest to a private "
    "launch snapshot, calls resident_launch, requires nonce-bound READY and one "
    "bounded text result over fd3, then cancels and reaps the child. Building "
    "or installing never grants execution: accept_execution must be JSON "
    "boolean true for these exact bytes; strings, numbers, false and omission "
    "grant no execution. For a named app, action=accept proves and saves a "
    "pending candidate without changing the serving version; action=activate "
    "reproves and atomically selects it. action=invoke uses the exact current "
    "selection and action=rollback reproves its exact prior receipt, artifact "
    "and configuration. Nonce, start_token and generation jointly bind stale "
    "result preconditions. The legacy unnamed operation interface remains "
    "isolated. expected_generation refuses stale "
    "requests. This does not grant wallet, node or deployment authority. "
    "Hostile same-UID file writers are outside "
    "the MVP snapshot authority boundary. No native-window claim is made.", 0,
    "package,resident,execute,accepted,application", "zcl.package_resident.input.v1",
    "zcl.package_resident.v1",
    "datadir,app,action,package_root,receipt_id,artifact_sha3,program,input_text,accept_execution,operation,configuration_generation,expected_generation,nonce,start_token,generation", "",
    "z23 app invoke package --input=-",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_BACKGROUND, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_PROCESS_EXEC, 0, zcl_native_handle_package_resident)
/* Building a copy only produces bytes; open and playtest still need
 * accept_execution for the exact image_sha3. So an agent may plan and
 * confirm it (AUTH_OPERATOR, plan first), on an adopted copy or a received
 * copy the owner confirmed once at bundle receive. */
ZCL_COMMAND_READY_COMMAND(
    "app.build", "app", "", "Build your app copy into an image",
    "copy is an adopted copy (a name under <datadir>/copies or its absolute "
    "directory) or a received copy whose publisher and root the owner "
    "confirmed at zcode package bundle receive; anything else is "
    "NOT_ADOPTED. The copy's Makefile prints its inputs with "
    "print-app-closure and builds $(APP_OUT)/app with -MD. Without confirm, "
    "refuses unsaved changes and returns package_root, closure_root, "
    "env_root (toolchain capsule), dependency_root (from zcode-package.json; "
    "a different dependency_root input is DEPENDENCY_MISMATCH), cache_hit "
    "and a plan_id; it writes nothing. With that plan_id and confirm:true, "
    "a cache hit returns the existing record and runs no make; otherwise "
    "make runs out of tree under lab_exec confinement where the host can "
    "(the reply says unconfined where not), and the image is stored under "
    "<datadir>/app_build/images/<image_sha3> with a zcl.app_build.v1 record. "
    "Refusals: BUILD_FAILED with a log tail, CLOSURE_DRIFT, UNSAVED_CHANGES. "
    "Nothing is executed but the build.",
    ZCL_COMMAND_LIST_BUDGET,
    "app,build,copy,image,compile,make,remix,game,cache",
    "zcl.app_build.input.v1", "zcl.app_build.v1",
    "copy,datadir,dependency_root,plan_id,confirm", "copy",
    "z23 app build --input='{\"copy\":\"skycombat-1\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_BACKGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_PROCESS_EXEC, 0, zcl_native_handle_app_build)

/* The front door's composites (tools/command/native_app_front_door.h). copy,
 * share and receive run owner leaves (adopt, app.seed, bundle sign, bundle
 * receive) as inner calls, which skip MCP policy, so they are AUTH_OWNER
 * themselves: MCP refuses them. save is the operator's version save by copy
 * name, which an agent may also run plan-first. */
ZCL_COMMAND_READY_COMMAND(
    "app.copy", "app", "", "Make your own copy of an app",
    "Owner only. app is a name such as skycombat. Uses the release of that "
    "app already in the datadir (the parentless one, newest sequence), or "
    "seeds one first through the app.seed leaf; without app.seed it refuses "
    "SEED_UNAVAILABLE. Then adopts it as <datadir>/copies/<app>-<n>. Without "
    "confirm, runs only the plan halves and returns the copy name and a "
    "plan_id; it writes nothing. With that plan_id and confirm:true, seeds "
    "if needed and adopts. Nothing is built or executed.",
    ZCL_COMMAND_RESULT_BUDGET,
    "app,copy,remix,adopt,seed,game,skycombat,keep",
    "zcl.app_copy.input.v1", "zcl.app_copy.v1",
    "app,datadir,plan_id,confirm", "app",
    "z23 app copy skycombat",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_NONE, 0, zcl_native_handle_app_copy)

ZCL_COMMAND_READY_COMMAND(
    "app.save", "app", "", "Save your copy's edits",
    "copy is a name under <datadir>/copies (or its absolute directory). "
    "Runs zcode.package.version.save on it: without confirm, lists the "
    "changed paths and returns a plan_id; with that plan_id and "
    "confirm:true, takes one append-only snapshot. Nothing is built.",
    ZCL_COMMAND_RESULT_BUDGET,
    "app,save,copy,version,snapshot,edit",
    "zcl.app_save.input.v1", "zcl.zcode_package_version_save.v1",
    "copy,datadir,plan_id,confirm", "copy",
    "z23 app save skycombat-1",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_NONE, 0, zcl_native_handle_app_save)

ZCL_COMMAND_READY_COMMAND(
    "app.share", "app", "", "Share your copy as one file",
    "Owner only. Saves the copy if it has unsaved edits, then signs it with "
    "the owner's key (zcode.package.bundle.sign) and writes NAME.z23share "
    "(output, default in the current directory) with one share line and a "
    "short publisher fingerprint; the full one is in publisher_fingerprint. "
    "Without confirm, runs only the plan halves and writes nothing, not "
    "even a first key. With that plan_id and confirm:true, saves and signs.",
    ZCL_COMMAND_RESULT_BUDGET,
    "app,share,copy,friend,file,z23share,sign,fingerprint",
    "zcl.app_share.input.v1", "zcl.app_share.v1",
    "copy,datadir,output,day,plan_id,confirm", "copy",
    "z23 app share skycombat-1",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_NONE, 0, zcl_native_handle_app_share)

ZCL_COMMAND_READY_COMMAND(
    "app.receive", "app", "", "Open a friend's shared copy",
    "Owner only; `z23 app open FILE.z23share` runs it. Verifies the file "
    "(zcode.package.bundle.verify) and, without confirm, returns its name, "
    "version, parent and short publisher fingerprint and a plan_id; it "
    "writes nothing. With that plan_id and confirm:true, receives it as "
    "<datadir>/copies/<name>-<n> trusting exactly the verified file's "
    "publisher and root, builds it with app.build and opens that image "
    "with app.run.copy. A file that does not verify keeps nothing.",
    ZCL_COMMAND_RESULT_BUDGET,
    "app,receive,open,friend,file,z23share,trust,fingerprint",
    "zcl.app_receive.input.v1", "zcl.app_receive.v1",
    "file,datadir,day,plan_id,confirm", "file",
    "z23 app open skycombat-1.z23share",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_BACKGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_PROCESS_EXEC, 0, zcl_native_handle_app_receive)

/* AUTH_OWNER: the owner's publisher key signs the seed release, so MCP
 * refuses it at plan and at confirm. */
ZCL_COMMAND_READY_COMMAND(
    "app.seed", "app", "", "Seed an in-repo app as your own package release",
    "app names a directory under apps/ of the z23 checkout (source, default "
    "the checkout this runs in). The package tree is apps/<app> plus every "
    "checkout file apps/<app>/zcode-seed.def maps (one '<repo path> <tree "
    "path>' per line; '..', absolute and symlinked paths refused) and "
    "apps/<app>/app.mk as its Makefile, so a copy builds with app build "
    "alone. Without confirm, returns package_root, release_id, file_count "
    "and a plan_id. With that plan_id and confirm:true, signs with "
    "~/.z23/zcode_publisher.key (made 0600 on first use) and publishes "
    "through zcode.package.publish.commit. When this owner already holds a "
    "release of the same package root, it is returned with existing:true "
    "and nothing is written. Nothing is built or executed.",
    ZCL_COMMAND_LIST_BUDGET,
    "app,seed,package,release,publish,copy,remix,game,source",
    "zcl.app_seed.input.v1", "zcl.app_seed.v1",
    "app,source,datadir,day,plan_id,confirm", "app",
    "z23 app seed --input='{\"app\":\"skycombat\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_app_seed)

ZCL_COMMAND_BRANCH("app.run", "app", "Run accepted installed binaries",
                   ZCL_COMMAND_LAYER_APP)

/* The copy open (`z23 app open skycombat-1` at the CLI). A separate
 * OPERATOR leaf, never a branch of the PUBLIC app.open: a guest-ceiling
 * session must not reach an unsandboxed user build. An agent may plan and
 * confirm it for an adopted copy (the preview loop); the image it runs is
 * the build record's, accepted by its exact hash. */
ZCL_COMMAND_READY_COMMAND(
    "app.run.copy", "app.run", "", "Open your built app copy",
    "copy is an adopted copy, or a received one the owner trusted, under "
    "<datadir>/copies. Without confirm, finds the build record of its saved "
    "tree and returns image_sha3 and a plan_id. Refusals: NOT_ADOPTED; "
    "NOT_BUILT (never built); STALE_BUILD (unsaved edits, or a saved "
    "version or toolchain not built yet). With that plan_id, confirm:true, "
    "accept_execution:true and that exact image_sha3 (else "
    "IMAGE_HASH_MISMATCH, also for changed image bytes), spawns exactly "
    "that image through resident_launch (fexecve of the pinned inode, new "
    "session, output to ~/.local/state/z23/apps/<copy>.log) and reports "
    "pid and proof once it is still running after the settle time.",
    0, "app,open,copy,run,play,game,image,preview",
    "zcl.app_run_copy.input.v1", "zcl.app_run_copy.v1",
    "copy,datadir,accept_execution,image_sha3,plan_id,confirm", "copy",
    "z23 app open skycombat-1",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_MAINTENANCE, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_PROCESS_EXEC, 0, zcl_native_handle_app_run_copy)


ZCL_COMMAND_READY_COMMAND(
    "app.run.confined", "app.run", "", "Run an accepted installed native binary to exit inside the OS sandbox",
    "Binds an exact installed package receipt and artifact digest to a private "
    "snapshot and executes that pinned inode with fexecve inside Landlock, "
    "seccomp (no network, ptrace, mount or namespace calls), no_new_privs and "
    "rlimits built from the supplied read_paths, write_paths and limits. Static "
    "PIE images only: no loader directory is granted and a PT_INTERP image is "
    "refused. Limits default to finite values (1 GiB address space, 60 CPU "
    "seconds, a 256-thread budget above the uid task count, 64 files, 64 MiB files); "
    "child processes and session detachment are denied; bounded threads are allowed. "
    "Unlike app.invoke.package the binary speaks no "
    "READY protocol: the leaf waits for exit (or kills the process group at "
    "timeout_ms) and reports the exit code or terminating signal. Where "
    "Landlock or seccomp is unavailable it refuses by name and never runs "
    "unconfined. accept_execution must be JSON boolean true. The environment "
    "is empty; paths must be absolute, existing and free of '..'.", 0,
    "package,resident,execute,confined,sandbox", "zcl.package_confined_run.input.v1",
    "zcl.package_confined_run.v1",
    "datadir,package_root,receipt_id,artifact_sha3,program,accept_execution,read_paths,write_paths,args,timeout_ms,as_bytes,cpu_seconds,nproc,fsize_bytes,nofile", "",
    "z23 app run confined --input=-",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_BACKGROUND, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_PROCESS_EXEC, 0, zcl_native_handle_confined_run)

/* Declared services (zcl.service_binding.v1). This branch is also the
 * namespace root every service's own leaves live under: a service named `x`
 * owns exactly `app.service.x` and `app.service.x.*`, which is why `list`,
 * `inspect`, `access`, and `status` are reserved service names. Adding a
 * service means appending to engine/composition/services/bindings.def and declaring its
 * leaves in a engine/composition/commands .def — `discover` and the generated API
 * reference then carry them with no further work. */
ZCL_COMMAND_BRANCH("app.service", "app",
                   "Token-gated services declared in the service catalog",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_READ(
    "app.service.list", "app.service", "",
    "List declared services and their catalog identity",
    "Every service declared by engine/composition/services/bindings.def with its command "
    "namespace, owned state prefix, host role, and the catalog's SHA3 root; a "
    "complete compile-time snapshot, static until the binary changes.",
    ZCL_COMMAND_LIST_BUDGET,
    "services,bindings,catalog,token", "zcl.command.empty_input.v1",
    "zcl.service_binding_index.v1", "", "", "z23 app service list",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_PUBLIC, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_TINY, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_APP_MANIFEST_READ,
    ZCL_COMMAND_TRAIT_DETERMINISTIC | ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_service_list)

ZCL_COMMAND_READY_READ(
    "app.service.inspect", "app.service", "",
    "Inspect one service binding: namespaces, token gate, isolation",
    "One declared service's full binding — command prefix, owned state table "
    "prefix, state schema, ZSLP token gate (genesis txid, threshold, snapshot "
    "rule), the enforced isolation flag set, and its SHA3 identity; complete "
    "for that service as compiled, with no node contact.", 0,
    "service,binding,gate,isolation,digest", "zcl.service_ref_input.v1",
    "zcl.service_binding.v1", "service", "service",
    "z23 app service inspect reference",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_PUBLIC, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_TINY, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_APP_MANIFEST_READ,
    ZCL_COMMAND_TRAIT_DETERMINISTIC | ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_service_inspect)

ZCL_COMMAND_READY_READ(
    "app.service.access", "app.service", "",
    "Evaluate one service's token gate and explain the verdict",
    "A granted/denied verdict for one service's ZSLP token gate, read from "
    "the debit-correct zslp_ledger at the binding's declared snapshot height "
    "(never from the credit-only zslp_balances): the verdict, the named "
    "reason, the snapshot height, the ledger's fold cursor, the balance, and "
    "the threshold. Reproducible — the same ledger and height always answer "
    "the same. Fails closed: an unreadable or under-folded ledger denies.", 0,
    "service,token,access,zslp,gate,snapshot", "zcl.service_access_input.v1",
    "zcl.service_access_verdict.v1", "service,address,datadir,tip_height",
    "service", "z23 app service access reference",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_PUBLIC, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_CHAIN_READ,
    ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_service_access)

ZCL_COMMAND_READY_READ(
    "app.service.status", "app.service", "",
    "Show each declared service's runtime lifecycle state",
    "Per-service lifecycle state (declared/starting/ready/degraded/blocked/"
    "stopping/exited), the blocker reason when blocked, and transition and "
    "fault counters, read from the in-process registry at call time; the "
    "registry is rebuilt from the compiled catalog each boot, so every "
    "service reads `declared` until something registers it.", 0,
    "service,lifecycle,state,blocker", "zcl.service_ref_input.v1",
    "zcl.service_lifecycle.v1", "service", "service",
    "z23 app service status",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_PUBLIC, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_TINY, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_APP_MANIFEST_READ,
    ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_service_status)
