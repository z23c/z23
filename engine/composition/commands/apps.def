ZCL_COMMAND_READY_READ(
    "app.customize", "app", "", "Source",
    "Verified immutable files anchored to the locally kept version. Optional "
    "source_version selects an authorized successor in that same copy. "
    "Pages and file reads pin selection revision; changed selection refuses. "
    "No source edits, build, execution or model invocation. File slices are "
    "UTF-8 or lossless base64: default 512 bytes, explicit limit 1..2048 bytes. "
    "The 1 MiB file bound and reply budget still apply; escaped content may "
    "require a smaller slice and is never truncated. "
    "query searches literal non-overlapping bytes in the pinned tree: UTF-8 "
    "1..64 bytes, expected_revision required, no path/limit. page and offset "
    "resume the manifest index and byte cursor. At most four files/4 MiB and "
    "two matches per call; snippets at most 96 bytes. complete is cursor end, "
    "not exhaustive coverage: files over 1 MiB are explicitly unsearched.",
    ZCL_COMMAND_LIST_BUDGET,
    "app,customize,source,change,kept,context,search", "zcl.app_customize.input.v1",
    "zcl.app_customize.v1", "name,change,expected_revision,source_version,path,offset,limit,page,query", "name",
    "z23 app customize skycombat",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_APP_MANIFEST_READ,
    ZCL_COMMAND_TRAIT_DETERMINISTIC | ZCL_COMMAND_TRAIT_IDEMPOTENT,
