/* ── the low-latency datagram link between two fleet boxes ────────────
 *
 * `fleet link probe` is the operator surface over engine/modules/gamelink:
 * it opens a real UDP session, pings it, and prints round-trip microseconds,
 * jitter and loss. It is a measurement tool, not a node service — the node
 * never calls it, it touches no datadir, and it shares no code and no socket
 * with block relay. See docs/node/GAMELINK.md. */

ZCL_COMMAND_BRANCH("fleet.link", "fleet", "Measure the datagram link to a peer",
                   ZCL_COMMAND_LAYER_OPS)

ZCL_COMMAND_READY_COMMAND(
    "fleet.link.probe", "fleet.link", "",
    "Round-trip time, jitter and loss over the UDP datagram link",
    "Opens an authenticated UDP datagram session, pings it for `seconds`, and "
    "reports round-trip microseconds, jitter, loss in parts per million, and "
    "every counter that says why a datagram did not arrive. mode is loopback, "
    "echo or probe. loopback is the default and needs nothing: it runs both "
    "ends inside this process over 127.0.0.1 with freshly drawn key material, "
    "which measures this box's own floor — the kernel's UDP path plus the "
    "per-packet crypto. echo holds a port open and answers pings so another "
    "box can measure the path; probe measures the path to a box running echo "
    "and needs its ip:port in peer. Both of those need the shared 32-byte key "
    "as 64 hex characters in key, because no pairing plumbing hands this leaf "
    "a live session's material yet. A probe that hears no pong FAILS rather "
    "than printing zeros, since an unreachable peer must never read as a fast "
    "one. It writes nothing and contacts no peer but the one named.", 0,
    "fleet,link,latency,rtt,jitter,loss,udp,game,probe",
    "zcl.fleet_link_probe.input.v1", "zcl.fleet_link_probe.v1",
    "mode,peer,bind,key,seconds", "",
    "z23 fleet link probe --seconds=2",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_DEV_MUTATION, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_MAINTENANCE, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_fleet_link_probe)

/* ── the thin remote-steering adapter ────────────────────────────────────
 *
 * One briefing call and one batch of instructions per steering cycle, over
 * the leaves that already exist: dev.agent.mail, dev.agent.queue,
 * fleet.board.list/show and fleet.ledger.status are called in-process with
 * the caller's context, so each of them still enforces its own
 * permissions. No new scheduler, ledger or workflow lives here. A `grant`
 * key names an adapter bearer minted by the owner (fleet.steer.grant);
 * without one the call is the local operator's own. */

ZCL_COMMAND_BRANCH("fleet.steer", "fleet",
                   "Brief, send and evidence for remote steering",
                   ZCL_COMMAND_LAYER_OPS)

ZCL_COMMAND_READY_READ(
    "fleet.steer.brief", "fleet.steer", "",
    "One-call fleet brief: tasks, workers, blockers, capacity, candidates",
    "Local tasks/workers/blockers/capacity/candidates/evidence/changes; "
    "no peer contact/waits. missing[]/ages identify unavailable sources. "
    "agents: mail/board names, not live workers. workers: newest16 "
    "plus workers_total/exact/truncated; receiver=/worker= evidence or "
    "local resident. Fields: name/host/source(local|mail)/self_reported/worksp"
    "ace_selector/workspace_head/current_ref/stage/last_seen_ts/age_s/tokens_la"
    "st_run/tokens_total/load1_centi/mem_avail_kib/disk_free_kib/resources_reaso"
    "n/state/reason. working: running queue or claimed nonterminal "
    "ref; blocked: refusal, unclaimable queue or failed intake; idle: "
    "evidence within alive_window_s=900 and no open work. Bare "
    "names/processes prove no work. Session freshness live|stale|UNKNOWN "
    "differs from activity active|completed|blocked|stale|UNKNOWN. "
    "sessions_active_reported: self-reports, not model turns. Unknown "
    "numbers null; capacity known/reason; tokens require receipts. "
    "Messages queued/delivered/acknowledged/completed; reply answered|"
    "acked|queued. Own outbox proves no delivery; recipient reply/ACK under "
    "ref required. Queued age>120s without receiver evidence blocks "
    "(newest8, rest counted). tasks: bounded local queue/landing attempts "
    "with identity/owner/dependency/proof/detail; no canonical joins. "
    "review/publication unknown; tasks_inventory_complete=false. "
    "tasks_sources_complete/tasks_shown/tasks_dropped report coverage. "
    "screen uses these states; json=true omits it. Token since: native "
    "stream-order prefixes: start 0|, resume returned cursor_token even when "
    "changes_truncated. Credit displayed changes after row/byte limits; "
    "omitted rows pending. Zero-fit pending pages refuse without "
    "advance; token pages omit screen. Integer since is lossy; integer cursor "
    "informational. changes_truncated/changes_dropped and budget_truncated "
    "report cuts. caller: grant mode/sender label or null+reason/scopes/"
    "expiry, never grant id; local operator: mode only. Read-only.", 65536,
    "fleet,steer,brief,steering,chatgpt,cursor,agents,blockers,capacity",
    "zcl.fleet_steer_brief.input.v1", "zcl.fleet_steer_brief.v1",
    "grant,since,limit,json", "",
    "z23 fleet steer brief",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_steer_brief)

ZCL_COMMAND_READY_COMMAND(
    "fleet.steer.send", "fleet.steer", "",
    "One bounded batch of directives to named fleet agents",
    "Posts 1..8 directives to named agents through dev.agent.mail. The "
    "sender is the presented grant's own label, so from must be stated and "
    "must match it: a from that disagrees is refused rather than rewritten, "
    "an unstated one is refused rather than defaulted, and the posted row "
    "carries the grant's binding so a receiver admits on the credential "
    "instead of on the name. Each item carries an "
    "idempotency_key, checked after the sender: a retry returns the "
    "recorded accept with "
    "duplicate:true and posts nothing, so retries reconcile the same "
    "request instead of duplicating work. Per-item states are queued or "
    "refused with the sibling's typed reason. An item addressed to another "
    "enrolled box travels as one signed fleet board note, so one whose "
    "mail row could exceed that note's 2048 bytes is refused "
    "STEER_REMOTE_BODY_TOO_LARGE before any mail is written. The batch "
    "fails outright "
    "only on bad batch input or a bad grant. Delivery, acknowledgement "
    "and completion are observed later through brief and evidence, never "
    "claimed here. It contacts no peer and never waits.", 65536,
    "fleet,steer,send,steering,chatgpt,directive,idempotent",
    "zcl.fleet_steer_send.input.v1", "zcl.fleet_steer_send.v1",
    "grant,items,from", "items",
    "z23 fleet steer send --items=[...]",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_DEV_MUTATION, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_WRITE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_fleet_steer_send)

ZCL_COMMAND_READY_READ(
    "fleet.steer.evidence", "fleet.steer", "",
    "One bounded evidence object by exact reference",
    "Returns one object by exact reference (type mail|queue|board|land, ref "
    "exact): queue accepts optional positive seq and attempt together to "
    "bind one attempt; land requires both with the exact tip as ref. "
    "Mail accepts stream,row_offset,seq,row_sha3 together for one exact retained JSONL line; ref-only mail remains latest-held. Ref-only queue behavior is unchanged. Otherwise returns the mail row "
