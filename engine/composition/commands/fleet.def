/* The owner's private fleet ledger. Consumer defines ZCL_COMMAND_*.
 *
 * Leaves under the existing `fleet` root (declared once, in
 * engine/composition/commands/fleet_board.def, alongside the fleet board and
 * wiki) rather than a root of its own: `fleet` already exists as a wire
 * contract, and a second ZCL_COMMAND_BRANCH row for the same path is a
 * path collision the registry refuses to build with.
 *
 * Every leaf here answers from local files. Nothing contacts a peer, and
 * nothing prints a row's contents anywhere a row could leave this machine.
 * See docs/FLEET_LEDGER.md. */

ZCL_COMMAND_BRANCH("fleet.ledger", "fleet", "Write and inspect the ledger",
                   ZCL_COMMAND_LAYER_OPS)

ZCL_COMMAND_READY_COMMAND( /* a writer */
    "fleet.ledger.add", "fleet.ledger", "",
    "Append one signed row to this box's own chain",
    "Appends one row to this machine's chain and returns its sequence "
    "number. kind is usage, task or vitals; subject is that kind's own "
    "closed vocabulary, so a vitals subject outside the declared catalog is "
    "refused. Measurements are passed as named pairs; a pair that is not "
    "passed is absent, which is a different fact from zero and is stored as "
    "one. note is a short label such as a task id. The row is signed by this "
    "node's delegated online key and carries its master key as the writer, "
    "both read from the datadir; a box with no filed delegation cannot "
    "write. It contacts no peer.", 0,
    "fleet,ledger,usage,tokens,vitals,append,record",
    "zcl.fleet_ledger_add.input.v1", "zcl.fleet_ledger_add.v1",
    "kind,subject,note,tokens_in,tokens_out,tokens_cached,tokens_reasoning,"
    "wall_ms,turns,tool_uses,cost_micro_usd,value,count,bytes,limit",
    "kind,subject",
    "z23 fleet ledger add --kind=usage --subject=grok --tokens_in=1200",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_DEV_MUTATION, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW, ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL, ZCL_COMMAND_CAP_DEV_STATE_READ,
    ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_fleet_ledger_add)

ZCL_COMMAND_READY_READ(
    "fleet.ledger.status", "fleet.ledger", "",
    "Per box: rows held, last sequence, and how stale the replica is",
    "Reports every chain this machine holds — its own and one replica per "
    "paired peer — with the rows held, the last sequence number, and the age "
    "of the newest row in seconds. A replica answers instantly and that is "
    "not the same as answering currently, so the age is always reported and "
    "never rounded away. Also reports what the load cost, whether the index "
    "had to fold any row out of its per-day window, how many peers the "
    "replication lane refused because their delegation was no longer "
    "current, and how many arriving batches found no free commit slot. It "
    "contacts no peer and prints no row contents.", 8192,
    "fleet,ledger,status,replica,freshness,boxes",
    "zcl.command.empty_input.v1", "zcl.fleet_ledger_status.v1", "", "",
    "z23 fleet ledger status",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_ledger_status)

ZCL_COMMAND_READY_READ(
    "fleet.usage", "fleet", "",
    "What every box spent, per provider, over the last days",
    "Sums the usage rows every chain here holds over a window of whole UTC "
    "days, grouped by box and provider, with cached tokens counted apart "
    "from the rest. Absent measurements are reported absent, never as zero. "
    "Where a quota row states a weekly cap for a provider, the share of it "
    "already spent is reported too. No peer is asked. The ledger is opened "
    "fresh on every call, which reads every chain from disk and re-verifies "
    "every row's signature before the index is walked; the two costs are "
    "reported separately as load_us and index_us so the claim can be "
    "checked rather than believed. days is 1 to the index window and "
    "defaults to 7; a longer "
    "window is refused rather than answered from days the index does not "
    "hold.", 16384,
    "fleet,usage,tokens,spend,provider,quota,week",
    "zcl.fleet_usage.input.v1", "zcl.fleet_usage.v1",
    "days,provider,box", "",
    "z23 fleet usage --days=7",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_usage)

ZCL_COMMAND_BRANCH("fleet.vitals", "fleet", "Sample this box into the ledger",
                   ZCL_COMMAND_LAYER_OPS)

ZCL_COMMAND_READY_COMMAND(
    "fleet.vitals.sample", "fleet.vitals", "",
    "Measure this box and append one signed vitals row per catalog metric",
    "Reads host facts through the platform seam once and appends one signed "
    "vitals row per catalog metric. An unknown id is refused by name. A fact "
    "this platform cannot measure is stored ABSENT, never as zero. Optional "
    "id samples one metric. It contacts no peer.", 0,
    "fleet,vitals,sample,load,memory,disk",
    "zcl.fleet_vitals_sample.input.v1", "zcl.fleet_vitals_sample.v1",
    "id", "",
    "z23 fleet vitals sample",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_DEV_MUTATION, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW, ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL, ZCL_COMMAND_CAP_DEV_STATE_READ,
    ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_fleet_vitals_sample)

ZCL_COMMAND_READY_READ(
    "fleet.objectives", "fleet", "",
    "Every objective z23 optimizes, its current value, target, and status",
    "Prints one row per id in the closed catalog "
    "(engine/composition/objectives.def): the objective id, the one file or "
    "command its value is read from, whether lower or higher is better, "
    "the current value, the target, the unit, and a status of met, unmet, "
    "or unmeasured(<reason>). landing_latency_s and "
    "landing_attempts_per_train read the landing outcomes ledger; "
    "proof_lint_wall_s and proof_test_wall_s read the newest landing "
    "attempt's phases.txt; commits_landed_today runs a local `git log` "
    "through the no-shell spawn seam; lint_families_over_ceiling counts "
    "oversized files under tools/lint/lintc; "
    "functions_over_complexity_cap counts the cyclomatic baseline's rows "
    "when that file exists. A value this tree cannot measure today is "
    "reported unmeasured with the reason named, never as a fabricated "
    "zero. outcomes, attempts_dir, repo, lintc_dir and baseline override "
    "the five paths a producer reads, for pointing the command at a "
    "fixture. It contacts no peer and writes nothing.",
    8192,
    "fleet,objectives,goals,targets,status,catalog",
    "zcl.fleet_objectives_input.v1", "zcl.fleet_objectives.v1",
    "outcomes,attempts_dir,repo,lintc_dir,baseline", "",
    "z23-dev fleet objectives",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_FOREGROUND,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_READ,
    ZCL_COMMAND_TRAIT_IDEMPOTENT | ZCL_COMMAND_TRAIT_PROSE,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_objectives)

ZCL_COMMAND_BRANCH("fleet.experiment", "fleet",
                   "Record and query delegation experiments",
                   ZCL_COMMAND_LAYER_OPS)

ZCL_COMMAND_READY_COMMAND(
    "fleet.experiment.predict", "fleet.experiment", "",
    "Append one signed predict row for a delegated task",
    "Appends one kind=experiment subject=predict row to this machine's chain "
    "and returns its sequence number. task_id is the note two rows of one "
    "delegation link by. task_class, harness, model and effort are closed "
    "vocabularies; a name that is not in the field's table, or the named "
    "member unknown, is refused by that field's name rather than stored. "
    "tokens and wall_s are the predicted cost, absent when omitted. It "
    "contacts no peer.", 0,
    "fleet,experiment,predict,delegation,tokens",
    "zcl.fleet_experiment_predict.input.v1", "zcl.fleet_experiment_predict.v1",
    "task_id,task_class,story,executor,harness,model,effort,tokens,wall_s,"
    "outcome,note",
    "task_id",
    "z23 fleet experiment predict --task_id=u1 --task_class=read "
    "--harness=manual --model=grok --effort=low --tokens=1200 --wall_s=30",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_DEV_MUTATION, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW, ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL, ZCL_COMMAND_CAP_DEV_STATE_READ,
    ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_fleet_experiment_predict)

ZCL_COMMAND_READY_COMMAND(
    "fleet.experiment.result", "fleet.experiment", "",
    "Append one signed result row for a delegated task",
    "Appends one kind=experiment subject=result row to this machine's chain "
    "and returns its sequence number. task_id is the note that pairs it with "
    "the predict, when one was written. task_class, model and outcome are "
    "closed vocabularies; a name that is not in the field's table, or the "
    "named member unknown, is refused by that field's name rather than "
    "stored. in, out, cache, reasoning, tool_uses, turns, wall_s, added, "
    "removed and defects are the measured cost, absent when omitted. A "
    "result with no matching predict is stored and later counted as "
    "unpredicted. It contacts no peer.", 0,
    "fleet,experiment,result,delegation,outcome",
    "zcl.fleet_experiment_result.input.v1", "zcl.fleet_experiment_result.v1",
    "task_id,task_class,story,executor,harness,model,effort,in,out,cache,"
    "reasoning,tool_uses,turns,wall_s,outcome,added,removed,defects,note",
    "task_id",
    "z23 fleet experiment result --task_id=u1 --task_class=read "
    "--model=grok --outcome=LAND --in=800 --out=200 --wall_s=28",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_DEV_MUTATION, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW, ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL, ZCL_COMMAND_CAP_DEV_STATE_READ,
    ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_fleet_experiment_result)

ZCL_COMMAND_BRANCH("fleet.triggers", "fleet",
                   "The closed registry of local-event reactions",
                   ZCL_COMMAND_LAYER_OPS)

ZCL_COMMAND_READY_READ(
    "fleet.triggers.list", "fleet.triggers", "",
    "Print the closed trigger registry",
    "Prints every declared trigger (engine/composition/triggers.def): its "
    "id, the source it reads, the field/op/value it matches, the action it "
    "performs, and why it exists. Reads only the compiled-in registry; it "
    "touches no file and contacts no peer.", 16384,
    "fleet,triggers,registry,list",
    "zcl.command.empty_input.v1", "zcl.fleet_triggers_list.v1", "", "",
    "z23-dev fleet triggers list",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_READ,
    ZCL_COMMAND_TRAIT_IDEMPOTENT | ZCL_COMMAND_TRAIT_PROSE,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_triggers_list)

ZCL_COMMAND_READY_COMMAND(
    "fleet.triggers.check", "fleet.triggers", "",
    "Run every trigger once against whatever is new in its source",
    "Reads each source (landing outcomes, this box's board file, the "
    "experiment TSV, ingested GitHub comment rows) from its own saved byte "
    "cursor, evaluates every registered trigger against every row that is "
    "new since last time, performs the matched action (print, append to "
    "triggers/fired.jsonl, or post a fleet board note), and advances the "
    "cursor past what it read. since, in seconds, skips evaluating a row "
    "whose own timestamp is older than that; dry-run performs the same "
    "actions but never moves the cursor, so a re-run sees the same rows "
    "again. It starts no daemon: one call reads what is new and returns. "
    "A board_post action reaches the local running node the same way "
    "`fleet board post` does and fails closed when none answers; every "
    "other action stays purely local.",
    0,
    "fleet,triggers,check,run,evaluate",
    "zcl.fleet_triggers_check.input.v1", "zcl.fleet_triggers_check.v1",
    "since,dry-run", "",
    "z23-dev fleet triggers check --since=3600",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_DEV_MUTATION, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_READ | ZCL_COMMAND_CAP_DEV_STATE_WRITE,
    ZCL_COMMAND_TRAIT_PROSE,
    zcl_native_handle_fleet_triggers_check)

ZCL_COMMAND_READY_COMMAND(
    "fleet.triggers.ingest", "fleet.triggers", "",
    "Append already-fetched GitHub discussion comment rows to the "
    "github_comments trigger source",
    "z23 has no outbound HTTP seam, so this never reaches GitHub itself: a "
    "tiny external adapter fetches new comments (e.g. via `gh api`) and "
    "writes them as one JSON object per line, and this leaf validates and "
    "appends the ones that carry every field the github_comments source "
    "needs (kind, owner, repo, number, comment_id, author, url, body, ts) "
    "to <state>/zclassic23/triggers/github_comments.jsonl. A line missing "
    "a field is skipped, not fatal, so re-feeding an overlapping fetch "
    "costs nothing; the per-source byte cursor `fleet triggers check` "
    "already keeps is what actually prevents re-firing after a restart. "
    "source is closed to \"github\". It contacts no peer.",
    0,
    "fleet,triggers,ingest,github,comments",
    "zcl.fleet_triggers_ingest.input.v1", "zcl.fleet_triggers_ingest.v1",
    "source,file", "source,file",
    "z23-dev fleet triggers ingest --source=github --file=/path/comments.jsonl",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_DEV_MUTATION, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW, ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL, ZCL_COMMAND_CAP_DEV_STATE_WRITE,
    ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_fleet_triggers_ingest)

ZCL_COMMAND_READY_READ(
    "fleet.experiment.stats", "fleet.experiment", "",
    "Per task_class and model: counts, LAND rate, medians, predicted-vs-actual",
    "Walks the experiment events this machine's index kept and prints one "
    "line per (task_class, model) plus a total line. Each line reports "
    "predict and result counts, LAND rate in basis points, median wall_s "
    "and tokens of the results, predicted-versus-actual token ratio in "
    "basis points, and how many results had no matching predict. task_class "
    "and model, when passed, restrict the table; a name that is not in the "
    "field's table is refused by that field's name. The answer comes from "
    "the in-memory index alone: no peer is asked. Absent medians print as "
    "absent, never as zero.", 16384,
    "fleet,experiment,stats,delegation,model",
    "zcl.fleet_experiment_stats.input.v1", "zcl.fleet_experiment_stats.v1",
    "task_class,model", "",
    "z23 fleet experiment stats --task_class=read --model=grok",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_experiment_stats)

ZCL_COMMAND_READY_READ(
    "fleet.experiment.export", "fleet.experiment", "",
    "Every kept experiment row as exp.sh's 22-column TSV, one line each",
    "Walks the experiment events this machine's index kept and prints one "
    "TSV line per predict or result row, in the exact column order and "
    "header exp.sh writes: ts, kind, box, task_id, task_class, story, "
    "executor, harness, model, effort, tokens_in, tokens_out, "
    "tokens_cached, tokens_reasoning, tool_uses, turns, wall_s, outcome, "
    "lines_added, lines_removed, defects, note. A column this build never "
    "kept for that row (a closed-vocabulary field the row did not carry, "
    "or `note`, which the leaf does not yet keep apart from task_id) "
    "prints empty rather than a guess; an absent counter prints 0, same as "
    "exp.sh's own convention. since, in hours, and box, a 64-hex-character "
    "box id, both restrict which rows print; omitted, every kept row from "
    "every box prints. The answer comes from the in-memory index alone: no "
    "peer is asked and no file but this machine's own chains is read.",
    65536,
    "fleet,experiment,export,delegation,tsv",
    "zcl.fleet_experiment_export.input.v1", "zcl.fleet_experiment_export.v1",
    "since,box", "",
    "z23 fleet experiment export --since=24",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_experiment_export)

ZCL_COMMAND_BRANCH("fleet.roles", "fleet",
                   "Which key may call which fleet leaf",
                   ZCL_COMMAND_LAYER_OPS)

ZCL_COMMAND_READY_READ(
    "fleet.roles.list", "fleet.roles", "",
    "Every fingerprint this node has ever granted or revoked a role",
    "Reads this node's own signed role/grant store (see "
    "engine/composition/roles.def) and reports every (fingerprint, role) "
    "pair it has ever seen, newest state first: whether it is currently "
    "active, and when it last changed. This node's own operator key is "
    "never listed — it holds every role implicitly and is checked by "
    "identity, not by a grant row. It contacts no peer.", 16384,
    "fleet,roles,grants,access,permissions",
    "zcl.command.empty_input.v1", "zcl.fleet_roles_list.v1", "", "",
    "z23 fleet roles list",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_roles_list)

ZCL_COMMAND_READY_COMMAND(
    "fleet.roles.grant", "fleet.roles", "",
    "Sign a row granting one role to one key's fingerprint",
    "Appends one signed row to this node's own role store, granting `role` "
    "(a name from the closed catalog in engine/composition/roles.def, never "
    "`operator`) to the key whose SHA3-256 fingerprint is `fp` (64 hex "
    "characters). The row is signed by this node's own delegated online "
    "key: a grant is always this node's own decision about a key, never a "
    "statement accepted from a peer. A later revoke of the same pair "
    "supersedes it on the next check.", 0,
    "fleet,roles,grant,access,permissions",
    "zcl.fleet_roles_grant.input.v1", "zcl.fleet_roles_grant.v1", "fp,role",
    "fp,role", "z23 fleet roles grant --fp=<64-hex> --role=worker",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_DEV_MUTATION, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW, ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL, ZCL_COMMAND_CAP_DEV_STATE_READ,
    ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_fleet_roles_grant)

ZCL_COMMAND_READY_COMMAND(
    "fleet.roles.revoke", "fleet.roles", "",
    "Sign a row revoking one role from one key's fingerprint",
    "Appends one signed row to this node's own role store, revoking `role` "
    "from the key whose fingerprint is `fp`. Nothing is deleted: the grant "
    "row still exists, but the next check of this pair sees the revoke and "
    "refuses. Revoking a role never granted is accepted and has no further "
    "effect.", 0,
    "fleet,roles,revoke,access,permissions",
    "zcl.fleet_roles_revoke.input.v1", "zcl.fleet_roles_revoke.v1",
    "fp,role", "fp,role",
    "z23 fleet roles revoke --fp=<64-hex> --role=worker",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_DEV_MUTATION, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW, ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL, ZCL_COMMAND_CAP_DEV_STATE_READ,
    ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_fleet_roles_revoke)

ZCL_COMMAND_READY_READ(
    "fleet.roles.check", "fleet.roles", "",
    "Would this key's roles allow this leaf (and board kind)?",
    "Resolves every active role the key named by `fp` currently holds in "
    "this node's own store and reports whether any of them grants `leaf` "
    "(an exact `fleet.<a>.<b>` name), restricted to `kind` when the leaf is "
    "a board post. `fp` equal to this node's own operator fingerprint is "
    "always allowed, matching that every unsigned local CLI use by this "
    "node's operator is unaffected by roles. A refusal names the exact "
    "typed reason a caller would have seen. It contacts no peer.", 4096,
    "fleet,roles,check,access,permissions",
    "zcl.fleet_roles_check.input.v1", "zcl.fleet_roles_check.v1",
    "fp,leaf,kind", "fp,leaf",
    "z23 fleet roles check --fp=<64-hex> --leaf=fleet.board.post "
    "--kind=result",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_roles_check)

/* ── the low-latency datagram link between two fleet boxes ────────────
 *
 * `fleet link probe` is the operator surface over engine/modules/gamelink:
 * it opens a real UDP session, pings it, and prints round-trip microseconds,
 * jitter and loss. It is a measurement tool, not a node service — the node
 * never calls it, it touches no datadir, and it shares no code and no socket
 * with block relay. See docs/GAMELINK.md. */

ZCL_COMMAND_BRANCH("fleet.link", "fleet", "Measure the datagram link to a peer",
                   ZCL_COMMAND_LAYER_OPS)

ZCL_COMMAND_READY_COMMAND(
    "fleet.link.probe", "fleet.link", "",
    "Round-trip time, jitter and loss over the UDP datagram link",
    "Opens an authenticated UDP datagram session, pings it for `seconds`, and "
    "reports round-trip microseconds, jitter, loss in parts per million, and "
    "every counter that says why a datagram did not arrive. mode is loopback, "
    "echo or probe. loopback is the default and needs nothing: it runs both "
    "ends inside this process over 127.0.0.1 with freshly drawn key material, "
    "which measures this box's own floor — the kernel's UDP path plus the "
    "per-packet crypto. echo holds a port open and answers pings so another "
    "box can measure the path; probe measures the path to a box running echo "
    "and needs its ip:port in peer. Both of those need the shared 32-byte key "
    "as 64 hex characters in key, because no pairing plumbing hands this leaf "
    "a live session's material yet. A probe that hears no pong FAILS rather "
    "than printing zeros, since an unreachable peer must never read as a fast "
    "one. It writes nothing and contacts no peer but the one named.", 0,
    "fleet,link,latency,rtt,jitter,loss,udp,game,probe",
    "zcl.fleet_link_probe.input.v1", "zcl.fleet_link_probe.v1",
    "mode,peer,bind,key,seconds", "",
    "z23 fleet link probe --seconds=2",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_DEV_MUTATION, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_MAINTENANCE, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_fleet_link_probe)
