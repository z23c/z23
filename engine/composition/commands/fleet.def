ZCL_COMMAND_READY_READ(
    "fleet.steer.mailbox", "fleet.steer", "",
    "One recipient's mail, a bounded cursor page",
    "Returns mail rows addressed to one recipient label (to, required), "
    "optionally only from one sender (from) and a ref prefix (ref), "
    "newest last. since is the cursor a previous page returned (omit for "
