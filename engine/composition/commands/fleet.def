ZCL_COMMAND_READY_COMMAND(
    "fleet.steer.wiki-write", "fleet.steer", "",
    "Write a wiki page on another node through an attributable steer grant",
    "Publishes PUBLIC knowledge signed by this node and replicated to peers. "
    "Requires an explicit attributable wiki-write grant. Required request_key "
    "is a stable token of at most 128 bytes; expected is absent for creation "
    "or an exact retained revision id for revision. Slug and title obey signed "
    "64/128-byte limits. Text is inline UTF-8, at most 16384 bytes; @path is "
    "literal text, never a file read. "
    "Plain prose remains readable by exact id; wiki-find returns valid "
    "zcl.fleet_wiki_entry.v1 entries and plain pages matched by slug, title "
    "or first line. Use the entry schema as inline text to make lessons "
    "searchable by rule and why. "
    "Admission checks current scope, expiry and revocation before retained "
    "replay. Attribution derives from the exact "
    "grant identity; caller-supplied agent is ignored. Atomic comparison uses "
    "the receiver's verified newest retained page across local authors, not "
    "distributed global latest. Corrupt newest refuses. Same grant/key and "
    "payload replays the retained original; changed payload refuses. Replay "
    "ends when that object evicts. Revocation does not cancel an already "
    "admitted commit. Returns signed readback metadata, body SHA3-256 and exact "
    "id for chunk reconstruction. Unknown outcomes require the same key for "
    "reconciliation. Default budget 4096, cap 8192, minimum 3072. No execution "
    "or retention lease is granted.", 8192,
    "fleet,steer,wiki,write,revision",
    "zcl.fleet_steer_wiki_write.input.v1", "zcl.fleet_steer_wiki_write.v1",
    "grant,request_key,expected,slug,title,text", "grant,request_key,expected,slug,title,text",
    "z23 fleet steer wiki-write --grant=<grant> --request_key=<stable-key> --expected=absent --slug=<slug> --title=<title> --text=<inline-text>",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_DEV_MUTATION, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_WRITE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_fleet_steer_wiki_write)

ZCL_COMMAND_READY_COMMAND(
    "fleet.steer.deliver", "fleet.steer", "",
    "Upload one C source file into the inert quarantine inbox",
    "Needs the deliver scope, which no other scope implies. One call carries "
    "one 16 KiB chunk (data_hex, canonical lowercase hex, exactly "
    "min(16384,size-offset) bytes) of a file of size 1..262144 bytes at an "
    "offset aligned to 16384. from must equal the grant's label; the upload "
    "is bound to that grant, so two grants sharing a label never share an "
    "upload. Offset 0 creates and freezes ref, name (.c or .h), size and "
    "sha3_512 (128 lowercase hex over the whole file). Later chunks must "
    "name the next durable offset; a byte-identical retry returns "
    "duplicate:true. The final chunk verifies SHA3-512 and replies "
    "upload_state quarantined with verified_sha3_512; a mismatch is "
    "STEER_DELIVER_HASH_MISMATCH and never ready. Quarantined means stored "
    "and hash-checked, never reviewed or accepted. Bytes land under the "
    "owner-private steer inbox and are never compiled, executed, "
    "dispatched or written to a checkout. Quotas: one receiving upload and "
    "8 retained per grant, 64 total, 2 MiB per grant, 16 MiB total; a "
    "partial expires after 24 hours, a failed upload after 1 hour; a verified "
    "one stays until fleet.steer.drop. Refusals STEER_DELIVER_BAD_INPUT, SIZE, "
    "PART, OFFSET, NOT_FOUND, CONFLICT, HASH_MISMATCH, BUSY, QUOTA, "
    "UNSAFE_PATH, STORE, EXPIRED_UPLOAD, UNSUPPORTED, and the retryable RATE "
    "(60 requests a minute per grant), BYTE_RATE (16 MiB an hour per grant) "
    "and OUTSTANDING (32 receiving uploads in total), plus the "
    "STEER_GRANT_* and sender refusals. Reply under 4 KiB.", 65536,
    "fleet,steer,deliver,upload,source,quarantine,chatgpt",
    "zcl.fleet_steer_deliver.input.v1", "zcl.fleet_steer_deliver.v1",
    "grant,from,ref,upload_id,name,size,sha3_512,offset,data_hex",
    "from,ref,upload_id,name,size,sha3_512,offset,data_hex",
    "z23 fleet steer deliver --from=<label> --ref=<ref> --upload_id=<32 hex> ...",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_DEV_MUTATION, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_WRITE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_fleet_steer_deliver)

