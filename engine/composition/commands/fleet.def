/* The owner's private fleet ledger. Consumer defines ZCL_COMMAND_*.
 *
 * Leaves under the existing `fleet` root (declared once, in
 * engine/composition/commands/fleet_board.def, alongside the fleet board and
 * wiki) rather than a root of its own: `fleet` already exists as a wire
 * contract, and a second ZCL_COMMAND_BRANCH row for the same path is a
 * path collision the registry refuses to build with.
 *
 * Every leaf here answers from local files. Nothing contacts a peer, and
 * nothing prints a row's contents anywhere a row could leave this machine.
 * See docs/agent/FLEET_LEDGER.md. */

ZCL_COMMAND_BRANCH("fleet.ledger", "fleet", "Write and inspect the ledger",
                   ZCL_COMMAND_LAYER_OPS)

ZCL_COMMAND_READY_COMMAND( /* a writer */
    "fleet.ledger.add", "fleet.ledger", "",
    "Append one signed row to this box's own chain",
    "Appends one row to this machine's chain and returns its sequence "
    "number. kind is usage, task or vitals; subject is that kind's own "
    "closed vocabulary, so a vitals subject outside the declared catalog is "
    "refused. Measurements are passed as named pairs; a pair that is not "
    "passed is absent, which is a different fact from zero and is stored as "
    "one. note is a short label such as a task id. The row is signed by this "
    "node's delegated online key and carries its master key as the writer, "
    "both read from the datadir; a box with no filed delegation cannot "
    "write. It contacts no peer.", 0,
    "fleet,ledger,usage,tokens,vitals,append,record",
    "zcl.fleet_ledger_add.input.v1", "zcl.fleet_ledger_add.v1",
    "kind,subject,note,tokens_in,tokens_out,tokens_cached,tokens_reasoning,"
    "wall_ms,turns,tool_uses,cost_micro_usd,value,count,bytes,limit",
    "kind,subject",
    "z23 fleet ledger add --kind=usage --subject=grok --tokens_in=1200",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_DEV_MUTATION, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW, ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL, ZCL_COMMAND_CAP_DEV_STATE_READ,
    ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_fleet_ledger_add)

ZCL_COMMAND_READY_READ(
    "fleet.ledger.status", "fleet.ledger", "",
    "Per box: rows held, last sequence, and how stale the replica is",
    "Reports every chain this machine holds — its own and one replica per "
    "paired peer — with the rows held, the last sequence number, and the age "
    "of the newest row in seconds. A replica answers instantly and that is "
    "not the same as answering currently, so the age is always reported and "
    "never rounded away. Also reports what the load cost, whether the index "
    "had to fold any row out of its per-day window, how many peers the "
    "replication lane refused because their delegation was no longer "
    "current, and how many arriving batches found no free commit slot. It "
    "contacts no peer and prints no row contents.", 8192,
    "fleet,ledger,status,replica,freshness,boxes",
    "zcl.command.empty_input.v1", "zcl.fleet_ledger_status.v1", "", "",
    "z23 fleet ledger status",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_ledger_status)

ZCL_COMMAND_READY_READ(
    "fleet.usage", "fleet", "",
    "What every box spent, per provider, over the last days",
    "Sums the usage rows every chain here holds over a window of whole UTC "
    "days, grouped by box and provider, with cached tokens counted apart "
    "from the rest. Absent measurements are reported absent, never as zero. "
    "Where a quota row states a weekly cap for a provider, the share of it "
    "already spent is reported too. No peer is asked. The ledger is opened "
    "fresh on every call, which reads every chain from disk and re-verifies "
    "every row's signature before the index is walked; the two costs are "
    "reported separately as load_us and index_us so the claim can be "
    "checked rather than believed. days is 1 to the index window and "
    "defaults to 7; a longer "
    "window is refused rather than answered from days the index does not "
    "hold.", 16384,
    "fleet,usage,tokens,spend,provider,quota,week",
    "zcl.fleet_usage.input.v1", "zcl.fleet_usage.v1",
    "days,provider,box", "",
    "z23 fleet usage --days=7",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_usage)

ZCL_COMMAND_BRANCH("fleet.vitals", "fleet", "Sample this box into the ledger",
                   ZCL_COMMAND_LAYER_OPS)

ZCL_COMMAND_READY_COMMAND(
    "fleet.vitals.sample", "fleet.vitals", "",
    "Measure this box and append one signed vitals row per catalog metric",
    "Reads host facts through the platform seam once and appends one signed "
    "vitals row per catalog metric. An unknown id is refused by name. A fact "
    "this platform cannot measure is stored ABSENT, never as zero. Optional "
    "id samples one metric. It contacts no peer.", 0,
    "fleet,vitals,sample,load,memory,disk",
    "zcl.fleet_vitals_sample.input.v1", "zcl.fleet_vitals_sample.v1",
    "id", "",
    "z23 fleet vitals sample",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_DEV_MUTATION, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW, ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL, ZCL_COMMAND_CAP_DEV_STATE_READ,
    ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_fleet_vitals_sample)

ZCL_COMMAND_READY_READ(
    "fleet.objectives", "fleet", "",
    "Every objective z23 optimizes, its current value, target, and status",
    "Prints one row per id in the closed catalog "
    "(engine/composition/objectives.def): the objective id, the one file or "
    "command its value is read from, whether lower or higher is better, "
    "the current value, the target, the unit, and a status of met, unmet, "
    "or unmeasured(<reason>). landing_latency_s and "
    "landing_attempts_per_train read the landing outcomes ledger; "
    "proof_lint_wall_s and proof_test_wall_s read the newest landing "
    "attempt's lint and test logs and phases.txt; commits_landed_today runs "
    "a local `git log` of origin/main through the no-shell spawn seam; lint_families_over_ceiling counts "
    "oversized files under tools/lint/lintc; "
    "functions_over_complexity_cap counts the cyclomatic baseline's rows "
    "when that file exists, counting only pin rows the way the lint gate "
    "parses them; node_rss_mb and node_tip_lag_blocks read the local "
    "node's status brief and node_warm_restart_s its datadir's "
    "boot_status.json, each unmeasured with the reason when the node is "
    "down; landed_rows_today, land_success_rate_7d, land_failure_repeats, "
    "product_commit_share_7d and generated_churn_10d are the lab KPIs, and "
    "the result carries a `screen` report card and `next`, the measured "
    "unmet objective with the largest gap to its target, product "
    "objectives (class product: the node a user runs) before lab ones "
    "(null when every "
    "measured one is met). A value this tree cannot measure today is "
    "reported unmeasured with the reason named, never as a fabricated "
    "zero. outcomes, attempts_dir, repo, lintc_dir, baseline and brief (a "
    "status-brief JSON file) override "
    "the paths a producer reads, for pointing the command at a "
    "fixture. It asks only the local node, no peer, and writes nothing.",
    32768,
    "fleet,objectives,goals,targets,status,catalog",
    "zcl.fleet_objectives_input.v1", "zcl.fleet_objectives.v1",
    "outcomes,attempts_dir,repo,lintc_dir,baseline,brief", "",
    "z23-dev fleet objectives",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_FOREGROUND,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_READ,
    ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_objectives)

/* The lab-loop leaves hang under their own branch: the `fleet` menu is at
 * ZCL_COMMAND_BRANCH_BUDGET. Paths stay fleet.objectives.*. */
ZCL_COMMAND_BRANCH("fleet.loop", "fleet",
                   "Lab-loop reads: work cards and landing verdicts",
                   ZCL_COMMAND_LAYER_OPS)

ZCL_COMMAND_READY_READ(
    "fleet.objectives.brief", "fleet.loop", "",
    "A work card for the objective z23 should work on next",
    "Picks the objective `fleet objectives` would pick as `next` (the "
    "measured unmet row with the largest gap, product before lab) and prints "
    "it as a zcl.work_card.v1-shaped card: name, level, outcome, owned and "
    "forbidden paths, the acceptance command and the stop_if conditions from "
    "engine/composition/objective_work.def, plus an `objective` object with "
    "its id, value, target, gap, unit, why and runner_ok. runner_ok_only "
    "narrows the pick to objectives whose work row is safe for an unattended "
    "runner (behaviour-preserving or measurement-only work outside core/, the "
    "reducer, the wallet and the land driver); when the unmet objective "
    "ranking first overall is not runner_ok the reply also carries `skipped`, "
    "[{objective, reason}], naming it. id briefs that one objective "
    "instead; an id not in the catalog is refused by name, and one that is met "
    "or unmeasured has nothing to brief. The card carries no base: take it "
    "from origin/main. outcomes, attempts_dir, repo, lintc_dir, baseline and "
    "brief override the paths the measurement reads, as for `fleet "
    "objectives`. The complexity card is narrowed to one file chosen from the "
    "baseline (the target_file and its pins); exclude is a comma list of "
    "paths to skip, for files already in flight. It asks only the local "
    "node, no peer, and writes nothing.",
    32768,
    "fleet,objectives,brief,work,card,next,runner",
    "zcl.fleet_objectives_brief_input.v1", "zcl.work_card.v1",
    "id,runner_ok_only,outcomes,attempts_dir,repo,lintc_dir,baseline,brief,"
    "exclude", "",
    "z23-dev fleet objectives brief",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_FOREGROUND,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_READ,
    ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_objectives_brief)

ZCL_COMMAND_READY_READ(
    "fleet.objectives.verdict", "fleet.loop", "",
    "Did a landing move an objective: compare two objectives snapshot rows",
    "Reads <state>/land/objectives.jsonl, the zcl.objectives_snapshot.v1 line "
    "the land queue appends after each landing, and compares two rows: by "
    "default the second-newest and newest, or the rows named by before_seq "
    "and after_seq (a seq the file does not hold is refused by name). Per "
    "objective it reports before, after, delta, direction, target, met_before, "
    "met_after and a verdict of improved (the value moved in the objective's "
    "direction: lower for min, higher for max), regressed, unchanged or "
    "unmeasured (either side null, or the id in only one row, with the "
    "reason). id narrows to one objective; an id in neither row is refused by "
    "name. The result also carries the improved, regressed, unchanged and "
    "unmeasured counts, a `regressions` array of ids, `skipped` (overlong, "
    "malformed or other-schema lines, which are ignored) and a plain `screen`. "
    "snapshot overrides the file path. The file is streamed once with a "
    "bounded line reader, so it may grow; the leaf writes nothing.",
    32768,
    "fleet,objectives,verdict,snapshot,regression,landing,runner",
    "zcl.fleet_objectives_verdict_input.v1", "zcl.fleet_objectives_verdict.v1",
    "snapshot,before_seq,after_seq,id", "",
    "z23-dev fleet objectives verdict",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_FOREGROUND,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_READ,
    ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_objectives_verdict)

ZCL_COMMAND_READY_READ(
    "fleet.objectives.step", "fleet.loop", "",
    "Decide the lab loop's next action: run, wait, paused or none",
    "The glue of the self-improving loop; it launches nothing. A land row "
    "whose note starts with `loop:<objective_id>:` was made by the loop (no "
    "separate ledger: that prefix is the whole record). For each landed loop "
    "row, newest first and at most 20, it compares the objectives snapshot at "
    "the landing's seq with the newest snapshot below it (the rows "
    "`fleet objectives verdict` reads, called in process) and reports the "
    "verdict of that row's own objective in `verdicts`. If the newest two "
    "landed loop rows both regressed their own objective the action is "
    "`paused`, naming both seqs and objective ids; force: true overrides that "
    "for one call and the result says so (`forced`); nothing is stored. If "
    "max_in_flight (1..4, default 2) loop rows are not final in the land "
    "queue the action is `wait`, naming their seqs. Otherwise the work order "
    "of `fleet "
    "objectives brief` is built in process: a runner_ok top objective gives "
    "action `run` with next = {objective, level, runner_ok, lane "
    "`loop-<objective_id>-<n>`, note_prefix `loop:<objective_id>:`, brief}; a "
    "top objective that is not runner_ok is listed in `skipped` (the brief is "
    "asked over the runner_ok rows only and reports what it passed over), so "
    "the top runnable objective runs; none unmet and runnable gives action `none` with the "
    "reason. A `run` also gives `dispatch` = {lane, note_prefix, engine, "
    "engine_reason, group, group_reason, task_file, task_text, argv[]}: the "
    "card as the task file engine_unit takes and the engine_unit command "
    "without --yes-dispatch, which the step never runs. The result is "
    "{action, reason, paused, forced, verdicts[], skipped[], dispatch, next, "
    "screen}. snapshot overrides the objectives.jsonl path; "
    "outcomes, attempts_dir, repo, lintc_dir, baseline, brief and exclude "
    "steer the measurement as for `fleet objectives brief`. It asks only the "
    "local node, no peer, and writes nothing.",
    32768,
    "fleet,objectives,step,loop,pause,regression,landing,runner",
    "zcl.fleet_objectives_step_input.v1", "zcl.fleet_objectives_step.v1",
    "force,snapshot,outcomes,attempts_dir,repo,lintc_dir,baseline,brief,"
    "exclude,max_in_flight", "",
    "z23-dev fleet objectives step",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_FOREGROUND,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_READ,
    ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_objectives_step)

ZCL_COMMAND_READY_READ(
    "fleet.objectives.value", "fleet.loop", "",
    "Token spend per worker role and model over lanes landed in 7 days",
    "Joins the lanes landed in the trailing 7 days to their worker agents and "
    "sums each agent's fresh tokens (uncached input plus output) and cache "
    "reads from the experiment ledger. Groups the agents by role (write, cx, "
    "review, review1, review2, fix, design, check) and model family (haiku, "
    "sonnet, opus, other); each row has the agents, the fresh total, the "
    "median fresh and cache-read tokens per agent and the whole-percent share "
    "of fresh tokens, largest first. lead is the lead's own transcript usage "
    "(session, else the newest in this checkout's Claude project), with its "
    "share of worker cache reads and outputs, or unmeasured. totals count the "
    "landed lanes, the lanes that joined an agent, the agents and the fresh "
    "tokens. skipped counts malformed ledger lines. outcomes, experiments and "
    "session point the reader at a fixture. Writes nothing; asks no node.",
    16384,
    "fleet,objectives,value,tokens,spend,role,model,landed,loop,lead",
    "zcl.fleet_objectives_value_input.v1", "zcl.fleet_objectives_value.v1",
    "outcomes,experiments,session", "",
    "z23-dev fleet objectives value",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_FOREGROUND,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_READ,
    ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_objectives_value)

ZCL_COMMAND_READY_READ(
    "fleet.goals", "fleet", "",
    "The live fleet report card: goals G1-G13, criteria C1-C8, milestones D1-D8",
    "Prints one row per id in the closed catalog "
    "(engine/composition/goals.def): the id, title, a grade of pass, "
    "partial, fail or unmeasured, the A+ bar, one evidence string from a "
    "local probe, and the command or card that would raise it. Probes run "
    "in this process: the landing outcomes ledger and a git log of "
    "origin/main (G9), a warm code lookup (G7), the wiki read path (G4), "
    "vitals history per admitted host (G8), the lane claims ledger (G13), "
    "the shell-script allowlist (D8) and the release update leaf (G6). "
    "Host-set goals (G1, G3, G5, G6, G8, G12) take their hosts from the "
    "admitted roster and are unmeasured without one. A row whose probe is "
    "missing is unmeasured with the reason, never a guessed grade, and a "
    "row passes only when every numeric clause of its bar was measured and "
    "met. repo overrides the git worktree G9 and G13 read; outcomes, "
    "bash_allowlist and claims override the files G9, D8 and G13 read. "
    "The G7 lookup uses the working directory's code index and may refresh "
    "it, writing under .codeindex; the leaf writes nothing else. "
    "It contacts no peer.",
    32768,
    "fleet,goals,scorecard,report,grade,mvp",
    "zcl.fleet_goals_input.v1", "zcl.fleet_goals.v1",
    "repo,outcomes,bash_allowlist,claims", "",
    "z23 fleet goals",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_MAINTENANCE,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_READ,
    ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_goals)

ZCL_COMMAND_READY_COMMAND(
    "fleet.receipt.append", "fleet.loop", "",
    "Append one receipt line for C1, C2, C4, C5 or C7",
    "Appends one JSON line {ts,item,verdict,wall_s,build_commit,host,detail} "
    "to $XDG_STATE_HOME (default $HOME/.local/state)/zclassic23-receipts/"
    "<item>.jsonl, creating the directory 0700, so `fleet goals` can grade "
    "that item from its newest line like C3. item is one of C1, C2, C4, C5, "
    "C7 and verdict one of pass, fail, skip; anything else is refused by "
    "name and nothing is written. wall_s is whole seconds and optional; "
    "detail is cut at 256 bytes. build_commit is the first 12 hex digits of "
    "the running binary's source id. It writes nothing else and contacts no "
    "peer.", 0,
    "fleet,receipt,append,goals,producer",
    "zcl.fleet_receipt_append.input.v1", "zcl.fleet_receipt_append.v1",
    "item,verdict,wall_s,detail",
    "item,verdict",
    "z23-dev fleet receipt append --item=C7 --verdict=pass --wall_s=95",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_DEV_MUTATION, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW, ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL, ZCL_COMMAND_CAP_DEV_STATE_WRITE,
    ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_fleet_receipt_append)

ZCL_COMMAND_READY_COMMAND(
    "fleet.receipt.parity", "fleet.loop", "",
    "Append one block-hash parity sample of two loopback nodes (goal C8)",
    "Asks two nodes on 127.0.0.1 for getblockcount, takes h = min(tips) - 100 "
    "and asks both for getblockhash h, then appends one JSON line {ts,height,"
    "our_hash,oracle_hash,match,source,ok} to parity.jsonl in dir (default "
    "$ZCL_SOAK_EVIDENCE_DIR, else $HOME/.local/state/"
    "zclassic23-soak-evidence), under an exclusive lock, creating the "
    "directory 0700 and never truncating. a_ is our node and b_ the oracle. "
    "Each node's RPC cookie is read by the node RPC client from "
    "<cookie_dir>/.cookie; no secret travels in argv. When either node "
    "cannot answer, the line is ok:false with null hashes and the leaf still "
    "succeeds, since a hole is evidence; failing to lock or append is an "
    "error. The reply echoes the sample. It reads no datadir itself and "
    "contacts no peer.", 0,
    "fleet,receipt,parity,hash,oracle,goals,c8,producer",
    "zcl.fleet_parity_sample.input.v1", "zcl.fleet_parity_sample.v1",
    "a_port,a_cookie_dir,b_port,b_cookie_dir,dir",
    "a_port,a_cookie_dir,b_port,b_cookie_dir",
    "z23-dev fleet receipt parity --a_port=18242 --a_cookie_dir=/path/to/our/node --b_port=8232 --b_cookie_dir=/path/to/oracle/node",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_DEV_MUTATION, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW, ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL, ZCL_COMMAND_CAP_DEV_STATE_WRITE,
    ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_fleet_parity_sample)

ZCL_COMMAND_BRANCH("fleet.experiment", "fleet",
                   "Record and query delegation experiments",
                   ZCL_COMMAND_LAYER_OPS)

ZCL_COMMAND_READY_COMMAND(
    "fleet.experiment.predict", "fleet.experiment", "",
