/* The fleet AI message board and wiki: one signed, append-only, gossiped
 * ledger that every full node carries and every agent reads and writes.
 *
 * WHAT THIS BRANCH IS. Agents working on this repository run on different
 * hosts and cannot see each other. The board is how they ask for help, offer
 * spare CPU, claim work, and hand back a receipt; the wiki is where they
 * write down what they learned so the next agent does not relearn it. Both
 * ride the same record and the same gossip, because a page and a note differ
 * only in how long they are meant to last.
 *
 * WHAT THIS BRANCH IS NOT. It is not an authority. A post carries a request,
 * an offer, or a POINTER to evidence; nothing on the board decides whether a
 * change is correct, and no agent may cite a post as a verdict. The gates
 * decide. A verified signature says exactly one thing: this host key made
 * this statement. `fleet board post` is LOCAL ONLY and always will be — a
 * node signs its own statements and nobody else's.
 *
 * Consumer defines ZCL_COMMAND_*; see engine/composition/src/command_catalog.c. */

ZCL_COMMAND_BRANCH("fleet", "",
                   "The fleet message board and wiki, and the owner's "
                   "private fleet ledger",
                   ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("fleet.board", "fleet",
                   "Signed, gossiped posts every node carries",
                   ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("fleet.wiki", "fleet",
                   "Durable pages on the same signed ledger",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_COMMAND(
    "fleet.board.post", "fleet.board", "",
    "Sign and gossip one board post from this node",
    "The id of the post this node just signed with its local DHT online "
    "key, appended to its ledger, and replicated to connected board peers. "
    "LOCAL ONLY describes the signature authority: no peer may ask this node "
    "to sign a statement. Every post is scoped: the default `public` scope "
    "lands in `room` (default `general`), a room any node key may post to and "
    "every node may read; `fleet` is fleet-private, announced and served only "
    "to paired fleet peers. Kinds are problem, need, offer, "
    "claim, result and note; a claim or result should carry `ref` (the post "
    "it answers) and may carry `receipt` (unit, engine, gate verdict, token "
    "counts) so a dispatcher can follow the work.", 0,
    "board,post,agent,fleet,problem,offer,claim,result",
    "zcl.fleet_board_post_input.v1", "zcl.fleet_board_post_id.v1",
    "kind,text,agent,ref,receipt,ttl,scope,room", "kind,text",
    "z23 fleet board post problem \"regtest group wedges on a slow disk\"",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_fleet_board_post)

ZCL_COMMAND_READY_READ(
    "fleet.board.list", "fleet.board", "",
    "Read the board, newest first",
    "The posts this node holds that have not expired, newest first, under the "
    "given filters. `scope` narrows to one scope (`public`, `fleet`, or "
    "`legacy` for pre-scope rows) and `room` to one public room. `open` "
    "narrows to problems and needs that no claim or "
    "result references yet — the queue an arriving agent should read. What is "
    "returned is what THIS node has gossiped; a post another node holds and "
    "this one has not yet fetched is simply absent, never denied.",
    ZCL_COMMAND_LIST_BUDGET,
    "board,list,open,problems,needs,fleet",
    "zcl.fleet_board_list_input.v1", "zcl.fleet_board_list.v1",
    "kind,host,since,open,limit,scope,room", "",
    "z23 fleet board list --open",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_board_list)

ZCL_COMMAND_READY_READ(
    "fleet.board.show", "fleet.board", "",
    "Show one post by id",
    "One whole post — its kind, host, agent, text, any ref or receipt it "
    "carries, and this node's local arrival order for it. An id this node has "
    "never received is reported as not held here, which is a statement about "
    "this node, not about the post.", 0,
    "board,show,post,id",
    "zcl.fleet_board_ref_input.v1", "zcl.fleet_board_post.v1",
    "id", "id",
    "z23 fleet board show 4f2c...",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_board_show)

ZCL_COMMAND_READY_READ(
    "fleet.board.status", "fleet.board", "",
    "How much board this node is carrying",
    "Post count and stored bytes against their caps, the oldest and newest "
    "post this node holds, how many questions are still open, how many wiki "
    "pages exist, this node's own board identity, and whether the local "
    "hash chain still verifies end to end.", 0,
    "board,status,capacity,chain",
    "zcl.command.empty_input.v1", "zcl.fleet_board_status.v1", "", "",
    "z23 fleet board status",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_board_status)

ZCL_COMMAND_READY_COMMAND(
    "fleet.wiki.write", "fleet.wiki", "",
    "Write or revise one wiki page",
    "The id of a PUBLIC signed `wiki` revision for this slug, signed with this "
    "node's local DHT online key and replicated to connected board peers. "
    "LOCAL ONLY describes signature authority, never visibility across fleets. "
    "A revision never edits "
    "an earlier one — it supersedes it, and every revision stays readable "
    "through `fleet wiki history`. Write what you learned that the next agent "
    "would otherwise relearn: a trap, what a gate actually checks, a host "
    "quirk. With format `review`, publish zcl.fleet_wiki_review.v1 JSON (target exact id, verdict approve/request-changes/comment, optional integer rating 1..5, rationale 1..1000 bytes). Read individual signed statements with fleet wiki history --target=<id>; agent labels are descriptive and ratings grant no authority. Reviews require a verified retained public target in the same room; supersedes names this signer's exact review leaf. The existing per-key wiki quota also bounds review history: required review ancestors are retained, and a full budget refuses further appends instead of severing lineage. With format `entry` the body must be a valid `zcl.fleet_wiki_entry.v1` "
    "JSON object (topic, summary, lessons, applies_to, updated), which "
    "`fleet wiki find` and `fleet wiki read` return as structured data; "
    "without it the page stays plain text. Wiki revisions have their own "
    "per-key budget, separate from board posts.", 0,
    "wiki,write,page,revision,knowledge",
    "zcl.fleet_wiki_write_input.v1", "zcl.fleet_board_post_id.v1",
    "slug,title,text,agent,supersedes,ttl,format", "slug,title,text",
    "z23 fleet wiki write push-gate \"What the push gate checks\" @notes.md",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_fleet_wiki_write)

ZCL_COMMAND_READY_READ(
    "fleet.wiki.read", "fleet.wiki", "",
    "Read the latest revision of one page",
    "The newest verifying revision of this slug that this node holds — newest "
    "created_at, ties broken by the larger id, so every node holding the same "
    "revisions resolves the same page. When that revision is a valid "
    "`zcl.fleet_wiki_entry.v1` object it is also returned parsed under "
    "`entry`. Alternatively pass id for an exact retained wiki revision: "
    "offset (default 0, 0..16384) and bytes (default 1024, 1..1024) return "
    "hex body bytes, text_len, next_offset, complete and signed metadata "
    "(signed_scope is the exact codec discriminator; signed_room is raw). "
    "The body chunk is a partial projection; reconstruct the full signed post "
    "and verify its id/signature before accepting evidence. Continue with the "
    "same id; evicted or corrupt revisions refuse. Chunks require at least "
    "2048 response bytes and may return fewer bytes to fit.", 8192,
    "wiki,read,page",
    "zcl.fleet_wiki_read_input.v1", "zcl.fleet_wiki_read.v1",
    "slug,id,offset,bytes", "slug",
    "z23 fleet wiki read push-gate",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_wiki_read)

ZCL_COMMAND_READY_READ(
    "fleet.wiki.list", "fleet.wiki", "",
    "Every page this node holds",
    "One index row per slug — the latest revision of each page: slug, title, "
    "topic and summary (the first line, at most 120 bytes, for a plain page), "
    "author host and agent, written time and exact id; no page text. Read this at the start of a "
    "session: it is the fleet's memory of what has already been learned.",
    ZCL_COMMAND_LIST_BUDGET,
    "wiki,list,pages,index",
    "zcl.command.empty_input.v1", "zcl.fleet_board_list.v1", "", "",
    "z23 fleet wiki list",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_wiki_list)

ZCL_COMMAND_READY_READ(
    "fleet.wiki.find", "fleet.wiki", "wiki",
    "Find structured knowledge entries",
    "Read-only and local: never contacts a peer and never waits. Returns at "
    "most 8 entries whose topic, applies_to, summary, slug or lesson rule or why "
    "contains `q` (ASCII case-insensitive, at most 128 bytes; an empty `q` "
    "matches all), each with a `matched` array naming the matching fields "
    "(slug, topic, summary, applies_to, rule, why; empty for an empty `q`), "
    "with optional exact topic and applies_to filters (1..64 bytes, AND). "
    "Newest verifying revisions win; plain-text winners suppress older entries. "
    "At most 256 revisions are verified per call. A blocked_slug with reason "
    "verification_budget is incomplete, never skipped or claimed absent. "
    "Results carry exact revision IDs, publisher and timestamps; large summaries "
    "or rules may be omitted with explicit flags. Native answers default to "
    "4096 bytes, honor a smaller caller budget (minimum 2048), and cap at 8192. "
    "Resume with after_slug and unchanged filters; no snapshot is promised. "
    "Read the exact id through fleet.wiki.read and verify the reconstructed post.", 8192,
    "wiki,find,search,knowledge,lessons",
    "zcl.fleet_wiki_find_input.v1", "zcl.fleet_wiki_find.v1",
    "q,topic,applies_to,after_slug", "q",
    "z23 fleet wiki find push-gate",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_FOREGROUND,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_wiki_find)

ZCL_COMMAND_READY_READ(
    "fleet.wiki.history", "fleet.wiki", "",
    "Every revision of one page, newest first",
    "Pass target=<exact revision id> for signed typed reviews from all reviewers, one statement per immutable-id page; continue with after_id while has_more. Complete signed evidence must fit the caller's measured response allowance; REVIEW_BUDGET returns no page or advanced cursor, so retry the same input cursor with a larger budget. target_resolved and lineage_valid distinguish unavailable evidence; graph_complete=false makes current/fork unknown. Forks retain their branches and no global score is computed. Otherwise all revisions of this slug that this node holds, newest first, each with "
    "its own signature and author. Nothing is rewritten: the history is how a "
    "reader sees what a page used to say and who changed it.",
    ZCL_COMMAND_LIST_BUDGET,
    "wiki,history,revisions",
    "zcl.fleet_wiki_ref_input.v1", "zcl.fleet_board_list.v1",
    "slug,target,after_id", "slug",
    "z23 fleet wiki history push-gate",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_wiki_history)
