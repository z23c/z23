/* One-paste fleet enrolment: how an owner adds a computer to the fleet.
 *
 * WHAT THIS BRANCH IS. Five leaves and one ceremony, plus `fleet roster head`,
 * which signs the revocation list `fleet import` also accepts. `fleet invite` on the
 * manager prints a single signed line. The owner pastes it into the AI agent
 * on the new computer, which clones, builds and runs `fleet join`. That
 * prints a second single line — the box's signed enrolment receipt — which
 * the owner pastes back on the manager as `fleet admit`. `fleet machines`
 * then lists what the fleet holds, and `fleet import` copies one sealed
 * roster line onto a box that is not the manager, checked against the
 * operator key that box trusts. Two pastes, three commands, no ports to
 * open and no node required on either end.
 *
 * NAMES. Every machine has one required, unique, human-readable name,
 * chosen by the owner at `fleet invite --name=`. It leads every reply and
 * every refusal, because it is how people talk about a computer. A box's
 * onion address, Noise fingerprint and ZID are observed facts that rotate;
 * none of them is ever the name. Renaming is not an edit: the name is bound
 * inside the box's own signature over its receipt, so a rename would need
 * its own operator-signed record kind and is deliberately not here.
 *
 * WHAT THIS BRANCH IS NOT. It is not mesh pairing and it does not grant
 * terminal execution. A machine row is an INVENTORY record: this owner
 * admitted this box under this name. Capability grants stay where they were
 * — `ops mesh pair commit` and the pairing store — and `fleet join` names
 * that as the next step rather than doing it. The ssh line `fleet admit`
 * can add is a BRIDGE: one restricted loopback port forward, never a shell.
 *
 * TRUST. The token carries the operator's public key and is signed by it,
 * so the box trusts the key the owner carried to it (trust on paste) and the
 * manager honours only invites its own key minted. Nothing private is ever
 * in either pasted string.
 *
 * Consumer defines ZCL_COMMAND_*; see engine/composition/src/command_catalog.c.
 * The `fleet` root branch is declared in
 * engine/composition/commands/fleet_board.def, which this file follows. */

ZCL_COMMAND_READY_COMMAND(
    "fleet.invite", "fleet", "",
    "Mint one signed invite line that adds a computer to this fleet",
    "One line of about three hundred characters: `z23 fleet join <token>`. "
    "--name is REQUIRED and is the human handle every fleet leaf prints "
    "first: 2 to 24 characters of a-z, 0-9 and interior dashes, unique "
    "across this fleet. A box's onion address, Noise fingerprint and ZID "
    "are observed facts that may rotate; none of them is ever its name. "
    "The token names the box, an expiry, a one-time nonce, an optional relay "
    "endpoint and this box's operator public key, all signed by this box's "
    "fleet key (created on first use). Nothing private is in it — a leaked "
    "token can enrol one box under that name, once, before it expires, and "
    "the machine row it produces still has to be admitted here. The nonce "
    "is drawn from this host's CSPRNG on every mint, so two invites never "
    "share one and admitting the second machine is never a replay. Refuses "
    "by name: invite_name_invalid, invite_ttl_invalid, "
    "invite_relay_invalid, invite_nonce_unavailable, "
    "box_key_unwritable. With `datadir` (or the CLI --datadir) the reply "
    "reports `operator_anchor`: whether the "
    "operator_pubkey printed here is yet an active ZID anchor (anchor it "
    "with `z23 core identity anchor`; nothing here requires it).", 0,
    "fleet,invite,enrol,join,token,machine,paste",
    "zcl.fleet_invite_input.v1", "zcl.fleet.invite.v1",
    "name,ttl_hours,relay,datadir", "name",
    "z23 fleet invite --name=studio --ttl-hours=24",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_fleet_enrol_dispatch)

ZCL_COMMAND_READY_COMMAND(
    "fleet.join", "fleet", "",
    "Join this computer to a fleet from one pasted invite",
    "Verifies the invite against the operator public key the invite itself "
    "carries, records that key as this box's fleet operator, creates this "
    "box's own Ed25519 key under the owner-private state root, collects what "
    "this box can honestly say about itself, and signs one enrolment "
    "receipt. The receipt is printed as `z23 fleet admit <receipt>` for the "
    "owner to paste back on the manager; it is NOT sent anywhere, so no port "
    "and no reachable relay is needed. Every fact in it is self-reported: "
    "this box signed it, nobody measured it. Refuses by name: "
    "invite_malformed, invite_signature_invalid, invite_expired, "
    "join_onion_invalid, box_key_unwritable. Optional --onion records the "
    "persistent onion hostname this box will answer on, beside its name and "
    "signed with the rest of the receipt; it is self-reported until a peer "
    "dials it.", 0,
    "fleet,join,enrol,invite,receipt,machine,onboarding,onion",
    "zcl.fleet_join_input.v1", "zcl.fleet.join.v1",
    "token,onion", "token",
    "z23 fleet join <token> [--onion=<v3>.onion]",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_fleet_enrol_dispatch)

ZCL_COMMAND_READY_COMMAND(
    "fleet.admit", "fleet", "",
    "Admit one joined computer to this fleet's machine roster",
    "Re-checks that the invite inside the receipt was minted by THIS box's "
    "key, that its nonce has never been spent, that the name is free, and "
    "that the box signed its own facts; then appends one operator-sealed row "
    "to the machine roster and assigns a relay port from a closed range. "
    "When the receipt carried a dedicated ~/.ssh/z23_fleet.pub, it also adds "
    "ONE `restrict,port-forwarding,permitlisten=` line to the operator's "
    "authorized_keys — a loopback port forward, never a shell, never agent "
    "or X11 forwarding — idempotent per box name; pass --bridge=no to skip "
    "it. Re-admitting the same box key keeps its existing port and adds "
    "nothing. Refuses by name: receipt_malformed, box_signature_invalid, "
    "invite_not_ours, invite_expired, invite_replayed, invite_name_taken, "
    "roster_full, roster_unwritable. With --require_anchor=yes it also refuses, "
    "before anything is checked or spent, unless this box's operator key is "
    "an active ZID anchor in the node.db read (fleet_root_not_anchored, "
    "fleet_root_rotated, fleet_root_revoked, fleet_root_anchor_unverifiable); "
    "without it the reply only reports `operator_anchor`.", 0,
    "fleet,admit,enrol,roster,machine,bridge,ssh",
    "zcl.fleet_admit_input.v1", "zcl.fleet.admit.v1",
    "receipt,bridge,datadir,require_anchor", "receipt",
    "z23 fleet admit <receipt>",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_fleet_enrol_dispatch)

ZCL_COMMAND_READY_COMMAND(
    "fleet.roster.head", "fleet", "",
    "Sign a roster head that revokes lost or retired computers",
    "Signs one roster HEAD with this box's operator key and prints it as a "
    "single line for pasting into `fleet import` on every box, this one "
    "included. A head carries a sequence number (--seq, at least 1, and "
    "higher than the last head you minted: boxes refuse a lower one) and "
    "the set of box public keys (--revoke, comma-separated 64-hex "
    "box_pubkey values from `fleet machines`; omit it to revoke nobody) "
    "that this fleet no longer admits. The set is sorted and de-duplicated "
    "before it is sealed, so two heads with the same content are the same "
    "bytes. A revoked box's roster row is refused at import and its signing "
    "key is dropped from the roster the relay gate reads. Writes nothing on "
    "this box; importing the printed line is a separate act. Refuses by "
    "name: fleet_head_invalid, fleet_head_too_large (a head longer than "
    "`fleet import` accepts in one line), fleet_operator_unknown.", 0,
    "fleet,roster,head,revoke,revocation,operator,sequence",
    "zcl.fleet_roster_head_input.v1", "zcl.fleet.roster.head.v1",
    "revoke,seq", "seq",
    "z23 fleet roster head --seq=1 --revoke=<box_pubkey>",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_fleet_enrol_dispatch)

ZCL_COMMAND_READY_COMMAND(
    "fleet.import", "fleet", "",
    "Copy one manager-sealed roster line onto this box's machine roster",
    "How a box that is not the manager learns which machines its fleet "
    "holds: paste one whole line from the manager's roster. The line is "
    "checked against the operator key this box already holds — the one "
    "`fleet join` recorded, or this box's own key on the manager — BEFORE "
    "anything is written, so a line sealed by any other key, or a sealed "
    "line with one byte changed, is refused and the roster is untouched. "
    "Importing a machine already on the roster adds nothing (appended "
    "false). Writes only this box's own roster file; grants no role, adds "
    "no ssh line and asks no node. Refuses by name: "
    "roster_line_not_operator_sealed, fleet_operator_unknown, "
    "invite_name_taken, roster_unwritable. With --require_anchor=yes a line the "
    "operator key sealed is refused unless that key is an active ZID anchor "
    "in the node.db read (fleet_root_not_anchored, fleet_root_rotated, "
    "fleet_root_revoked, fleet_root_anchor_unverifiable); a line it did not "
    "seal is still roster_line_not_operator_sealed. The line may instead be "
    "a roster HEAD minted by `fleet roster head`: an operator-sealed "
    "sequence number and the box public keys the fleet has revoked. A head "
    "with a lower sequence than the one held is refused (fleet_head_stale), "
    "the same sequence and bytes is a no-op, the same sequence with "
    "different bytes is refused (fleet_head_conflict), and a higher "
    "sequence replaces it. A machine row for a revoked box is refused "
    "(fleet_box_revoked), and a stored head this box cannot verify refuses "
    "every row (fleet_head_unreadable) and admits no peer: it fails closed. "
    "The first successful import pins the operator key it came from; a "
    "later import under a different operator key is refused "
    "(fleet_root_changed) unless the input carries "
    "confirm_operator_change=yes, which re-pins. Only the exact word yes "
    "counts.", 0,
    "fleet,import,roster,machine,enrol,operator,verify",
    "zcl.fleet_import_input.v1", "zcl.fleet.import.v1",
    "line,datadir,require_anchor,confirm_operator_change", "line",
    "z23 fleet import <roster-line>",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_fleet_enrol_dispatch)

ZCL_COMMAND_READY_READ(
    "fleet.machines", "fleet", "",
    "List the computers this owner has admitted to the fleet",
    "Verified roster rows, oldest first, each split into `verified` (what "
    "the operator signature attests: name, box public key, relay port, "
    "enrolment time) and `self_reported` (what the box said about its own "
    "hardware, OS and toolchain — signed by that box, measured by nobody). "
    "The two are never merged. The NAME leads every row and does not change "
    "with the box's onion address, Noise fingerprint or ZID. Rows this "
    "operator key did not seal are counted in `unverifiable` and never "
    "rendered, and they do not consume a page slot. Optional `offset` and "
    "`limit` select one page of verified rows; `limit` is at least 1 and is "
    "capped at the render maximum, so a hand-grown roster past that cap is "
    "reached by a later offset rather than a larger reply. `total` counts "
    "every verified row, `returned` is this page, `truncated` means a later "
    "page exists, and `next_offset` is -1 on the last page. Absent keys "
    "read the first page. Reads no node: when the CLI was given --datadir it "
    "opens that node.db READ-ONLY, never creating it, and reports "
    "`operator_anchor` — whether this fleet's operator key "
    "is an active ZID anchor (state active, rotated, revoked, not_anchored, "
    "unchecked or unreadable). That state is reported, never enforced: an "
    "enrolment made before the key was anchored still lists.",
    /* One page is at most the roster render cap, so the largest answer
     * stays inside this budget. The next page is next_offset. */
    65536,
    "fleet,machines,roster,inventory,verified,self-reported",
    "zcl.fleet_machines_input.v1", "zcl.fleet.machines.v1",
    "offset,limit", "",
    "z23 fleet machines --input='{\"offset\":0,\"limit\":64}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_fleet_enrol_dispatch)

ZCL_COMMAND_READY_READ(
    "fleet.doctor", "fleet", "",
    "Where this node is in fleet setup, and what to run next",
    "One read-only checklist, in this order: node, identity, membership, "
    "delegation, transport, pairing, mail, wiki. Each check is ok, missing, "
    "blocked or unknown, with one plain sentence and an existing command to "
    "run next; the top-level state is the worst check and the top-level next "
    "is the first command named. Composes reads that already exist (the "
    "node's peer list and machine identity, fleet.machines, fleet.nodes.table "
    "and the wiki list), so it writes nothing and prints public "
    "fingerprints only. Node calls share a six second deadline; machine and "
    "pairing lists stop at 64 rows. Checks that need the running node are "
    "blocked while none answers. The agent mail store is a developer tool and "
    "is reported unknown with its z23-dev command.",
    32768,
    "fleet,doctor,setup,status,checklist,next,onboarding",
    "zcl.fleet_doctor_input.v1", "zcl.fleet_doctor.v1", "datadir", "",
    "z23 fleet doctor",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_LATENCY_FOREGROUND,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_doctor)
