    "metaverse,space,scout,run,portal,policy,deadline,evidence",
    "zcl.metaverse_space_scout_run.input.v1",
    "zcl.metaverse_space_scout_run.v1",
    "starting_roots,observation_unix,maximum_depth,maximum_spaces,maximum_portals,maximum_bytes,deadline_ms,plan_token,confirm,workspace,datadir",
    "", "z23 metaverse space scout run --input='<confirmed-mission-json>'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_metaverse_space_scout_run)

ZCL_COMMAND_READY_READ(
    "metaverse.space.scout.show", "metaverse.space.scout", "",
    "Show one signed local scout attestation and its canonical evidence map",
    "Loads the attestation root, verifies its observer delegation/signature, "
    "loads and re-derives the linked deterministic map root, and renders every "
    "visited root, owner, advertised service, portal outcome, typed failure, "
    "policy denial count and truncation reason. The result explicitly remains "
    "local evidence, never authority or global truth.",
    ZCL_COMMAND_LIST_BUDGET,
    "metaverse,space,scout,show,map,attestation,local-evidence",
    "zcl.metaverse_space_scout_show.input.v1",
    "zcl.metaverse_space_scout_show.v1",
    "root,workspace,datadir", "root",
    "z23 metaverse space scout show <attestation-root>",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE,
    zcl_native_handle_metaverse_space_scout_show)

ZCL_COMMAND_BRANCH("metaverse.build", "metaverse",
                   "Content-addressed C23 build jobs, actions, and receipts",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_COMMAND(
    "metaverse.build.plan", "metaverse.build", "",
    "Persist one immutable preprocessed C23 compile action",
    "Computes domain-separated build_action.v1 and build_job.v1 identities "
    "from pre-hashed source, toolchain, flags, environment, and preprocessed "
    "TU inputs, then atomically records a SNAPSHOTTED "
    "c23.compile.preprocessed.v1 action. V1 fixes target linux-x86_64-v3, "
    "virtual root /zbuild/src, output unit.o, no network, and bounded CPU, "
    "memory, and time. Repeating identical inputs is idempotent; an identity "
    "collision with different immutable inputs refuses.",
    0, "metaverse,build,plan,c23,compile,sha3,immutable",
    "zcl.build_plan.input.v1", "zcl.build_plan.v1",
    "source_sha256,source_cas_sha3,toolchain_sha3,input_root_sha3,flags_sha3,environment_sha3,profile,datadir",
    "source_sha256,source_cas_sha3,toolchain_sha3,input_root_sha3,flags_sha3,environment_sha3,profile",
    "z23 metaverse build plan --input='{\"source_sha256\":\"<64hex>\",\"source_cas_sha3\":\"<64hex>\",\"toolchain_sha3\":\"<64hex>\",\"input_root_sha3\":\"<64hex>\",\"flags_sha3\":\"<64hex>\",\"environment_sha3\":\"<64hex>\",\"profile\":\"dev\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW, ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_metaverse_build_plan)

ZCL_COMMAND_READY_COMMAND(
    "metaverse.build.submit", "metaverse.build", "",
    "Queue every action in one planned build",
    "Atomically advances a planned build and each nonterminal action to "
    "QUEUED. It records coordinator intent only; worker loss or timeout is "
    "resolved by the coordinator as a named LOCAL_FALLBACK, never by this "
    "command waiting on a peer. Re-submission of an already queued job is "
    "idempotent.",
    0, "metaverse,build,submit,queue,idempotent",
    "zcl.build_submit.input.v1", "zcl.build_job.v1",
    "job_id,datadir", "job_id",
    "z23 metaverse build submit <job_id>",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW, ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_metaverse_build_submit)

ZCL_COMMAND_READY_READ(
