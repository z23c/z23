    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_metaverse_space_show)

ZCL_COMMAND_READY_READ(
    "metaverse.space.status", "metaverse.space", "",
    "Explain whether this node can publish, discover, or scout a Space",
    "Composes the existing identity/delegation, authenticated DHT, package "
    "store, sovereignty-policy, Space CAS and local signed-record owners into "
    "one non-creating readiness view. An optional exact semantic root adds "
    "local manifest/descriptor visibility plus publication and declared "
    "replication state. Replies expose readiness booleans, counts, blocker "
    "codes and one safe next command—never keys, identities, peer addresses, "
    "private policy rules, endpoints, or filesystem paths.",
    ZCL_COMMAND_RESULT_BUDGET,
    "metaverse,space,status,readiness,blockers,publication,replication",
    "zcl.metaverse_space_status.input.v1",
    "zcl.metaverse_space_status.v1",
    "root,kind,workspace,datadir", "",
    "z23 metaverse space status --input='{\"root\":\"<64hex>\",\"kind\":\"space_manifest\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_metaverse_space_status)

ZCL_COMMAND_READY_COMMAND(
    "metaverse.space.publish", "metaverse.space", "",
    "Publish one local space object through the existing signed DHT",
    "Revalidates the local CAS object, derives a bounded generic blob carrier, "
    "and checks this node's STORE, INDEX, SERVE and FORWARD policy before any "
    "write. It then publishes existing generic POINTER and PROVIDER records "
    "under the space.manifest or space.service namespace; it introduces no "
    "second discovery protocol. Manifest publication also requires current "
    "chain authorization. Publication never executes object contents.",
    0, "metaverse,space,publish,dht,provider,pointer,policy",
    "zcl.metaverse_space_publish.input.v1", "zcl.metaverse_space_publish.v1",
    "root,workspace,datadir", "root",
    "z23 metaverse space publish <64hex>",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_metaverse_space_publish)

ZCL_COMMAND_READY_COMMAND(
    "metaverse.space.discover", "metaverse.space", "",
    "Discover one exact space root under local admission policy",
    "Looks up generic signed POINTER records for one exact semantic root, "
    "deterministically filters conflicts and superseded records, then routes "
    "only through authenticated restricted PROVIDER records. DISCOVER and "
    "FETCH policy are checked before routing; STORE and INDEX policy are "
    "rechecked after bytes are verified and before local CAS admission. The "
    "reply distinguishes pointer publisher evidence from the manifest owner. "
    "Operational outcomes are closed as present, pending, blocked, not_found "
    "or invalid, with retryability, the exact phase, bounded progress and one "
    "safe next action. A foreground call spends at most ten seconds trying to "
    "finish a scheduled healthy fetch. No candidate can trigger execution or "
    "confer authority.",
    0, "metaverse,space,discover,dht,provider,policy,admission",
    "zcl.metaverse_space_discover.input.v1", "zcl.metaverse_space_discover.v1",
    "root,kind,workspace,datadir", "root",
    "z23 metaverse space discover <64hex> --kind=space_manifest",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_metaverse_space_discover)

ZCL_COMMAND_BRANCH("metaverse.space.scout", "metaverse.space",
                   "Bounded read-only space missions and signed local evidence",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_READ(
    "metaverse.space.scout.plan", "metaverse.space.scout", "",
    "Plan one bounded read-only traversal of sovereign spaces",
    "Canonicalizes sorted starting roots plus explicit depth, space, portal, "
    "byte and monotonic-duration caps under the local observer's network. "
    "Returns an exact stateless plan token and writes nothing. Planning grants "
    "no interaction or execution authority.",
