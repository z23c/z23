/* METAVERSE — sovereign digital property: PRINCIPAL -> PROPERTY -> RIGHTS ->
 * ACTION -> RECEIPT. This file is jointly owned by the peer lanes that
 * declare leaves under the `metaverse` root; keep one branch row per level
 * and do not declare a second `metaverse` branch in another .def file.
 *
 * `metaverse.agent` — the confined-agent broker's two observation surfaces.
 * Both leaves are READ-ONLY and node-free: they read a broker directory that
 * an operator names, and they CREATE NOTHING. A missing directory is an
 * explicit not-present verdict, never an implicit mkdir — see the read-leaf
 * contract in docs/NATIVE_COMMAND_INTERFACE.md.
 *
 * `metaverse.property` — the READ half of the property catalog.
 *
 * THE INVARIANT OF THIS BRANCH: there is no second ownership truth. The
 * catalog is a PROJECTION rebuilt at call time over the models that already
 * own each kind (the package store, the blob store, and — as their readers
 * are wired — ZNAM, ZSLP, the store, and the swap contracts). It caches no
 * owner, no revision, and no status, so it cannot disagree with them. Both
 * leaves here are strictly read-only, including on open: they reach store
 * bytes by path and never open a handle whose open() rewrites the datadir.
 *
 * Every view states its EVIDENCE GRADE — what THIS node checked, in this
 * call. `local_content_hash` means a root re-derived from bytes held here;
 * `local_signature` adds a publisher signature verified during the call;
 * only `chain_validated_local` is chain-bound, and `chain_bound` is emitted
 * as its own boolean so no consumer has to infer it. There is no grade that
 * means "verified" in the abstract.
 *
 * Every view ALSO states its SETTLEMENT CLASS, which is a different
 * question: the evidence grade says what this node checked, the settlement
 * class says what kind of answer the authority gives at all.
 * `content_addressed` — the id is a hash; anyone can recheck it with no
 * authority. `proof_of_work` — ownership is an ordering settled by
 * accumulated work, and the `work` block reports the anchor height,
 * confirmation depth, and chainwork since the anchor. `local_declaration`
 * — this node asserts it and nothing outside this node has agreed.
 * `chain_anchored_incomplete` — the record points at an on-chain object
 * this node tracks no anchor height for. The `work` block appears on every
 * view: for anything but a proof-of-work kind it reports measurable=false
 * with a named gap and -1 in every number, because "does not apply" and
 * "zero confirmations" are different facts. No field ranks, scores, or
 * rates a property; the surface reports the mechanism and the measurement.
 *
 * Consumer defines ZCL_COMMAND_*; see engine/composition/src/command_catalog.c. */

ZCL_COMMAND_BRANCH("metaverse", "",
                   "Sovereign digital property: catalog, rights, receipts",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_BRANCH("metaverse.agent", "metaverse",
                   "Confined agents acting under a scoped grant",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_READ(
    "metaverse.agent.status", "metaverse.agent", "",
    "What confinement the agent broker actually achieved",
    "The confined-agent broker's recorded state for one broker directory: the "
    "broker and agent pids, the socket, the SO_PEERCRED identity the broker "
    "accepted, the grant's id and fingerprint (never the grant itself), and the "
    "counts of requests served, refused, and receipted. The confinement block "
    "reports what the agent ACHIEVED, not what was requested: `agent_uid_"
    "posture` is separate_uid only where a real uid switch happened and "
    "same_uid where the host allowed no such switch, and the Landlock and "
    "seccomp flags are the broker's and the child's own measurements. A "
    "directory with no broker.json answers broker_state_present=false with a "
    "reason; a recorded broker pid that is no longer alive answers "
    "broker_running=false rather than implying liveness from the file.",
    ZCL_COMMAND_LIST_BUDGET,
    "metaverse,agent,broker,confinement,landlock,seccomp,peercred,grant",
    "zcl.metaverse_agent_status.input.v1", "zcl.metaverse_agent_status.v1",
    "dir", "dir",
    "z23 metaverse agent status --dir=/tmp/mv-broker",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_INSTANT, ZCL_COMMAND_COST_TINY,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_metaverse_agent_status)

ZCL_COMMAND_READY_READ(
    "metaverse.agent.money", "metaverse.agent", "",
    "Identity-bound dev/prod custody, never an implied zero",
    "Reconciles the owner-created dev and prod wallet bindings in one broker "
    "directory against each running node's persistent wallet identity and "
    "authoritative vault/intent readers. Every wallet reports CURRENT, "
    "UNKNOWN, STALE, or CONFLICTED with completeness, reason, confirmed, "
    "pending, encumbered, intent-reserved, and agent-available ZCL plus tip "
    "and observation evidence. Missing or unreachable readers never collapse "
    "to zero. The portfolio total appears only when both assigned wallets are "
    "current and complete. Output contains no endpoint, datadir, address, key, "
    "or grant token.",
    ZCL_COMMAND_LIST_BUDGET,
    "metaverse,agent,money,custody,wallet,balance,identity,reserve",
    "zcl.metaverse_agent_money.input.v1", "zcl.metaverse_agent_money.v1",
    "dir", "dir",
    "z23 metaverse agent money --dir=/tmp/mv-broker",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_metaverse_agent_money)

ZCL_COMMAND_READY_READ(
    "metaverse.agent.liquidity", "metaverse.agent", "",
    "Plan parallel transaction liquidity without moving funds",
    "Reads one explicitly bound dev or prod wallet through the broker and "
    "reports whether the requested number of simultaneous payments has enough "
    "independent reservation-eligible transparent UTXOs. Exact recipient value "
    "plus maximum fee is budgeted per slot. If value exists but coin fan-out is "
    "needed, returns aggregate output count/value and the existing vault-intent "
    "address/plan/commit route. This is advisory: it creates no address, plan, "
    "reservation, signature, transaction, or automatic rebalance. Missing, "
    "stale, conflicting, or unreachable custody remains explicit and no "
    "address, outpoint, endpoint, datadir, key, or grant token is returned.",
    ZCL_COMMAND_LIST_BUDGET,
    "metaverse,agent,liquidity,utxo,fanout,parallel,transaction,plan",
    "zcl.metaverse_agent_liquidity.input.v1",
    "zcl.metaverse_agent_liquidity.v1",
    "dir,wallet_scope,recipient_value_zat,maximum_fee_zat,concurrency",
    "dir,wallet_scope,recipient_value_zat,maximum_fee_zat,concurrency",
    "z23 metaverse agent liquidity --input='{\"dir\":\"/private/broker\",\"wallet_scope\":\"dev\",\"recipient_value_zat\":1000,\"maximum_fee_zat\":10000,\"concurrency\":10}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE,
    zcl_native_handle_metaverse_agent_liquidity)

ZCL_COMMAND_READY_READ(
    "metaverse.agent.audit", "metaverse.agent", "",
    "Every action the confined agent took, and whether the log is intact",
    "The broker's append-only receipt log for one broker directory, verified "
    "before it is rendered. Each receipt commits to the previous receipt's id "
    "and is Ed25519-signed over that id, so the verdict block separates the "
    "three ways a log can be wrong: `chain_breaks` (a row was edited, "
    "reordered, or removed), `bad_signatures` (a row was written by something "
    "other than this broker), and `malformed` (a row does not parse). "
    "`tamper_evident_ok` is true only when the log has at least one row and all "
    "three counters are zero — an empty or absent log is never reported as "
    "verified. The rendered tail is bounded by `limit`; the verdict always "
    "covers the whole file, not just the tail.",
    ZCL_COMMAND_LIST_BUDGET,
    "metaverse,agent,audit,receipt,tamper,chain,signature,evidence",
    "zcl.metaverse_agent_audit.input.v1", "zcl.metaverse_agent_audit.v1",
    "dir,limit", "dir",
    "z23 metaverse agent audit --dir=/tmp/mv-broker",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_metaverse_agent_audit)

ZCL_COMMAND_BRANCH("metaverse.property", "metaverse",
                   "What property exists, who controls it, and how we know",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_READ(
    "metaverse.property.list", "metaverse.property", "",
    "Every property this datadir holds, one row per kind scanned",
    "A bounded page of property views projected at call time from each "
    "kind's own authoritative model — never from a catalog table, because "
    "there is none. Each item carries property_id, kind, authority_source, "
    "settlement (+ settlement_means), immutable/content/descriptor roots, "
    "owner principal, revision, status, provenance, evidence_grade (+ the "
    "explicit chain_bound boolean), a `work` block, and the "
    "actions its CURRENT state supports (availability, not authority — "
    "intersect with a grant before acting). Every property kind emits a row "
    "in `kinds[]` even when its reader is not wired, with "
    "available:false and the exact reason: a kind dropped from the output "
    "would be indistinguishable from a kind that owns nothing. Each of "
    "those rows also states its settlement class, so the mix of "
    "hash-verifiable, work-settled, and merely locally-asserted kinds is "
    "visible without opening a single property. `total` is "
    "the real inventory and `items_truncated` says when the page is shorter "
    "than it. Narrow with `kind`; unscanned kinds are still listed, marked "
    "not-scanned.",
    ZCL_COMMAND_LIST_BUDGET,
    "metaverse,property,catalog,own,inventory,evidence,kind",
    "zcl.metaverse_property_list.input.v1", "zcl.metaverse_property_list.v1",
    "kind,limit,datadir", "kind",
    "z23 metaverse property list",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE,
    zcl_native_handle_metaverse_property_list)

ZCL_COMMAND_READY_READ(
    "metaverse.property.show", "metaverse.property", "",
    "One property: its roots, controller, status, and evidence grade",
    "The full current view of one property named by `property_id` "
    "('<kind>:<64-hex immutable root>'), re-derived from the authoritative "
    "model during this call — so an object that changed or disappeared "
    "since the last read is reflected here, never served from a cache. "
    "`status` is present|incomplete|absent|unknown; absent is a determined "
    "verdict (the authority was asked and holds nothing), not a lookup "
    "failure. `evidence_grade` names what this node checked and "
    "`evidence_source` names the primitive that answered it; "
    "`has_freshness_height` is false for every kind whose authority is not "
    "chain-anchored, because stamping a tip height beside a claim the tip "
    "does not commit would be a false freshness claim. `settlement` names "
    "what kind of answer the authority gives — a hash anyone can recheck, "
    "an ordering settled by accumulated work, a bare assertion by this "
    "node, or a chain reference with no anchor height tracked — and "
    "`settlement_means` spells it out. The `work` block quantifies only the "
    "work-settled case (anchor_height, confirmation_depth, "
    "chainwork_since_anchor); for every other kind it reports "
    "measurable:false with a named gap and -1 in each number, never a zero "
    "that could be read as a measurement. A kind whose reader "
    "is not wired is refused by name (KIND_UNAVAILABLE), never answered "
    "empty.",
    ZCL_COMMAND_LIST_BUDGET,
    "metaverse,property,show,detail,evidence,owner,root",
    "zcl.metaverse_property_show.input.v1", "zcl.metaverse_property_show.v1",
    "property_id,datadir", "property_id",
    "z23 metaverse property show content:<64hex>",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE,
    zcl_native_handle_metaverse_property_show)

ZCL_COMMAND_BRANCH("metaverse.space", "metaverse",
                   "Signed sovereign spaces and generic typed services",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_READ(
    "metaverse.space.plan", "metaverse.space", "",
    "Plan one signed space manifest or typed service descriptor",
    "Canonicalizes and validates either a read-only service_descriptor.v1 or "
    "a delegated, expiring space_manifest.v1, then returns its semantic root "
    "and an exact stateless plan token. Planning writes no CAS bytes, DHT "
    "records, policy rows, or indexes. A manifest signature proves its ZID "
    "delegation only when the running node independently confirms that "
    "delegation against current chain state. Service descriptors carry roots "
    "and read verbs only: they grant no authority and are never executable.",
    ZCL_COMMAND_RESULT_BUDGET,
    "metaverse,space,manifest,service,plan,signature,sovereignty",
    "zcl.metaverse_space_plan.input.v1", "zcl.metaverse_space_plan.v1",
    "kind,protocol_root,read_only_verbs,object_roots,capability_roots,sequence,not_before,expiry,name,description,service_roots,portal_roots,admission_root,datadir",
    "kind",
    "z23 metaverse space plan --input='{\"kind\":\"service_descriptor\",\"protocol_root\":\"<64hex>\",\"read_only_verbs\":[\"discover\"]}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_metaverse_space_plan)

ZCL_COMMAND_READY_COMMAND(
    "metaverse.space.commit", "metaverse.space", "",
    "Commit one exactly planned space object to local CAS",
    "Requires confirm:true and the exact stateless plan token, revalidates the "
    "whole object and current local STORE and INDEX policy, then writes the "
    "canonical bytes to the named workspace CAS. Existing bytes are re-read "
    "and re-hashed before an idempotent success; a corrupt or colliding object "
    "fails closed. This does not publish, fetch, execute, or grant authority.",
    0, "metaverse,space,manifest,service,commit,cas,policy",
    "zcl.metaverse_space_commit.input.v1", "zcl.metaverse_space_commit.v1",
    "kind,protocol_root,read_only_verbs,object_roots,capability_roots,sequence,not_before,expiry,name,description,service_roots,portal_roots,admission_root,plan_token,confirm,datadir,workspace",
    "kind,plan_token,confirm",
    "z23 metaverse space commit --input='{\"kind\":\"service_descriptor\",\"protocol_root\":\"<64hex>\",\"read_only_verbs\":[\"discover\"],\"plan_token\":\"<64hex>\",\"confirm\":true}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_metaverse_space_commit)

ZCL_COMMAND_READY_READ(
    "metaverse.space.show", "metaverse.space", "",
    "Re-derive one local space object and its evidence grade",
    "Reads canonical CAS bytes by semantic root and re-derives the root and "
    "typed contents. A manifest reports its preserved signature evidence, "
    "current validity window and current chain-authorization separately; an "
    "expired manifest remains inspectable but is not called chain-bound. A "
    "service descriptor is content-hash evidence only and never executable.",
    ZCL_COMMAND_RESULT_BUDGET, "metaverse,space,show,evidence,cas,signature",
    "zcl.metaverse_space_show.input.v1", "zcl.metaverse_space_show.v1",
    "root,workspace,datadir", "root",
    "z23 metaverse space show <64hex>",
