ZCL_COMMAND_BRANCH("ops.mesh.device.psk", "ops.mesh.device", "HOST hash-PSK secret files", ZCL_COMMAND_LAYER_OPS)
ZCL_COMMAND_READY_COMMAND(
    "ops.mesh.device.psk.new", "ops.mesh.device.psk", "",
    "Create a new 32-byte HOST PSK file and print its fingerprint",
    "Writes 32 host CSPRNG bytes to a NEW file (O_CREAT|O_EXCL|O_NOFOLLOW, mode 0600) beneath an existing owner-private 0700 parent, then fsyncs file and directory. An existing path or symlink refuses with PSK_KEY_EXISTS. The reply carries only psk_fingerprint, the first 16 hex of domain-separated SHA3-256 over the key, never key bytes or path; commit secret_file shows the same fingerprint for out-of-band comparison. No grant, import or service.",
    ZCL_COMMAND_RESULT_BUDGET, "mesh,device,host,psk,secret,keygen,offline",
