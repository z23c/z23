    "zcl.command.empty_input.v1", "zcl.rom_seed_status.v1", "", "",
    "z23 ops debug rom_seed enable",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_rom_seed_enable)
ZCL_COMMAND_READY_COMMAND(
    "ops.debug.rom_seed.disable", "ops.debug.rom_seed", "",
    "Disable ROM-seed serving",
    "The settled policy+counters state after turning ROM-seed serving off "
    "(new uploads are refused; the caller is expected to consult "
    "rom_seed_policy_admit_upload on its existing serve path); idempotent, "
    "so disabling an already-disabled policy returns the same settled "
    "state.", 0,
    "rom,seed,disable,policy",
    "zcl.command.empty_input.v1", "zcl.rom_seed_status.v1", "", "",
    "z23 ops debug rom_seed disable",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_rom_seed_disable)
ZCL_COMMAND_READY_READ(
    "ops.debug.rom_seed.artifacts", "ops.debug.rom_seed", "",
    "List served ROM artifacts + seed stats",
    "Every artifact this node has served at least one chunk of, with "
    "bytes/chunks/distinct-peer totals folded from the local serve-log "
    "ledger; the seed engine's artifact registry (digests, names) joins in "
    "once that lane is wired, reported honestly absent until then.",
    ZCL_COMMAND_LIST_BUDGET,
    "rom,seed,artifacts,ledger,stats",
    "zcl.command.empty_input.v1", "zcl.rom_seed_artifacts.v1", "", "",
    "z23 ops debug rom_seed artifacts",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_PUBLIC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_rom_seed_artifacts)
ZCL_COMMAND_READY_COMMAND(
    "ops.debug.rom_seed.publish", "ops.debug.rom_seed", "",
    "Publish this node's starter artifacts to the swarm",
    "The now-served ROM artifact catalog after a single idempotent re-scan of "
    "<datadir> + <datadir>/bundles/: every consensus-state bundle and header-"
    "chain seed already on disk is (re)registered with the seeder — carrying "
    "the artifact-kind the discovery quorum requires — so a fresh peer's "
    "directory listing advertises a usable manifest. Publishes only content-"
    "verified files already present (produces none; the standing exporter owns "
    "production, dumpstate bundle_exporter); a corrupt/wrong-kind file is "
    "refused and never offered. Reflects the registry at call time.",
    ZCL_COMMAND_LIST_BUDGET,
    "rom,seed,publish,register,bundle,starter,serve,swarm",
    "zcl.command.empty_input.v1", "zcl.rom_seed_publish.v1", "", "",
    "z23 ops debug rom_seed publish",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_rom_seed_publish)

/* ROM-fetch engine (the CLIENT half of docs/ROM_DELIVERY.md;
 * engine/controllers/src/rom_fetch_controller.c, core/modules/net/include/net/rom_fetch.h).
 * Same `ops.debug` nesting as ops.debug.rom_seed (top-level ops is at its
 * ZCL_COMMAND_BRANCH_BUDGET ceiling). The `bundle` leaf takes the expected
 * digests as EXPLICIT operator input — the operator commits to the content
 * before a byte is fetched; the engine downloads + content-verifies and
 * leaves the file in the datadir. It is NOT an activation path: install
 * funnels only through -install-consensus-bundle (the unified installer's
 * RECEIPT / CHECKPOINT_CONTENT authority). */
ZCL_COMMAND_BRANCH("ops.debug.rom_fetch", "ops.debug", "ROM-fetch engine",
                   ZCL_COMMAND_LAYER_OPS)
ZCL_COMMAND_READY_READ(
    "ops.debug.rom_fetch.status", "ops.debug.rom_fetch", "",
    "ROM-fetch engine status",
    "The fetch engine's last attempt (peer, filename, size, chunks done, "
    "ok/fail + detail), in-progress flag, and cumulative "
    "attempts/successes/failures/bytes-installed, read live from this "
    "node's in-process fetch state at call time. Also carries a "
    "\"sync_benchmark\" object: the zcl.sync_benchmark.v1 phase-timed sync "
    "receipt (elapsed_ms per phase, t_ready/t_sovereign milestones, "
    "resource counters). Today the automatic zero-flag boot path stamps "
    "headers/artifact_verify/install/tail_download/tail_fold; "
    "peer_discovery/manifest/artifact_download remain null (with a reason) "
    "on that path and populate only via the manual "
    "ops.debug.rom_fetch.bundle command — this is the ONE place an "
    "operator reads sync timings, live, without parsing "
    "<datadir>/sync_benchmark.json by hand.", 0,
    "rom,fetch,download,bundle,status",
    "zcl.command.empty_input.v1", "zcl.rom_fetch_status.v1", "", "",
    "z23 ops debug rom_fetch status",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_PUBLIC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_rom_fetch_status)
ZCL_COMMAND_READY_COMMAND(
    "ops.debug.rom_fetch.bundle", "ops.debug.rom_fetch", "",
    "Fetch + verify a ROM artifact from a peer",
    "Downloads a ROM artifact (e.g. the consensus-state bundle) from a "
    "seeding peer's file service and verifies it BY CONTENT against the "
    "digests supplied here — the operator commits to (root, whole_sha3, "
    "size) before a byte is requested; any whole-file mismatch discards "
    "the download (nothing is accepted partially). 'peer' may be a comma-separated "
    "host list for the parallel multi-seeder scheduler. The verified "
    "file lands at <out_dir>/<filename> (default: the node datadir); it "
    "is NOT activated — install funnels only through "
    "-install-consensus-bundle. Blocks for the duration of the download.", 0,
    "rom,fetch,download,bundle,verify",
    "zcl.rom_fetch_bundle.input.v1", "zcl.rom_fetch_bundle.result.v1",
    "peer,port,root,whole_sha3,size,filename,out_dir", "",
    "z23 ops debug rom_fetch bundle --input='{\"peer\":\"203.0.113.7\",\"root\":\"<64hex>\",\"whole_sha3\":\"<64hex>\",\"size\":\"538507264\"}'",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_BACKGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_rom_fetch_bundle)

ZCL_COMMAND_BRANCH("ops.mesh", "ops", "Mesh",
                   ZCL_COMMAND_LAYER_OPS)
ZCL_COMMAND_READY_READ(
    "ops.mesh.identity", "ops.mesh", "ops.machine.status,machine.status",
    "Report this machine's mesh identity readiness",
    "A redacted live-daemon capsule of exact source and binary identity, "
    "platform/environment, stable public Noise fingerprint, encrypted "
    "transport, authenticated DHT identity, confinement, hot-swap support, "
    "and named blockers. It creates no identity and grants no pairing or "
    "remote-control authority.",
    ZCL_COMMAND_RESULT_BUDGET,
    "mesh,machine,identity,readiness,platform,hotswap",
    "zcl.command.empty_input.v1", "zcl.machine_mesh_identity.v1",
    "", "", "z23 ops mesh identity",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_ops_mesh_identity)
ZCL_COMMAND_READY_READ(
    "ops.mesh.status", "ops.mesh", "",
    "Request one paired machine's signed status receipt",
    "Uses an established Noise session or spends up to 15 seconds acquiring "
    "one current signed direct route, then waits up to 15 seconds for the "
    "signed receipt (multiplexed on zpkgswm) and projects its status token, "
    "responder identity fingerprints, observation times, and the redacted "
    "status capsule. A refusal receipt is a successful answer carrying the "
    "named refusal status. Endpoint bytes grant no authority: no private "
    "request is sent until the live Noise static and active ZID delegation "
    "match the pairing. Grants no authority beyond its status-read capability.",
    ZCL_COMMAND_RESULT_BUDGET,
    "mesh,status,receipt,pairing,noise,capsule",
    "zcl.ops_mesh_status.input.v1", "zcl.mesh_status_receipt_view.v1",
    "pairing_id", "pairing_id",
    "z23 ops mesh status --pairing_id=<64hex>",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_ops_mesh_status)
ZCL_COMMAND_READY_COMMAND(
    "ops.mesh.terminal", "ops.mesh", "",
    "Attach this terminal to a confined shell on one paired machine",
    "CLI-only bridge to the mesh terminal lane: opens a terminal session on "
    "the paired peer through this node's mesh_terminal_* RPCs over the "
    "established Noise session, then relays keystrokes and screen bytes "
    "until the remote shell ends, a session limit closes it, or you detach. "
    "On a terminal it runs in raw mode (restored on every exit path), sends "
    "the window size and follows resizes, and detaches on ~. at the start of "
    "a line. With stdin not a terminal it sends stdin, writes remote output "
    "only to stdout, ends with one end-of-transmission byte, and puts every "
    "diagnostic on stderr. Refusals are printed with the responder's own "
    "name (not-paired, capability-unavailable, confinement-unavailable, "
    "concurrency-limit, ...); the signed close receipt's reason, byte counts "
    "and duration are printed on stderr. When the remote shell ends the exit "
    "code is its own status from the close report (N, or 128 plus the signal); "
    "a report with no status exits 255 (status unknown, never success) and an "
    "unusable one exits 6; detaching exits 0, 4 denied, 5 transient, 130 "
    "interrupted. In raw mode Ctrl-C goes to the remote "
    "shell, not to this command; modes the remote set by escape sequence "
    "(alternate screen, mouse, bracketed paste) are not reset on exit. A "
    "Windows peer needs CR line ends and has no end-of-file byte on piped "
    "input. Needs the peer's pairing to carry the "
    "terminal capability. Dispatch through JSON returns a blocker.",
    ZCL_COMMAND_RESULT_BUDGET,
    "mesh,terminal,shell,attach,pairing,noise,pty",
    "zcl.ops_mesh_terminal.input.v1", "zcl.ops_mesh_terminal.blocker.v1",
    "pairing_id", "pairing_id",
    "z23 ops mesh terminal --pairing_id=<64hex>",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_STREAM,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_ops_mesh_terminal)
ZCL_COMMAND_READY_READ(
    "ops.mesh.machines", "ops.mesh", "",
    "List paired machines: durable verified evidence plus a live probe",
    "Every durable pairing record — active, expired, and revoked — rendered "
    "from the observation store with redacted identity fingerprints, pairing "
    "authority state, and the latest independently verified signed status "
    "receipt, marked fresh, stale, or never-seen from the current time (a "
    "stale receipt is evidence of the past, never current reachability). The "
    "call also runs a bounded live refresh: up to 8 active records are "
    "probed over the established Noise status lane with a collective "
    "12-second budget, each verified terminal receipt is persisted before "
    "rendering, and each probed row additionally reports its live verdict "
    "(online / refused:<status> / unreachable / timeout / unknown). Offline "
    "machines stay listed; no dial is ever attempted. "
    "total/returned/truncated make the bounds explicit.",
    ZCL_COMMAND_RESULT_BUDGET,
    "mesh,machines,fleet,observations,online,offline,stale,reachability",
    "zcl.command.empty_input.v1", "zcl.mesh.machines.v1", "", "",
    "z23 ops mesh machines",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_ops_mesh_machines)
/* `machines` is the operator's diagnostic view of the same store, and it
 * dials. `roster` is the fleet as a game sees it: no probe, no node, no
 * write, and every fact split by who established it, so nothing a machine
 * claimed about itself can be read as something a peer confirmed. It is
 * aliased `fleet roster` because that is the name the game asks by. */
ZCL_COMMAND_READY_READ(
    "ops.mesh.roster", "ops.mesh", "fleet.roster",
    "List this operator's machines with each fact labelled by who "
    "established it",
    "Every machine paired with this one, read from the durable pairing and "
    "observation stores under a datadir opened read-only: the chain "
    "identity fingerprint, a short Noise fingerprint, the pairing state, "
    "and two separate fact classes that never share a field. verified "
    "carries only facts a peer established, each with the time that "
    "observation was made; self_reported carries the facts a machine states "
    "about itself, which no consumer can mistake for the first class. A "
    "fact this node has no observer for comes back observed:false with the "
    "reason, never as a silent false. airships is what "
    "engine/composition/fleet_airship_rules.def awards for the verified "
    "facts, per machine and for the fleet, and the assets and facts come "
    "from that table rather than from this leaf. rules renders every row of "
    "that table with the sentence saying why it pays what it pays, so a "
    "count of zero is accounted for in the same reply. One page holds at most "
    "32 paired rows in paired_at,pairing_id order. `after` skips that many "
    "rows. When rows remain, truncated is true and next_resume_after is how "
    "many rows are already listed. It refuses an operator with no "
    "pairing at all, and refuses two rows carrying one chain identity "
    "rather than count one machine as two. It never dials, never probes, "
    "never writes, and never asks a running node anything.",
    ZCL_COMMAND_RESULT_BUDGET,
    "fleet,roster,machines,airships,verified,reachable,game,identity",
    "zcl.fleet_roster_input.v1", "zcl.fleet_roster.v1", "datadir,after", "",
    "z23 fleet roster [--after=<paired rows already listed>]",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_fleet_roster)
ZCL_COMMAND_BRANCH("ops.mesh.pair", "ops.mesh", "Pairing",
                   ZCL_COMMAND_LAYER_OPS)
ZCL_COMMAND_READY_READ(
    "ops.mesh.pair.plan", "ops.mesh.pair", "",
    "Preview pairing one connected machine",
    "Finds the connected peer with an established Noise session "
    "(optionally narrowed by an address substring or a Noise fingerprint hex "
    "prefix), pulls its held ZID delegation, and renders what commit would "
    "record: peer address, Noise fingerprint hex to compare out of band, "
    "master pubkey, delegation validity window, the status-read-only "
    "capability, the default expiry, and the pairing id. No durable write. "
    "Never dials: no matching session peer is PEER_NOT_CONNECTED, more than "
    "one is AMBIGUOUS_PEER.",
    ZCL_COMMAND_RESULT_BUDGET,
    "mesh,pair,plan,preview,noise,fingerprint,delegation",
    "zcl.ops_mesh_pair_plan.input.v1", "zcl.mesh.pairing.plan.v1",
    "peer", "peer",
    "z23 ops mesh pair plan --peer=<addr-or-fingerprint-prefix>",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_ops_mesh_pair_plan)
ZCL_COMMAND_READY_COMMAND(
    "ops.mesh.pair.commit", "ops.mesh.pair", "",
    "Pair one connected machine with status-read authority",
    "The ceremony gate. --fingerprint is MANDATORY: the out-of-band compared "
    "peer Noise fingerprint (ops mesh pair plan here, ops mesh identity on "
    "the other machine). Re-derives the live session and held delegation at "
    "commit time, then records a durable pairing with status-read-only "
    "capability expiring in --days days (default 7, maximum 30). The pairing "
    "authority rechecks genesis, active ZID projection, finality-delayed "
    "beacon, delegation signature, and fingerprint binding; every refusal is "
    "a named code and writes nothing. An identical existing record is "
    "returned unchanged; a revoked id stays revoked. Never dials.",
    ZCL_COMMAND_RESULT_BUDGET,
    "mesh,pair,commit,noise,fingerprint,ceremony,status-read",
    "zcl.ops_mesh_pair_commit.input.v1", "zcl.mesh.pairing.commit.v1",
    "peer,fingerprint,days,terminal", "peer",
    "z23 ops mesh pair commit --peer=<selector> --fingerprint=<64hex> [--days=7]",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
