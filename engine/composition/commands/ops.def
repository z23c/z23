/* ── ops.host ──────────────────────────────────────────────────────────────
 * Machine-local hygiene for the box this node runs on. Not chain state and
 * not a dev-only convenience: the hourly janitor unit calls this on fleet
 * machines that carry the release binary and no checkout, which is why the
 * tree is `ops` and not `dev` (engine/composition/commands/README.md). */
ZCL_COMMAND_BRANCH("ops.host", "ops", "Host maintenance",
                   ZCL_COMMAND_LAYER_OPS)
ZCL_COMMAND_READY_COMMAND(
    "ops.host.gc", "ops.host", "",
    "Classify and reclaim dead dev-proof worktree generations",
    "One report per sweep class over the dev-proof worktree pools (the disk "
    "pool and its tmpfs twin by default, or --roots): registered, and the "
    "partition of it into reapable / too_young / in_use / locked / "
    "need_review, plus bytes_reclaimable and bytes_reclaimed. Only a clean "
    "worktree is removed. A clean detached worktree whose HEAD no origin or "
    "archive ref holds is removed after age_days (default 7; 0 keeps it) and "
    "only once refs/archive/wt/<name> holds that HEAD (unique_archived, "
    "kept_on_failure). A dirty worktree is never removed; it is listed in "
    "needs_review with idle_days and dirty_count. Counts are "
    "measured at call time from git's own worktree listing and a single "
    "/proc pass, never cached. Dry run unless apply=true, and even then git's "
    "own worktree removal goes first; a directory git unregistered but left "
    "behind is finished off, and never left unnamed. Every protected path is "
    "named in refusals[] rather than silently skipped.", 65536,
    "host,gc,garbage,worktree,generation,disk,reclaim,janitor",
    "zcl.host_gc.input.v1", "zcl.host_gc.v1",
    "apply,floor_hours,roots,age_days", "",
    "z23 ops host gc --apply=false",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_DESTRUCTIVE,
    ZCL_COMMAND_RISK_DEV_MUTATION, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_MAINTENANCE, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_WRITE | ZCL_COMMAND_CAP_PROCESS_EXEC,
    ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_ops_host_gc)
ZCL_COMMAND_READY_COMMAND(
    "ops.host.build", "ops.host", "",
    "Run a heavy command through the host build queue",
    "CLI-only: queues the command behind the host's build lanes (waiting is "
    "the default, --no-wait refuses with 75 when busy), refuses below the "
    "free-space reserve (--reserve-gib or DEVBUILD_RESERVE_GIB, default 30 "
    "GiB, the floor the installed devbuild wrapper admits with), then runs "
    "it in a systemd user scope under development.slice with a CPU quota, "
    "24G of memory and no swap, on a disposable scratch directory that is "
    "released after success and retained after failure. "
    "Streams the command's stdio and exits with its status; --plan prints "
    "the limits. Shares its queue files with the installed devbuild wrapper. "
    "Dispatch through JSON returns a blocker.",
    ZCL_COMMAND_RESULT_BUDGET, "host,build,queue,admission,scope,scratch",
    "zcl.command.empty_input.v1", "zcl.ops_host_build.blocker.v1", "", "",
    "z23 ops host build -- make lint-fast",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_DEV_MUTATION, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_STREAM,
    ZCL_COMMAND_LATENCY_BACKGROUND, ZCL_COMMAND_COST_HIGH,
    ZCL_COMMAND_CONFIRM_NONE, ZCL_COMMAND_LANE_LOCAL,
    ZCL_COMMAND_CAP_DEV_STATE_WRITE | ZCL_COMMAND_CAP_PROCESS_EXEC,
    ZCL_COMMAND_TRAIT_NONE, zcl_native_handle_ops_host_build)
ZCL_COMMAND_READY_READ(
