ZCL_COMMAND_BRANCH("ops.mesh.device.host.package", "ops.mesh.device.host", "Exact installed HOST tunnel execution", ZCL_COMMAND_LAYER_OPS)
ZCL_COMMAND_READY_COMMAND(
    "ops.mesh.device.host.package.run", "ops.mesh.device.host.package", "",
    "Run exact owner-accepted installed bin/tunnel in foreground",
    "Linux raw CLI only, before node/config startup. Exact datadir/package_root/receipt_id/artifact_sha3, accept_execution=true and runtime_policy=host_os required. role is client or receiver; runtime_input is the existing bounded nonsecret HOST JSON with absolute profile directory. Fixed argv/env/CWD and bin/tunnel only; no shell or arbitrary executable. launch_ms/execution_ms/cleanup_ms bound process observation, excluding filesystem acquisition. Sealed top image is pinned; mutable system loader/libc are used as-is, not verified, pinned or confined. HUP forwards bounded engine drain; hard cancel/deadline wins. CLEAN requires engine exit and descendant/supervisor reap; incomplete cleanup exits nonzero with explicit owner-EOF custody handoff, not success. JSON/RPC stream execution refuses.",
    ZCL_COMMAND_RESULT_BUDGET, "mesh,device,host,package,installed,raw",
    "zcl.device.host.package.input.v1", "zcl.device.host.raw.v1",
    "datadir,package_root,receipt_id,artifact_sha3,accept_execution,runtime_policy,role,runtime_input,launch_ms,execution_ms,cleanup_ms", "datadir,package_root,receipt_id,artifact_sha3",
    "z23 ops mesh device host package run --input=<explicit-json>",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE, ZCL_COMMAND_RISK_APP_WRITE,
    ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_LOW, ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL, ZCL_COMMAND_CAP_NONE,
    ZCL_COMMAND_TRAIT_NONE, zcl_native_handle_ops_mesh_device_host_runtime)
ZCL_COMMAND_READY_COMMAND(
    "ops.mesh.device.host.receiver", "ops.mesh.device.host", "",
    "Run a finite foreground receiver for one exact HOST pair/root",
    "Linux raw CLI only, no node/config startup or stdout JSON. One --input JSON or --input-file=<absolute owner file>. Explicit profile (location relied on unverified), selected peer/root/target_port and literal listen_address/listen_port (zero explicitly ephemeral); confirm=true and allow_external required for nonloopback. Finite lifetime/session/handshake/idle limits (hard maxima lifetime 86400000 = 24 h, session 28800000 = 8 h, idle 1800000 = 30 min; grant expiry and revocation still end a session sooner), max_active1..4 and max_sessions1..64; sessions count only after PSK authentication and 256 pre-auth failures close the listener. Stderr listener token proves bind/listen only. Target is literal loopback, connected only after mutual confirmation by guarded PSK IO. Revoke/root change or signal closes owned listener/contexts. No built-in supervision/autostart; platform/deploy/examples/z23-tunnel-receiver.service is an optional example user unit, not an installed or qualified deployment. No private delivery or guest-restore qualification.",
    ZCL_COMMAND_RESULT_BUDGET, "mesh,device,host,psk,receiver,foreground",
    "zcl.device.host.receiver.input.v1", "zcl.device.host.raw.v1",
    "directory,peer_key,expected_root,target_port,route_id,listen_address,listen_port,allow_external,lifetime_ms,handshake_ms,session_ms,idle_ms,max_active,max_sessions,confirm", "directory,peer_key",
    "z23 ops mesh device host receiver --input=<explicit-json>",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_EFFECT_MUTATE, ZCL_COMMAND_RISK_APP_WRITE,
    ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_LOW, ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL, ZCL_COMMAND_CAP_NONE,
    ZCL_COMMAND_TRAIT_NONE, zcl_native_handle_ops_mesh_device_host_runtime)
ZCL_COMMAND_READY_COMMAND(
    "ops.mesh.device.host.shell", "ops.mesh.device.host", "",
    "Open an ssh shell through the HOST tunnel in one command",
    "Linux and macOS raw CLI only, before node/config startup. ssh is resolved once from PATH (absolute entries only; an empty or relative entry refuses) and that path is probed and exec()ed with a fixed argv, no /bin/sh: KexAlgorithms pinned to sntrup761x25519-sha512@openssh.com (mlkem768x25519-sha256 first when ssh -Q kex offers it), StrictHostKeyChecking=yes, ControlPath=none, ProxyCommand=<this binary> ops mesh device host client --input-file=<route_input>, then -- user@host. user/host are [A-Za-z0-9._-] with an alphanumeric first byte; route_input is an absolute owner regular client input file in [A-Za-z0-9._/-]; anything else refuses because ssh runs ProxyCommand through a shell. dry_run=true runs no ssh probe and executes nothing: it prints the resolved ssh path, kex_probe:skipped and both candidate argv shapes as JSON.",
    ZCL_COMMAND_RESULT_BUDGET, "mesh,device,host,psk,ssh,shell,raw,foreground",
    "zcl.device.host.shell.input.v1", "zcl.device.host.shell.v1",
    "user,host,route_input,dry_run", "user,host,route_input",
    "z23 ops mesh device host shell --input=<explicit-json>",
