ZCL_COMMAND_DEV_READ(
    "dev.retrieval.benchmark", "dev.retrieval", "",
    "Compare literal, BM25, and identifier-graph file retrieval",
    "An observational, native-only comparison over one exact ZVCS manifest "
    "root. The unchanged production goal selector is projected to unique "
    "files beside a BM25 index and a bounded rare identifier-atom/observed "
    "reverse-reference "
    "rerank of that same retained file set. It emits "
    "rankings and exact full-file context byte costs only; a separate "
    "evaluator may join reviewed gold after both rankings are sealed. No "
    "result changes production ordering or authorizes promotion.",
    ZCL_COMMAND_LIST_BUDGET,
    "dev,retrieval,benchmark,bm25,recall,mrr,context",
    "zcl.dev_retrieval_benchmark_input.v1",
    "zcl.dev_retrieval_benchmark.v3",
    "workspace,expected_vcs_root,task_id,query,cursor", "",
    "z23-dev dev retrieval benchmark --input='"
    "{\"workspace\":\"<canonical-absolute-checkout>\","
    "\"expected_vcs_root\":\"<64-lowercase-hex>\","
    "\"task_id\":\"task\",\"query\":\"goal\"}'",
    ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_PERSISTENT, ZCL_COMMAND_COST_HIGH,
    ZCL_COMMAND_LANE_LOCAL, ZCL_COMMAND_CAP_CHECKOUT_READ,
    ZCL_COMMAND_TRAIT_IDEMPOTENT | ZCL_COMMAND_TRAIT_DEV_ONLY,
    zcl_native_handle_dev_retrieval_benchmark,
    "retrieval benchmarking requires the dev binary",
    "z23-dev dev retrieval benchmark")

ZCL_COMMAND_DEV_READ(
    "dev.retrieval.pair", "dev.retrieval", "",
    "Measure one frozen retrieval profile pair",
    "Loads one bounded retrieval_pair_artifact.v1 from the workspace CAS, "
    "verifies SHA3-256 of its exact bytes against artifact_root, parses the "
    "existing canonical profile, heuristic, study, policy, task, candidate "
    "and environment wires, derives both arms from the same context-byte "
    "snapshot and joins reviewed gold through the maintained science adapter. "
    "Returns both evaluation wires and the paired science observation/result. "
    "Source provenance and run facts are declared, chronology and holdout "
    "independence remain unverified, reproduction is not run. No evidence "
    "is stored, no signing or promotion is authorized.",
    ZCL_COMMAND_LIST_BUDGET,
    "dev,retrieval,pair,measurement,science",
    "zcl.dev_retrieval_pair_input.v1", "zcl.dev_retrieval_pair.v1",
    "workspace,artifact_root", "",
    "z23-dev dev retrieval pair --input='{\"workspace\":\"<CAS-workspace>\",\"artifact_root\":\"<64-lowercase-hex>\"}'",
    ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL, ZCL_COMMAND_CAP_CHECKOUT_READ,
    ZCL_COMMAND_TRAIT_IDEMPOTENT | ZCL_COMMAND_TRAIT_DEV_ONLY,
    zcl_native_handle_dev_retrieval_pair,
    "paired retrieval observation requires the dev binary",
    "z23-dev dev retrieval pair")
