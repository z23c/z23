/* Canonical root and discovery branch. Consumer defines ZCL_COMMAND_*.
 * Root order is a wire contract: status, core, app, dev, ops, discover, code,
 * vault, zcode, metaverse, yardsale. The last two roots are declared in their
 * own .def files (engine/composition/commands/metaverse.def and
 * engine/composition/commands/yardsale.def), not here. */

ZCL_COMMAND_READY_READ(
    "status", "", "", "Node and wallet readiness with one next action",
    "The safe real-money front door: node health and sync, wallet readiness, "
    "receive/send capability, custody-authoritative spendable/pending/reserved "
    "amounts, encryption, encrypted backup, Sapling prover/checkpoint posture, "
    "mempool size, one stable blocker, and one executable next action. It emits "
    "no address, key, wallet identity, path, cookie, memo, grant, or raw error. "
    "Use `core status brief` for the lean chain-only script surface.", 4096,
    "health,sync,wallet,balance,backup,sapling,blocker,next", "zcl.command.empty_input.v1",
    "zcl.status_journey.v1", "", "", "z23 status",
    ZCL_COMMAND_LAYER_ROOT, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_CHAIN_READ | ZCL_COMMAND_CAP_WALLET_REQUEST,
    ZCL_COMMAND_TRAIT_IDEMPOTENT | ZCL_COMMAND_TRAIT_PROSE,
    ZCL_COMMAND_TRANSPORT_NATIVE,
    zcl_native_bridge_command)

ZCL_COMMAND_BRANCH("core", "", "Consensus-bound node capabilities",
                   ZCL_COMMAND_LAYER_CORE)
ZCL_COMMAND_BRANCH("app", "", "Capability-scoped sovereign applications",
                   ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("dev", "", "Native edit, proof, and publication loop",
                   ZCL_COMMAND_LAYER_DEV)
ZCL_COMMAND_BRANCH("ops", "", "Node diagnostics",
                   ZCL_COMMAND_LAYER_OPS)
ZCL_COMMAND_BRANCH("discover", "", "Search and describe the command registry",
                   ZCL_COMMAND_LAYER_DISCOVER)

ZCL_COMMAND_READY_READ(
    "discover.help", "discover", "help,dev.help",
    "Show one branch or leaf without loading the whole tree",
    "One registry node's immediate children or a leaf's contract, derived from "
    "the static in-binary command registry; deterministic and node-free.", 0,
    "help,menu,branch,context", "zcl.discover.path_input.v1",
    "zcl.discovery_document.v1", "path", "path",
    "z23 discover help dev.app",
    ZCL_COMMAND_LAYER_DISCOVER, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_PUBLIC, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_TINY,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE,
    ZCL_COMMAND_TRAIT_DETERMINISTIC | ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE,
    zcl_native_handle_discover_help)

ZCL_COMMAND_READY_READ(
    "discover.search", "discover", "search,dev.search,dev.diagnose.search",
    "Rank at most five commands by local deterministic intent search",
    "At most five registry commands ranked by deterministic local intent "
    "match against the static catalog; no node contact; empty when nothing "
    "scores.", 0,
    "search,find,intent,error,capability", "zcl.discover.search_input.v1",
    "zcl.command_search.v1", "query", "query",
    "z23 discover search 'ABI mismatch'",
    ZCL_COMMAND_LAYER_DISCOVER, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_PUBLIC, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_TINY,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE,
    ZCL_COMMAND_TRAIT_DETERMINISTIC | ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE,
    zcl_native_handle_discover_search)

ZCL_COMMAND_READY_READ(
    "discover.describe", "discover", "",
    "Describe one leaf's schemas, safety, authority, and availability",
    "One leaf's full contract — schemas, policy, semantics, and availability — "
    "from the static in-binary registry; deterministic and complete for that "
    "leaf.", 0,
    "describe,schema,risk,authority,availability",
    "zcl.discover.path_input.v1", "zcl.command_spec.v1", "path", "path",
    "z23 discover describe dev.app.simulate",
    ZCL_COMMAND_LAYER_DISCOVER, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_PUBLIC, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_TINY,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE,
    ZCL_COMMAND_TRAIT_DETERMINISTIC | ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE,
    zcl_native_handle_discover_describe)

ZCL_COMMAND_READY_READ(
    "discover.schema", "discover", "",
    "Return the compact input or output schema contract for one leaf",
    "The requested-side schema id and legacy allowed key list for one leaf. "
    "Input adds represented transport types and bounds from the shared validator; "
    "unrepresented fields and handler constraints remain incomplete. Transport "
    "requiredness is not handler optionality or permission to invoke. Output "
    "keeps the legacy shape. Deterministic and node-free.", 0,
    "schema,input,output,contract", "zcl.discover.schema_input.v1",
    "zcl.command_schema.v1", "path,side", "path",
    "z23 discover schema dev.app.simulate --side=input",
    ZCL_COMMAND_LAYER_DISCOVER, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_PUBLIC, ZCL_COMMAND_LATENCY_INSTANT,
    ZCL_COMMAND_COST_TINY,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE,
    ZCL_COMMAND_TRAIT_DETERMINISTIC | ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE,
    zcl_native_handle_discover_schema)

ZCL_COMMAND_READY_READ(
    "discover.wiki", "discover", "wiki",
    "Walk the docs knowledge tree one topic at a time",
    "One docs/ topic, or with the `code` prefix one source directory of the "
    "repository, with no node running: its title and summary, immediate "
    "sub-topics and pages (a reply holds as many as fit its budget, at most 64; "
    "resume with `after`), the "
    "commands its README names, and the next commands to run. An empty topic "
    "is the root; `code` lists the top-level source directories and `code/<dir>` "
    "a directory with each file's purpose line. `docsdir` overrides the "
    "checkout's docs directory and `codedir` its repository root. Lesson "
    "search over the signed fleet wiki is `fleet.wiki.find`.",
    ZCL_COMMAND_EXTENDED_LIST_BUDGET,
    "wiki,docs,topic,tree,knowledge,navigate,start,first,steps,getting started,new agent,begin,newcomer,onboarding", "zcl.discover.wiki_input.v1",
    "zcl.wiki_node.v1", "topic,after,docsdir,codedir", "topic",
    "z23 wiki code/tools/command",
    ZCL_COMMAND_LAYER_DISCOVER, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_PUBLIC, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_TINY,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE,
    ZCL_COMMAND_TRAIT_DETERMINISTIC | ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE,
    zcl_native_handle_discover_wiki)

ZCL_COMMAND_READY_READ(
    "discover.read", "discover", "",
    "Read one docs page in bounded UTF-8-safe chunks",
    "One Markdown page under docs/, or a .c, .h, .def, .sh or .md source file "
    "under code/, with no node running: `bytes` (default 4096, at most "
    "16384) from `offset`, cut on a UTF-8 boundary, with the page title, its "
    "size, and `next_offset` (null at the end). Paths are confined to docs/ "
    "and the repository; `docsdir` and `codedir` override the checkout.",
    40960,
    "read,page,docs,markdown,chunk", "zcl.discover.read_input.v1",
    "zcl.wiki_page.v1", "page,offset,bytes,docsdir,codedir", "page",
    "z23 discover read README.md --bytes=300",
    ZCL_COMMAND_LAYER_DISCOVER, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_PUBLIC, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_TINY,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE,
    ZCL_COMMAND_TRAIT_DETERMINISTIC | ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE,
    zcl_native_handle_discover_read)
