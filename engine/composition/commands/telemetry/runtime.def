/* The `ops.telemetry.runtime` branch. Owned by the runtime telemetry lane.
 *
 * All three leaves are READY: they render the typed runtime snapshot
 * (platform/modules/util/include/util/telemetry/runtime_fields.def) through the one render
 * layer, and each shows ONE group of it. The values are read live from the
 * running node's dumpstate surface at call time, so a leaf fails closed with a
 * retryable NODE_UNAVAILABLE when nothing answers rather than returning a
 * document in which every field is null. */

ZCL_COMMAND_BRANCH("ops.telemetry.runtime", "ops.telemetry",
                   "Supervisor tree, services and host resources",
                   ZCL_COMMAND_LAYER_OPS)

ZCL_COMMAND_READY_READ(
    "ops.telemetry.runtime.services", "ops.telemetry.runtime", "",
    "Registered services and their liveness",
    "Read live from the running node at call time: the supervisor tree as "
    "aggregates — registered children, free registry slots, how many are "
    "stalled, and the split between ticks run (activity), idle ticks "
    "(legitimately nothing to do) and children that ran without ever "
    "producing a result. Per-child rows are not here; ops state "
    "--subsystem=supervisor lists them. Health is derived from the field "
    "table's rules, never authored.", 0,
    "telemetry,runtime,services,supervisor,lifecycle",
    "zcl.command.empty_input.v1", "zcl.telemetry.runtime.services.v1", "", "",
    "z23 ops telemetry runtime services",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_DEV_STATE_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE,
    zcl_native_handle_ops_telemetry_runtime_services)

ZCL_COMMAND_READY_READ(
    "ops.telemetry.runtime.threads", "ops.telemetry.runtime", "",
    "Threads and their supervision state",
    "Read live from the running node at call time: whether the supervisor "
    "sweep thread and the tick-runner thread are up, how long since each last "
    "beat, how often the runner has wedged, and the CPU topology those "
    "threads run on. The sweep-age bar is the independent backstop's own 30 s "
    "freeze threshold, not a number invented here.", 0,
    "telemetry,runtime,threads,pthread,supervision",
    "zcl.command.empty_input.v1", "zcl.telemetry.runtime.threads.v1", "", "",
    "z23 ops telemetry runtime threads",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_DEV_STATE_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE,
    zcl_native_handle_ops_telemetry_runtime_threads)

ZCL_COMMAND_READY_READ(
    "ops.telemetry.runtime.resources", "ops.telemetry.runtime", "",
    "Host resources this process holds",
    "Read live from the running node at call time: the memory organ's level, "
    "the usage it computed, which ceiling that usage is judged against, "
    "whether the organ is still polling, and total host RAM. Values are as of "
    "the organ's last five-second poll, not as of this call. Resident memory "
    "is reported but deliberately not judged — RSS climbing during background "
    "validation is expected on this node.", 0,
    "telemetry,runtime,resources,memory,cpu,fd",
    "zcl.command.empty_input.v1", "zcl.telemetry.runtime.resources.v1", "", "",
    "z23 ops telemetry runtime resources",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_DEV_STATE_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE,
    zcl_native_handle_ops_telemetry_runtime_resources)
