/* The `ops.telemetry.sync` branch. Owned by the sync telemetry lane.
 *
 * All three leaves are READY: each fills one typed `struct sync_snapshot`
 * through the sync provider (engine/services/src/sync_telemetry_fill.c) and
 * renders it with telemetry_render(), the single renderer. The handlers are
 * pure control — they pick a snapshot and a view, and for the two ladder
 * leaves they project the ALREADY-RENDERED document into one row per rung.
 * They name no telemetry field and decide no health; see
 * tools/command/native_telemetry_sync_command.c and
 * docs/TELEMETRY_CONTRACT.md.
 *
 * FRESHNESS, stated once here because all three share it: the provider reads
 * lock-free publications of THIS PROCESS's reducer stages plus one durable
 * progress_meta row behind a non-blocking trylock. Every leaf therefore
 * carries per-leaf provenance and a `freshness` block, and a durable read that
 * lost its trylock reports UNAVAILABLE with reason `progress_store_busy`
 * rather than a stale number. */

ZCL_COMMAND_BRANCH("ops.telemetry.sync", "ops.telemetry",
                   "Reducer frontier, stages and catch-up posture",
                   ZCL_COMMAND_LAYER_OPS)

ZCL_COMMAND_READY_READ(
    "ops.telemetry.sync.summary", "ops.telemetry.sync", "",
    "Sync posture and the current bottleneck",
    "One typed sync snapshot taken at call time and rendered at the requested "
    "view: the proven height H*, the gap to the network tip, the stage ladder "
    "and the fold rate, each leaf carrying its own presence, source and "
    "observed_unix. `bottleneck` names the rung the ladder is waiting on and "
    "`basis` says how it was chosen — cursor_deficit_to_upstream when a rung "
    "sits below its upstream's cursor, slowest_step_us_ewma when the ladder is "
    "level; a null stage always carries a reason token. next[] drills into "
    "that rung. A view that does not fit the reply budget is rendered one tier "
    "shallower with view_downgraded=true, never returned empty.",
    ZCL_COMMAND_LIST_BUDGET,
    "telemetry,sync,summary,hstar,gap,bottleneck",
    "zcl.command.empty_input.v1", "zcl.telemetry.sync.summary.v1", "", "",
    "z23 ops telemetry sync summary",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_DEV_STATE_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_telemetry_sync_summary)

ZCL_COMMAND_READY_READ(
    "ops.telemetry.sync.stages", "ops.telemetry.sync", "",
    "Every reducer stage cursor",
    "One typed sync snapshot taken at call time, projected into one row per "
    "ladder rung: the rung's name, the field-table group it lives in, every "
    "field that rung publishes (cursor, counters, step EWMA) and the loudest "
    "health verdict any of its leaves earned. The rung set is derived from the "
    "field table, not listed here, so it cannot fall out of step with the "
    "ladder. `completeness` and `freshness` describe the whole snapshot the "
    "rows were cut from, so a reader can tell a real 0 from an unread one.",
    ZCL_COMMAND_LIST_BUDGET,
    "telemetry,sync,stages,cursor,ladder,reducer",
    "zcl.command.empty_input.v1", "zcl.telemetry.sync.stages.v1", "", "",
    "z23 ops telemetry sync stages",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_DEV_STATE_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_telemetry_sync_stages)

ZCL_COMMAND_READY_READ(
    "ops.telemetry.sync.stage", "ops.telemetry.sync", "",
    "One reducer stage in full detail",
    "The same call-time snapshot as `stages`, cut down to the one rung named "
    "by `stage` and rendered at full detail: every field that rung publishes, "
    "its position in the ladder, the upstream rung whose cursor bounds it "
    "(`upstream_stage`, with the ready-to-run `upstream_invocation` beside it "
    "rather than in next[], because a next[] step may not point back at the "
    "command serving it), and the per-leaf provenance (presence, source, "
    "observed_unix, age_ms, reason) for each of its leaves. A name that is not "
    "a rung is refused with UNKNOWN_STAGE and the valid set as evidence — "
    "never an empty reply.",
    ZCL_COMMAND_LIST_BUDGET,
    "telemetry,sync,stage,cursor,one,detail",
    "zcl.telemetry.sync_stage.input.v1", "zcl.telemetry.sync.stage.v1",
    "stage", "stage",
    "z23 ops telemetry sync stage --stage=body_persist",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_DEV_STATE_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_telemetry_sync_stage)
