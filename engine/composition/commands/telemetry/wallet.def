/* The `ops.telemetry.wallet` branch. Owned by the wallet telemetry lane.
 *
 * Both leaves are READY: the typed wallet snapshot
 * (util/telemetry/wallet_fields.def), its provider
 * (contexts/wallet/services/src/wallet_telemetry_fill.c) and the shared renderer are all
 * in place, and the handlers in tools/command/native_telemetry_wallet_command.c
 * do nothing but pick a snapshot and a view.
 *
 * THE CONTRACT BOTH LEAVES ARE WRITTEN UNDER: posture, never account data.
 * Neither reply can carry a key, a seed, an address or a balance - the field
 * table admits only booleans, counters, cursor distances and closed-set
 * tokens, and the provider reaches no accessor that could produce anything
 * else. `security` describes how keys are HANDLED and whether the node can
 * spend; it never describes what it would spend.
 *
 * A leaf value the serving process cannot read is rendered as null with a
 * static reason token and judged `unknown` - never omitted, and never a
 * plausible zero. */

ZCL_COMMAND_BRANCH("ops.telemetry.wallet", "ops.telemetry",
                   "Wallet projection and key-handling posture",
                   ZCL_COMMAND_LAYER_OPS)

ZCL_COMMAND_READY_READ(
    "ops.telemetry.wallet.summary", "ops.telemetry.wallet", "",
    "Wallet projection posture",
    "The whole zcl.telemetry.wallet.v1 domain, collected live at call time from the process serving the call: how current the wallet's read models are, the key-handling posture, and whether a recoverable backup exists and how old it is. Values are POSTURE ONLY - no balance, address or key material appears in this reply at any view. Every leaf carries its own presence and a static reason when it could not be read, `completeness` states the totals, and `health` is derived from the field table's declared rules, never authored here. Most leaves are process-local: read against the running node, not a stopped one.", ZCL_COMMAND_LIST_BUDGET,
    "telemetry,wallet,summary,notes,projection,backup,posture",
    "zcl.command.empty_input.v1", "zcl.telemetry.wallet.summary.v1", "", "",
    "z23 ops telemetry wallet summary",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_DEV_STATE_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_telemetry_wallet_summary)

ZCL_COMMAND_READY_READ(
    "ops.telemetry.wallet.security", "ops.telemetry.wallet", "",
    "Key-handling safety posture",
    "The `security` group of zcl.telemetry.wallet.v1, collected live at call time: whether private and Sapling spending keys are wrapped at rest, whether they are reachable right now, whether THIS BUILD can create a Sapling proof at all (a default build cannot, and reports so), and how the shielded fast-resume checkpoint loaded. It reports how keys are HANDLED and never emits key material, an address, or a balance. `can_spend_shielded` states what this binary can actually do, not what the code aspires to.", ZCL_COMMAND_LIST_BUDGET,
    "telemetry,wallet,security,keys,vault,locked,encrypted,shielded,prover",
    "zcl.command.empty_input.v1", "zcl.telemetry.wallet.security.v1", "", "",
    "z23 ops telemetry wallet security",
    ZCL_COMMAND_LAYER_OPS, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_DEV_STATE_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_telemetry_wallet_security)
