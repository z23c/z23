/* Owner-signed public work cards. A card is the text of a board `need` post in
 * public room `work`; its state derives from the claim and result posts that
 * reference it. Read-only: posting, claiming and intake are separate leaves.
 * Consumer defines ZCL_COMMAND_*; see engine/composition/src/command_catalog.c. */

ZCL_COMMAND_BRANCH("work", "",
                   "Owner-signed public work cards on the node's board",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_READ(
    "work.list", "work", "card",
    "List the owner's public work cards with their derived state",
    "Reads the `need` posts in public room `work` that the owner key signed "
    "and returns, for each card that satisfies zcl.work_card.v1, its id, name, "
    "level, a 160-byte outcome preview and its state: open; claimed "
    "when a claim references it; submitted when a result from a non-owner key "
    "references it; done when a result signed by the owner key references it. "
    "Posts signed by any other key are ignored in the list of cards. Cards that fail validation are "
    "listed in `rejected` with a reason code. The owner key defaults to the "
    "project owner key pinned in the source; pass `owner` to trust another key. "
    "`level` keeps one card level. What is returned is what this node holds; a post it has not fetched yet is absent, not denied.",
    ZCL_COMMAND_LIST_BUDGET,
    "work,card,task,board,volunteer,need,open,claim,start,first,steps,begin,newcomer,onboarding",
    "zcl.work_list_input.v1", "zcl.work_list.v1",
    "level,limit,owner", "",
    "z23 work list --level=haiku",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_work_list)

ZCL_COMMAND_READY_READ(
    "work.show", "work", "card.show",
    "Show one work card whole with its claim and result posts",
    "The validated card for one board post id, its derived state, and up to "
    "four claim and four result posts that reference it, each with a "
    "160-byte text preview and the total count. A post that is not a `need` "
    "in room `work` signed by the owner key, or whose card fails validation, "
    "is refused with the reason code.",
    ZCL_COMMAND_LIST_BUDGET,
    "work,card,show,task,board,claim,result",
    "zcl.work_show_input.v1", "zcl.work_show.v1",
    "id,owner", "id",
    "z23 work show 4f2c0a9e...",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_LATENCY_FAST,
    ZCL_COMMAND_COST_LOW, ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_work_show)
