ZCL_COMMAND_BRANCH("zcode.desc", "zcode",
                   "Onion descriptors",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_COMMAND(
    "zcode.desc.publish", "zcode.desc", "",
    "Publish a signed onion-service descriptor",
    "Builds the canonical ZIDD descriptor body (service onion, optional "
    "intros of \"<onion>:<64hex auth_key>\" pairs (comma-separated, or "
    "a JSON array of {onion, auth_key}), not_before), signs it as a zid doc "
    "with the 32-byte master seed read from seed_file (exactly 64 hex "
    "chars; perms must be 0600/0400 or it is refused with the chmod "
    "hint; the seed is cleansed after use and never logged), stores the "
    "canonical doc wire as a content-addressed blob under "
    "<datadir>/zcode, and files it under the blinded record key for the "
    "current period at <datadir>/zcode/descriptors/<record_key>.zid. "
    "Returns doc_hex, root, master_pubkey, record_key and period. "
    "Numeric inputs (seq, not_before, expiry, now) are taken as decimal "
    "strings. seq is "
    "monotonic per identity: a republish with a seq at or below the one "
    "already held is refused STALE_SEQ and nothing is written. Defaults: "
    "seq 1, not_before now, expiry not_before+3d. The record key rotates "
    "every 86400 seconds, so a live service republishes each period. No "
    "chain write and no fee — this signs and stores, it does not anchor "
    "the identity.", 0,
    "zcode,desc,descriptor,onion,publish,zid,blinded,rotation,swarm",
    "zcl.zcode_desc_publish.input.v1", "zcl.zcode_desc_publish.v1",
    "onion,intros,seed_file,seq,not_before,expiry,now,datadir", "onion",
    "z23 zcode desc publish --input='{\"onion\":\"<56base32>.onion\",\"seed_file\":\"/path/seed.hex\",\"intros\":\"<56base32>.onion:<64hex>\",\"seq\":\"1\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zdesc_publish)

ZCL_COMMAND_READY_READ(
    "zcode.desc.verify", "zcode.desc", "",
    "Check a descriptor's signature against a master key you supply",
    "Decodes a descriptor from --doc=<hex> or --file=<path to a saved "
    ".zid> and checks it against --pubkey=<64hex>: the signature, the "
    "doc's expiry, and the body's not_before must all hold at --now (or "
    "the wall clock). Prints the service onion, every introduction point "
    "with its auth_key, the validity window, seq, and the record key the "
    "descriptor would be filed under. Numeric inputs (now) are taken as "
    "decimal strings. THE KEY IS YOURS TO SUPPLY: the "
    "reply always carries chain_anchored:false and "
    "verified_against:\"supplied_key\", because nothing here consults "
    "the chain — a pass means \"signed by the key you named\", never "
    "\"signed by a chain-anchored key\". Failures are hard and named: "
    "KEY_MISMATCH (a different identity signed it), VERIFY_FAILED "
    "(tampered, corrupted, or expired), NOT_A_DESCRIPTOR_BODY (signed "
    "for something else, or not yet valid), DOC_DECODE_FAILED "
    "(truncated hex).", 0,
    "zcode,desc,descriptor,verify,signature,onion,zid,expiry",
    "zcl.zcode_desc_verify.input.v1", "zcl.zcode_desc_verify.v1",
    "doc,file,pubkey,now", "pubkey",
    "z23 zcode desc verify --input='{\"doc\":\"<hex>\",\"pubkey\":\"<64hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_PUBLIC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_zdesc_verify)

ZCL_COMMAND_READY_READ(
    "zcode.desc.resolve", "zcode.desc", "",
    "Look up an identity's current descriptor by its blinded record key",
    "Derives SHA3-256(\"ZIDB\" | pubkey | period_le64) for the current "
    "period, reads the record filed under it in "
    "<datadir>/zcode/descriptors/, verifies it against the same "
    "--pubkey=<64hex>, and prints the service onion, the introduction "
    "points, the validity window, and which period answered. Numeric "
    "inputs (now) are taken as decimal strings. THE "
    "BOUNDARY RULE is applied for you: on a miss the previous period is "
    "tried too, so a publisher a few seconds the other side of midnight "
    "is still findable, and previous_period_fallback reports when that "
    "happened. Two periods on, a record stops being addressable and the "
    "answer is DESCRIPTOR_ABSENT — the publisher must republish each "
    "period. Verification is against the key you supply: the reply "
    "carries chain_anchored:false and verified_against:\"supplied_key\". "
    "Reading a record requires knowing the master key, which is the "
    "whole anti-enumeration point — this cannot list services.", 0,
    "zcode,desc,descriptor,resolve,onion,blinded,record-key,period,lookup",
    "zcl.zcode_desc_resolve.input.v1", "zcl.zcode_desc_resolve.v1",
    "pubkey,now,datadir", "pubkey",
    "z23 zcode desc resolve --input='{\"pubkey\":\"<64hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_PUBLIC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_zdesc_resolve)

/* ── Signed endpoint records (zendp) ─────────────────────────────────
 * The chain-bound twin of zcode.desc.*. A node's address stops being a
 * bare string anyone can assert and becomes a document the node SIGNED
 * (a zid_doc with body tag "ZIDE", carried as a content-addressed blob
 * over the same frozen package swarm — no new message, no transaction,
 * no fee). Addressed by SHA3-256("ZIDE" | blinded_key(pubkey, period)),
 * its own address space beside the descriptor's.
 *
 * THE ONE DIFFERENCE FROM zcode.desc, AND IT IS THE POINT: no key is
 * supplied by the caller on the verify side. The record carries its own
 * master_pubkey and that key is resolved against the on-chain identity
 * projection; an ACTIVE anchor is REQUIRED. Every reply here carries
 * chain_anchored:true and verified_against:"chain_anchor". A record
 * whose key was never anchored, was rotated away, or was revoked — or
 * one offered while the chain cannot be asked at all — is DISCARDED: no
 * file is written and nothing enters any directory. There is no
 * "stored but untrusted" state.
 *
 * PUBLICATION IS OPERATOR-INVOKED, ALWAYS. Records are free to publish,
 * but publishing binds a chain-anchored identity to a network location
 * in durable signed bytes, which is a privacy decision belonging to the
 * operator; auto-republish would also need the identity master seed
 * resident for the process lifetime. Nothing here runs at startup, on a
 * timer, or in the background, and no flag enables one.
 *
 * See contexts/wallet/modules/zid/include/zid/zendp.h and contexts/commons/modules/vcs/include/vcs/zendp_swarm.h. */
ZCL_COMMAND_BRANCH("zcode.endpoint", "zcode",
                   "Signed addresses",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_COMMAND(
    "zcode.endpoint.publish", "zcode.endpoint", "",
    "Publish this node's signed endpoint record",
    "Builds the canonical ZIDE record body from the transports you name "
    "(onion + onion_port, ipv4 + ipv4_port, ipv6 + ipv6_port; at least "
    "one is required and ports default to 8033), plus the services "
    "bitmask, the best height you claim, and not_before. Signs it as a "
    "zid doc with the 32-byte master seed read from seed_file (exactly "
    "64 hex chars; perms must be 0600/0400 or it is refused with the "
    "chmod hint; the seed is cleansed after use and never logged), "
    "stores the canonical doc wire as a content-addressed blob under "
    "<datadir>/zcode, and files it under the blinded record key at "
    "<datadir>/zcode/endpoints/<record_key>.zid. Returns doc_hex, root, "
    "master_pubkey, record_key, period and the anchor the chain "
    "reported. NUMERIC INPUTS SPLIT TWO WAYS, because the registry "
    "types some keys and not others: `height` must be a bare whole "
    "number (\"height\":3196556), while onion_port, ipv4_port, "
    "ipv6_port, services, seq, not_before, expiry and now are taken as "
    "decimal STRINGS (\"seq\":\"1\"). seq is monotonic per identity: a "
    "republish with a "
    "seq at or below the one already filed is refused STALE_SEQ and "
    "nothing is written. Defaults: seq 1, not_before now, expiry "
    "not_before+3d. THE VALIDITY WINDOW IS CAPPED AT 30 DAYS: expiry "
    "minus not_before may be at most 2592000 seconds (exactly 30 days "
    "is allowed, one second more is refused WINDOW_TOO_LONG and "
    "nothing is written; an expiry at or before not_before is refused "
    "BAD_WINDOW). The cap is the bound on how long a retired key keeps "
    "being advertised to a node that never sees it revoked, so it is "
    "enforced when you publish AND re-checked by every reader — a "
    "longer window cannot be signed here and would not be honoured "
    "anywhere. Publishing does NOT require the key to be anchored "
    "yet — the anchor transaction may still be unconfirmed — but the "
    "reply says discoverable:false when it is not, because only an "
    "ACTIVE key is ever offered to peer discovery. No chain write and "
    "no fee. The record key rotates every 86400 seconds and NOTHING "
    "republishes for you: announcing this node is always your choice.",
    0,
    "zcode,endpoint,zendp,publish,onion,ipv4,ipv6,signed,anchor,swarm",
    "zcl.zcode_endpoint_publish.input.v1", "zcl.zcode_endpoint_publish.v1",
    "onion,onion_port,ipv4,ipv4_port,ipv6,ipv6_port,services,height,seed_file,seq,not_before,expiry,now,datadir",
    "seed_file",
    "z23 zcode endpoint publish --input='{\"onion\":\"<56base32>.onion\",\"onion_port\":\"8033\",\"seed_file\":\"/path/seed.hex\",\"seq\":\"1\",\"height\":3196556}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zendp_publish)

ZCL_COMMAND_READY_COMMAND(
    "zcode.endpoint.accept", "zcode.endpoint", "",
    "Verify a peer's endpoint record against the chain and file it",
    "THE RECEIVING SIDE. Takes record bytes from --doc=<hex> or "
    "--file=<path to a saved .zid> and runs the whole pipeline: decode, "
    "signature, the document's validity window, the ZIDE body tag, the "
    "record's own not_before, and then the chain — the master_pubkey the "
    "record carries is resolved against the on-chain identity "
    "projection and must be ACTIVE. Only on a full pass is the record "
    "filed under <datadir>/zcode/endpoints/<record_key>.zid, which is "
    "what this node loads and re-verifies at start. A record that fails "
    "ANY rung is DISCARDED: no file is written, nothing enters a "
    "directory, and there is no lesser 'stored but flagged' state to "
    "read back later. The four chain outcomes stay four outcomes — "
    "NO_CHAIN_LOOKUP (nothing could ask, fails closed), "
    "CHAIN_UNAVAILABLE (asked, the lookup failed), KEY_NOT_ANCHORED "
    "(never registered), KEY_ROTATED and KEY_REVOKED (retired) — "
    "because 'the chain could not be asked' must never read the same as "
    "'the chain said no'. An offered record whose seq does not "
    "supersede the one already filed is refused STALE_SEQ and the file "
    "is left unchanged. Numeric inputs (now) are taken as decimal "
    "strings. Accepting a record is only ever ADDITIVE — it gives peer "
    "discovery one more place to try and can never exclude a peer.",
    0,
    "zcode,endpoint,zendp,accept,verify,chain,anchor,peer,discovery",
    "zcl.zcode_endpoint_accept.input.v1", "zcl.zcode_endpoint_accept.v1",
    "doc,file,now,datadir", "doc",
    "z23 zcode endpoint accept --input='{\"doc\":\"<hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zendp_accept)

ZCL_COMMAND_READY_READ(
    "zcode.endpoint.verify", "zcode.endpoint", "",
    "Check an endpoint record against the chain without storing it",
    "The read-only twin of accept: identical pipeline, including the "
    "on-chain anchor check, into a directory nobody reads and with NO "
    "file written. Decodes a record from --doc=<hex> or --file=<path> "
    "and prints the endpoints it names, the validity window, seq, the "
    "record key it would be filed under, and the anchor state and "
    "height the chain reported. THE KEY IS NOT YOURS TO SUPPLY: it "
    "comes from the record and is resolved against the chain, so the "
    "reply carries chain_anchored:true and "
    "verified_against:\"chain_anchor\" — a pass means the signing key is "
    "anchored and ACTIVE, not merely that some key signed the bytes. "
    "Numeric inputs (now) are taken as decimal strings. Use this to "
    "inspect a record before deciding whether to accept it.",
    0,
    "zcode,endpoint,zendp,verify,signature,chain,anchor,dry-run",
    "zcl.zcode_endpoint_verify.input.v1", "zcl.zcode_endpoint_verify.v1",
    "doc,file,now,datadir", "doc",
    "z23 zcode endpoint verify --input='{\"doc\":\"<hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_PUBLIC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_zendp_verify)

ZCL_COMMAND_READY_READ(
    "zcode.endpoint.resolve", "zcode.endpoint", "",
    "Look up a filed endpoint record by its blinded record key",
    "Derives SHA3-256(\"ZIDE\" | blinded_key(pubkey, period)) for the "
    "current period, reads the record filed under it in "
    "<datadir>/zcode/endpoints/, and re-runs the WHOLE pipeline on the "
    "bytes that came off disk — signature, window, body, and the "
    "on-chain anchor — because a file is a witness, never the authority "
    "for what a record says. Prints the endpoints, the window, seq and "
    "the anchor. THE BOUNDARY RULE is applied for you: on a miss the "
    "previous period is tried too, so a publisher a few seconds the "
    "other side of midnight is still findable, and "
    "previous_period_fallback reports when that happened. Two periods "
    "on, a record stops being addressable and the answer is "
    "ENDPOINT_ABSENT — the publisher must republish each period. "
    "Numeric inputs (now) are taken as decimal strings. Reading a "
    "record requires knowing the master key, which is the whole "
    "anti-enumeration point — this cannot list identities.",
    0,
    "zcode,endpoint,zendp,resolve,blinded,record-key,period,lookup",
    "zcl.zcode_endpoint_resolve.input.v1", "zcl.zcode_endpoint_resolve.v1",
    "pubkey,now,datadir", "pubkey",
    "z23 zcode endpoint resolve --input='{\"pubkey\":\"<64hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_PUBLIC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_zendp_resolve)

ZCL_COMMAND_READY_READ(
    "zcode.endpoint.list", "zcode.endpoint", "",
    "Show every filed endpoint record and whether the node will use it",
    "Scans <datadir>/zcode/endpoints/ and re-verifies each record "
    "against the chain right now — the same work the node does at "
    "start. Each row reports usable:true with the endpoints it names, "
    "or usable:false with the named reason it was discarded "
    "(KEY_NOT_ANCHORED, KEY_ROTATED, KEY_REVOKED, an expired window, a "
    "bad signature, or the chain being unreachable). Answers \"which of "
    "these will my node actually use, and why not the rest\" without "
    "restarting anything. Unlike resolve this needs no master key, "
    "because it only reads files this operator already has — it is not "
    "an enumeration of anyone else's identities. Numeric inputs (now) "
    "are taken as decimal strings.",
    0,
    "zcode,endpoint,zendp,list,records,discovery,anchor,audit",
    "zcl.zcode_endpoint_list.input.v1", "zcl.zcode_endpoint_list.v1",
    "now,datadir", "",
    "z23 zcode endpoint list",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_PUBLIC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_zendp_list)

ZCL_COMMAND_READY_COMMAND(
    "zcode.package.checkout", "zcode.package", "",
    "Reconstruct one verified package tree without executing it",
    "Reads one complete ordinary content.v2 package from the local CAS by "
    "immutable `root`, rederives the manifest root, re-verifies every chunk "
    "at its exact coordinate, and atomically reconstructs the canonical "
    "paths and modes beneath an absent `destination`. The checkout is inert: "
    "it never builds, tests, loads, links, or executes downloaded bytes; "
    "those remain separate explicit local policy steps.",
    ZCL_COMMAND_RESULT_BUDGET,
    "zcode,package,checkout,reconstruct,content-v2,verified,no-exec",
    "zcl.zcode_package_checkout.input.v1",
    "zcl.zcode_package_checkout.v1",
    "root,destination,datadir", "root,destination",
    "z23 zcode package checkout --input='{\"root\":\"<64hex>\",\"destination\":\"/tmp/package-source\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_zcode_package_checkout)

/* ── the install lifecycle (add plan / add commit / rollback) ──────────
 *
 * Phase 1: the package must already be in the local content-addressed
 * store (published here, or fetched by `zcode package fetch`). These
 * leaves resolve, lock, verify, build, install, and activate it; the
 * multi-peer fetch inside `add` is a later phase and this surface says so
 * rather than pretending (a step with missing bytes reports state
 * `fetching` with rule `package-incomplete`).
 *
 * `add plan` is a MUTATING leaf even though it installs nothing: it
 * persists the plan under <datadir>/zcode/addplans/<plan-id> so that
 * commit can be checked against exactly what the operator read. */

ZCL_COMMAND_BRANCH("zcode.package.add", "zcode.package",
                   "Install a package: plan then commit",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_COMMAND(
    "zcode.package.add.plan", "zcode.package.add", "",
    "Resolve, dependency-lock, and report what installing would do",
    "Resolves `name_or_root` (a 64-hex package root is identity; a "
    "publisher/package name only SELECTS the highest published semver), "
    "walks the package's own zcode-package.json declarations into a "
    "bounded acyclic dependency DAG locked to immutable package roots, and "
    "reports every step in BUILD ORDER (dependencies first, target last) "
    "with the lifecycle state it has actually reached: `installed` (this "
    "exact root is already installed), `verified` (every manifest chunk "
    "re-hashed from the CAS, envelope and recipe root check out), "
    "`fetching` (bytes still missing locally — rule `package-incomplete`; "
    "multi-peer fetch is a later phase and this never pretends to have "
    "fetched), or `discovered` (present but failing verification). "
    "`ready:true` means every step can proceed on commit. A dependency "
    "cycle, a self-dependency, a depth/count overflow, an unresolvable "
    "root, or a name/semver label that disagrees with the resolved "
    "release is a named rejection, never a silently broken edge. Persists "
    "the plan and returns `plan_id`; the id is a SHA3 commitment to every "
    "field including the expiry, so an edited plan file is simply not "
    "found. Plans expire in 15 minutes — a proposal, not a standing "
    "authorization. A dependency-rich step list is pageable with the "
    "shared `cursor`/`max_items` controls: a shortened reply carries a "
    "`_page` descriptor naming where to resume, and the complete list is "
    "the concatenation of every page in order.",
    0,
    "zcode,package,add,install,plan,dependency,lock,resolve",
    "zcl.zcode_add_plan.input.v1", "zcl.zcode_add_plan.v1",
    "name_or_root,now_unix,datadir,cursor,max_items", "name_or_root",
    "z23 zcode package add plan --input='{\"name_or_root\":\"ringbuffer\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_package_add_plan)

ZCL_COMMAND_READY_COMMAND(
    "zcode.package.add.commit", "zcode.package.add", "",
    "Execute a plan: verify, build+test confined, install, activate, pin",
    "Loads the plan named by `plan_id`, refuses it if its bytes do not "
    "hash to its own id (`plan-tampered`), if it expired "
    "(`plan-expired`), or if re-deriving the dependency lock from the "
    "store right now yields a different lock root (`lock-changed`) — so a "
    "plan can never authorize installing something the store no longer "
    "holds. Then, for every locked step in build order: re-hash every "
    "chunk from the CAS against the manifest (a tampered store object "
    "fails here and never reaches a build), run the declarative recipe's "
    "build and tests in build/bin/zclassic23-package-verify --emit "
    "(seccomp + rlimits + Landlock where the kernel offers it; no Make, "
    "CMake, shell, configure, hooks, or build-time network), "
    "INDEPENDENTLY re-hash every emitted artifact against the worker's "
    "build receipt, install only what the receipt commits into "
    "<datadir>/zcode/installed/<root>/ by atomic rename, activate by "
    "rename-based symlink swap, append the generation log, and pin the "
    "package so it can seed to other peers. The result is a static .a "
    "plus public headers on disk: the node NEVER dlopens or links "
    "downloaded code into itself. The previous generation is retained, so "
    "`zcode package rollback` is immediate.",
    0,
    "zcode,package,add,commit,install,build,verify,receipt,pin",
    "zcl.zcode_add_commit.input.v1", "zcl.zcode_add_commit.v1",
    "plan_id,now_unix,datadir,cursor,max_items", "plan_id",
    "z23 zcode package add commit --input='{\"plan_id\":\"<64hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_BACKGROUND, ZCL_COMMAND_COST_HIGH,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_package_add_commit)

ZCL_COMMAND_READY_COMMAND(
    "zcode.package.rollback", "zcode.package", "",
    "Go back one step: re-activate the previous generation",
    "Reads the append-only generation log and re-activates the newest "
    "DISTINCT root older than the active one, by the same atomic "
    "rename-based symlink swap install uses. `name` is OPTIONAL: with no "
    "name this goes back one step on the package whose active version "
    "changed most recently, so undoing a change never requires knowing a "
    "name, a hash, or a path (`selected_by_default` reports that it chose). "
    "`to_root` is the exact 32-byte identity now active. History is never "
    "rewritten: the rollback appends a new generation naming the older "
    "root, and BOTH installed trees stay on disk. The log keeps its newest "
    "64 generations, evicting oldest-first, so it is bounded and a full log "
    "can never refuse a rollback. `no-previous-generation` means only one "
    "generation was ever active; `never-installed` means this name has no "
    "generation log here; `nothing-installed` means no package has ever "
    "been activated. Rollback re-points the active symlink only — it never "
    "rebuilds, never re-runs the worker, never uses the network, and never "
    "reads the version it is leaving, so it works when that version is "
    "broken or deleted outright.",
    0,
    "zcode,package,rollback,revert,undo,generation,activate,previous",
    "zcl.zcode_package_rollback.input.v1", "zcl.zcode_package_rollback.v1",
    "name,now_unix,datadir", "",
    "z23 zcode package rollback --input='{}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_package_rollback)

ZCL_COMMAND_READY_COMMAND(
    "zcode.package.reproduce", "zcode.package", "",
    "Reproduce one installed package's build receipt",
    "The installed-node reproduction step: for one ALREADY-INSTALLED "
    "package (`name_or_root` is a 64-hex root, publisher/package, or "
    "name@semver), re-verifies every committed input against the CAS, "
    "re-materializes the source tree, and re-runs the fixed verifier worker "
    "under the STANDARD build profile against the install receipt's own "
    "dependency lock and committed dependency set (the same confined "
    "zclassic23-package-verify --emit build add commit ran, one profile "
    "stricter). Only when the rebuild receipt is BYTE-IDENTICAL on every "
    "committed output (MATCH) and hashes to a DISTINCT receipt id is it "
    "filed under <datadir>/zcode/receipts/<receipt-id-hex> — two distinct "
    "receipt ids with byte-identical output sets is the reproduction fact "
    "that makes the `reproduction` object of `zcode package verify` report "
    "reproduced=true without any factory tooling. A rebuild that diverges, "
    "a package that is not installed (`not-installed`), and a rebuild that "
    "lands the install build's own id (`receipt-not-distinct`) are named "
    "refusals that file nothing. Idempotent: a re-run re-files the same "
    "deterministic receipt.",
    0,
    "zcode,package,reproduce,rebuild,receipt,match,install,verify",
    "zcl.zcode_package_reproduce.input.v2", "zcl.zcode_package_reproduce.v1",
    "name_or_root,fast_cache,datadir", "name_or_root",
    "z23 zcode package reproduce --input='{\"name_or_root\":\"alice/ringbuffer\",\"fast_cache\":\"~/.cache/z23/fastobj\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_BACKGROUND, ZCL_COMMAND_COST_HIGH,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_package_reproduce)

/* ── zcode.node — joining the network, and keeping this node current ──────
 *
 * `join` and `update` are BARE ROOT ALIASES (tools/command/
 * native_command.c's roots[]), exactly like `explain` / `profile` /
 * `meaning` are bare aliases of ops.debug.*: a stranger who has just
 * installed a node types `z23 join`, not a four-word path. The canonical
 * `zcode node ...` path exists so the surface is discoverable from the
 * menu, but the alias is the primary invocation.
 *
 * BUDGET NOTE — the `zcode` branch menu is bounded by
 * ZCL_COMMAND_BRANCH_BUDGET. Its child labels are intentionally terse: a menu
 * that overruns the budget renders as NOTHING (write_bounded_json returns 0),
 * so a new `zcode.*` branch must preserve the measured menu contract rather
 * than assume headroom.
 *
 * Everything under `update` is PLANNED on purpose. A node self-update path
 * that silently does nothing is worse than one that refuses BY NAME, so
 * each leaf carries an availability_reason and the registry grammar makes
 * it a typed blocker instead of a no-op. */
ZCL_COMMAND_BRANCH("zcode.node", "zcode",
                   "Node join/update",
                   ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("zcode.node.update", "zcode.node",
                   "Node self-update",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_COMMAND(
    "zcode.node.join", "zcode.node", "join",
    "Join this node to the C23 network",
    "Reports the CURRENT join posture read from this process "
    "(package_hosting / build_worker / joined), whether a C23 compiler is "
    "present on this host, and then writes the join flags into "
    "<datadir>/z23.conf: -packagehost=1 always, -buildworker=1 only when a "
    "compiler was actually found. The file is the node's own config; "
    "command-line flags still win over it. Nothing is started, stopped, "
    "signalled or restarted — the service manager owns the node process, so "
    "the reply names the restart the operator must run. Two named tiers are "
    "reported: SWARM (needs only -packagehost=1, works over ordinary P2P "
    "peers, no coins and no on-chain identity) and DHT (an OPTIONAL upgrade "
    "that additionally needs -noisetransport and an active on-chain ZID anchor "
    "whose registration spends a fee). DHT is never a blocker for joining. "
    "The `verdict` is a TUPLE — reachable/responsive/fresh/serving reported "
    "independently, with latency beside them as telemetry and never folded "
    "in, because a timeout tuned on fast storage grades a slow honest node "
    "as broken. `announcement.state` is `ready` only once all four of "
    "descriptor-published, rendezvous-established, circuit-built and "
    "listener-accepting are CONFIRMED; otherwise it names the first "
    "outstanding stage. From this one-shot CLI every one of those is "
    "`unobservable`, which is neither a pass nor a fail.",
    ZCL_COMMAND_RESULT_BUDGET,
    "join,network,swarm,dht,packagehost,buildworker,compiler,config,onboard",
    "zcl.zcode_node_join.input.v1", "zcl.zcode_node_join.v1",
    "datadir", "",
    "z23 join",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_node_join)

/* ── zcode.node.verify — "the same bytes", checked, not taken on faith ──
 *
 * The one command a user runs to answer: did I get the same bytes as the
 * publisher, produced by MY OWN machine? It rebuilds the node here and
 * byte-compares. It NEVER checks a published hash against the file it was
 * published beside — contexts/commons/modules/vcs/node_reproduce.c refuses to compare unless one
 * receipt is RECEIVED and the other LOCAL_REBUILD, so no argument list
 * makes it grade a publisher against themselves.
 *
 * `partial` is a first-class verdict, not a softened pass: the vendored
 * static archives under vendor/lib/ are not rebuilt by this run, so today
 * the honest ceiling for the shipped node is PARTIAL with every uncovered
 * component named. Silently dropping them to print `match` is exactly how
 * a green result stops meaning anything. */
ZCL_COMMAND_READY_COMMAND(
    "zcode.node.verify", "zcode.node", "",
    "Rebuild this node here and compare bytes",
    "Answers ONE question: are the bytes you are running the bytes YOUR "
    "machine builds from source? It hashes the artifact you have (by "
    "default this process's own executable), rebuilds z23 from "
    "`source_dir` in an isolated tree under `scratch_dir` via "
    "tools/scripts/node_reproduce.sh, and byte-compares. It asks no "
    "server, and it never compares a published hash against the file it "
    "was published beside — that check has one participant and proves "
    "nothing, so the comparator refuses it by construction. `verdict` is "
    "the answer, never the envelope status: `match` (every artifact "
    "byte-identical, nothing uncovered), `partial` (everything comparable "
    "matched, and the named `unverified` components were NOT rebuilt here "
    "— NOT a pass), `source-differs` (this checkout is not the source that "
    "binary came from, which says nothing about the publisher), "
    "`toolchain-differs` (same source, different compiler — the ordinary "
    "reason two honest builds differ), `claim-false` (same source AND the "
    "same recorded toolchain, different bytes: the artifact is not what "
    "this source and toolchain produce), `undiagnosed` (bytes differ and "
    "an identity is missing, so it names neither rather than guessing). "
    "The toolchain of BOTH sides is read the same way, from each ELF's "
    ".comment section. Refusals name the rule: ARTIFACT_MISSING, "
    "ARTIFACT_UNREADABLE, NO_SOURCE_TREE, BAD_PROFILE, REBUILD_FAILED, "
    "REBUILD_RECEIPT_INVALID. Costs a full node build; it starts, stops "
    "and signals nothing.",
    16384,
    "verify,reproduce,bytes,rebuild,supply-chain,trust,artifact,toolchain",
    "zcl.zcode_node_verify.input.v1", "zcl.zcode_node_verify.v1",
    "artifact,source_dir,scratch_dir,profile,jobs,timeout_seconds", "",
    "z23 zcode node verify --input='{\"source_dir\":\"/path/to/zclassic23\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_BACKGROUND, ZCL_COMMAND_COST_HIGH,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_node_verify)

ZCL_COMMAND_PLANNED_COMMAND(
    "zcode.node.update.status", "zcode.node.update", "update",
    "Show what this node would update to",
    "Will report the source identity this node is RUNNING against the "
    "newest node release it has verified locally, plus whether an update "
    "is available, already staged, or blocked. Until the release feed and "
