ZCL_COMMAND_READY_READ(
    "zcode.package.peers", "zcode.package.swarm", "zcode.package.peers",
    "Swarm peers, possession, pin, and transfer snapshot",
    "The live swarm engine's per-peer view for one 64-hex package `root`: "
    "peer id, the LOCAL session pseudo-key (0x02 || SHA3-256(domain || "
    "host identity) — a transport-session scope for the service book, "
    "explicitly NOT a contributor identity), resolved tier, in-flight "
    "requests, a transfer snapshot of verified served/fetched bytes, the "
    "download-allowance-exhausted flag, and the book offence tally, plus "
    "the download status summary. Rows bounded at 32 (peers_truncated "
    "flags the rest). Peer facts are session-scoped and never persisted: "
    "without a live hosting engine the reply is live:false with an empty "
    "list — honestly, never replayed from disk. Store-side `possession` "
    "always names whether THIS node holds the root complete, whether it "
    "is operator-pinned, and whether it is public-serveable "
    "(`would_serve`). Missing store facts fail closed; replica counts "
    "are never invented.",
    ZCL_COMMAND_LIST_BUDGET,
    "zcode,package,peers,swarm,advertisers,tier,session",
    "zcl.zcode_package_peers.input.v1", "zcl.zcode_package_peers.v1",
    "root,datadir", "root",
    "z23 zcode package peers --input='{\"root\":\"<64hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_zcode_package_peers)

ZCL_COMMAND_READY_READ(
    "zcode.package.offered", "zcode.package.swarm", "zcode.package.offered",
    "Roots peers ANNOUNCEd this session that this node can fetch",
    "The live swarm engine's union of package roots peers have ANNOUNCEd "
    "this session, sorted by root. Each row is one 64-hex `root` with "
