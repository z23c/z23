ZCL_COMMAND_PLANNED_COMMAND(
    "zcode.node.update.apply", "zcode.node.update", "",
    "Stage a verified newer node release",
    "Will stage an already-verified release beside the running binary and "
    "hand the swap to the service manager. It will NOT start, stop, signal "
