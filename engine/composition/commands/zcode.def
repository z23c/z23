ZCL_COMMAND_READY_READ(
    "zcode.commons.schedule.propose.plan",
    "zcode.commons.schedule.propose", "",
    "Plan one Proof-of-Participation epoch proposal",
    "Rebuilds the Commons projection, takes its minted totals as "
    "already_emitted, computes the decided (cap - emitted) / 1040 weekly "
    "budget against the 21,000,000 ZC23 cap and splits it pro-rata by the "
    "100/40/20/5 class weights over the epoch's verified evidence. "
