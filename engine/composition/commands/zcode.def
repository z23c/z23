    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_zcode_storage_status)

/* ── slice 12: the authenticated package swarm ─────────────────────────
 * The swarm engine (contexts/commons/modules/vcs/package_swarm_node.*) is pure; the "zpkgswm"
 * wire frames ride the existing P2P transport through net hooks, and the
 * glue lives in engine/composition/src/boot_zcode_swarm.c. fetch is live when a
 * -packagehost=1 node runs (node-global engine) and otherwise persists
 * the resumable download record — never a faked download. peers is
 * session state: it reports live:false honestly on a one-shot CLI.
 * offered is the same session catalog of roots peers have ANNOUNCEd. */

/* The zcode.package menu crossed its fixed branch budget once the swarm
 * leaves and the fastobj branch coexisted as direct children (contract §8:
 * every branch menu renders inside ZCL_COMMAND_BRANCH_BUDGET — the contract
 * test renders them all and fails the push). Nesting, not summary-trimming
 * and not a budget bump, is the repo's precedent (see docs/ROM_DELIVERY.md
 * on ops.debug.rom_seed, and the zcode.package.dev.* aliases below left by
 * the same migration). Old dotted paths stay as aliases so every existing
 * `zcode package fetch`-style invocation keeps resolving unchanged. */
ZCL_COMMAND_BRANCH("zcode.package.swarm", "zcode.package",
                   "Authenticated swarm fetch and peer view",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_COMMAND(
    "zcode.package.fetch", "zcode.package.swarm", "zcode.package.fetch",
    "Fetch a package from the authenticated swarm",
    "Starts (or idempotently resumes) a swarm download of one package: "
    "`root` (64 hex) is exact identity; optional `name` is a LOCAL "
    "store-index label — the same `name` `zcode package library` emits — "
    "never ZNAM. Manifest-first, then chunks rarest-first across the "
    "peers advertising the root, every chunk SHA3-verified against the "
    "root-committed manifest BEFORE it is stored (the authentication), "
    "with bounded attempts naming a terminal failure. Against a running "
    "-packagehost=1 node this drives the live engine (live:true); a "
    "one-shot CLI persists the resumable record under "
    "<datadir>/zcode/downloads/<root-hex> and reports live:false — the "
    "next hosting boot resumes it. Fetch is inert: no build, link, "
    "execute, install, or deploy. ALREADY_COMPLETE (already_complete:"
    "true) is the idempotent redelivery. Rejections name the rule: "
    "MISSING_ROOT_OR_NAME, BAD_ROOT, UNKNOWN_NAME, NAME_ROOT_MISMATCH, "
    "AMBIGUOUS_NAME, NO_STORE, DOWNLOAD_SLOTS_FULL (16 tracked downloads), "
    "RECORD_IO. `day` pins the accounting window for deterministic "
    "testing (host clock when omitted).",
    0,
    "zcode,package,fetch,download,swarm,resume,name",
    "zcl.zcode_package_fetch.input.v1", "zcl.zcode_package_fetch.v1",
    "root,name,day,datadir,namespace,maximum_bytes", "",
    "z23 zcode package fetch --input='{\"name\":\"<local-library-name>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_package_fetch)

ZCL_COMMAND_READY_COMMAND(
    "zcode.package.source.reproduce", "zcode.package.swarm",
    "zcode.package.source.reproduce",
    "Fetch, reconstruct, and attest one exact source package",
    "One job-root-derived package root is enough: plan first drives the "
    "authenticated provider lookup/fetch, re-derives the self-describing "
