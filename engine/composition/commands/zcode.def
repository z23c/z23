ZCL_COMMAND_BRANCH("zcode.storage", "zcode",
                   "CAS storage",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_READ(
    "zcode.storage.status", "zcode.storage", "",
    "Store quota pools plus the pin-allowance policy view",
    "The slice-2 content-addressed store's quota pools (pins / hot / "
    "rare / staging) with budget and used bytes each, hosting_enabled "
    "and quota_bytes from the flags, store_present honesty (a datadir "
    "with no store reports zero usage without creating one), and the "
    "slice-11 policy view: the live PINS pool usage/headroom against "
    "the per-tier contributor pin allowances (new users have none — "
    "pins are earned; the pin-allowance-exceeded rule gates "
    "contributor-requested pins via vcs_policy_check_pin). The "
    "operator's own pins are never tier-gated; the PINS pool is never "
    "evicted.",
    ZCL_COMMAND_LIST_BUDGET,
    "zcode,storage,status,quota,pools,pins,policy",
