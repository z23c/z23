/* ── attestation import: closing the third-party evidence loop ─────────
 * An attestation is signed, self-verifying, PORTABLE evidence, but the
 * only writer into a store's attestations/ dir was the verifier program
 * itself, on its own filesystem. import files any third party's wire into
 * the local store. Filing is NOT acceptance: import validates only the
 * wire's internal consistency and embedded signature — the local
 * approved-verifier quorum policy applies at evaluation time (zcode
 * package verify), never at import. */
ZCL_COMMAND_BRANCH("zcode.package.attest", "zcode.package",
                   "File signed third-party verifier attestations",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_COMMAND(
    "zcode.package.attest.import", "zcode.package.attest", "",
    "File a signed attestation wire into the local store",
    "Hex-decodes attestation_wire (bound "
    "VCS_PACKAGE_ATTEST_MAX_WIRE_BYTES), parses the canonical ZCLATT wire "
    "(every grammar and consistency rule named on rejection), verifies the "
    "embedded secp256k1 signature over the attestation id (bad/low-S "
    "signatures named), and files the exact bytes at "
    "<datadir>/zcode/attestations/<attestation-id-hex> with tmp+rename "
    "discipline. Idempotent: re-importing the identical wire succeeds with "
    "filed=false, already_present=true; a same-name file that does not "
    "read back identical is a fail-closed STORE_CONFLICT (impossible for "
    "honest wires — the id is the content hash). Filing is NOT acceptance: "
    "the approved-verifier quorum policy is applied by zcode package "
    "verify at evaluation time, and the attested package/release/recipe "
    "need not be locally present. The response carries filed, "
    "already_present, attestation_id, signer_pubkey, result_class, and a "
    "note stating the filing/acceptance boundary.",
    0,
    "zcode,package,attest,import,attestation,verifier,portable,file",
    "zcl.zcode_package_attest_import.input.v1",
    "zcl.zcode_package_attest_import.v1",
    "attestation_wire,datadir", "attestation_wire",
    "z23 zcode package attest import --input='{\"attestation_wire\":\"<hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_package_attest_import)

/* ── attestation transport: offer + pull ───────────────────────────────
 * import closes the loop for bytes a human already carried. These two
 * close it for bytes nobody carried. An attestation is at most 681 bytes,
 * under the blob bound, so it travels as an ordinary one-file one-chunk
 * content.v2 package over the already-frozen 'zpkgswm' codec — NO new wire
 * message, no new bound, no new store. Discovery is two ordinary signed
 * DHT records in zclassic23.attestation, and BOTH are required: a PROVIDER
 * on the attestation blob root ("ask me for these bytes" — the record the
 * fetch path routes on) and a POINTER binding the attested package root to
 * that blob root ("that blob attests this package"). Publishing only one
 * is a silent no-op at pull time. Neither leaf consults the approved-
 * verifier allowlist: admitting is not accepting, and the quorum belongs
 * to zcode package verify. */
ZCL_COMMAND_READY_COMMAND(
    "zcode.package.attest.offer", "zcode.package.attest", "",
    "Make one filed attestation reachable over the swarm",
    "Re-reads <datadir>/zcode/attestations/<attestation_id>, re-parses the "
    "canonical ZCLATT wire, re-verifies the embedded secp256k1 signature, "
    "re-derives the id, and admits the EXACT bytes into the package store "
    "as an ordinary blob. Idempotent: the transport_root is a pure function "
    "of the signed bytes — identical on every node forever — and is NOT the "
    "attestation id. The reply carries attestation_id, transport_root, "
    "package_root, release_id, recipe_root, signer_pubkey, result_class, "
    "namespace, and TWO ready-to-run zcode network publish inputs. Offering "
    "makes the bytes REACHABLE and announces NOTHING; telling the network "
    "is the separate second act and takes BOTH records: run publish with "
    "provider_publish_input (\"ask me for these bytes\" — what the fetch "
    "path routes on) AND with pointer_publish_input (\"that blob attests "
    "this package root\" — what a puller looks up). Pointer-only means a "
    "puller learns which blob to want and finds nobody serving it; "
    "provider-only means the bytes are reachable and nobody knows to ask. "
    "ATTESTATION_ABSENT names an id with no filed wire; ATTESTATION_INVALID "
    "and ATTESTATION_ID_MISMATCH name the failed codec rule.",
    0,
    "zcode,package,attest,offer,attestation,swarm,blob,provider,pointer",
    "zcl.zcode_package_attest_offer.input.v1",
    "zcl.zcode_package_attest_offer.v1",
    "attestation_id,datadir", "attestation_id",
    "z23 zcode package attest offer --input='{\"attestation_id\":\"<64hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_package_attest_offer)

ZCL_COMMAND_READY_COMMAND(
    "zcode.package.attest.pull", "zcode.package.attest", "",
    "Fetch and admit published attestations for one package root",
    "Resolves every zclassic23.attestation POINTER record at "
    "semantic_root=package_root, drives the ordinary swarm fetch for each "
    "DISTINCT attestation blob root, and admits each result with "
    "expect_package_root ALWAYS set to package_root. That receiver-side "
    "binding check — never the publish gate — is the security property: an "
    "attestation whose own package_root differs is refused "
    "package-root-binding and NOT filed, so a hostile pointer in this "
    "namespace cannot deliver evidence about another package. Bounded rows "
    "carry transport_root, fetch_outcome, admit_result (the NAMED rule), "
    "attestation_id, signer_pubkey, result_class, filed and "
    "already_present, plus totals pointers_seen, distinct_transport_roots, "
    "fetched, admitted, filed, refused and rows_truncated — capped by "
    "maximum_records, never truncated silently. A row that fails STAYS in "
    "the report naming its rule: one bad or unreachable pointer never "
    "aborts the sweep, so the other verifiers' attestations still land. "
    "status separates the two dead ends that must never be merged: "
    "NO_ATTESTATION_POINTERS (nobody has attested this root yet) versus "
    "ATTESTATION_BYTES_UNREACHABLE (pointers exist, no authenticated "
    "provider served the bytes). Pulling is NOT accepting — attestations "
    "from unapproved signers and failure result classes are filed on "
    "purpose, and the approved-verifier quorum is applied later by zcode "
    "package verify.",
    0,
    "zcode,package,attest,pull,attestation,swarm,pointer,quorum,evidence",
    "zcl.zcode_package_attest_pull.input.v1",
    "zcl.zcode_package_attest_pull.v1",
    "package_root,datadir,maximum_records", "package_root",
    "z23 zcode package attest pull --input='{\"package_root\":\"<64hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_package_attest_pull)

/* ── attestation admit: carriage without a DHT ─────────────────────────
 * offer and pull assume a working authenticated record layer. A node that
 * has ALREADY fetched an attestation blob — zcode package fetch on the
 * transport root, or the swarm delivering it some other way — had the
 * evidence in its package store and no way to admit it: import wants hex
 * it does not hold, pull wants a DHT that needs identity files and a
 * delegation chain verified against real chain history. admit closes that
 * hole with no network at all. Its package_root is OPTIONAL where pull's
 * is mandatory, and the semantics below say exactly when omitting it is
 * wrong. */
ZCL_COMMAND_READY_COMMAND(
    "zcode.package.attest.admit", "zcode.package.attest", "",
    "Admit one attestation blob this node already holds",
    "Reads the blob at transport_root back out of the package store (the "
    "blob layer re-verifies the manifest, root and chunk hash), parses it "
    "as a canonical ZCLATT wire, re-verifies the embedded "
    "signature, re-derives the id, and files the EXACT bytes at "
    "<datadir>/zcode/attestations/<attestation-id-hex>. It contacts NO "
    "network: it admits bytes you already hold, so a node whose "
    "authenticated record layer is not up can still take in an attestation "
    "it fetched with zcode package fetch. package_root is OPTIONAL here "
    "and MANDATORY on zcode package attest pull, deliberately: pull "
    "resolved the blob FROM a POINTER keyed on a package root, so it "
    "is answering a question about one specific package and MUST bind, or "
    "a hostile pointer could deliver an attestation for a DIFFERENT "
    "package as evidence about yours; admit is handed a transport root "
    "directly. If you are asking whether this attestation is evidence "
    "about a particular package you MUST pass package_root; a wire naming "
    "a different root is then refused PACKAGE_ROOT_BINDING and NOT filed. "
    "Omitting it is NOT the safe default: it is the weaker 'I am not "
    "asking about one package' case, which files whatever package the "
    "wire names and asserts nothing about yours. A malformed "
    "package_root is BAD_PACKAGE_ROOT, never treated as absent. "
    "Idempotent: identical bytes succeed with already_present=true; a "
    "same-name file that does not read back identical is fail-closed "
    "STORE_CONFLICT. ATTESTATION_BYTES_ABSENT "
    "names a root no blob is held for (fetch it first). Every refusal "
    "names its own rule, and the reply repeats it as admit_result. "
    "Admitting is NOT accepting: unapproved signers and "
    "failure result classes are filed on purpose; the quorum is "
    "applied later by zcode package verify.",
    0,
    "zcode,package,attest,admit,attestation,blob,transport,offline,file",
    "zcl.zcode_package_attest_admit.input.v1",
    "zcl.zcode_package_attest_admit.v1",
    "transport_root,package_root,datadir", "transport_root",
    "z23 zcode package attest admit --input='{\"transport_root\":\"<64hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_package_attest_admit)

/* ── slice 4: contributor identity + ZNAM pointers ─────────────────────
 * The secp256k1 publisher key is the only authoritative identity; ZNAM
 * records are mutable pointers resolved through the canonical ZNAM model
 * and bound only when the name owner equals the publisher key's P2PKH. */

ZCL_COMMAND_BRANCH("zcode.contributor", "zcode",
                   "Contributors",
                   ZCL_COMMAND_LAYER_APP)

