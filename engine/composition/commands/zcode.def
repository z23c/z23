/* ── Anchor domains: the durable record of what a batch committed ────
 * `zcode release anchor` stores the sorted leaf set + the root it folds
 * to in zid_domains/zid_domain_leaves (schema v38, models/zid_domain.h)
 * BEFORE any chain write, and `zcode release prove` reads that stored
 * leaf set — so adding or deleting a .zid file can no longer silently
 * change what an already-issued inclusion proof means. These two read
 * leaves make the store inspectable: what domains exist, what root each
 * one carries, whether that root is on-chain, and what leaves are under
 * it. Also exposed as `z23 dumpstate zid_domains`. */
ZCL_COMMAND_BRANCH("zcode.domain", "zcode",
                   "Anchor domains",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_READ(
    "zcode.domain.list", "zcode.domain", "",
    "List the anchor domains stored in this datadir",
    "Every domain in <datadir>/node.db's zid_domains table, name-ordered: "
    "domain, num_leaves, root, anchored (plus anchored_txid and the height "
    "the anchor was BROADCAST at when it is), updated_at, and has_owner. "
    "Many domains coexist — zcode, zdesc, zdir, third-party registries — "
    "each anchoring at its own cadence. An empty list means nothing has "
    "been folded yet in this datadir, not an error; fold one with `zcode "
    "release anchor`.", 0,
    "zcode,domain,list,zid,registry,anchor,batch,root",
    "zcl.zcode_domain_list.input.v1", "zcl.zcode_domain_list.v1",
    "datadir", "",
    "z23 zcode domain list --input='{}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_zcode_domain_list)

ZCL_COMMAND_READY_READ(
    "zcode.domain.status", "zcode.domain", "",
    "Show one anchor domain's stored root, leaves, and anchor",
    "One domain (--domain, default \"zcode\") from <datadir>/node.db: the "
    "domain_row (num_leaves, root, anchored/anchored_txid/anchored_height, "
    "updated_at, owner), stored_leaf_rows, the integrity answer "
    "leaf_rows_match_num_leaves (false means the domain row and its leaf "
    "table disagree and every proof against this root is suspect — re-run "
    "`zcode release anchor`), and the first 50 leaves as index + "
    "record_digest + label (\"<name>@<version>\"). DOMAIN_NOT_FOUND names "
    "a domain that has never been folded.", 0,
    "zcode,domain,status,zid,registry,anchor,batch,root,leaves,proof",
    "zcl.zcode_domain_status.input.v1", "zcl.zcode_domain_status.v1",
    "domain,datadir", "",
    "z23 zcode domain status --input='{\"domain\":\"zcode\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_zcode_domain_status)
/* ── Light-client proof chain (docs/spec/sovereign-identity-layer.md) ──
 * The spec's chain — header PoW -> anchor tx inclusion -> ZANC anchor
 * decode -> domain root -> record inclusion proof -> zid signature ->
 * master-key anchor — as ONE read-only command over evidence the caller
 * hands in. No node contact. Each rung reports independently;
 * `not_checked` always carries a reason and is rendered distinctly from
 * `passed`.
 * Rungs 1-6 are node-free. Rung 7 (identity_anchor) cannot be — whether a
 * key is anchored on-chain and still active is only answerable from a
 * folded chain — so it is opt-in on an explicit `datadir`, reads the
 * zid_identities projection READONLY via db_zid_identity_find, and stays
 * not_checked without one. `node_free` in the report says which. */
ZCL_COMMAND_BRANCH("zcode.proof", "zcode",
                   "Proof verify",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_READ(
    "zcode.proof.walk", "zcode.proof", "",
    "Walk a record's proof chain down to proof-of-work, rung by rung",
    "A seven-rung report for one zid document: (1) header + Equihash PoW, "
    "(2) the anchor tx's merkle inclusion in that header, (3) the first "
    "OP_RETURN parsing as a ZANC anchor, (4) the domain root matching the "
    "anchored digest, (5) record inclusion via zid_tree_verify, (6) the "
    "zid signature and expiry, (7) the master key's on-chain identity "
    "anchor. Every rung reports passed / failed / not_checked "
    "INDEPENDENTLY and a not_checked rung always states why — it is never "
    "counted as passing. `verified_prefix` counts only CONSECUTIVE passing "
    "rungs from 1, so a later rung can never be lifted by a broken earlier "
    "one, and `chain_complete` is true only when all seven pass. Rungs 1-6 "
    "are node-free — only the evidence you pass in. Rung 7 asks a question "
    "no document can answer about itself, so it is OPT-IN on `datadir`: "
    "with one it resolves the master key against that node's folded "
    "zid_identities projection (READONLY) and passes only on an ACTIVE "
    "anchor — a rotated or revoked key FAILS and names its successor; "
    "without one it stays not_checked and `node_free` is true. A walk that "
    "ran returns status PASSED even when rungs fail — the envelope drops "
    "`data` on any other status and the report is the product; read "
    "`verdict`/`first_break`, never the exit code. Only a "
    "missing/undecodable document (NO_DOCUMENT) fails outright.", 16384,
    "zid,proof,chain,verify,light-client,anchor,zanc,pow,inclusion,walk",
    "zcl.zcode_proof_walk.input.v1", "zcl.zcode_proof_walk.v1",
    "doc,doc_file,proof,root,tx,header,headers,merkle_branch,merkle_index,"
    "now,datadir",
    "",
    "z23 zcode proof walk --input='{\"doc\":\"<hex>\",\"proof\":"
    "\"<hex>\",\"root\":\"<64hex>\",\"tx\":\"<hex>\",\"header\":\"<hex>\","
    "\"merkle_index\":1,\"merkle_branch\":\"<64hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_PUBLIC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_proof_chain_walk)

/* ── Signed onion-service descriptors (zdesc) ────────────────────────
 * The flagship application of the sovereign identity layer: a service's
 * introduction-point set becomes a SIGNED DOCUMENT distributed as
 * content (a zid_doc with body tag "ZIDD", carried as a
 * content-addressed blob over the existing package swarm) instead of a
 * record handed to a directory authority. Addressed by the BLINDED
 * record key for a time period — SHA3-256("ZIDB" | master_pubkey |
 * period_le64), a whole UTC day — so only someone who already knows the
 * master key can compute the address. Rotation is a new seq and a new
 * signature: no transaction, no fee, no naming certificate authority.
 *
 * VERIFICATION STATUS: verify/resolve check the signature against a
 * CALLER-SUPPLIED master pubkey. Nothing in this tree consults the
 * chain, and every reply carries chain_anchored:false plus
 * verified_against:"supplied_key".
 * See docs/spec/sovereign-identity-layer.md and contexts/wallet/modules/zid/include/zid/zdesc.h. */
ZCL_COMMAND_BRANCH("zcode.network", "zcode",
                   "Package DHT", ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_COMMAND(
    "zcode.network.delegate", "zcode.network", "",
    "Provision this node's DHT delegation",
    "Reads the active ZID master seed exactly once from a regular 0400/0600 "
    "file, requires that master to be ACTIVE and its finality-delayed beacon "
    "to be ten blocks deep, reuses the persistent Noise X25519 identity, and "
    "atomically creates the separate online Ed25519 key and signed ZIDN "
    "delegation under <datadir>/zcode/dht. Default validity is three days; "
    "the existing 30-day ZID window cap is enforced. Renewal advances the "
    "filed sequence by default and leaves node_id stable. The reply contains "
    "node ID, sequence, window, and beacon metadata, never key material.",
    0, "zcode,network,dht,delegate,zid,noise,identity,provision",
    "zcl.zcode_network_delegate.input.v1",
    "zcl.zcode_network_delegate.v1",
    "seed_file,sequence,now,expiry,datadir", "seed_file",
    "z23 zcode network delegate --input='{\"seed_file\":\"/path/master.hex\"}'",
