ZCL_COMMAND_READY_COMMAND(
    "zcode.focus.claim-publish", "zcode.focus", "",
    "Publish one admitted worker focus claim",
    "Reverifies one canonical work item, exact source generation, bounded "
    "agent context, signed work request and signed worker admission. It "
    "derives the claimant, validity interval, evidence plan and write-scope "
    "binding, then stores the inert canonical scope, empty situation focus "
    "and focus_claim.v1 bytes in the existing workspace CAS with bounded "
    "readback and root verification. The claim records existing admission; "
    "it grants no assignment, execution, acceptance or deployment authority.",
    ZCL_COMMAND_RESULT_BUDGET,
    "zcode,focus,claim,worker,scope,admission,cas",
    "zcl.zcode_focus_claim_publish.input.v1",
    "zcl.zcode_focus_claim_publish.v1",
    "workspace,work,situation_root,write_scope,work_request_root,work_admission_carrier_root,datadir,details",
    "workspace,work,situation_root,write_scope,work_request_root,work_admission_carrier_root",
    "z23 zcode focus claim-publish --input='{...}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_zcode_focus_claim_publish)

ZCL_COMMAND_READY_COMMAND(
    "zcode.focus.snapshot-publish", "zcode.focus", "",
    "Publish one canonical active-claim focus snapshot",
    "Loads and re-roots one to sixteen existing focus claims, their exact "
    "write scopes, signed requests and signed admission carriers. It sorts "
    "the roots canonically, rejects duplicates, overlap, stale admission and "
    "authority or budget mismatch, then stores focus_claim_set.v1 and the "
    "composed focus.v1 in the existing workspace CAS. This immutable "
    "snapshot is evidence about admitted work, never a queue, lease, "
    "scheduler, execution permission, acceptance or deployment decision.",
    ZCL_COMMAND_RESULT_BUDGET,
    "zcode,focus,snapshot,claims,disjoint,admission,cas",
    "zcl.zcode_focus_snapshot_publish.input.v1",
    "zcl.zcode_focus_snapshot_publish.v1",
    "workspace,work,claim_roots,work_admission_carrier_roots,datadir,details",
    "workspace,work,claim_roots,work_admission_carrier_roots",
    "z23 zcode focus snapshot-publish --input='{...}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_focus_snapshot_publish)

