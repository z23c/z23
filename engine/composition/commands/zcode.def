ZCL_COMMAND_READY_COMMAND(
    "zcode.package.dev.improve", "zcode.package.dev", "zcode.improve",
    "Improve code candidate",
    "mode=plan stores the workspace and returns immutable task, context, and "
    "scope roots without launching work. mode=admit re-derives the candidate "
    "tree/patch, enforces scope and limits, and queues the selected fixed "
    "compile, package, test, or fuzz action. The task binds every input and "
    "expiry. Before task/context persistence, both modes rebuild the CAS task "
    "projection and refuse an exact same-source/same-goal open task or a "
    "component-bounded declared-scope overlap; incomplete scans refuse. This "
    "is collision evidence only: ownership, assignment, and execution remain "
    "unobserved, and no adapter gains acceptance authority. Admission appends one "
    "root-bound async proof request and returns before discovery, packaging, "
    "transfer, or remote execution. remote_peer is an optional local hint; "
    "zero permits later discovery of any eligible full-node peer.", 0,
    "zcode,improve,task,agent,zbuild,proof,compile,package,test,fuzz",
    "zcl.zcode_improve.input.v1", "zcl.zcode_improve.v1",
    "workspace,candidate_workspace,datadir,mode,planned_task_root,planned_context_root,candidate_source_sha256,source_root,dependency_lock_root,dependency_lock_hex,write_scope_root,write_scope_csv,acceptance_tests_root,acceptance_recipe_hex,model_policy_root,goal,proof_policy_hex,action_kind,fixed_input_path,fixed_input_relpath,preprocessed_path,patch_root,candidate_source_root,adapter_policy_root,author_pubkey,candidate_sequence,candidate_created_unix,profile,expires_unix,max_changed_files,max_patch_bytes,max_context_bytes,max_cpu_seconds,max_memory_bytes,max_output_bytes,context_symbol,remote_peer",
    "workspace,dependency_lock_hex,write_scope_csv,acceptance_recipe_hex,model_policy_root,goal,proof_policy_hex,expires_unix",
    "z23 zcode improve --input='{\"mode\":\"plan\",\"workspace\":\"/src/project\",\"dependency_lock_hex\":\"<canonical wire hex>\",\"write_scope_csv\":\"src,include\",\"acceptance_recipe_hex\":\"<canonical wire hex>\",\"model_policy_root\":\"<64hex>\",\"goal\":\"fix seeded bug\",\"proof_policy_hex\":\"<wire hex>\",\"context_symbol\":\"buggy_function\",\"expires_unix\":123}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_improve)

ZCL_COMMAND_READY_COMMAND(
    "zcode.package.dev.evidence", "zcode.package.dev", "zcode.evidence",
    "Evaluate candidate evidence",
    "Re-verifies canonical work receipts from the existing workspace CAS, "
    "applies the task-bound proof_policy.v1, and reports whether the selected "
    "output has local reproduction or the user's approved distinct-signer "
    "quorum. Compile, test, fuzz, and approving review receipts are counted "
    "separately against their exact fixed action kinds; review.v1 must bind "
    "an existing trusted proof set. A release-byte-identity policy remains "
    "false until final release artifacts exist. Remote observations remain "
    "untrusted until reproduction or the applicable quorum passes. Emits "
    "and stores the canonical proof-set root used by review.v1.",
    0, "zcode,evidence,receipt,quorum,reproduce,proof",
    "zcl.zcode_evidence.input.v1", "zcl.zcode_evidence.v1",
    "workspace,datadir,action_id", "workspace,action_id",
    "z23 zcode evidence --input='{\"workspace\":\"/src/project\",\"action_id\":\"<64hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
