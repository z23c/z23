ZCL_COMMAND_READY_COMMAND(
    "zcode.work.run", "zcode.work", "", "Run one contained adapter handoff",
    "Reloads the verified task and canonical agent context, materializes an "
    "isolated candidate workspace, and either emits a bounded manual packet or "
    "runs the fixed opt-in Codex adapter behind Landlock, a scrubbed environment "
    "and strict limits. Selected locked packages contribute only receipt-verified "
    "headers and C APIs relevant to the goal; an ambiguous package-only match "
    "keeps its complete public header surface. The exact task lock is reflected "
    "only in isolated candidate metadata, and that metadata change alone is never "
    "admitted as requested behavior. A failed bounded build carries "
    "its structured compiler "
    "diagnostic into the next adapter packet. Its typed status handoff retains "
    "the workspace and short work ID without a forbidden command self-loop or "
    "proof roots. Only an explicitly targeted datadir or the resident node's "
    "already-owned ledger may receive live admission; a one-shot default target "
    "stays in the closed scratch build lifecycle. A repeated run on an admitted "
    "candidate whose bound datadir still holds outstanding independent proof is "
    "an idempotent waiting observation identical to work status, never a fresh "
    "attempt; without that chain it fails closed. A repeated run on a task whose "
    "candidate already holds complete evidence, or is accepted, is likewise an "
    "idempotent observation of that state. The default "
    "result is root-free; "
    "details=true exposes "
    "exact proof identities. No adapter receives acceptance or publication authority.",
    ZCL_COMMAND_RESULT_BUDGET,
    "zcode,work,run,adapter,manual,codex,contained,candidate",
    "zcl.zcode_work_run.input.v1", "zcl.zcode_work_run.v1",
    "workspace,work,adapter,datadir,details", "",
    "z23-dev zcode work run --input='{\"work\":\"latest\",\"adapter\":\"manual\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_work_run)

ZCL_COMMAND_READY_COMMAND(
    "zcode.work.accept", "zcode.work", "", "Accept one exact proven candidate",
    "This explicit human decision reloads the latest canonical candidate, "
    "signed work evidence and current signed lane, requires the exact proof "
    "policy, then advances the existing CANDIDATE and PROVEN lane receipts. "
    "CANDIDATE remains proof readiness; only this command's PROVEN result is "
    "human acceptance. An optional confirmation_identity binds this write to "
    "the exact task, candidate, proof policy and proof set previously shown by "
    "app presentation release-confirm; its typed handoff avoids copying that "
    "identity, and stale or mismatched facts are refused. "
    "It does not edit source files, publish a package, or give the adapter "
    "acceptance authority. Repeating an already-PROVEN acceptance is "
    "idempotent. The default result hides roots and carries the existing "
    "publication job in a typed next action; details=true exposes exact "
    "identities.", ZCL_COMMAND_RESULT_BUDGET,
    "zcode,work,accept,human,proven,lane,evidence",
    "zcl.zcode_work_accept.input.v1", "zcl.zcode_work_accept.v1",
    "workspace,work,datadir,confirmation_identity,details", "",
    "z23-dev zcode work accept --input='{\"work\":\"latest\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_work_accept)

/* ── work transport: solutions move between nodes, keyed by task ──────
 * A task is content-addressed (task_root); a solution is the source
 * package whose accepted-work chain verifies against exactly that root.
 * Discovery in zclassic23.work is keyed by the PROBLEM, not by author or
 * package name. Both leaves ride only existing wires: the frozen swarm
 * codec for bytes, signed POINTER/PROVIDER records for discovery. */
ZCL_COMMAND_READY_COMMAND(
    "zcode.work.offer", "zcode.work", "",
    "Make one accepted solution discoverable by its task",
    "Verifies the source package at package_root is held complete and "
    "reconstructs to a verified accepted-work chain (task, candidate, "
    "proof policy, every receipt, PROVEN lane), DERIVES the task root it "
    "solves — the task root is an output of verification, never an input "
    "— and returns TWO ready-to-run zcode network publish inputs for "
    "zclassic23.work: provider_publish_input (\"ask me for these bytes\", "
    "the record the fetch path routes on) and pointer_publish_input "
    "(\"this package solves this task\", what a puller looks up when all "
    "it knows is the task root). Both are required; either alone is a "
    "silent no-op at pull time. WORK_NOT_RECONSTRUCTIBLE names a package "
    "that is not held or does not verify. Offering announces NOTHING: "
    "publishing is the separate second act.",
