    "z23 zcode workspace source bundle checkout --input='{\"bundle\":\"/tmp/source.zvsb\",\"source_root\":\"<64hex>\",\"workspace\":\"/tmp/zvcs-scratch\",\"destination\":\"/tmp/source-scratch\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
