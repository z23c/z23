ZCL_COMMAND_READY_COMMAND(
    "zcode.workspace.source.bundle.fetch", "zcode.workspace.source.bundle", "",
    "Fetch a source bundle from peers by its content root",
    "Asks each peer in a comma-separated host:port list which source bundles "
    "it seeds, downloads every "
    "artifact advertising the requested ZVCS tree root, and writes one to an "
    "explicit scratch path only after the delivered bytes rederive that exact "
    "root — the same complete manifest and blob rehash the local verify "
    "performs. Bytes are accepted for hashing to the requested root and for no "
    "other reason: no signature, no signer identity, no acceptance chain, no "
    "approved-verifier list and no hardcoded host take part. A peer that "
    "serves a different tree is discarded and deprioritized, and no output "
    "file is created on any refusal. It does not materialize or execute "
    "source.", ZCL_COMMAND_RESULT_BUDGET,
    "zcode,source,bundle,zvcs,fetch,p2p,content-addressed,identity-free,git-free",
    "zcl.zcode_source_bundle_fetch.input.v1",
    "zcl.zcode_source_bundle_fetch.v1",
    "source_root,output,peers", "source_root,output,peers",
    "z23 zcode workspace source bundle fetch --input='{\"source_root\":\"<64hex>\",\"output\":\"/tmp/source.zvsb\",\"peers\":\"203.0.113.7:18034,198.51.100.9:18035\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_HIGH,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_zcode_source_bundle_fetch)

ZCL_COMMAND_READY_COMMAND(
    "zcode.workspace.source.bundle.publish", "zcode.workspace.source.bundle",
    "",
    "Offer a workspace to peers by its content root",
    "Captures the workspace into ZVCS, builds its compressed bundle, lands it "
    "under the RUNNING node's own seeded artifact directory, registers it "
    "there by name, and prints the 64-hex source root another machine needs to "
    "pull it with fetch after learning a serving peer address. The node picks "
    "the destination path; the caller names "
    "none. Registration is by exact name, never a bounded directory sweep, so "
    "how many entries share that directory cannot silently hide the bundle, "
    "and the result reports the offer only after the node's registry confirms "
    "it by root. Publishing grants no acceptance authority and asks for no "
    "identity: a fetcher still accepts the bytes solely because they rederive "
    "the root it asked for. Optional source_root is a pin — a workspace that "
    "captures to a different tree is refused before publication bytes are "
    "written. It "
    "does not execute source.", ZCL_COMMAND_RESULT_BUDGET,
    "zcode,source,bundle,zvcs,publish,seed,p2p,content-addressed,identity-free,git-free",
    "zcl.zcode_source_bundle_publish.input.v1",
    "zcl.zcode_source_bundle_publish.v1",
    "workspace,source_root", "workspace",
    "z23 zcode workspace source bundle publish --input='{\"workspace\":\"/src\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_HIGH,
    ZCL_COMMAND_CONFIRM_IDEMPOTENCY,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_source_bundle_publish)

ZCL_COMMAND_READY_COMMAND(
    "zcode.workspace.source.package.checkout",
    "zcode.workspace.source.package", "",
    "Reconstruct an exact source carrier from the P2P store",
    "Reads one complete ordinary content.v2 package by immutable root, "
    "rederives its exact carrier shape and every chunk, verifies all "
    "path-stable ZVCS shards against the separately supplied accepted source "
    "root, imports the carried task/candidate/policy/proof/lane chain, derives "
    "its signer from the candidate, and re-resolves PROVEN authority before "
    "materializing source plus pinned offline vendor "
    "archives into an existing empty scratch destination. Retrieval never "
    "uses Git or executes downloaded source.", ZCL_COMMAND_RESULT_BUDGET,
    "zcode,source,package,content-v2,p2p,checkout,reconstruct,git-free,no-exec",
    "zcl.zcode_source_package_checkout.input.v1",
    "zcl.zcode_source_package_checkout.v1",
    "datadir,package_root,source_root,accepted_work_root,workspace,destination",
    "datadir,package_root,source_root,accepted_work_root,workspace,destination",
    "z23 zcode workspace source package checkout --input='{\"datadir\":\"/tmp/zclassic23-node\",\"package_root\":\"<64hex>\",\"source_root\":\"<64hex>\",\"accepted_work_root\":\"<64hex>\",\"workspace\":\"/tmp/zvcs-scratch\",\"destination\":\"/tmp/source-scratch\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_HIGH,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_zcode_source_package_checkout)

