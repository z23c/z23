ZCL_COMMAND_READY_COMMAND(
    "zcode.work.pull", "zcode.work", "",
    "Fetch and verify published solutions for one task root",
    "Resolves every zclassic23.work POINTER record at "
    "semantic_root=task_root, drives the ordinary swarm fetch for each "
    "DISTINCT source package, and verifies each with "
    "vcs_zcode_work_solution_admit — reconstruction from stored bytes "
    "re-verifying the package's own accepted-work chain, with "
    "expect_task_root ALWAYS set to the caller's root. That "
    "receiver-side binding check — never the publish gate — is the "
    "security property: a package that proves a DIFFERENT task is refused "
    "task-mismatch and stays unverified. Bounded rows carry "
    "transport_root, fetch_outcome, admit_result (the NAMED rule), "
    "source_root and accepted_work_root (verified rows only), plus "
    "totals pointers_seen, distinct_transport_roots, fetched, admitted, "
    "refused and rows_truncated. A row that fails STAYS in the report "
    "naming its rule; one bad pointer never aborts the sweep. status "
    "separates the dead ends that must never be merged: NO_WORK_POINTERS "
    "(nobody has solved this task yet) versus WORK_BYTES_UNREACHABLE "
    "(solutions exist, no authenticated provider served the bytes). "
    "Pulling is NOT accepting and NOTHING is executed: reconstruction "
    "runs in fresh private scratch removed before returning, and choosing "
    "what to do with the source is a separate explicit act.",
    0,
    "zcode,work,pull,solution,task,dht,pointer,swarm,verify",
    "zcl.zcode_work_pull.input.v1",
    "zcl.zcode_work_pull.v1",
    "task_root,datadir,maximum_records", "task_root",
    "z23 zcode work pull --input='{\"task_root\":\"<64hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_work_pull)

/* ── task transport: posted problems move between nodes ───────────────
 * The other half of the work lane: before a solution can be discovered by
 * its task, the task itself must be discoverable. A task is already
 * content-addressed (task_root); this carrier adds the part a stranger
 * cannot re-derive from the task wire alone — the goal preimage bound at
 * task.goal_root and the proof policy bytes bound at
 * task.proof_policy_root — inside one ordinary content.v2 package. No new
 * wire message and no new CAS object: bytes ride the frozen swarm codec,
 * discovery is two signed records in zclassic23.task, exactly like the
 * work and attestation lanes. The task object is deliberately unsigned.
 * Record signatures identify the publisher, local sovereignty policy
 * controls visibility, and receiver verification binds task integrity.
 * AGENT_SCOPE governance remains dormant. */
ZCL_COMMAND_READY_COMMAND(
    "zcode.task.offer", "zcode.task", "",
    "Bind one task's wires into the transport carrier",
    "Loads one task's three wires from the workspace object store (task "
    "wire at task_root, goal preimage at task.goal_root, proof policy at "
    "task.proof_policy_root — raw CAS loads do not verify, so EACH is "
    "re-hashed against its own address before use), binds them into the "
    "fixed-layout zcl-task-context.v1 carrier (exactly three members, "
    "deterministic root), admits it to the package store, and returns "
    "task_root, context_root, expires_unix and TWO ready-to-run zcode "
    "network publish inputs for zclassic23.task: provider_publish_input "
    "(\"ask me for these bytes\", the record the fetch path routes on) and "
    "pointer_publish_input (\"this context posts this task\", what a "
    "puller looks up when all it knows is the task root). Both are "
    "required; either alone is a silent no-op at pull time. "
    "TASK_WIRES_NOT_HELD names a workspace that lacks any of the three "
    "wires or one that does not hash to its own address. Offering "
    "announces NOTHING: publishing is the separate second act.",
    0,
    "zcode,task,offer,post,carrier,context,dht,provider,pointer",
    "zcl.zcode_task_offer.input.v1",
    "zcl.zcode_task_offer.v1",
    "task_root,datadir", "task_root",
    "z23 zcode task offer --input='{\"task_root\":\"<64hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_task_offer)

ZCL_COMMAND_READY_COMMAND(
    "zcode.task.pull", "zcode.task", "",
    "Fetch and verify posted contexts for one task root",
    "Resolves every zclassic23.task POINTER record at "
    "semantic_root=task_root, drives the ordinary swarm fetch for each "
    "DISTINCT context, and verifies each with vcs_zcode_task_context_admit "
    "— manifest re-rooting, the fixed three-file shape, and every "
    "cross-binding re-run from stored bytes, with expect_task_root ALWAYS "
    "set to the caller's root and a liveness check at this instant (an "
    "expired posting drops off here). That receiver-side binding check — "
    "never the publish gate — is the security property: a context that "
    "proves a DIFFERENT task is refused task-mismatch and stays "
    "unverified. Verified rows carry expires_unix and the goal text — the "
    "problem statement a remote agent starts from; failed rows carry "
    "fetch_outcome and admit_rule (the NAMED rule). Totals pointers_seen, "
    "distinct_transport_roots, fetched, admitted, refused and "
    "rows_truncated bound the report; a row that fails STAYS in it, and "
    "one bad pointer never aborts the sweep. status separates the dead "
    "ends that must never be merged: NO_TASK_POINTERS (nobody has posted "
    "this task) versus TASK_BYTES_UNREACHABLE (postings exist, no "
    "authenticated provider served the bytes) versus TASKS_REFUSED (bytes "
    "arrived, every context failed a named rule). Pulling is NOT "
    "executing: choosing to do the work is the ordinary local journey.",
    0,
    "zcode,task,pull,context,dht,pointer,swarm,verify,goal",
    "zcl.zcode_task_pull.input.v1",
    "zcl.zcode_task_pull.v1",
    "task_root,datadir,maximum_records", "task_root",
    "z23 zcode task pull --input='{\"task_root\":\"<64hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_task_pull)

ZCL_COMMAND_READY_COMMAND(
