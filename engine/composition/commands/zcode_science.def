/* S5 (2026-08-03, additive): local discovery PageRank over the rebuildable
 * science projection. Explanatory only — rank, votes, and mass are never
 * proof-acceptance, routing, reward, or protocol-control input, and the
 * evidence-admission path never reads this projection. */
ZCL_COMMAND_READY_COMMAND(
    "zcode.science.discover", "zcode.science.rank", "",
    "Search and rank study properties",
    "Filters FIRST over the SQL study projection (search is a substring of "
    "the study or hypothesis root hex; category is the projection state "
    "active|expired|retracted at now_unix; hardware keeps only studies with "
    "a projected result carrying that hardware profile root), then ranks "
    "ONLY the bounded filtered graph (4096 nodes, 64 citation edges per "
    "node, versions/forks of one lineage collapsed). Entries carry mass, "
    "mass share in millionths, direct citation count, and seed weight; the "
    "reply binds the corpus, graph, seed-set, and filter-policy roots, the "
    "omitted node/edge counts, truncation, coverage mass, and the "
    "convergence residual. Local and explanatory only: never proof, "
    "routing, or reward input.", 0,
    "zcode,science,discover,rank,pagerank",
    "zcl.zcode_science_discover.input.v1", "zcl.zcode_science_discover.v1",
    "search,category,hardware,network_genesis_root,now_unix,max,"
    "datadir,workspace", "",
    "z23 zcode.science.discover --input='{\"category\":\"active\",\"max\":16}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_READ,
    ZCL_COMMAND_RISK_READ, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_DETERMINISTIC,
    zcl_native_handle_zcode_science_discover)

