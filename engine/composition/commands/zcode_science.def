/* Acceptance-proof glue (2026-08-03, additive): the operator surface for
 * zcode_science_rebuild — drop the six SQL projection tables and re-derive
 * them from the workspace CAS. Previously reachable only from tests; the
 * two-node acceptance proof (tools/dev/science_acceptance.sh) drives it to
 * demonstrate the projection is disposable and the CAS is the truth. */
ZCL_COMMAND_READY_COMMAND(
    "zcode.science.rebuild", "zcode.science", "",
    "Rebuild the science projection from the CAS",
    "Drops the six rebuildable science projection tables (studies, results, "
    "reproductions, findings, votes, reviews — never the plan ledger) and "
    "re-derives every row from the addressed wires under the workspace CAS "
    "(.zvcs/objects). Rebuild-equivalence: the projection after rebuild is "
    "identical to the projection before the drop; the CAS wires are the "
    "only truth. The reply reports the re-projected row counts per table.",
    0,
    "zcode,science,rebuild,projection,cas",
    "zcl.zcode_science_rebuild.input.v1",
    "zcl.zcode_science_rebuild.v1",
    "now_unix,datadir,workspace", "",
    "z23 zcode.science.rebuild --input='{\"now_unix\":1500}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_science_rebuild)

/* G1/S7 carrier (2026-08-04, additive): science objects ride the existing
 * package swarm as one-chunk content.v2 blob packages (vcs/blob_store.h)
 * — no new wire, no new store. publish mirrors a committed workspace-CAS
 * wire into the package store and files signed generic POINTER/PROVIDER
 * records; fetch resolves a semantic root, schedules the swarm download and
 * admits the bytes. Dual addressing remains explicit: the blob root is the
 * transport address; the science root is re-derived from admitted bytes,
 * never trusted from a record. */
ZCL_COMMAND_READY_COMMAND(
    "zcode.science.publish", "zcode.science", "",
    "Publish a science object to the swarm as a blob",
    "Mirrors a committed science wire (study, result, reproduction, "
    "findings, review, vote, hardware profile, benchmark method) from the "
    "workspace CAS into the package store as a one-chunk blob package, so "
    "the package swarm carries it to peers. The wire is re-parsed and its "
    "canonical root re-derived before mirroring; corrupt or non-science "
    "content is refused. A hosting node also commits a signed one-day "
    "science POINTER and two-hour PROVIDER through the generic S7 record "
    "service. Reply includes both roots and the wire kind for diagnostics; "
    "a fetching node needs only the semantic science root. One-shot mode "
    "persists the blob, while discovery publication requires the running "
    "authenticated DHT identity. STORE, INDEX, SERVE and FORWARD must each "
    "be allowed by the node's local sovereignty policy.",
    0,
    "zcode,science,publish,blob,swarm,cas",
    "zcl.zcode_science_publish.input.v1",
    "zcl.zcode_science_publish.v1",
    "root,datadir,workspace", "root",
    "z23 zcode.science.publish --input='{\"root\":\"<64hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_science_publish)

ZCL_COMMAND_READY_COMMAND(
    "zcode.science.fetch", "zcode.science", "",
    "Fetch and admit a blob-carried science object",
    "Iteratively resolves the supplied semantic science root through signed "
    "POINTER records, preserves deterministic conflicts as fallback "
    "candidates, discovers each candidate's signed PROVIDER records, and "
    "restricts swarm requests to freshly authenticated provider peers. It "
    "schedules (or resumes) the transport-root swarm download and "
    "— once bytes are local — admits them: re-derives the science root "
    "from bytes (never trusted from a record), stores the wire in the CAS, "
    "and refreshes the projection via the CAS-authoritative rebuild. "
    "blob_root remains an explicit transport-address compatibility input. "
    "Idempotent: re-admitting reports new=false. With no live engine the "
    "resumable download record is persisted fail-closed for the next "
    "-packagehost=1 boot; a fresh provider route must be established after "
    "restart, then re-invoke after delivery to admit. FETCH, STORE and INDEX "
    "are rechecked for semantic root, transport root, publisher ZID and "
    "science service type. Reply includes discovery/conflict/provider "
    "diagnostics plus the download and admission result. cancel=true with "
    "an exact blob_root cancels outstanding requests and deletes only that "
    "root's resumable restricted-fetch record.",
    0,
    "zcode,science,fetch,blob,swarm,admit",
    "zcl.zcode_science_fetch.input.v1",
    "zcl.zcode_science_fetch.v1",
    "root,blob_root,datadir,workspace,now_unix,cancel", "",
    "z23 zcode.science.fetch --input='{\"root\":\"<science-root-64hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_science_fetch)
