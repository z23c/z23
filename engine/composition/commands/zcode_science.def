/* ZCODE Scientific Metaverse (S3) — canonical CAS storage plus rebuildable
 * projections for studies, benchmark evidence, reproductions, findings,
 * reviews, and curation votes.
 *
 * THE INVARIANT OF THIS BRANCH: the addressed wires under the workspace CAS
 * (.zvcs/objects) are the only truth. Every write is an exact expiring plan
 * (persisted request identity + wire + 600s expiry) followed by a
 * confirm:true commit; re-committing the same request reattaches to the
 * same result root and stores one CAS object. SQL tables are rebuildable
 * projections only. Expiry gates NEW submissions; it never erases stored
 * evidence. Every rejection names the exact failed rule.
 *
 * Consumer defines ZCL_COMMAND_*; see engine/composition/src/command_catalog.c. */

ZCL_COMMAND_BRANCH("zcode.science", "zcode",
                   "Scientific evidence",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_BRANCH("zcode.science.study", "zcode.science",
                   "Preregistered study lifecycle",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_BRANCH("zcode.science.work", "zcode.science",
                   "Benchmark results and reproductions",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_BRANCH("zcode.science.review", "zcode.science",
                   "Findings reviews",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_BRANCH("zcode.science.vote", "zcode.science",
                   "Curation votes",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_BRANCH("zcode.science.findings", "zcode.science",
                   "Findings lifecycle",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_BRANCH("zcode.science.rank", "zcode.science",
                   "Local discovery ranking",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_COMMAND(
    "zcode.science.study.plan", "zcode.science.study", "",
    "Plan a study submission",
    "Validates the exact study_spec.v1 wire (structural rules plus the "
    "submission window at now) and persists an exact, expiring (600s) plan "
    "binding the wire and its request identity hash. No CAS object and no "
    "projection row is written; re-planning the same request returns the "
    "same plan_root.", 0,
    "zcode,science,study,plan,preregistration",
    "zcl.zcode_science_study_plan.input.v1", "zcl.zcode_science_plan.v1",
    "wire_hex,now_unix,datadir,workspace", "wire_hex",
    "z23 zcode.science.study.plan --input='{\"wire_hex\":\"<844hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
