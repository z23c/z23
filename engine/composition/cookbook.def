/* Copyright 2026 Rhett Creighton - Apache License 2.0
 *
 * cookbook — the answers to "how do I do X in this checkout", as data.
 *
 * WHY THIS IS A REGISTRY AND NOT A DOCUMENT
 * -----------------------------------------
 * A hand-written how-to rots, and this tree keeps proving it: three lint
 * gates were found in one week that were right about what they looked for
 * and wrong about where they looked. A recipe telling a newcomer to run a
 * command that no longer exists costs more than no recipe at all, because
 * they will believe it and spend an hour.
 *
 * So every row here is CHECKED by tools/lint/check_cookbook.sh. A RUN row
 * has its command actually run and the expected token must appear in the
 * output. An ASK row must still name a command the binary offers and reports
 * as ready. A READ row must name a tracked file that still contains the
 * symbol it points at. docs/COOKBOOK.md is GENERATED from this file, so the
 * prose cannot drift from the rows either.
 *
 * THIS IS NOT docs/DEVELOPING.md. That is the ORDER you do things in —
 * orient, inspect, edit, prove, integrate. This is the lookup table: one
 * question, one answer, no narrative. Read DEVELOPING once; come back here
 * every time you forget the exact incantation.
 *
 * ROW SHAPES
 *
 *   SECTION(title)
 *     a heading in the generated document. Rows belong to the section above
 *     them.
 *
 *   RECIPE_RUN(id, question, tool, args, expect)
 *     id        kebab-case and stable — it is how a person cites a recipe
 *     question  the words someone would actually type when stuck
 *     tool      Z23_DEV, and nothing else today. A gate that runs
 *               whatever a string says is a gate that runs whatever anyone
 *               puts in this file, so the tool set is closed and arguments
 *               carrying shell metacharacters are refused.
 *     args      split on spaces and passed without a shell, so no argument
 *               may contain one
 *     expect    a substring that must appear in the output. Pick one that
 *               would stop appearing if the command lost its meaning, not
 *               one an error message would also contain.
 *
 *   RECIPE_ASK(id, question, command_path, expect)
 *     for a command whose own menu calls it background latency. Running it
 *     inside a lint gate would make the gate as slow as the command, so what
 *     is checked instead is that the command still exists and still reports
 *     itself ready. That is weaker than running it, and it is written down
 *     here rather than hidden.
 *
 *   RECIPE_READ(id, question, path, symbol)
 *     the answer is a worked example that already exists in this tree.
 *     Pointing at real code beats paraphrasing it: the paraphrase goes stale
 *     and the code cannot.
 *
 * ADDING A ROW: put it under the right SECTION, then run
 * tools/lint/check_cookbook.sh --fix to regenerate docs/COOKBOOK.md. Never
 * edit that file by hand.
 */

SECTION("Find out what is already here")

RECIPE_RUN("already-exists",
           "Does this checkout already do the thing I am about to write?",
           Z23_DEV, "code have retrieval",
           "capabilities")

RECIPE_RUN("which-tests",
           "Which focused test group does a change to this file route to?",
           Z23_DEV, "code tests engine/modules/chainlog/src/chainlog.c",
           "chainlog")

RECIPE_RUN("blast-radius",
           "If I change this file, what else does it reach?",
           Z23_DEV, "code impact cognition/modules/retrieval/src/retrieval.c",
           "code.impact")

RECIPE_RUN("symbol-card",
           "What is this symbol, where is it defined, who calls it?",
           Z23_DEV, "code sym zcl_malloc",
           "zcl_malloc")

RECIPE_RUN("the-short-answer",
           "I have forgotten every command. Which four actually matter?",
           Z23_DEV, "code guide",
           "proof_command")

RECIPE_ASK("weakest-first",
           "I have an hour. Where in the tree should I look first?",
           "code.general", "ready")

RECIPE_ASK("module-scorecard",
           "What does one module own, and what actually proves it?",
           "code.territory", "ready")

SECTION("Write C23 the way this tree writes it")

RECIPE_READ("checked-allocation",
            "How do I allocate memory here? Never raw malloc.",
            "platform/modules/base/include/base/safe_alloc.h", "zcl_malloc")

RECIPE_READ("log-and-return",
            "How do I report an error and leave the function in one line?",
            "platform/modules/base/include/base/log_macros.h", "LOG_FAIL")

RECIPE_READ("fail-an-allocation-on-purpose",
            "How do I prove my cleanup path actually runs?",
            "platform/modules/base/include/base/safe_alloc.h", "zcl_alloc_fault_fail_nth")

RECIPE_READ("fixed-width-wire-form",
            "How do I put a struct on the wire so two machines agree?",
            "contexts/commons/modules/metaverse/src/node_character_wire.c", "node_character_sheet_encode")

RECIPE_READ("tamper-evident-history",
            "How do I keep a record nobody can quietly edit?",
            "engine/modules/chainlog/src/chainlog.c", "zcl_chainlog_append")

RECIPE_READ("durable-file-write",
            "How do I write a file so a power cut cannot half-write it?",
            "platform/modules/platform/include/platform/private_file.h",
            "platform_private_file_flush")

RECIPE_READ("rank-not-just-match",
            "How do I rank text hits instead of returning them in file order?",
            "cognition/modules/retrieval/src/retrieval.c", "zcl_retrieval_query")

SECTION("Wire a new thing in so CI can see it")

RECIPE_READ("new-lib-module",
            "I am adding a lib module. Where do I declare it?",
            "engine/composition/lib_module_order.def", "LIB_MODULE")

RECIPE_READ("new-test-group",
            "I wrote a test file. Why does nothing run it?",
            "tools/dev/test_group_catalog.def", "ZCL_TEST_GROUP")

RECIPE_READ("impact-rule",
            "Why did the push gate say my change is unmapped?",
            "cognition/controllers/include/controllers/agent_impact_rules.def",
            "AGENT_IMPACT_RULE")

RECIPE_READ("new-lint-gate",
            "I want a rule the build enforces. Where does a gate get wired?",
            "tools/lint/run_lint.sh", "gate_command")

RECIPE_READ("group-purpose",
            "The build says my module has no purpose string. Where does it go?",
            "cognition/modules/codeindex/src/codeindex_group.c", "ci_group_purpose")

SECTION("Prove it")

RECIPE_READ("run-one-group",
            "How do I run exactly one test group and nothing else?",
            "Makefile", "t-fast")

RECIPE_READ("prove-a-refusal",
            "How do I test that something refuses, not just that it works?",
            "tests/harness/src/test_chainlog.c", "case_uncommitted_gap")

RECIPE_READ("every-bit-matters",
            "How do I prove an encoding has no bits nobody looks at?",
            "tests/harness/src/test_chainlog.c", "case_bit_sweep")
