         "environment_root hashes only a fixed named-variable list (CC, CXX, CFLAGS, ... SOURCE_DATE_EPOCH).",
         "tools/dev/dev_proof.c",
         "CPLUS_INCLUDE_PATH")
ZCL_FACT("landing.proof", "path_excluded",
         "PATH is deliberately excluded from environment_root because a reordered PATH must not move any root.",
         "tools/dev/dev_proof.c",
         "A reordered PATH now moves no root")
ZCL_FACT("landing.proof", "source_cas_content",
         "source_cas_root/mutation_root come from a native content-addressed Merkle tree over source bytes, not box identity.",
         "tools/dev/dev_source_identity.c",
         "zcl.dev_source_cas_identity.v1")
ZCL_FACT("landing.proof", "child_set_root_calc",
         "child_set_root is a pure SHA3 function of the receipt's own 4 dimension roots and counts.",
