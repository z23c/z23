/* Copyright 2026 Rhett Creighton - Apache License 2.0
 *
 * purpose: What a dev proof receipt contains, how it is sealed and admitted, and where it is cached.
 *
 * One ZCL_FACT row per verified fact. Fields, in order:
 *   topic   dotted topic id, identical on every row in this file.
 *   key     snake_case, unique within the topic.
 *   claim   one sentence, <= 160 chars, no tab and no quote.
 *   path    repo-relative file the claim was read from.
 *   anchor  literal substring that must still exist in that file.
 *
 * tools/lint/check_orient_facts.sh proves every path and anchor on every
 * commit, so a row that stops being true fails the build instead of
 * misleading the next reader. Never weaken an anchor to make it match;
 * delete or rewrite the row. See docs/zrc/0006-knowledge-in-the-checkout.md. */

ZCL_FACT("landing.proof", "receipt_roots_list",
         "The receipt struct carries 10 fixed content roots plus 4 dimension roots.",
         "tools/dev/dev_proof_receipt.h",
         "uint8_t child_set_root[ZCL_DEV_PROOF_ROOT_BYTES];")
ZCL_FACT("landing.proof", "source_root_calc",
         "source_root is SHA3 over the domain string plus the local commit hex text, not tree content.",
         "tools/dev/dev_proof.c",
         "zcl.dev_proof_git_source.v1")
ZCL_FACT("landing.proof", "changed_set_root_calc",
         "changed_set_root is a file hash over the changed-files list at paths->changed.",
         "tools/dev/dev_proof.c",
         "zcl.dev_proof_changed_set.v1")
ZCL_FACT("landing.proof", "impact_policy_root_file",
