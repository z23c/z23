 * purpose: How a lint gate is wired, how lint differs from lint-fast, and
 *          why a gate that scanned nothing must refuse to pass.
 *
 * Row shape and the rule against weakening an anchor: see index.def and
 * docs/zrc/0006-knowledge-in-the-checkout.md. */

ZCL_FACT("lint.gates", "gate_wiring_three_files",
         "Adding a lint gate touches three files: the Makefile (target and LINT_GATES line), gate_commands.def, and the DEFENSIVE_CODING.md block.",
         "tools/lint/lintc/gate_lint_gate_wiring.c",
         "Adding a lint gate is a THREE-FILE operation")
ZCL_FACT("lint.gates", "gate_wiring_assertion_a",
         "z23-lint check-lint-gate-wiring asserts A that every LINT_GATES/LINT_FAST_GATES member has a gate_commands.def LINT_ROW or a native command.",
         "tools/lint/lintc/gate_lint_gate_wiring.c",
         "gate(s) in LINT_GATES/LINT_FAST_GATES with NO gate_command() entry")
ZCL_FACT("lint.gates", "gate_wiring_assertion_b",
         "z23-lint check-lint-gate-wiring asserts B that every gate_commands.def row is named by one of the two gate lists, else it is dead wiring.",
         "tools/lint/lintc/gate_lint_gate_wiring.c",
         "gate_command() entries that NO gate list names (dead wiring)")
ZCL_FACT("lint.gates", "gate_wiring_assertion_c",
         "z23-lint check-lint-gate-wiring asserts C that every listed gate has a real check-<name> Makefile target for the ZCL_LINT_SERIAL=1 fallback.",
         "tools/lint/lintc/gate_lint_gate_wiring.c",
         "listed gate(s) with no 'check-...:' target")
ZCL_FACT("lint.gates", "gate_wiring_assertion_d",
         "z23-lint check-lint-gate-wiring asserts D that every gate_commands.def .sh script path actually exists on disk.",
         "tools/lint/lintc/gate_lint_gate_wiring.c",
         "gate_command() entries naming a script that does not exist")
ZCL_FACT("lint.gates", "lint_gates_list_defined",
         "The LINT_GATES list, the source of truth for the make lint umbrella, is defined starting with check-lint-gate-wiring as its first member.",
         "Makefile",
         "LINT_GATES :=")
ZCL_FACT("lint.gates", "lint_fast_gates_list_defined",
         "The LINT_FAST_GATES list for make lint-fast is a separate, smaller backslash-continued block in Makefile.",
         "Makefile",
         "LINT_FAST_GATES :=")
ZCL_FACT("lint.gates", "lint_target_invokes_driver",
         "The default (non-serial) make lint recipe invokes z23-lint run with the full LINT_GATES list as arguments.",
         "Makefile",
         "$(LINT_GATES)")
ZCL_FACT("lint.gates", "lint_fast_target_invokes_driver",
         "The default lint-fast recipe invokes the same z23-lint run driver but passes LINT_FAST_GATES instead of LINT_GATES.",
         "Makefile",
         "$(LINT_FAST_GATES)")
ZCL_FACT("lint.gates", "lint_serial_fallback_makefile",
         "Setting ZCL_LINT_SERIAL=1 makes the lint target run LINT_GATES as plain Make prerequisites instead of calling z23-lint run.",
         "Makefile",
         "lint: $(LINT_GATES)")
ZCL_FACT("lint.gates", "driver_execs_scripts_directly",
         "z23-lint run execs each gate's own command directly via its gate_commands.def table and never reads the Makefile recipe.",
         "Makefile",
         "the parallel driver execs each gate's script directly and never reads")
ZCL_FACT("lint.gates", "driver_list_flag",
         "z23-lint run --list prints the gate names of the compiled gate_commands.def table, sorted.",
         "tools/lint/lintc/run_main.c",
         "qsort(names, (size_t)g_table.n")
ZCL_FACT("lint.gates", "driver_print_command_flag",
         "z23-lint run --print-command GATE is the one supported external reader of a single gate's exact invocation string.",
         "tools/lint/lintc/run_main.c",
         "--print-command")
ZCL_FACT("lint.gates", "driver_jobs_env_default",
         "z23-lint run defaults its parallel worker count to 8 via the ZCL_LINT_JOBS environment variable when --jobs is not given.",
         "tools/lint/lintc/run_main.c",
         "DEFAULT_JOBS = 8")
ZCL_FACT("lint.gates", "driver_budget_env_default",
         "z23-lint run applies a soft 75-second wall-time budget via ZCL_LINT_BUDGET_SEC, warning rather than failing past it.",
         "tools/lint/lintc/run_main.c",
         "DEFAULT_BUDGET = 75")
ZCL_FACT("lint.gates", "driver_timing_dir_default",
         "z23-lint run writes per-run gate timing artifacts under .cache/lint-timing by default, overridable via ZCL_LINT_TIMING_DIR.",
         "tools/lint/lintc/run_main.c",
         "%s/.cache/lint-timing")
ZCL_FACT("lint.gates", "driver_serial_prologue",
         "z23-lint run forces check-git-hooks-installed to run serially and first, ahead of the parallel gate pool.",
         "tools/lint/lintc/run_main.c",
         "check-git-hooks-installed check-build-epoch-integrity")
ZCL_FACT("lint.gates", "scan_floor_capability_closure",
         "The check-capability-closure gate enforces an anti-hollow floor of 500 scanned objects via CCG_MIN_OBJECTS.",
         "tools/lint/lintc/gate_capability_closure.c",
         "CCG_MIN_OBJECTS = 500")
ZCL_FACT("lint.gates", "scan_floor_clang_portability",
         "The native check-clang-portability gate sets a known source floor of 900 translation units so a broken Makefile parse cannot silently pass.",
         "tools/lint/lintc/gate_clang_portability_scan.c",
         "cp_reqscan(c->nsrc, 900, hint)")
ZCL_FACT("lint.gates", "scan_floor_byte_order_measured",
         "check_byte_order_codec_single is ported to the native lint runtime; its shell shim was deleted and callers run z23-lint directly.",
         "tools/lint/lintc/gate_byte_order_codec_single_report.c",
         "check-byte-order-codec-single, part 2")
ZCL_FACT("lint.gates", "scan_floor_honest_witness",
         "check_honest_witness's native implementation refuses to report clean off a zero-witness scan when .c files are present, naming that exact fail-silent hole.",
         "tools/lint/lintc/gate_source_fences.c",
         "Refusing to report clean off an empty scan.")
ZCL_FACT("lint.gates", "arm_symbol_baseline_file",
         "check-arm-symbol-single's native gate reads its shrink-only ratchet baseline path from ZCL_ARM_SYMBOL_BASELINE, defaulting to arm_symbol_single_baseline.txt.",
         "tools/lint/lintc/gate_arm_symbol_single.c",
         "c->baseline = env_or(")
ZCL_FACT("lint.gates", "arm_symbol_baseline_update_manual",
         "The arm_symbol_single baseline is only rewritten by an explicit UPDATE invocation, never automatically by make lint.",
         "tools/lint/lintc/gate_arm_symbol_single.c",
         "baseline UPDATED:")
ZCL_FACT("lint.gates", "arm_symbol_baseline_artifact_id",
         "The generated arm_symbol_single_baseline.txt file carries a versioned artifact-id header line identifying its schema.",
         "tools/lint/arm_symbol_single_baseline.txt",
         "artifact-id: zcl.arm_symbol_single_baseline.v1")
