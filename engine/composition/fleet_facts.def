/* ── who handles what ──────────────────────────────────────────────────── */
FLEET_FACT("opus", "handles_well", "hard-implementation", "doctrine", "DOCTRINE",
           "deep debugging and design judgement; read its refusal, a brief that duplicates a landed subsystem is correctly declined")
FLEET_FACT("sonnet", "handles_well", "verification", "doctrine", "DOCTRINE",
           "reads a diff, runs the named gates, answers LAND or HOLD; keep it in the foreground, it stalls waiting on a background notification")
FLEET_FACT("sonnet", "handles_well", "gate-fixing", "doctrine", "DOCTRINE",
           "give it the exact gate name; a gate is never turned green by raising a baseline")
FLEET_FACT("sonnet", "handles_well", "finishing-rebase", "doctrine", "DOCTRINE",
           "finishes an unfinished unit and resolves a rebase conflict; the brief must forbid git stash explicitly")
FLEET_FACT("sonnet", "handles_well", "scoped-implementation", "doctrine", "DOCTRINE",
           "one well-scoped change with a named test group and a stated acceptance bar")
FLEET_FACT("sonnet", "handles_poorly", "fixture-line-reading", "doctrine", "DOCTRINE",
           "a verifier reading a gate's selftest transcript reports the fixture's FAIL lines as a red gate although the exit is zero; the brief says only the exit and the final summary line count, and names the fixture lines in advance")
FLEET_FACT("haiku", "handles_well", "mechanical-rows", "doctrine", "DOCTRINE",
           "row edits, doc counts, log triage; state the commit trailer literally or it goes missing")
FLEET_FACT("glm-5.3", "handles_well", "audit-only", "doctrine", "DOCTRINE",
           "answers is-this-stale honestly, including an honest negative result")
FLEET_FACT("glm-5.3", "handles_well", "scoped-implementation", "doctrine", "DOCTRINE",
           "takes a brief that invites planning, which the flash tier cannot")
FLEET_FACT("glm-5.3-flash", "handles_well", "single-file-pinned-test", "doctrine", "DOCTRINE",
           "one file, one registered group that actually runs, and a per-file change ceiling")
FLEET_FACT("glm-5.3-flash", "handles_poorly", "multi-file-implementation", "doctrine", "DOCTRINE",
           "writes outside the worktree, merges a foreign branch into its lane, rewrites a whole file when asked for one row")
FLEET_FACT("glm-5.3-flash", "requires", "pinned-test", "doctrine", "DOCTRINE",
           "a registered group in tools/dev/test_group_catalog.def that runs, not a test file that merely exists")
FLEET_FACT("grok", "handles_well", "single-file-pinned-test", "doctrine", "DOCTRINE",
           "one function, one table row, one test: the lint-gate ports and the bip page cache each landed in one round; brief it with file:line, the literal output strings, and the mutation check")
FLEET_FACT("grok", "handles_well", "gate-port-pair", "doctrine", "DOCTRINE",
           "two small self-contained lint gates in one job land in one round at the cost of one; pair gates that source no helper script and pin both output strings")
FLEET_FACT("grok", "handles_poorly", "seam-finding", "doctrine", "DOCTRINE",
           "a brief that says find where X is registered burns every round; name the seam yourself (file, function, table row) before queueing")
FLEET_FACT("grok", "requires", "finisher", "doctrine", "DOCTRINE",
           "a rounds-exhausted verdict is judged, not trusted: rerun the judged group in the unit worktree first; two of two such verdicts were stale judge logs over a fix already committed")
FLEET_FACT("grok", "trap_signature", "uncommitted-exit", "doctrine", "DOCTRINE",
           "a queue run can exit nonzero after the work when the final commit refuses, unsigned or unquoted acceptance; the worktree still holds the diff, so the verifier applies git diff as a patch and commits under its own signature")
FLEET_FACT("grok-queue-judge", "requires", "base-relative-diff", "doctrine", "DOCTRINE",
           "a judge that diffs only the dirty tree reports a committed second-round fix as no change and hands the verifier a stale log; count commits since BASE plus dirty files, and rebuild dev-bin before the judged group")
FLEET_FACT("muse", "handles_well", "long-wall-implementation", "doctrine", "DOCTRINE",
           "the only tier given a two-hour wall; specify interfaces (file, flags, error names, fixtures), never goals")
FLEET_FACT("muse", "requires", "finisher", "doctrine", "DOCTRINE",
           "a unit is not done until a finisher has run, because the wall expires with the work uncommitted")

/* ── how work lands ────────────────────────────────────────────────────── */
FLEET_FACT("train", "max", "four-lanes", "lane_state:train", "DOCTRINE",
           "docs/agent/TRAIN_PROTOCOL.md: a train carries at most four lanes in a fixed order")
FLEET_FACT("train", "requires", "lint-fast-green", "lane_state:train", "DOCTRINE",
           "lint-fast is green before the proof runs, so the proof spends its minutes on the tests")
FLEET_FACT("train", "requires", "rebase-onto-origin-main-tip", "lane_state:train", "DOCTRINE",
           "every push moves the base and invalidates every in-flight proof, so a train proves against the exact current tip")
FLEET_FACT("box", "max", "one-proof", "lane_state:proof", "DOCTRINE",
           "one proof per box at a time; that lock is what makes a second proof's verdict mean anything")
FLEET_FACT("lane", "max", "one-worktree", "doctrine", "DOCTRINE",
           "one worktree per lane, and never two lanes in one checkout")
FLEET_FACT("lane", "max", "one-make", "box:any", "DOCTRINE",
           "two make invocations running at once in one worktree rebuild objects under a live test group and report failures the code does not have; an agent that sees an unexplained engine failure first checks for its own second make")
FLEET_FACT("commit", "requires", "signature", "doctrine", "DOCTRINE",
           "every commit is signed; git log --format=%G? must show no N before anything is proven")
FLEET_FACT("main", "refuses_when", "unsigned-commit", "doctrine", "DOCTRINE",
           "the remote rejects an unsigned commit, so an unsigned lane discovers it at push time with the proof already spent")
FLEET_FACT("main", "requires", "full-lint", "doctrine", "DOCTRINE",
           "main is green only under make lint, every gate, 4 min on 32 cores; lint-fast is a subset, proving only that leaves main red; assembler runs every check-* the diff touches, and the ship box runs the whole set before deploy")
FLEET_FACT("make-prerequisite", "trap_signature", "later-defined-variable", "doctrine", "DOCTRINE",
           "make expands prerequisites at parse time, so a later-defined var is empty and the target loses it; t-fast naming the lint-tool var got no lint binary; name BIN_DIR or define it above first use; prove with make --debug=v -n")
FLEET_FACT("push", "refuses_when", "not-fast-forward", "doctrine", "DOCTRINE",
           "fast-forward only; never force-push")
FLEET_FACT("lane", "refuses_when", "git-stash", "doctrine", "DOCTRINE",
           "the stash is shared across every worktree of one checkout, so one lane's stash pops into another's tree")
FLEET_FACT("check-capability-closure", "requires", "full-build-epoch", "lane_state:train", "DOCTRINE",
           "the closure and inventory checks read the whole package epoch (build/bin/zclassic23-package-verify-dev), not dev-bin; on a dev-bin-only tree they report a stale epoch, which is not a closure failure")
FLEET_FACT("landing-worktree", "max", "one-driver", "lane_state:train", "DOCTRINE",
           "one z23-land-train unit per box, landings serialised across boxes by hand, and nobody runs anything inside the landing worktree while its proof is in flight")
FLEET_FACT("live-datadir", "refuses_when", "bulk-copy-while-serving", "box:any", "DOCTRINE",
           "a 34 GB cp -a of a live datadir on the box serving it stalled the projection worker past its deadline and the watchdog killed the public node; copy from a stopped node or from a leaf")
FLEET_FACT("dev-describe-branch", "max", "branch-budget", "doctrine", "DOCTRINE",
           "ZCL_COMMAND_BRANCH_BUDGET caps one describe branch at 3072 bytes and the dev branch sat 14 bytes under it on 2026-09-06; a new dev.* command needs a trimmed summary or a regrouping first")
FLEET_FACT("file-size-ceiling", "max", "fifteen-hundred-lines", "doctrine", "DOCTRINE",
           "check-file-size-ceiling fails any source file above 1500 lines and the baseline shrinks, so a three-hundred-line feature in a thirteen-hundred-line file needs the author to split along a seam before a verifier can say LAND")

/* ── proof traps: a failure signature, and what it actually means ──────── */
FLEET_FACT("proof", "refuses_when", "self-skip", "lane_state:proof", "DOCTRINE",
           "a self-skipped group is refused by the accounting; skip is not the same answer as unobserved")
FLEET_FACT("proof-generation-root", "is_a", "ram-backed-filesystem", "lane_state:proof", "DOCTRINE",
           "tools/dev/dev_proof.c materialises a generation under a RAM-backed root, which is a different filesystem from the checkout")
FLEET_FACT("ram-generation-root", "refuses_when", "stale-generation", "lane_state:proof", "DOCTRINE",
           "unswept RAM generations older than ninety minutes fill the root until reserve refuses; proofs then disk-hardlink inputs and next landing fails with unexplained links; sweep them, making read-only test dirs writable first")
FLEET_FACT("test_boot_phase", "trap_signature", "ram-generation-root", "lane_state:proof", "DOCTRINE",
           "its block-I/O probe burns under the suite tmpdir inside the generation, and fsync on tmpfs never moves ru_oublock; not load, not a flake")
FLEET_FACT("test_boot_phase", "lives_at", "tests/harness/src/test_boot_phase.c", "lane_state:proof", "DOCTRINE",
           "read bp_burn_block_io before classifying this group's failure")
FLEET_FACT("dependency-unavailable", "trap_signature", "cross-filesystem-hardlink", "lane_state:proof", "DOCTRINE",
           "the dependency exists; link() answered EXDEV because the generation root is not the checkout's filesystem. make vendor does nothing for it")
FLEET_FACT("closure-truncated", "trap_signature", "impact-planner-refusal", "lane_state:proof", "DOCTRINE",
           "tools/dev/devloop_plan.c refuses a dimension whose impact walk truncated; that is the planner or the index, never the train")
FLEET_FACT("check-windows-acceptance", "trap_signature", "ship-box-toolchain", "platform:windows", "DOCTRINE",
           "one box's mingw resolves clock_gettime and another's does not; a green acceptance on the assembling box proves nothing about the shipping box, so the gate that counts runs where make ship runs")
FLEET_FACT("shared-inode", "trap_signature", "identity-refusal", "lane_state:proof", "DOCTRINE",
           "replacing a hardlinked vendor input bumps the shared inode's ctime and every in-flight proof whose seal covered it refuses on identity; dedupe only between landings, and copy with reflink, never link")
FLEET_FACT("source-identity", "trap_signature", "ctime-bump", "platform:linux", "DOCTRINE",
           "source-build superseded, only mutation digest differs on a clean tree: ctime moved; identity hashes ctime of tracked sources and transients under source roots; before ship, find vendor -xdev -type f -links +1 prints nothing")
FLEET_FACT("landing-worktree", "trap_signature", "stale-installed-hook", "lane_state:train", "DOCTRINE",
           "landing-worktree pre-push is a symlink into build/githooks; proof rebuild of z23-git-hook trips check_git_hooks_installed and test_make_lint_gates_realroot; check out the tip and make install-hooks before every submit")
FLEET_FACT("landing-worktree", "trap_signature", "unexplained-links", "lane_state:train", "DOCTRINE",
           "prebuild proof_generation_dependency_unexplained_links: landing vendor file has two links, partner not the train's copy; leftover disk generation hardlinked it; between landings replace via a temp name, never cp -al or ln")
FLEET_FACT("proof-accounting", "refuses_when", "self-skip", "lane_state:proof", "DOCTRINE",
           "test_log_account admits a landing only when ran+reused=selected and failed, skipped, unobserved are zero; SKIP because the host lacks a feature fails the landing, so observe what the host offers instead of skipping")
FLEET_FACT("proof-accounting", "refuses_when", "unobserved-leg", "lane_state:proof", "DOCTRINE",
           "an UNOBSERVED leg (tor bootstrap missed its window at load thirty) counts like a failure; the runner reruns an UNOBSERVED-only pass once and never caches it, and a load-sensitive probe says so in its own output")
FLEET_FACT("proof-lock", "trap_signature", "stray-lane-watcher", "lane_state:proof", "DOCTRINE",
           "lane commits fork a z23-dev proof-ensure watcher holding the per-box proof lock; landing at resident_proof_request_queued with no attempt dir and empty leases waits on one; kill by exact pid, never by pattern, before submit")
FLEET_FACT("landing-failure", "trap_signature", "proof-failed-marker", "lane_state:train", "DOCTRINE",
           "the reason is .cache/zcl-dev-proof/<tip>-<base>.failed, the step and exit are in the newest attempts/phases.txt, and failed groups with their repro line are in logs/*.test.log; read those three before touching the train")
FLEET_FACT("lane", "requires", "private-inodes", "box:any", "DOCTRINE",
           "cp -al of a lane/scratch/liveness tree shares checkout inodes; each link bumps shared ctime, fails check-no-hardlink-seeding past two and supersedes a running ship gate; copy cp -a --reflink=auto via lane_new.sh or bundle")
FLEET_FACT("lane", "trap_signature", "missing-gate-binary", "lane_state:proof", "DOCTRINE",
           "a check-* gate via make in a lane can fail only because its binary was never built, as check-fleet-observations without build/bin/z23-fleet-observe; parallel lint builds nothing, so build that binary and rerun first")

/* ── where the rest of the doctrine is written down ────────────────────── */
FLEET_FACT("executor-routing", "lives_at", "engine/composition/fleet_facts.def", "doctrine", "DOCTRINE",
           "this table is the source; docs/agent/EXECUTOR_HEURISTICS.md renders it and never restates it")
FLEET_FACT("train-protocol", "lives_at", "docs/agent/TRAIN_PROTOCOL.md", "doctrine", "DOCTRINE",
           "the lane and train state machine, its board rows, and the landing service verbs")

