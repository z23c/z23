#undef FLEET_CONTEXT
#undef ZCL_FLEET_CONTEXT_LOCAL_
#endif
#ifdef ZCL_FLEET_TERM_LOCAL_
#undef FLEET_TERM
#undef ZCL_FLEET_TERM_LOCAL_
#endif
#ifdef ZCL_FLEET_FACT_LOCAL_
#undef FLEET_FACT
#undef ZCL_FLEET_FACT_LOCAL_
#endif
