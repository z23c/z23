HOTSWAP_PROBE_CASE("service.vault.intent.decision.story.v1", "service",
    "dev.test.story", "{\"owner\":\"transaction_intent\"}",
    "zcl.vault_intent_decision_story.v1", 2048)
/* The hermetic case. Unlike every command case above, dispatching this one
 * needs no resident node and no datadir: the empty input derives the NEW_USER
 * row — the free allowance — from compiled-in constants alone. */
HOTSWAP_PROBE_CASE("command.zcode.package.policy.limits.free.v1", "command",
    "zcode.package.policy.limits", "{}",
    "zcl.zcode_package_policy_limits.v1", 4096)
/* Wave 2 probes. Each dispatches its file's declared probe leaf with the empty
 * input its catalog row accepts, and is budgeted at or under that row's
 * byte budget. */
HOTSWAP_PROBE_CASE("command.store.catalog.default.v1", "command",
    "app.store.catalog", "{}", "zcl.store_catalog.v1", 8192)
HOTSWAP_PROBE_CASE("command.wallet.security.status.default.v1", "command",
    "core.wallet.security.status", "{}", "zcl.wallet_security.v1", 2048)
HOTSWAP_PROBE_CASE("command.status.journey.default.v1", "command",
    "status", "{}", "zcl.status_journey.v1", 4096)
/* Wave 3 probes. Every one dispatches a leaf whose catalog row declares
 * zcl.command.empty_input.v1, so {} is the only input it accepts. */
HOTSWAP_PROBE_CASE("command.account.list.default.v1", "command",
    "app.account.list", "{}", "zcl.account_index.v1", 8192)
HOTSWAP_PROBE_CASE("command.market.moderation.status.default.v1", "command",
    "app.market.moderation.status", "{}", "zcl.market_moderation_status.v1", 4096)
HOTSWAP_PROBE_CASE("command.rom_fetch.status.default.v1", "command",
    "ops.debug.rom_fetch.status", "{}", "zcl.rom_fetch_status.v1", 4096)
HOTSWAP_PROBE_CASE("command.rom_seed.status.default.v1", "command",
    "ops.debug.rom_seed.status", "{}", "zcl.rom_seed_status.v1", 4096)
/* Wave 4 probes. purchase.guide and want.list already had resident cases and
 * are deliberately not duplicated here -- the rule wants exactly one. */
HOTSWAP_PROBE_CASE("command.shop.want.fulfill.list.default.v1", "command",
    "app.shop.want.fulfill.list", "{}", "zcl.shop_fulfill_list.v1", 8192)
HOTSWAP_PROBE_CASE("command.wallet.recovery.status.default.v1", "command",
    "core.wallet.recovery.status", "{}", "zcl.wallet_recovery_status.v1", 4096)
