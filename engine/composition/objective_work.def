/* Copyright 2026 Rhett Creighton - Apache License 2.0
 *
 * objective_work — for every objective in the closed catalog
 * (engine/composition/objectives.def), where its fix lives, the one command
 * that shows it moved, and when to stop. `fleet objectives` DECIDES which
 * objective to work on; `fleet objectives brief` turns that pick into a
 * zcl.work_card.v1-shaped card from the row below. Exactly one row per
 * catalog id, none extra; tests/harness/src/test_fleet_objectives_brief.c
 * refuses a missing, duplicate or orphan row.
 *
 * Row shape:
 *
 *   Z23_OBJECTIVE_WORK(id_, runner_ok_, owned_paths_, acceptance_, stop_if_)
 *
 *   id_          the objective id, verbatim from objectives.def.
 *   runner_ok_   1 only when the work is behaviour-preserving or
 *                measurement-only AND never touches core/, engine/reducer/,
 *                contexts/wallet/, consensus storage (coins, event log,
 *                block index, nullifiers) or the land driver
 *                (tools/command/native_dev_land*). 0 hands the objective to
 *                a human-supervised lane. It is also 0 when the work would
 *                edit what grades the runner: the objectives leaves and
 *                catalogs (tools/command/native_fleet_objectives*,
 *                objective_work.def, objectives.def, commands/fleet.def),
 *                the lint gates (the tools/lint/lintc tree), the
 *                platform/deploy tree
 *                or a pinned Commons package root (the registry in
 *                zcode_package_registry.def). The brief forbids all of
 *                these on every card and narrows functions_over_complexity_cap
 *                to one file. An unattended runner may take only
 *                runner_ok=1 rows.
 *   owned_paths_ a short comma list, no spaces, of repo globs where the fix
 *                lives.
 *   acceptance_  the exact command that shows the objective moved: words of
 *                letters, digits and _./=:,+- joined by single spaces, the
 *                charset a work card accepts.
 *   stop_if_     when to stop and hand back to a human.
 *
 * Append new rows at the end, in step with objectives.def.
 */

Z23_OBJECTIVE_WORK("landing_latency_s", 0,
                   "tools/command/native_dev_land*,tools/dev/**",
                   "z23-dev fleet objectives",
                   "the fix needs a change to the land driver or the proof "
                   "phases")

Z23_OBJECTIVE_WORK("landing_attempts_per_train", 0,
                   "tools/command/native_dev_land*,tools/dev/**",
                   "z23-dev fleet objectives",
                   "the retry cause sits in the land driver or in a test "
                   "that fails only under the train")

Z23_OBJECTIVE_WORK("proof_lint_wall_s", 0,
                   "tools/lint/**,Makefile",
                   "z23-dev fleet objectives",
                   "a speed-up would skip or weaken a lint gate")

