/* Copyright 2026 Rhett Creighton. Licensed under Apache-2.0.
 *
 * Declarative darwin-arm64 capability truth.  This is deliberately data, not
 * prose: tools/scripts/macos_acceptance.sh validates the closed capability
 * set and derives the exact registered-test aggregate from the final field
 * plus the required platform-baseline set below.
 *
 * ZCL_MACOS_CAPABILITY(id, state, reason_code, exact_test_groups_csv)
 * state is one of available, degraded, unavailable.  A capability may be
 * unavailable and still name evidence: that group proves the refusal path.
 *
 * ZCL_MACOS_REQUIRED_TEST(exact_test_group)
 * These are the documented native-macOS baseline groups that are not already
 * selected by a capability row.  Keeping them declarative makes deletion or
 * renaming visible to the same static validator that checks capability
 * evidence; tools/scripts/macos_acceptance.sh pins this exact set. */
ZCL_MACOS_REQUIRED_TEST(test_binary_staleness)
ZCL_MACOS_REQUIRED_TEST(test_cold_join_sovereign)
ZCL_MACOS_REQUIRED_TEST(test_crypto)
ZCL_MACOS_REQUIRED_TEST(test_dev_platform)
ZCL_MACOS_REQUIRED_TEST(test_os_proc)
ZCL_MACOS_REQUIRED_TEST(test_rng)
ZCL_MACOS_REQUIRED_TEST(test_self_backtrace)
ZCL_MACOS_REQUIRED_TEST(test_sqlite)

