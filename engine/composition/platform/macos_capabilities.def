ZCL_MACOS_CAPABILITY(noise, available, native_noise_transport, test_noise_nk_handshake,test_noise_xx_handshake,test_noise_transport_parity)
ZCL_MACOS_CAPABILITY(kqueue, available, native_recursive_directory_watcher, test_directory_watcher,test_watcher_record)
ZCL_MACOS_CAPABILITY(launchd, available, native_launchagent_lifecycle, test_service_state,test_service_state_driver)
ZCL_MACOS_CAPABILITY(scheduler_qos, available, apple_background_qos_applied_before_worker_entry, test_thread_qos)
ZCL_MACOS_CAPABILITY(resident_confinement, unavailable, landlock_and_seccomp_are_linux_only, test_os_sandbox,test_confine)
ZCL_MACOS_CAPABILITY(package_execution, degraded, rlimits_are_not_full_isolation, test_os_sandbox,test_platform_toolchain,test_sandbox_process_budget,test_zcode_verify)
