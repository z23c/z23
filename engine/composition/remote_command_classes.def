/* ── owner_capability ─────────────────────────────────────────────── */
REMOTE_COMMAND_CLASS("dev.hotswap.probe", REMOTE_CLASS_OWNER_CAPABILITY,
    "verify-only half of the fleet dev loop: dlopen, ABI-validate, self-test, never commit. Blast radius is one dev-lane process that keeps serving its previous generation on any failure.")
REMOTE_COMMAND_CLASS("dev.hotswap.apply", REMOTE_CLASS_OWNER_CAPABILITY,
    "the fleet dev loop's activation step, and the reason this channel exists. The capability must name this leaf explicitly and expire. Remote class only SUBTRACTS authority: hotswap_activation_authorized() still requires -hotswap-activate, ZCL_HOTSWAP_ACTIVATE=1 and the dev datadir, and still refuses the canonical datadir, after the remote check has passed.")
REMOTE_COMMAND_CLASS("zcode.workspace.source.bundle.fetch", REMOTE_CLASS_OWNER_CAPABILITY,
    "lets a remote node converge to a named source root by pulling and verifying it ITSELF. source_bundle_fetch() accepts nothing that vcs_source_bundle_verify() does not match against the caller-supplied root, so the capability grants go-find-these-bytes, never trust-these-bytes.")
REMOTE_COMMAND_CLASS("ops.logs", REMOTE_CLASS_OWNER_CAPABILITY,
    "a bounded log read is the second thing a fleet driver needs and the first thing that leaks: log bodies carry operator paths, peer addresses and datadir names. Bounded and useful, so not never_remote; leaky, so never read_only.")
REMOTE_COMMAND_CLASS("ops.debug.bundle", REMOTE_CLASS_OWNER_CAPABILITY,
    "a bounded diagnostic capture over several subsystems at once. Same reasoning as ops.logs: genuinely needed across a fleet, too broad to hand out without the capability naming it.")
REMOTE_COMMAND_CLASS("getnodelog", REMOTE_CLASS_OWNER_CAPABILITY,
    "the agent-contract log read. Same leak surface as ops.logs and classified identically.")
REMOTE_COMMAND_CLASS("eventlog", REMOTE_CLASS_OWNER_CAPABILITY,
    "the agent-contract event-log read. Bodies can quote operator paths and peer identity; bounded, but named-capability only.")


