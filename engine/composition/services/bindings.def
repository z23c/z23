/* Declarative `zcl.service_binding.v1` catalog — the list of services this
 * build declares. Include only with ZCL_SERVICE_BINDING_ENTRY(...) defined by
 * engine/composition/src/service_binding_catalog.c.
 *
 * ADDING A SERVICE — the whole recipe, no core edit anywhere:
 *   1. Append one ZCL_SERVICE_BINDING_ENTRY here with the next binding_id.
 *      `name`, `command_prefix` (= "app.service." + name), and
 *      `state_table_prefix` are the three namespaces you claim; the validator
 *      refuses reserved and overlapping ones.
 *   2. Declare your command leaves in a engine/composition/commands .def under your
 *      command_prefix. `discover` and docs/API_REFERENCE.md pick them up with
 *      no further work — the reference is generated from those .def files.
 *   3. Own your state: every table you write starts with state_table_prefix.
 *      Add the CREATE TABLE to a node.db migration like any other projection.
 *   4. Point `gate` at the ZSLP GENESIS txid whose holders may use the
 *      service. Balances come from `zslp_ledger` — the debit-correct
 *      per-(token,outpoint) ledger — never from `zslp_balances`, which is a
 *      credit-only merchant ledger keyed on ticker strings.
 *   5. `isolation` is not a choice. It is the complete
 *      ZCL_SERVICE_ISOLATION_REQUIRED_V1 set or the catalog does not validate.
 *
 * token_genesis_txid is in internal (node) byte order — the same order
 * zslp_ledger stores as token_id, NOT display/RPC order. */

ZCL_SERVICE_BINDING_ENTRY(
    .struct_size = sizeof(struct zcl_service_binding_v1),
    .schema_version = ZCL_SERVICE_BINDING_V1,
    .binding_id = 1,
    .name = "reference",
    .display_name = "Reference Service (contract demonstration)",
    .version = "0.1.0",
    .host_service_id = ZCL_SERVICE_ID_APPD,
    .command_prefix = "app.service.reference",
    .state_table_prefix = "svc_reference_",
    .state_schema = "zcl.service.reference.state.v1",
    .state_schema_version = 1,
    .gate = {
        /* Deliberately the reserved unminted sentinel: this reference entry
         * names no real token, so its gate can be inspected and tested but
         * never grants. `app service access reference` answers denied with
         * reason `token_unminted`, and the lifecycle refuses to start it.
         * A real service replaces these 32 bytes with its GENESIS txid. */
        .token_genesis_txid = {
            0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
            0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
            0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
            0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
        },
        .min_balance = 1,
        .snapshot_kind = ZCL_SERVICE_GATE_SNAPSHOT_CONFIRMED_DEPTH,
        .holder_kind = ZCL_SERVICE_GATE_HOLDER_WALLET,
        .snapshot_param = 100,
    },
    .isolation = ZCL_SERVICE_ISOLATION_REQUIRED_V1,
    .restart_policy = ZCL_SERVICE_RESTART_TRANSIENT,
    .health_deadline_ms = 15000)
