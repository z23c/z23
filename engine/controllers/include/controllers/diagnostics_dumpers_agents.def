/* Per-domain dumpstate subsystem descriptors: agent and multi-user operator surfaces: agent copy-prove/test run tracking, principals, auth challenges, self-backtrace
 *
 * Split from diagnostics_dumpers.def (see that file's aggregator
 * comment for the shared #include contract). Data-only: no macro
 * definitions or include guards belong in this file. */

    DIAG_LOCAL("agent_copy_prove", agent_copy_prove_dump_state_json,
               "copy-prove run launched via agentcopyprove: queued/running/done state, verdict, "
               "h_star before/after, tip_regression, copy_path (key = the run's slug)"),
    DIAG_LOCAL("agent_test", agent_test_dump_state_json,
               "allowlisted test run launched via agenttest: queued/running/done state, "
               "verdict (PASS/FAIL/NO_MATCH/ERROR), exit_code, output tail "
               "(key = \"<kind>-<name>\", kind = test_group|scenario)"),
    DIAG_LOCAL("principals", principal_dump_state_json,
               "multi-user-server identity registry: count + public projection of each principal {address, role, status, key_kind, last_login, has_znam}"),
    DIAG_LOCAL("agent_sessions", agent_session_dump_state_json,
               "scoped agent spend-authority grants: count; with a session_id key, the session's "
               "{account, max_per_tx_zat, max_per_window_zat, window_seconds, window_start_epoch, "
               "spent_in_window_zat, expires_at, revoked} projection"),
    DIAG_LOCAL("auth", auth_challenge_dump_state_json,
               "auth login-challenge nonce store: db_open + pending (unconsumed) single-use challenge count"),
    DIAG_LOCAL("self_backtrace", self_backtrace_dump_state_json,
               "live self-backtrace surface: installed flag, dump_count, and last dump's "
               "{last_path, last_thread_count, last_unix_ts}. Triggered by ops.debug.backtrace"),
