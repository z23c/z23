/* Per-domain dumpstate subsystem descriptors: supervisor/watchdog/boot/service lifecycle, hardware + capacity organs, sovereignty posture, and other cross-cutting node-runtime state not owned by a narrower domain
 *
 * Split from diagnostics_dumpers.def (see that file's aggregator
 * comment for the shared #include contract). Data-only: no macro
 * definitions or include guards belong in this file. */

    DIAG_ENTRY("supervisor", supervisor_dump_state_json,
               "root supervisor: registered liveness contracts, ticks_run, stall_fires, deadlines",
               "runtime", "runtime", "platform/modules/util/src/supervisor.c",
               "in_process_snapshot", "cheap",
               "child service name, or use subsystem=supervisor.<name>",
               "sync.watchdog", "net.outbound_floor",
               "tests/harness/src/test_supervisor.c", false),
    DIAG_RUNTIME("supervisor_backstop", supervisor_backstop_dump_state_json,
                 "independent sweep-heartbeat watcher for the root supervisor "
                 "thread (Pillar 7): freeze threshold, respawn latch, "
                 "off-systemd fallback state",
                 "platform/modules/util/src/supervisor_backstop.c",
                 "tests/harness/src/test_supervisor_backstop.c"),
    DIAG_CONDITION("blocker", blocker_dump_state_json,
                   "typed blocker registry: active blockers by class {permanent,transient,dependency,resource}, "
                   "deadlines, escape actions, fire counts, and each blocker's hand-off "
                   "(remedy / remedy_kind / needs_human / operator_decision / standing)",
                   "platform/modules/util/src/blocker.c", DIAG_TEST_DEFAULT),
    DIAG_CONDITION("blocker_handoff", blocker_handoff_dump_state_json,
                   "blocker hand-off registry: the build-time remedy ratchet joined to the "
                   "operator-decision table (key = a blocker id to resolve); reports "
                   "owner_bound_rows, owner_rows_with_decision, and names every "
                   "OWNER-bound pattern that still has no decision written down",
                   "engine/conditions/src/blocker_handoff_registry.c",
                   "tests/harness/src/test_blocker_handoff.c"),
    DIAG_CONDITION("blocker_history", blocker_history_dump_state_json,
                   "durable blocker/condition firing history over EV_OPERATOR_NEEDED "
                   "pages, bridged into the durable event log and folded incrementally: "
                   "total_events, unparsed_events, overflow_dropped, distinct_ids, "
                   "capacity, and top {id, fire_count, first_seen_unix, last_seen_unix, "
                   "last_reason} sorted by fire_count descending (key = max rows, default 10)",
                   "engine/services/src/blocker_history.c",
                   "tests/harness/src/test_blocker_history.c"),
    DIAG_CONDITION("watchdog", condition_engine_dump_state_json,
                   "compat alias for condition_engine status",
                   "engine/modules/framework/src/condition.c",
                   "tests/harness/src/test_condition_engine.c"),
    DIAG_SERVICE("boot", chain_restore_dump_state_json,
                 "last boot's integrity check + nbits-backfill counters",
                 "engine/services/src/chain_restore_boot_snapshot.c",
                 DIAG_TEST_DEFAULT),
    DIAG_PROJECTION("boot_timings", boot_flight_recorder_dump_state_json,
                    "boot-phase flight recorder: most recently persisted "
                    "boot's per-stage ms next to each stage's recorded "
                    "median across the last "
                    "BOOT_FLIGHT_RECORDER_MAX_BOOTS boots; a stage over "
                    "max(5s,4x median) raises the named blocker "
                    "boot.stage_regression (fail-loud, never fail-stop)",
                    "engine/composition/src/boot_flight_recorder.c",
                    "tests/harness/src/test_boot_flight_recorder.c"),
    DIAG_RUNTIME("service_state", service_state_dump_state_json,
                 "canonical runtime operational mode "
                 "(boot/restore/reconcile/degraded_serving/syncing/"
                 "healthy/repairing) + last transition reason",
                 "platform/modules/util/src/service_state.c", DIAG_TEST_DEFAULT),
    DIAG_RUNTIME("machine_identity", machine_identity_dump_state_json,
                 "redacted local-machine capsule: exact source and running "
                 "binary identities, native platform, encrypted transport, "
                 "authenticated DHT identity, confinement, hot-swap "
                 "capability, and named blockers; grants no machine access",
                 "engine/controllers/src/diagnostics_machine_identity.c",
                 "tests/harness/src/test_syncdiag_network.c"),
    DIAG_ENTRY("service_bindings", service_token_gate_dump_state_json,
               "declared services (zcl.service_binding.v1): per-service ZSLP "
               "token gate — genesis txid, whether it is the unminted "
               "sentinel, min_balance threshold, snapshot rule "
               "(confirmed_depth/fixed_height + param), and holder kind. "
               "Declaration only; evaluating a gate is app.service.access",
               "runtime", "config", "engine/services/src/service_token_gate.c",
               "static_declaration", "cheap",
               "a declared service name, or omit for the whole catalog",
               "reference", NULL,
               "tests/harness/src/test_service_binding.c", false),
    DIAG_ENTRY("service_lifecycle", service_lifecycle_dump_state_json,
               "declared-service lifecycle registry: per-service state "
               "(declared/starting/ready/degraded/blocked/stopping/exited), "
               "the blocker reason when blocked, and transition/fault "
               "counters. In-memory, rebuilt from the compiled catalog each "
               "boot",
               "runtime", "runtime", "engine/services/src/service_lifecycle.c",
               "in_process_snapshot", "cheap",
               "a declared service name, or omit for every service",
               "reference", NULL,
               "tests/harness/src/test_service_binding.c", false),
    DIAG_RUNTIME("health", health_dump_state_json,
                 "unified heartbeat ring: registered subsystems, ages, stall fires",
                 "engine/modules/health/src/heartbeat.c", DIAG_TEST_DEFAULT),
    DIAG_LOCAL("sandbox", sandbox_dump_state_json,
               "os_sandbox confinement: active + profile name, landlock_abi, "
               "seccomp_supported/active, node deny-set size. Confirms whether "
               "-sandbox=steady entered the node steady-state profile"),
    DIAG_CONDITION("sticky_escalator", sticky_escalator_dump_state_json,
                   "always-terminating remedy ladder (sticky S2): armed state, "
                   "current rung, per-rung dispatch counts, witness window, "
                   "re-arm cooldown, ladder cycles, non-latching page count",
                   "engine/services/src/sticky_escalator.c", DIAG_TEST_DEFAULT),
    DIAG_CONDITION("condition_engine", condition_engine_dump_state_json,
                   "self-heal engine: registered conditions with active/cleared status, attempts, thresholds",
                   "engine/modules/framework/src/condition.c",
                   "tests/harness/src/test_condition_engine.c"),
    DIAG_RUNTIME("long_op", long_op_dump_state_json,
                 "active long-operation scopes (>600s code paths) that gate STATE_STUCK watchdog suppression",
                 "platform/modules/util/src/long_op.c", DIAG_TEST_DEFAULT),
    DIAG_SERVICE("mempool_limits", mempool_limits_dump_state_json,
                 "mempool limits: enforce/expire call counts, evicted/expired totals, last-run summary",
                 "engine/services/src/mempool_limits.c", DIAG_TEST_DEFAULT),
    DIAG_SERVICE("crypto_registry", crypto_registry_dump_state_json,
                 "registered crypto schemes, statuses, implementations, and kind counts",
                 "core/modules/crypto_registry/src/crypto_registry.c", DIAG_TEST_DEFAULT),
    DIAG_SERVICE("soak", soak_dump_state_json,
                 "soak attestation log: lines_written, last_ts, "
                 "last_healthy, rotations, write_failures, file_bytes",
                 "engine/services/src/soak_attestation_service.c",
                 DIAG_TEST_DEFAULT),
    DIAG_CONDITION("canary_watch", canary_watch_dump_state_json,
                   "replay-canary sentinel watch: verdict_dir, last_scan, "
                   "files_seen, per-kind verdict+reason+ts, fail latch, "
                   "condition_active",
                   "engine/services/src/canary_sentinel_watch.c",
                   DIAG_TEST_DEFAULT),
    DIAG_ENTRY("stopwatch_evidence", stopwatch_evidence_dump_state_json,
               "REPORTER ONLY — the C3 / PROOF B wall-clock stopwatch "
               "evidence ledgers on disk: per ledger, last_verdict, "
               "skip_streak and no_pass_streak, the CLASS of the trailing "
               "skip run (not_configured is benign and never alarms; "
               "fixture_absent / config_error / harness_misuse are defects), "
               "its alarm threshold and whether that is crossed. Answers "
               "'has a scheduled proof been quietly skipping?' — it grades "
               "nothing, clears nothing, and feeds no score",
               "diagnostic", "service",
               "engine/services/src/stopwatch_skip_watch.c",
               "filesystem_snapshot", "bounded_lookup",
               "ledger name, or empty for every ledger",
               "c3", "netdisrupt",
               "tests/harness/src/test_stopwatch_skip_watch.c", false),
    DIAG_ENTRY("slo_evidence", slo_evidence_dump_state_json,
               "REPORTER ONLY — bounded, node-free external uptime-probe "
               "evidence: strict complete-row counts, per-instance window "
               "coverage, reachability, oracle gap, outage run, staleness, "
               "capacity flags and a fail-closed verdict. It grades no code, "
               "controls no node and grants no authority",
               "diagnostic", "service",
               "engine/services/src/slo_ledger_summary.c",
               "filesystem_snapshot", "bounded_lookup",
               "instance name, or empty for required and observed lanes",
               "canonical", "dev",
               "tests/harness/src/test_slo_ledger_summary.c", false),
    DIAG_ENTRY("mvp", mvp_dump_state_json,
               "MVP v1 scoreboard (schema zcl.mvp_status.v1): docs/MVP.md's "
               "eight operator acceptance criteria as {id,title,met,evidence,"
               "since,blocker} + met_count/total/ready_for_v1. REPORTER ONLY "
               "— derives met=true|false|unknown from live evidence "
               "(node_health tip-hold, soak service, utxo_parity oracle, "
               "replay-canary watch); an absent source is unknown with a "
               "named reason, never silently met, and it flips nothing true",
               "diagnostic", "service",
               "engine/controllers/src/diagnostics_mvp.c",
               "in_process_snapshot", "cheap", NULL, NULL, NULL,
               DIAG_TEST_DEFAULT, true),
    DIAG_LOCAL("unhealthy", unhealthy_dump_state_json,
               "unhealthy-only rollup: all_ok/checked/reporting + unhealthy subsystems (name+reason) from `_health`"),
    DIAG_LOCAL("hotswap", hotswap_dump_state_json,
               "DEV-ONLY in-process hot-swap loader: availability + per-generation {gen, so_path, loaded_at, replaced_count, ok}; 'unavailable' in release"),
    DIAG_LOCAL("sovereignty", sovereignty_dump_state_json,
               "operational (release_assisted) vs sovereign (self_folded) "
               "trust mode: coins_kv_proven_authority, self_folded_marker, "
               "coins_applied_height, hstar, self_derived_tip_static_checks, "
               "authority_posture, trust_mode, per-pool shielded_pool_counts "
               "(sprout/sapling anchors + nullifiers), the "
               "shielded_import.provenance row (source/best-block/counts/"
               "tip-bind from -import-complete-shielded), and what is gated "
               "(mint/wallet-spend/snapshot-export vs tip-following)"),
    DIAG_LOCAL("status_frontdoor", status_frontdoor_dump_state_json,
               "single-round-trip operator status (Program O2): provable tip "
               "(H*), reducer floor, peer snapshot (trylock+cached), and the "
               "in-memory blocker registry — each labeled with its staleness "
               "and any dark member named in degraded[]. Takes NO "
               "progress_store_tx_lock and runs no COUNT(*), so `status` stays "
               "answerable while the reducer owns the write lock. The native "
               "`status` handler reaches it in one dumpstate call; the legacy "
               "12-call document stays behind `status --full`"),
    DIAG_RUNTIME("time_authority", time_authority_dump_state_json,
                 "time-discipline organ: wall-vs-CLOCK_MONOTONIC_RAW offset_us, EWMA drift "
                 "(drift_ppm_milli / drift_ppm_approx), step_count + last_step_age_us/"
                 "last_step_magnitude_us (|Δoffset|>500ms jumps), observation_count. "
                 "Sampled from the health-sweep tick; feeds the clock_skew_reconcile "
                 "condition. Operational time only — consensus timestamp rules untouched",
                 "platform/modules/util/src/time_authority.c",
                 "tests/harness/src/test_time_authority.c"),
    DIAG_LOCAL("cpu_topology", cpu_topology_dump_state_json,
               "CPU topology organ: logical_cpus, physical_cores, smt_threads_per_core, "
               "l3_domains + per-domain {id, l3_size_bytes, cpu_count, cpus}, "
               "largest_l3_domain (the V-Cache CCD on multi-CCD AMD parts), source "
               "(sysfs/fallback)"),
    DIAG_LOCAL("hw_profile", hw_profile_dump_state_json,
               "hardware profile organ: online/physical cores, ram_bytes + ram_class "
               "(low/medium/high), x86 isa {avx2, avx512f/vl/bw/dq, vpclmulqdq, vaes, "
               "gfni, sha_ni, active SHA-256 and Equihash BLAKE2b tiers}, "
               "storage {rotational, rotational_known}, l3 "
               "{domain_count, asymmetric, large_domain_id}, derived {verify_workers, "
               "script_batch_cap, sqlite_*_cache_kib, sqlite_*_mmap_bytes}, and "
               "pin_reducer_available (whether -pin-reducer would take effect)"),
    DIAG_SERVICE("storage_housekeeping", storage_housekeeping_dump_state_json,
                 "datadir size-bound sweeper: sweeps, and the count of "
                 "progress.kv compactions, topology.db WAL truncations and "
                 "Tor log rotations it has performed, plus the last measured "
                 "projection_file_bytes / projection_live_bytes / "
                 "topology_wal_bytes and the tick interval",
                 "engine/services/src/storage_housekeeping.c",
                 "tests/harness/src/test_storage_pacing.c"),
    DIAG_LOCAL("storage_pacing", storage_pacing_dump_state_json,
               "datadir storage class (rotational/solid/unknown) + how it was "
               "decided (override/sysfs/bench/probe/default), and the IO bounds "
               "that class implies: sequential_readahead + "
               "boot_readahead_window_bytes for the boot repair walks, "
               "serialize_maintenance + maintenance_gap_ms for the maintenance "
               "writers, wal_truncate_bytes, log_rotate_bytes, and "
               "compact_floor_bytes/compact_ratio_pct for the projection stores"),
    DIAG_LOCAL("hw_bench", hw_bench_dump_state_json,
               "hardware bench organ: boot-time measured fsync_us + pread_us "
               "medians (or -1/'fallback' if unmeasured), fingerprint (hw_profile "
               "signature the measurement was taken under), from_cache, "
               "age_seconds, measured, and derived {batch_size_normal_100, "
               "verify_workers_normal_4} each tagged measured/fallback — the "
               "closed loop that scales reducer_drain.c's per-stage batch size "
               "with measured fsync latency and bg_validation_service.c's "
               "worker count with measured random-read latency"),
    DIAG_SERVICE("recovery", recovery_coordinator_dump_state_json,
                 "unified recovery coordinator (chain domain): last rung fired "
                 "(cursor_warm_restart/rederive_range/segment_refetch/blocker) "
                 "+ last outcome, run count, and per-rung fire counts. Selects "
                 "the cheapest sufficient rung and orchestrates the existing "
                 "healers.",
                 "engine/services/src/recovery_coordinator.c",
                 "tests/harness/src/test_recovery_coordinator.c"),
    DIAG_RUNTIME("mem_pressure", mem_pressure_dump_state_json,
                 "memory-pressure organ (Rung 1 follow-on): level "
                 "(nominal/elevated/high/critical), current/denominator "
                 "bytes + basis (cgroup_high/cgroup_max/sys_total), rss_bytes, "
                 "elevated/high/critical_pct thresholds, polling_active, and "
                 "per-sink {name, last_shrink_unix, shrink_calls}",
                 "platform/modules/util/src/mem_pressure.c", DIAG_TEST_DEFAULT),
    DIAG_SERVICE("confinement", confinement_dump_state_json,
                 "process confinement verdict: unconfined (the headline), "
                 "requested vs active profile and the requested_but_unconfined "
                 "degrade, the filesystem-restriction interface + ABI + the "
                 "actual fs_grants[] the Landlock domain was built from, how "
                 "the syscall filter was installed (tsync/prctl/none) and "
                 "whether it covers all threads, and retrofit_join_permitted. "
                 "Reads only latched apply-time state — never re-probes "
                 "Landlock, which a confined process cannot survive",
                 "platform/modules/platform/src/os_sandbox_witness.c",
                 "tests/harness/src/test_os_sandbox_hotswap_interaction.c"),
    DIAG_ENTRY("telemetry_rollup", telemetry_rollup_dump_state_json,
               "the WHOLE-NODE telemetry fold: every domain in the provider "
               "registry, judged by the same evaluator as the per-domain "
               "leaves and folded with max() over {ok,unknown,degraded,"
               "unhealthy}. A domain nobody could collect stays listed as "
               "collected:false with a reason and counts as unknown, which "
               "outranks ok. Key selects the projection: summary (fold + "
               "named bottleneck), health (enums only), alerts_active "
               "(failing rules, bounded, drops stated)",
               "runtime", "service",
               "engine/services/src/telemetry_rollup.c",
               "in_process_snapshot", "cheap",
               "summary|health|alerts_active", "summary", "health",
               "tests/harness/src/test_telemetry_rollup.c", true),
