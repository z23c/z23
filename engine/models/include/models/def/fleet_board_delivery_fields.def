#define FLEET_BOARD_DELIVERY_FIELDS \
    ZCL_MODEL_BLOB(post_id, post_id, 32), \
    ZCL_MODEL_BLOB(peer,    peer,    32), \
    ZCL_MODEL_I64 (verdict, verdict), \
    ZCL_MODEL_TEXT(reason,  reason), \
    ZCL_MODEL_I64 (at,      at)
