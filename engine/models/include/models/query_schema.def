/* Copyright 2026 Rhett Creighton - Apache License 2.0
 *
 * The CLOSED identifier set for the typed model query builder.
 *
 * This file is the ONLY place a table or column name may enter SQL text.
 * models/query_builder.h turns each row here into an enum constant, and
 * every builder entry point takes those enums — never a `const char *`
 * identifier — so a caller has no expressible way to name a table or column
 * that is not listed below. An out-of-range enum (an integer cast in from
 * somewhere) fails the statement closed rather than reaching SQLite.
 *
 * Include with QB_TABLE(t) and QB_COLUMN(t, c) defined; either may be a
 * no-op. The enum symbol and the SQL identifier are the SAME token — the
 * builder stringizes `c` — so a row cannot say one thing and emit another.
 *
 * Rows are added only when a model is converted off literal SQL. Keep each
 * table's columns in schema declaration order; that is the order a reader
 * will compare against the CREATE TABLE in engine/models/src/database_*.c.
 */

/* peers — engine/models/src/database_schema.c */
QB_TABLE(peers)
QB_COLUMN(peers, id)
QB_COLUMN(peers, ip)
QB_COLUMN(peers, port)
QB_COLUMN(peers, services)
QB_COLUMN(peers, last_seen)
QB_COLUMN(peers, last_try)
QB_COLUMN(peers, attempts)
QB_COLUMN(peers, source)
QB_COLUMN(peers, bandwidth_score)
QB_COLUMN(peers, is_zcl23)

