/* Canonical field table for the `metaverse` telemetry domain. Data only.
 *
 * Row grammar and what each row generates: util/telemetry_field_table.h.
 * Every field name in this domain is spelled here and nowhere else.
 *
 * Lane ownership: this file belongs to the metaverse domain alone. Append groups
 * below the `meta` group; do not reorder or reword existing rows, and keep
 * each group's rows contiguous.
 *
 * ── WHY THIS DOMAIN IS SHAPED THE WAY IT IS ─────────────────────────────
 *
 * NO WATCH FIELDS, DELIBERATELY. Every other domain samples ambient state a
 * running node keeps in memory. This one does not have any: sovereign digital
 * property is DIRECTORY-SCOPED and node-free — the catalog is a projection
 * rebuilt at call time over a directory the CALLER names, and the confined
 * agent broker is a separate process whose state lives in a broker directory.
 * There is nothing here for a change-feed sampler to poll, so this domain
 * declares zero watch fields and is skipped by the sampler. Inventing a change
 * feed for it would be inventing state.
 *
 * NO INVENTORY LEAVES, FOR THE SAME REASON. "How many properties does this
 * node hold" cannot be answered without a directory, and this table's provider
 * takes no path — a leaf that defaulted one would read (and this repo has
 * already been bitten by reads that write) the operator's live datadir.
 * Inventory is `metaverse property list --datadir=<dir>`; what lives here is
 * the part that IS node-free: which property kinds this build can project at
 * all, which is exactly what makes an empty inventory readable.
 *
 * NO CONFINEMENT LEAVES. The `confinement` and `sandbox` subsystem reporters
 * already publish this process's Landlock/seccomp posture. A second name for
 * one fact is the duplication this whole effort exists to remove. */

TL_DOMAIN_META(metaverse, "zcl.telemetry.metaverse.v1",
    "property catalog, adapters and confined broker services")

TL_GROUP(meta, "how and when this snapshot itself was taken")

TL_LEAF(meta, collected_unix, TLC_I64, TFU_UNIX_TIME, TLV_NORMAL,
    TFR_INFO, TL_NONE, 0, TFS_INFO,
    "wall-clock second at which the provider began filling this snapshot; "
    "every other leaf's observed_unix is at or after this instant",
    "", "")

TL_GROUP_END(meta)

/* ── metaverse groups start here (owned by this domain's lane) ── */

/* The property-kind vocabulary and its readers. Every value in this group is
 * read out of the compiled-in adapter registry (lib/metaverse/src/
 * adapter_registry.c): static const data, no lock, no path, no I/O. It answers
 * the question that has to be answered BEFORE an inventory means anything —
 * "which kinds can this build project at all?" — because an empty catalog and
 * a catalog whose readers are not wired look identical from the inventory
 * alone.
 *
 * The per-kind reader flags are one leaf per element of METAVERSE_KIND_TABLE,
 * which is a compile-time constant set; the provider static_asserts the count
 * so adding a kind without adding its row is a build failure, not a silently
 * missing flag. */
TL_GROUP(catalog, "property kinds this build declares, and which have a reader")

TL_LEAF(catalog, kinds_declared, TLC_I64, TFU_GAUGE, TLV_SUMMARY,
    TFR_INFO, TL_NONE, 0, TFS_INFO,
    "property kinds METAVERSE_KIND_TABLE declares, excluding the reserved "
    "UNKNOWN zero. The size of the vocabulary this build understands — never "
    "a count of property this node holds",
    "", "")

TL_LEAF(catalog, kinds_readable, TLC_I64, TFU_GAUGE, TLV_SUMMARY,
    TFR_MIN_ABS, TL_NONE, 1, TFS_WARN,
    "property kinds whose adapter row has BOTH a list and a show reader wired, "
    "so the catalog can project them from a directory it is pointed at",
    "no property kind can be projected at all: every kinds[] row of `metaverse "
    "property list` returns unavailable, and this node reports no digital "
    "property whatever it actually holds on disk",
    "z23 metaverse property list --datadir=<dir> — every kinds[] row "
    "carries the exact unavailable_reason for its own kind")

TL_LEAF(catalog, kinds_unreadable, TLC_I64, TFU_GAUGE, TLV_NORMAL,
    TFR_INFO, TL_NONE, 0, TFS_INFO,
    "property kinds whose adapter row declares an unavailable_reason in place "
    "of a reader. A stated gap, not a fault: the catalog still emits a row per "
    "kind, so an unwired kind is reported rather than dropped",
    "", "")

TL_LEAF(catalog, registry_complete, TLC_BOOL, TFU_BOOL, TLV_SUMMARY,
    TFR_EXPECT_TRUE, TL_NONE, 0, TFS_CRITICAL,
    "true only when every declared kind resolves to exactly one adapter row "
    "AND that row's own kind field equals the kind it was looked up by",
    "a kind resolves to no adapter row, or to a row keyed to a different kind: "
    "it drops out of the catalog silently, so property of that kind is "
    "invisible rather than reported unavailable",
    "z23 metaverse property list --datadir=<dir> and count the kinds[] "
    "rows against values.catalog.kinds_declared")

TL_LEAF(catalog, reader_content, TLC_BOOL, TFU_BOOL, TLV_NORMAL,
    TFR_INFO, TL_NONE, 0, TFS_INFO,
    "whether the `content` kind (authority vcs.blob_store) has a list+show "
    "reader wired in this build",
    "", "")

TL_LEAF(catalog, reader_zcode_package, TLC_BOOL, TFU_BOOL, TLV_NORMAL,
    TFR_INFO, TL_NONE, 0, TFS_INFO,
    "whether the `zcode_package` kind (authority vcs.package_store) has a "
    "list+show reader wired in this build",
    "", "")

TL_LEAF(catalog, reader_znam_name, TLC_BOOL, TFU_BOOL, TLV_NORMAL,
    TFR_INFO, TL_NONE, 0, TFS_INFO,
    "whether the `znam_name` kind (authority znam.registry) has a list+show "
    "reader wired in this build",
    "", "")

TL_LEAF(catalog, reader_zslp_asset, TLC_BOOL, TFU_BOOL, TLV_NORMAL,
    TFR_INFO, TL_NONE, 0, TFS_INFO,
    "whether the `zslp_asset` kind (authority zslp.ledger) has a list+show "
    "reader wired in this build",
    "", "")

TL_LEAF(catalog, reader_hosted_service, TLC_BOOL, TFU_BOOL, TLV_NORMAL,
    TFR_INFO, TL_NONE, 0, TFS_INFO,
    "whether the `hosted_service` kind (authority service.registry) has a "
    "list+show reader wired in this build",
    "", "")

TL_LEAF(catalog, reader_endpoint_onion, TLC_BOOL, TFU_BOOL, TLV_NORMAL,
    TFR_INFO, TL_NONE, 0, TFS_INFO,
    "whether the `endpoint_onion` kind (authority net.onion_service) has a "
    "list+show reader wired in this build",
    "", "")

TL_LEAF(catalog, reader_storefront_product, TLC_BOOL, TFU_BOOL, TLV_NORMAL,
    TFR_INFO, TL_NONE, 0, TFS_INFO,
    "whether the `storefront_product` kind (authority store.product) has a "
    "list+show reader wired in this build",
    "", "")

TL_LEAF(catalog, reader_contract_swap, TLC_BOOL, TFU_BOOL, TLV_NORMAL,
    TFR_INFO, TL_NONE, 0, TFS_INFO,
    "whether the `contract_swap` kind (authority swap.contract) has a "
    "list+show reader wired in this build",
    "", "")

TL_LEAF(catalog, reader_character_sheet, TLC_BOOL, TFU_BOOL, TLV_NORMAL,
    TFR_INFO, TL_NONE, 0, TFS_INFO,
    "whether the `character_sheet` kind (authority "
    "metaverse.character_sheet) has a list+show reader wired in this build. "
    "False does not mean a character cannot be checked: a character is "
    "content-addressed and is verified by recomputing it from the birth seed "
    "presented with it. It means no datadir path enumerates the seeds this "
    "node holds",
    "", "")

TL_GROUP_END(catalog)
