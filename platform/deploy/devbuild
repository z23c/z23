#
# REFERENCE MIRROR — NOT the file that runs. NOT installed by any make target.
#
# `devbuild` is the shared HOST BUILD SCHEDULER. Every heavy build, proof,
# benchmark and test matrix on a shared build host goes through it. It is
# referenced by name from tools/dev/node_lifecycle.sh, from
# tools/dev/commons_journey_acceptance.sh, from
# tools/scripts/qualify_fleet_gateway_front.sh and from several docs under
# docs/work/ — and until this file existed, nothing in this repository said
# what it was, what it enforces, or where to get it. A fresh clone inherited
# call sites for a program it had never heard of.
#
# WHY THIS IS A MIRROR AND NOT THE AUTHORITY. The installed copy at
# ~/.local/bin/devbuild is SHARED with a second, unrelated project (`qedc`):
# both projects' heavy jobs serialize against each other through the locks
# below, and that only works because there is exactly ONE scheduler binary
# arbitrating both. Vendoring this file as z23's own authority would fork the
# arbiter — two copies, each believing it holds the slot — and shipping an
# installer that wrote ~/.local/bin/devbuild would have z23 overwrite a file
# the other project also depends on. Neither is z23's call to make
# unilaterally. So this file is documentation with exact bytes: read it,
# diff it against the installed copy, reimplement it if your host needs one.
#
#   diff -u platform/deploy/devbuild ~/.local/bin/devbuild
#
# IT IS NOT REQUIRED TO BUILD Z23. On a machine you do not share, plain
# `make -j"$(nproc)" z23` is complete and correct, and you never need this.
# devbuild exists so that concurrent heavy jobs on a SHARED host do not
# oversubscribe it. Treat it as host policy, not as a build dependency.
#
# WHAT IT ENFORCES, precisely, as the body below shows:
#   * One project slot per project, each admitting up to N concurrent lanes,
#     one per lane lock; lane 0 is the historic <project>.lock, so an older
#     caller still waiting on it alone stays mutually exclusive with lane 0.
#     Z23 admits up to DEVBUILD_Z23_LANES jobs (default 3, max 4), one per
#     lane lock ($HOME/.local/state/development/z23.lock plus .lock.1/
#     .lock.2/.lock.3). QEDC admits up to DEVBUILD_QEDC_LANES jobs (default
#     2, max 4), one per lane lock ($HOME/.local/state/development/
#     qedc.lock plus .lock.1/.lock.2/.lock.3); two QEDC units never share a
#     worktree (QEDC enforces it) and heavy steps take QEDC's own locks, so
#     the single slot was never their mutual exclusion.
#   * A shared/exclusive reader-writer lock across BOTH projects at
#     $HOME/.local/state/development/heavy.lock: normal project jobs take it
#     shared, `--exclusive` takes it exclusively and locks the whole host.
#   * Without --wait a busy slot/lane is an immediate refusal with exit 75,
#     never a queue. With --wait it blocks until a lane is free, polling
#     once a second while it waits.
#   * FIFO among ordinary --wait waiters: flock(2) wakes waiters in no
#     particular order, so each waiter leaves an enqueue-ordered ticket file
#     under $HOME/.local/state/development/<project>.queue/; a waiter that
#     wins a lane while an older live ticket still exists hands the lane
#     back and retries, so long-queued jobs are not passed over.
#   * Z23 landing priority: a `dev land ...` argv or DEVBUILD_PRIORITY=land
#     job leaves a marker under
#     $HOME/.local/state/development/z23.priority/<pid> and takes the next
#     free z23 lane ahead of ordinary FIFO waiters. QEDC is unaffected.
#   * A hard floor of 24 GiB MemAvailable, checked after the locks are held;
#     below it the job is refused (exit 75) rather than started into swap.
#   * The job runs inside `systemd-run --user --scope --slice=development.slice`
#     with CPUQuota set to 100% per worker core, MemoryMax=24G (48G for
#     --exclusive), MemorySwapMax=0, IOWeight=20, and a per-project
#     CPUWeight: Z23 gets 20 per job; QEDC gets 20 * DEVBUILD_Z23_LANES /
#     DEVBUILD_QEDC_LANES per job (30 at the defaults of 3 and 2), so
#     QEDC's combined per-job weight across its lanes still equals the
#     combined weight of all concurrent Z23 lanes.
#   * taskset pins the job to worker CPUs only: the first two physical cores
#     of every socket are LEFT OUT so the live node and interactive work keep
#     dedicated silicon. On this host that is 28 of 32 CPUs, hence the
#     working agreement's `-j"$(nproc)"` inside a devbuild scope granting 28.
#   * nice 10 and ionice class 2 priority 7 below that, so a heavy job always
#     loses to the node.
#   * Nesting does not stack: a devbuild invoked from inside a devbuild scope
#     reuses the enclosing budget rather than taking a second slot, and
#     refuses outright (exit 75) if it would switch or widen the project.
#   * Per-job accounting: once a job finishes, one JSON line is appended to
#     $HOME/.local/state/development/devbuild.jobs.jsonl with project, pid,
#     cwd, queued/started/ended timestamps, wait_s, run_s, rc, lane,
#     mem_peak_mib (from the scope's memory.peak, sampled every 2 s),
#     cpu_s, tree (a 16-hex checkout fingerprint computed at enqueue from
#     HEAD, `git diff HEAD --binary`, and untracked file names, sha256
#     truncated), and cmd. Best-effort; never fails the build. The scope
#     unit is named devbuild-<pid>-<ns>.scope.
#   * Checkout fingerprint: before queuing, devbuild computes that same
#     tree key and, if the identical cwd + cmd already recorded rc:0 on the
#     identical tree in devbuild.jobs.jsonl, prints an advisory note on
#     stderr ("already PASSED on this identical checkout"). Advisory only;
#     the rerun proceeds either way.
#   * `--plan` prints the decision and exits without running anything; it is
#     the safe way to ask what a slot would grant.
#
# Exit codes: 64 usage, 75 slot busy / host too loaded / cannot nest.
#
set -euo pipefail
wait_for_slot=0
project=${DEVBUILD_PROJECT:-auto}
plan=0
while (( $# )); do
    case $1 in
        --wait) wait_for_slot=1; shift ;;
        --project) project=${2:?Project required}; shift 2 ;;
        --exclusive) project=exclusive; shift ;;
        --plan) plan=1; shift ;;
        --) shift; break ;;
        *) break ;;
    esac
done
if [[ $project == auto ]] && grep -Fq '/development.slice/' /proc/self/cgroup; then
    project=${DEVBUILD_ACTIVE:-exclusive}
fi
if [[ $project == auto ]]; then
    common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
    case $common in
        */qedc/*|*/qedc.git) project=qedc ;;
        */zclassic23/*|*/z23/*|*/z23.git) project=z23 ;;
        *) project=exclusive ;;
    esac
fi
case $project in qedc|z23|exclusive) ;; *) printf 'Unknown project: %s\n' "$project" >&2; exit 64 ;; esac
if (( ! plan )) && grep -Fq '/development.slice/' /proc/self/cgroup; then
    (( $# > 0 )) || { printf 'devbuild: command required\n' >&2; exit 64; }
    enclosing=${DEVBUILD_ACTIVE:-exclusive}
    if [[ $enclosing != exclusive && $project != "$enclosing" ]]; then
        printf 'devbuild: cannot expand or switch an enclosing %s budget\n' "$enclosing" >&2
        exit 75
    fi
    printf 'devbuild: reusing enclosing %s budget\n' "$enclosing" >&2
    exec "$@" 8>&- 9>&-
fi
cores=$(getconf _NPROCESSORS_ONLN)
[[ $cores =~ ^[0-9]+$ ]] && (( cores >= 8 )) || { printf 'devbuild requires at least eight online CPUs\n' >&2; exit 75; }
cpu_plan=$(lscpu -b -p=CPU,CORE,SOCKET | awk -F, '
    /^#/ { next }
    { key=$2 SUBSEP $3
      if (!(key in physical)) physical[key]=++count
      if (physical[key] > 2) { list=list sep $1; sep=","; workers++ }
    }
    END { if (workers < 4) exit 1; print list; print workers }
')
cpu_list=${cpu_plan%$'\n'*}
worker_cores=${cpu_plan##*$'\n'}
[[ $worker_cores =~ ^[0-9]+$ ]] || exit 75
quota=$((worker_cores * 100))%
memory=24G
[[ $project != exclusive ]] || memory=48G
if (( plan )); then
    printf 'project=%s cpus=%s cpu_quota=%s memory_max=%s reserve=24GiB\n' "$project" "$cpu_list" "$quota" "$memory"
    exit 0
fi
(( $# > 0 )) || { printf 'Usage: devbuild [--wait] [--project qedc|z23|--exclusive] COMMAND [ARGS...]\n' >&2; exit 64; }
command_umask=$(umask)
queued_at=$(date +%s)
# Checkout fingerprint at enqueue: HEAD plus the working-tree diff and
# untracked names. Two runs of the same command with the same fingerprint
# did identical work; the accounting line records it so repeats can be
# measured, and a repeat of a run that passed is named on stderr (advisory:
# a rerun can be intentional, e.g. a flake hunt, so nothing is refused).
tree_key=
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    tree_key=$( { git rev-parse HEAD; git diff HEAD --binary; git ls-files --others --exclude-standard; } 2>/dev/null | sha256sum | cut -c1-16 ) || tree_key=
fi
if [[ -n $tree_key && -r $HOME/.local/state/development/devbuild.jobs.jsonl ]]; then
    same_cmd=$(printf '%s ' "$@" | head -c 300 | tr -d '"\\\000-\037')
    prior=$(tail -n 400 "$HOME/.local/state/development/devbuild.jobs.jsonl" 2>/dev/null |
        grep -F "\"tree\":\"$tree_key\"" | grep -F "\"cwd\":\"$(pwd | tr -d '"\\')\"" |
        grep -F "\"cmd\":\"$same_cmd\"" | grep -F '"rc":0,' | tail -n 1) || prior=
    [[ -z $prior ]] || printf 'devbuild: note: this exact command already PASSED on this identical checkout (tree %s); rerunning anyway\n' "$tree_key" >&2
fi
umask 077
mkdir -p "$HOME/.local/state/development"
lock_args=()
(( wait_for_slot )) || lock_args=(-n)
if [[ $project != exclusive ]]; then
    exec 8>"$HOME/.local/state/development/$project.lock"
    # Z23 only: landing work (`dev land ...` or
    # DEVBUILD_PRIORITY=land) goes first. A priority waiter leaves a pid
    # marker; an ordinary waiter that wins the lock while a live marker
    # exists hands it back and retries. QEDC slots are unaffected.
    prio=0
    prio_dir="$HOME/.local/state/development/$project.priority"
    if [[ $project == z23 ]]; then
        [[ ${DEVBUILD_PRIORITY:-} == land ]] && prio=1
        case " $* " in *" dev land "*) prio=1 ;; esac
        mkdir -p "$prio_dir"
    fi
    if (( prio )); then
        : > "$prio_dir/$$"
    fi
    # FIFO among ordinary waiters: flock wakes waiters in no order, so a
    # long-queued job could be passed over indefinitely. Each waiter leaves
    # an enqueue-ordered ticket; a waiter that wins the lock while an older
    # live ticket exists hands it back. Priority (landing) waiters skip the
    # ticket order but still go first, as above.
    queue_dir="$HOME/.local/state/development/$project.queue"
    ticket=
    if (( wait_for_slot )) && (( ! prio )); then
        mkdir -p "$queue_dir"
        ticket="$queue_dir/$(date +%s%N)-$$"
        : > "$ticket"
    fi
    trap 'rm -f "$prio_dir/$$" ${ticket:+"$ticket"}' EXIT
    # Z23 runs up to DEVBUILD_Z23_LANES jobs at once (default 3), one per
    # lane lock; the first lane is the historic z23.lock, so an older
    # wrapper still waiting on it stays mutually exclusive with lane 0.
    # Measured 2026-09-28: one serial slot left ~79% of the 28 worker CPUs
    # idle while a dozen jobs queued 15+ minutes for 40-500 s of work.
    # Every job keeps its own 24 GiB scope and the shared development
    # slice still caps all jobs together; landing proofs run outside it.
    # Only the FIFO head (or a landing job) may take a free lane.
    # QEDC runs up to DEVBUILD_QEDC_LANES (default 2). Measured 2026-09-28:
    # QEDC gate units used ~1.8 cores for ~30 min yet queued up to 57 min
    # behind one lane. Two units never share a worktree (QEDC enforces it);
    # shared QEDC caches write via rename and heavy steps take QEDC's own
    # locks, so the single slot was never their mutual exclusion.
    lanes=1
    if [[ $project == z23 ]]; then
        lanes=${DEVBUILD_Z23_LANES:-3}
        [[ $lanes =~ ^[1-4]$ ]] || lanes=3
    elif [[ $project == qedc ]]; then
        lanes=${DEVBUILD_QEDC_LANES:-2}
        [[ $lanes =~ ^[1-4]$ ]] || lanes=2
    fi
    lane=0
    if (( lanes > 1 )); then
        exec 5>"$HOME/.local/state/development/$project.lock.1"
        exec 6>"$HOME/.local/state/development/$project.lock.2"
        exec 4>"$HOME/.local/state/development/$project.lock.3"
        lane_fds=(8 5 6 4)
        while :; do
            head=1
            if (( ! prio )); then
                for marker in "$prio_dir"/*; do
                    [[ -e $marker ]] || continue
                    if kill -0 "${marker##*/}" 2>/dev/null; then head=0; break; fi
                    rm -f "$marker"
                done
            fi
            if (( head )) && [[ -n $ticket ]]; then
                for other in "$queue_dir"/*; do
                    [[ -e $other && $other < $ticket ]] || continue
                    if kill -0 "${other##*-}" 2>/dev/null; then head=0; break; fi
                    rm -f "$other"
                done
            fi
            if (( head )); then
                for (( l = 0; l < lanes; l++ )); do
                    if /usr/bin/flock -n "${lane_fds[l]}"; then lane=$((l + 1)); break; fi
                done
                (( lane == 0 )) || break
            fi
            (( wait_for_slot )) || { printf 'devbuild: %s build lanes busy; use --wait\n' "$project" >&2; exit 75; }
            sleep 1
        done
    fi
    while (( lane == 0 )); do
        /usr/bin/flock "${lock_args[@]}" 8 || { printf 'devbuild: %s build slot busy; use --wait\n' "$project" >&2; exit 75; }
        [[ -n $ticket ]] || break
        yield=0
        if [[ $project == z23 ]]; then
            for marker in "$prio_dir"/*; do
                [[ -e $marker ]] || continue
                if kill -0 "${marker##*/}" 2>/dev/null; then yield=1; break; fi
                rm -f "$marker"
            done
        fi
        if (( ! yield )); then
            for other in "$queue_dir"/*; do
                [[ -e $other && $other < $ticket ]] || continue
                if kill -0 "${other##*-}" 2>/dev/null; then yield=1; break; fi
                rm -f "$other"
            done
        fi
        (( yield )) || break
        /usr/bin/flock -u 8
        sleep 1
    done
    if (( prio )); then rm -f "$prio_dir/$$"; fi
    [[ -z $ticket ]] || rm -f "$ticket"
fi
exec 9>"$HOME/.local/state/development/heavy.lock"
if [[ $project == exclusive ]]; then
    /usr/bin/flock "${lock_args[@]}" 9 || { printf 'devbuild: build slots busy; use --wait\n' >&2; exit 75; }
else
    /usr/bin/flock -s "${lock_args[@]}" 9 || { printf 'devbuild: exclusive build running; use --wait\n' >&2; exit 75; }
fi
available=$(awk '$1 == "MemAvailable:" {print $2}' /proc/meminfo)
[[ $available =~ ^[0-9]+$ ]] && (( available >= 24 * 1024 * 1024 )) || {
    printf 'devbuild: fewer than 24 GiB available; deferred\n' >&2; exit 75;
}
printf 'devbuild: %s lane %s, CPUs %s, memory %s\n' "$project" "${lane:-0}" "$cpu_list" "$memory" >&2
# One JSON line per job: queue wait and run wall seconds, for measuring
# slot contention. Best-effort; never fails the build.
started_at=$(date +%s)
unit="devbuild-$$-$(date +%s%N).scope"
cg="/sys/fs/cgroup/user.slice/user-$(id -u).slice/user@$(id -u).service/development.slice/$unit"
sample="$HOME/.local/state/development/.sample-$$"
# Peak memory and CPU seconds of this job's own scope, sampled every 2 s
# (the scope is gone once the command exits). Advisory only.
# It holds no lock fd and exits with this wrapper, so a killed wrapper can
# never leave a lane locked behind it.
devbuild_pid=$$
( while kill -0 "$devbuild_pid" 2>/dev/null; do
      if [[ -r $cg/memory.peak ]]; then
          printf '%s %s\n' "$(cat "$cg/memory.peak" 2>/dev/null)" \
              "$(awk '$1 == "usage_usec" {print $2}' "$cg/cpu.stat" 2>/dev/null)" \
              > "$sample.tmp" 2>/dev/null && mv -f "$sample.tmp" "$sample"
      fi
      sleep 2
  done ) 4>&- 5>&- 6>&- 8>&- 9>&- &
sampler=$!
devbuild_account() {
    local cmd peak=0 cpu_us=0
    kill "$sampler" 2>/dev/null || true
    { read -r peak cpu_us < "$sample"; } 2>/dev/null || true
    rm -f "$sample" "$sample.tmp"
    [[ $peak =~ ^[0-9]+$ ]] || peak=0
    [[ $cpu_us =~ ^[0-9]+$ ]] || cpu_us=0
    cmd=$(printf '%s ' "$@" | head -c 300 | tr -d '"\\\000-\037')
    printf '{"project":"%s","pid":%d,"cwd":"%s","queued":%d,"started":%d,"ended":%d,"wait_s":%d,"run_s":%d,"rc":%d,"lane":%d,"mem_peak_mib":%d,"cpu_s":%d,"tree":"%s","cmd":"%s"}\n' \
        "$project" "$$" "$(pwd | tr -d '"\\')" "$queued_at" "$started_at" "$(date +%s)" \
        "$((started_at - queued_at))" "$(( $(date +%s) - started_at ))" "$rc" "${lane:-0}" \
        "$((peak / 1048576))" "$((cpu_us / 1000000))" "$tree_key" "$cmd" \
        >> "$HOME/.local/state/development/devbuild.jobs.jsonl" 2>/dev/null || true
}
# Fair share per project, not per job: Z23 may hold up to DEVBUILD_Z23_LANES
# lanes at weight 20 each, so QEDC's single lane gets the matching project
# weight. Under contention each project then gets about half the slice;
# idle CPU still goes to whoever is running. QEDC measured 2026-09-28:
# ~2.8 cores per gate unit at load 50 while three Z23 lanes ran at 20 each.
cpu_weight=20
z23_lanes=${DEVBUILD_Z23_LANES:-3}
[[ $z23_lanes =~ ^[1-4]$ ]] || z23_lanes=3
# QEDC's project weight is split across its lanes so two QEDC jobs together
# still weigh what Z23's lanes weigh together.
qedc_lanes=${DEVBUILD_QEDC_LANES:-2}
[[ $qedc_lanes =~ ^[1-4]$ ]] || qedc_lanes=2
[[ $project != qedc ]] || cpu_weight=$((20 * z23_lanes / qedc_lanes))
rc=0
systemd-run --user --scope --quiet --unit="$unit" --slice=development.slice \
    --property="CPUQuota=$quota" --property="MemoryMax=$memory" \
    --property=MemorySwapMax=0 --property=CPUWeight="$cpu_weight" --property=IOWeight=20 -- \
    /usr/bin/env "DEVBUILD_ACTIVE=$project" "ZCC_MAX_MB=${ZCC_MAX_MB:-24576}" \
    /usr/bin/nice -n 10 /usr/bin/ionice -c 2 -n 7 \
    /usr/bin/taskset --cpu-list "$cpu_list" \
    /bin/bash -c 'umask "$1"; shift; exec "$@"' devbuild-command \
    "$command_umask" "$@" 4>&- 5>&- 6>&- 8>&- 9>&- || rc=$?
devbuild_account "$@"
exit "$rc"
