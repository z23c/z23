# Per-box configuration for tools/scripts/fleet_sync.sh and the node's
# systemd unit.
#
# Copy to ~/.config/zclassic23-fleetsync/<box>.env and edit. This file is
# NEVER committed: it holds local paths, ports, and unit names that belong to
# your machine and nobody else's. Only this .example template is tracked.
#
# Every value below is a placeholder. Nothing in this repository knows or
# assumes anything about how many machines you run or what you call them.
#
# NAMING: the `DEVFLEET_*` spellings are what the shipped template unit
# `platform/deploy/zcl23-devfleet@.service` reads, so keep them if you use that unit.
# `fleet_sync.sh` also accepts `MESH_DATADIR` / `MESH_RPCPORT` / `MESH_UNIT`
# and prefers those when both are set.

# Your own name for this machine. Used as a filename and a log prefix.
BOX=changeme

# Absolute path to this box's datadir, and the ports it listens on.
DEVFLEET_DATADIR=/absolute/path/to/datadir
DEVFLEET_PORT=<p2p port>
DEVFLEET_RPCPORT=<rpc port>

# Extra node flags. Pin one -addnode per peer you want a standing connection
# to; without them a box has no edge to your other machines that survives a
# restart.
DEVFLEET_FLAGS="-listen -tor -onion-persist -txindex -showmetrics=0"
# DEVFLEET_FLAGS="$DEVFLEET_FLAGS -addnode=<peer>.onion:<port>"

# systemd unit that owns the node process. fleet_sync.sh defaults to
# zcl23-devfleet@<box>.service; set this if you named yours something else.
# MESH_UNIT=your-node@changeme.service

# Optional second (production) instance the loop may auto-update. Leave
# RESTART_PROD=manual on any machine whose node is mid-acceptance: restarting
# it resets any running soak clock.
# PROD_UNIT=your-node.service
# PROD_BIN=/absolute/path/to/live-binary
RESTART_PROD=manual
