# Example environment file for
# platform/deploy/examples/z23-tunnel-renew@.service.
#
# Copy to (one file per paired peer, named after the instance):
#     ~/.config/z23/tunnel-renew-r1.env      for z23-tunnel-renew@r1
#     ~/.config/z23/tunnel-renew-mac.env     for z23-tunnel-renew@mac
#
# Z23_BIN                z23 binary to run (default below).
# Z23_TUNNEL_RENEW_INPUT absolute path of the pair-renew input JSON, a
#                        regular file owned by you, not group/other
#                        writable, at most 4096 bytes. It is route data,
#                        not a secret: the PSK is imported from an
#                        owner-private source file during the confirm step
#                        and never appears here. Example contents (one
#                        object; only the seven path/identity fields are
#                        required, the two tunables default as shown):
#
#     {"state_dir":"<HOME>/.local/state/z23-tunnel/<client-route-dir>",
#      "peer":"r1",
#      "hub_state_dir":"<HOME>/.local/state/z23-tunnel/<hub-profile-dir>",
#      "hub_config_dir":"<HOME>/.config/systemd/user",
#      "hub_unit_file":"z23-tunnel-receiver@r1.service",
#      "evidence_dir":"<HOME>/.local/state/z23-tunnel/<evidence-dir>",
#      "slot_bin":"<HOME>/.local/lib/z23/tunnel-<version>/z23",
#      "renew_before_s":259200,
#      "grant_days":7}
#
#     state_dir is THIS host's client route directory for the peer (the
#     side that dials); hub_* name the receiving side, which must live on
#     this same host — the renew leaf reaches no other machine. A hub on
#     another host is renewed by running this unit THERE.
#     renew_before_s is 3600..2592000 (default 259200 = 72 h): a plan
#     reports renew_due only inside that window. grant_days is 1..30
#     (default 7): the lifetime of the epoch the confirm step mints.
# Edit both to real absolute paths before enabling the timer: values in
# this file get no systemd specifier or shell expansion, so a %h or $HOME
# written here reaches the unit as a literal string and the run fails with
# exit 127 (binary not found).
Z23_BIN=<HOME>/.local/bin/z23
Z23_TUNNEL_RENEW_INPUT=<HOME>/.local/state/z23-tunnel/renew-r1.json
