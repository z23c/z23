# Copy to ~/.config/z23/zclassicd.env (mode 0600). Read by
# zclassicd-oracle.service and zclassicd-bootstrap.service.
ZCLASSICD_BIN=/home/<user>/bin/zclassicd
# sha256 of the pinned zclassicd v2.1.2-beta6 binary (64 lowercase hex).
ZCLASSICD_SHA256=
# A datadir seeded by `ops host legacy seed` holds no peers.dat. Whatever
# starts it needs a peer source: the bootstrap unit passes
# -addnode=127.0.0.1:8033 (the local z23 node). Use your node's P2P address
# if it is not on 8033.
