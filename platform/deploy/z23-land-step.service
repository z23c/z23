[Unit]
Description=Z23 land queue driver (dev land drive --prove, one row)

[Service]
Type=oneshot
WorkingDirectory=%h/development/z23/main
# One bounded `dev land drive --prove` row per tick, under ordinary devbuild
# admission (tools/command/native_dev_land.c): the row is rebased, proved and,
# when its exact receipt is admitted, fast-forwarded onto origin/main.
#
# PUBLISH BOUNDARY: this unit has no `git push` of its own and ships no shell
# script in the path. It publishes only through the native leaf's exact
# receipt gate, the same reasoning that carries native_dev_land.c in the
# closed allowlist of tools/lint/lintc/gate_no_unattended_publish.c; the unit
# is not and must never become an allowlist entry.
ExecStart=%h/bin/devbuild --wait %h/development/z23/main/build/bin/z23-dev dev land drive --prove --max_rows=1

# The timeout covers a 13-45 min proof plus queueing; it also bounds a hung
# row, because a oneshot the timer still sees as "activating" never gets a
# fresh OnUnitInactiveSec edge.
TimeoutStartSec=5400
TimeoutStopSec=60

# The test harness a proof run drives needs an unlimited stack.
LimitSTACK=infinity

# Yield to the node and to interactive work.
Nice=10
CPUWeight=20
IOWeight=20
IOSchedulingClass=idle

StandardOutput=journal
StandardError=journal
