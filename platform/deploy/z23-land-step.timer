[Unit]
Description=Z23 Landing Stepper Timer

[Timer]
# Drives the native land queue on the land host: one `dev land drive --prove`
# drain at the earlier of 20s after the previous finish or 30s after its
# start, plus once 2 minutes after boot. A drain takes queued rows one after
# another; a tick that finds it still running is answered DRIVE_BUSY. An
# idle queue retains the 20s post-finish cadence.
OnBootSec=2min
OnUnitActiveSec=30s
OnUnitInactiveSec=20s
AccuracySec=1s
Persistent=false
Unit=z23-land-step.service

[Install]
WantedBy=timers.target
