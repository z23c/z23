[Unit]
Description=Z23 Landing Stepper Timer

[Timer]
# Drives the native land queue on the land host: one `dev land drive --prove`
# row at the earlier of 20s after the previous finish or 30s after its
# start, plus once 2 minutes after boot. A long row can therefore be followed
# immediately; an idle row retains the 20s post-finish cadence.
OnBootSec=2min
OnUnitActiveSec=30s
OnUnitInactiveSec=20s
AccuracySec=1s
Persistent=false
Unit=z23-land-step.service

[Install]
WantedBy=timers.target
