[Unit]
Description=Z23 Landing Stepper Timer

[Timer]
# Drives the native land queue on the land host: one `dev land drive --prove`
# row every ~20s after the previous one finishes, plus once 2 minutes after
# boot. No long-running process has to stay alive; systemd restarts the timer
# on its own after a crash or reboot.
OnBootSec=2min
OnUnitInactiveSec=20s
AccuracySec=1s
Persistent=false
Unit=z23-land-step.service

[Install]
WantedBy=timers.target
