[Unit]
Description=Z23 Worktree + Merged-Branch Garbage Collector Timer

[Timer]
# Daily 03:35 — after z23-logrotate.timer (03:00) and
# z23-simnet-nightly.timer (03:10), before
# z23-bundle-export.timer (04:00) and
# z23-replay-canary-nightly.timer (04:30); distinct from the
# z23-test-suite.timer hourly *:20:00 slot.
OnCalendar=*-*-* 03:35:00
RandomizedDelaySec=300
Persistent=true
Unit=z23-worktree-gc.service

[Install]
WantedBy=timers.target
