[Unit]
Description=Z23 Build Drift Probe — is the running binary still the binary we think is running (read-only)
# Appends one JSON line per run to
# ~/.local/state/zclassic23-drift/build-drift-ledger.jsonl via
# tools/scripts/build_drift_probe.sh.
#
# It compares three things that can drift apart independently:
#   1. the expectation the RUNNING process was started with
#      (ZCL_AGENT_EXPECT_SOURCE_ID, read from /proc/<MainPID>/environ),
#   2. the checked-in candidate pin (platform/deploy/release-candidates.jsonl),
#   3. what the process is ACTUALLY executing (/proc/<MainPID>/exe).
#
# (3) is the point. Fingerprinting ~/.local/bin/zclassic23-live — the file at
# the path — is what `make agent-doctor` does, and it cannot see a deploy that
# overwrote the file under a live process: the path shows the new build while
# the node keeps running the old one until the next restart. /proc/<pid>/exe is
# pinned by the kernel to the inode being executed, so that window is visible
# instead of invisible. The two are reported separately
# (artifact_path_matches_running) rather than one silently winning.
#
# READ-ONLY. It never signals, restarts, or writes to any node datadir. The
# only thing it writes is its own ledger, outside every datadir, so the record
# survives a node crash. `agentbuild` is an identity command run as a separate
# short-lived process — the same call agent-doctor.sh already makes.
#
# Deliberately NO Requires= on the node: a node that is not running is itself
# a recorded line (state=node_not_running), not a skipped run. A hole in the
# ledger must never be the way an outage is represented.
After=zclassic23.service

[Service]
Type=oneshot
WorkingDirectory=%h/github/zclassic23
ExecStart=%h/github/zclassic23/tools/scripts/build_drift_probe.sh collect
# Two bounded `agentbuild` invocations at 20s each plus a sha256 of a ~22MB
# binary. Generous margin for a loaded box; never infinity (see
# zcl-bombard.service for what TimeoutStartSec=infinity costs).
TimeoutStartSec=120
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
