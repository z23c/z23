[Unit]
Description=Z23 Intervention Ledger — detects every touch of a node, attributed or not
# The record that makes "N days with zero operator intervention" a
# FALSIFIABLE claim. Per cycle, per watched unit, it records:
#   - every ActiveState transition, with InvocationID and the systemd
#     Result (the queryable form of SERVICE_RESULT), so two restarts inside
#     one cycle are two InvocationIDs and not one NRestarts delta;
#   - a sha256 of `systemctl cat <unit>` — the unit PLUS every drop-in — so
#     a config edit is an event even with no restart;
#   - a sha256 of the service binary on disk AND of /proc/<MainPID>/exe, so
#     a binary swap is an event even with NO restart, and a binary swapped
#     underneath a running node is its own distinct event.
# Anything it detects without a matching `zcl-intervene "<reason>"`
# declaration inside the attribution window is recorded as `unattributed`.
#
# Appends to ~/.local/state/zclassic23-intervention/intervention-ledger.jsonl.
# EVENT-driven, so a quiet node writes nothing and the file never needs
# rotation — the record is genuinely append-only and never truncated. A
# daily heartbeat line proves the detector was alive during quiet stretches,
# so "no events" cannot be confused with "the detector was dead".
#
# READ-ONLY OBSERVER. It never starts, stops, reloads, enables, disables, or
# edits any unit, and it never writes inside any datadir.
After=zclassic23.service

[Service]
Type=oneshot
ExecStart=%h/github/zclassic23/tools/scripts/intervention_ledger.sh collect
# Watch list. Add units here as lanes are deployed; the collector never
# auto-discovers, because a monitor that picks its own targets quietly
# stops watching the one you cared about the day its name changes.
Environment=ZCL_INTERVENE_UNITS=zclassic23.service
# One `systemctl show`, one `systemctl cat`, and two sha256 passes per unit
# (each capped at ZCL_EVIDENCE_TIMEOUT_SEC, default 10s). Measured at ~175ms
# for one unit on a healthy box.
TimeoutStartSec=90
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
