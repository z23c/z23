[Unit]
Description=Z23 Intervention Ledger Timer — every 60s

[Timer]
# OnCalendar (wall-clock), NOT OnBootSec/OnUnitActiveSec — same lesson the
# SLO probe timer records in its own comment: the monotonic form loses its
# anchor across a user-manager restart and silently never fires again. A
# detector that dies quietly is worse than no detector, because its silence
# reads as "nothing happened".
#
# 60s, matching the SLO probe: a binary swapped with no restart should show
# up in the record within a minute, not within an hour.
OnCalendar=*-*-* *:*:00
RandomizedDelaySec=7
Persistent=true
Unit=zclassic23-intervention.service

[Install]
WantedBy=timers.target
