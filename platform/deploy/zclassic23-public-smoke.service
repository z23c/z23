[Unit]
Description=Z23 Public Explorer Smoke — the only EXTERNAL availability evidence
# The uptime ledger's `reachable` column is a LOOPBACK RPC dial from the
# same host as the node: it measures "the process is answering", not "a user
# can reach the service". Every failure between the node and a user — the
# port forward, TLS, an expiring certificate, the box's route to the
# internet, DNS — is invisible to it and always will be.
#
# This unit drives tools/scripts/public_explorer_smoke.sh, which fetches the
# real public endpoint over the real internet path and appends one JSON line
# per run to ~/.local/state/zclassic23-public-smoke/availability-ledger.jsonl
# (reachable, unreachable_streak, api_ok, html_ok, HTTP statuses, latencies,
# served_height, fail_stage). A FAILED check is not a unit failure — it IS
# the data point, and the line is written on every path, so an outage leaves
# a record instead of depending on somebody watching a terminal.
#
# READ-ONLY: it issues HTTP GETs and writes only its own ledger.
[Service]
Type=oneshot
ExecStart=%h/github/zclassic23/tools/scripts/public_explorer_smoke.sh
Environment=ZCL_PUBLIC_BASE=https://zclnet.net
# The script exits non-zero on a failed check by design. The ledger line is
# already written by then, so systemd's own failure accounting is redundant
# here and a red unit every time the site hiccups trains the operator to
# ignore it. SuccessExitStatus keeps the record without the noise; the
# ledger's unreachable_streak is what escalates.
SuccessExitStatus=0 1
# Two HTTPS fetches, each --connect-timeout 8 --max-time 20 = 40s worst
# case. Measured at ~2.6s against the live endpoint.
TimeoutStartSec=90
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
