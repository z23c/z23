[Unit]
Description=Z23 Public Explorer Smoke Timer — every 5 minutes

[Timer]
# OnCalendar (wall-clock), NOT monotonic — see the SLO probe timer's comment
# for the 3.5-day outage the monotonic form caused on 2026-07-20.
#
# 5 minutes, not 60 seconds: this crosses the public internet and hits the
# real endpoint, so the cadence is a courtesy to the service as well as a
# measurement. 5 minutes still bounds an undetected outage to one pager
# interval.
OnCalendar=*-*-* *:0/5:30
RandomizedDelaySec=20
Persistent=true
Unit=zclassic23-public-smoke.service

[Install]
WantedBy=timers.target
