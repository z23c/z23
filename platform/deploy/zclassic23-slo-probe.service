[Unit]
Description=Z23 External SLO Prober — client-viewpoint uptime ledger (read-only)
# Appends one JSON line per run per DEPLOYED local instance (canonical
# rpcport 18232, dev rpcport 18252 — the INSTANCES table in the script is
# the list) to ~/.local/state/zclassic23-slo/uptime-ledger.jsonl via
# tools/scripts/node_slo_probe.sh. An instance that is not deployed gets no
# row at all rather than a permanently unreachable one, so any_unreachable=1
# in the ledger always means something is actually wrong.
# This is an EXTERNAL prober — it dials each instance's
# RPC port the same way any outside client would and records exactly what
# came back, never trusting node self-reports. READ-ONLY: it never
# restarts, stops, or writes to any node. After= the canonical node so a
# boot-time catch-up run samples a started node; deliberately NO Requires=
# — an unreachable instance is recorded as a reachable:false line (a hole
# in the ledger is itself the data point), never skipped.
After=zclassic23.service

[Service]
Type=oneshot
ExecStart=%h/github/zclassic23/tools/scripts/node_slo_probe.sh collect
# Per REACHABLE instance: getblockchaininfo + getpeerinfo (each capped at
# ZCL_SLO_RPC_TIMEOUT_SEC, default 8s), one `systemctl show` and one
# `du -sb` (each capped at ZCL_SLO_HOST_TIMEOUT_SEC, default 5s), and two
# `dumpstate` self-report calls (each capped at ZCL_SLO_STATE_TIMEOUT_SEC,
# default 5s) = 36s worst case. Two instances plus the oracle RPC = 80s
# worst case. Measured cost on a healthy box is ~0.25s for the whole
# cycle; the 150s budget exists so a WEDGED host cannot produce
# overlapping runs of a 60s collector.
TimeoutStartSec=150
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
