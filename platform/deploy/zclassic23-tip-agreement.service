[Unit]
Description=Z23 Off-Host Tip-Hash Agreement Recorder (read-only)
# Appends one JSON line per run per deployed local instance to
# ~/.local/state/zclassic23-parity/agreement-ledger.jsonl via
# tools/scripts/tip_agreement_probe.sh.
#
# This is the FIRST thing in the repository that compares a BLOCK HASH
# against genuinely remote peers on a cadence. Every parity reference that
# existed before it dialled 127.0.0.1 — the sibling zclassicd on this same
# box, same disk, same clock, same operator. This one reads the node's
# peer_chain_observations table (real 32-byte tip hashes learned from real
# remote nodes, written by engine/services/src/network_monitor.c) and asks
# whether our own hash at that height is the same bytes.
#
# READ-ONLY, in the same sense as zclassic23-slo-probe.service: it dials the
# node's operator surfaces the way an outside caller would and records what
# came back. It never restarts, stops, signals, or writes to any node or
# datadir. Its only write is its own ledger under ~/.local/state.
#
# Every sample records one of three outcomes — agrees / disagrees /
# could-not-ask. The third is never an implicit pass: a query the node
# interrupted, an envelope whose pager dropped the rows, a height we do not
# hold, and a hash backed by fewer than two DISTINCT remote hosts all record
# as could-not-ask, and tools/scripts/tip_agreement_judge.sh refuses to pass
# a window of them.
#
# After= the canonical node so a boot-time catch-up run samples a started
# node. Deliberately NO Requires= — a node that will not answer is recorded
# as could-not-ask, which is the data point, never a skipped run.
After=zclassic23.service

[Service]
Type=oneshot
ExecStart=%h/github/zclassic23/tools/scripts/tip_agreement_probe.sh collect
# Worst case per instance: three `core storage query` reads and one
# `dumpstate`, each capped at ZCL_PARITY_RPC_TIMEOUT_SEC (default 8s), plus
# one getblockhash RPC at the same cap = 40s. One instance is deployed here,
# so 40s worst case against a 120s budget. Measured cost on a healthy box is
# under 2s for the whole cycle; the headroom exists so a wedged host cannot
# produce overlapping runs of a 10-minute collector.
TimeoutStartSec=120
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
