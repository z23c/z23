ZCL_MODULE_CAPABILITY("tools/command/native_dev_land_offer_verify.c", CAP_FS_READ|CAP_FS_WRITE, "stats PATH entries for an executable devbuild and reads the scratch worktree's agent-verify verdict file, which it unlinks so a verdict this run did not write is never trusted; the git rev-list/cherry-pick and the make agent-verify child, plus for --check=gate the lint preparation and full lint children (all always behind the host admission rail, refused when absent), run only inside the reverify scratch worktree through the spawn seam with an argv and no shell, time-bounded with the process group killed on timeout")
