ZCL_MODULE_CAPABILITY("tools/command/native_fleet_parity.c", CAP_FS_WRITE|CAP_NETWORK|CAP_CLOCK, "asks two loopback nodes for getblockcount and getblockhash through the node RPC client, then appends one JSON line to parity.jsonl under a flock on parity.lock after making the directory 0700; it reads no datadir itself and truncates nothing")
