ZCL_MODULE_CAPABILITY("tools/command/native_fleet_parity.c", CAP_FS_READ|CAP_FS_WRITE, "opens parity.lock read-write for its flock and appends one JSON line to parity.jsonl after making the directory 0700; the two loopback getblockcount/getblockhash calls go through the node RPC client, whose own object carries that network reach; it reads no datadir and truncates nothing")
