 * Source-owned capability declaration for devloop_watch_session.c. */
ZCL_MODULE_CAPABILITY("tools/dev/devloop_watch_session.c", CAP_FS_READ|CAP_FS_WRITE|CAP_PROCESS|CAP_CLOCK, "records each launched dev watcher session (pid, birth token, boot id, image inode) in an owner-only directory under the checkout's .cache; signals only a session whose leader is gone and whose every readable surviving member runs that recorded dev image, at least one rooted at the checkout, in this boot, and only when its record carries the birth token the caller names; never signals a running leader or the caller's own session; keeps, never signals, a record it can neither prove nor disprove; removes a record only while it is still the file that was judged; and bounds each stop phase on the monotonic clock")
