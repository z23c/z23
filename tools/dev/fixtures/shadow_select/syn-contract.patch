# Shadow-selection corpus entry syn-contract: zcl_codec_reader_finish keeps its
# signature and ABI but now returns true on trailing bytes (reported only
# through reader->error); the component test is updated to the new convention.

diff --git a/platform/modules/codec/src/cursor.c b/platform/modules/codec/src/cursor.c
index 6f37e12b6c..10bb7ce963 100644
--- a/platform/modules/codec/src/cursor.c
+++ b/platform/modules/codec/src/cursor.c
@@ -76,10 +76,10 @@ static bool writer_need(struct zcl_codec_writer *writer, size_t length)
 bool zcl_codec_reader_finish(struct zcl_codec_reader *reader)
 {
     if (!reader || reader->error != ZCL_CODEC_OK) return false;
-    if (reader->position != reader->length) {
+    /* Trailing bytes are reported through reader->error; the return value
+     * says only whether decoding hit a hard error. */
+    if (reader->position != reader->length)
         reader->error = ZCL_CODEC_TRAILING;
-        return false;
-    }
     return true;
 }
 
diff --git a/tests/harness/src/test_codec_cursor.c b/tests/harness/src/test_codec_cursor.c
index 4292c45135..8a7c205482 100644
--- a/tests/harness/src/test_codec_cursor.c
+++ b/tests/harness/src/test_codec_cursor.c
@@ -92,7 +92,7 @@ static int codec_test_failures(void)
         zcl_codec_reader_init(&trailing, canonical, length);
         char text[16]; uint16_t text_len;
         ASSERT(zcl_codec_read_u16_string(&trailing, text, sizeof(text), &text_len));
-        ASSERT(!zcl_codec_reader_finish(&trailing));
+        ASSERT(zcl_codec_reader_finish(&trailing));
         ASSERT(trailing.error == ZCL_CODEC_TRAILING);
         PASS();
     } _test_next:;
