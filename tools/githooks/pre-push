#!/usr/bin/env bash
# Copyright 2026 Rhett Creighton - Apache License 2.0
#
# Pre-push LOCAL CI gate.
#
# This project runs CI ONLY locally on the maintainer's own server - never
# GitHub Actions (Actions cost money). `make pre-push-ci` is the synchronous
# gate; full-suite, fuzz, and coverage proof work runs through linger timers so
# pushes are blocked by focused regressions, not by background evidence jobs.
#
# Activate:  make install-hooks   (sets core.hooksPath=tools/githooks)
# Fast local edit-loop before commit:  make fast-ci
# The default pre-push is make pre-push-ci: strict focused tests for exactly
# the files being pushed to origin/main.
# Background proof lanes:  make install-quality-linger
# Bypass once:  git push --no-verify     OR     ZCL_SKIP_PREPUSH=1 git push
# Override the command (e.g. a faster subset):  ZCL_PREPUSH_CMD='make lint'
#
# Full `make ci` remains available for release-grade manual runs. The default
# push path keeps long-running full-suite/fuzz/coverage evidence off the
# critical path.
#
# SIGPIPE-safety: the gate's verbose stdout is redirected to a log file
# (build/pre-push-ci.log), never streamed raw through this hook's own
# stdout/stderr. Whatever ultimately reads this hook's output (a terminal,
# `git push | head`, an agent harness that truncates long output, ...) may
# stop draining before the gate finishes. If that verbose output were piped
# straight through, a `make` recipe that gets EPIPE writing to ITS stdout
# reports a fatal "write error" and dies non-zero — even though the actual
# checks passed — spuriously blocking the push. Writing to a regular file
# can never EPIPE, so the gate's real exit code is what decides the push,
# never whether some downstream reader kept reading. SIGPIPE is ignored and
# every informational echo/tail below is `|| true`-guarded so this hook's
# own (much smaller) summary output can't trigger the same failure mode one
# level up.
set -euo pipefail
trap '' PIPE

# Git for Windows launches hooks with its own minimal MSYS runtime, which does
# not carry the UCRT64 compiler, make, or flock used by the native Z23 lane.
# Re-enter once through the qualified MSYS2 shell so an ordinary `git push`
# proves the same environment as `make windows-acceptance`.
windows_hook_lane=0
case "$(uname -s 2>/dev/null || true)" in
    MINGW*|MSYS*)
        windows_hook_lane=1
        if [ "${Z23_PREPUSH_UCRT64:-0}" != "1" ]; then
            persisted_msys2_root="$(git config --worktree --get z23.windowsMsys2Root 2>/dev/null || true)"
            windows_msys2_root=${Z23_WINDOWS_MSYS2_ROOT:-${persisted_msys2_root:-/c/msys64}}
            windows_msys2_bash=$windows_msys2_root/usr/bin/bash.exe
            if [ ! -x "$windows_msys2_bash" ]; then
                echo "pre-push: MSYS2 UCRT64 shell missing: $windows_msys2_bash" >&2 || true
                exit 1
            fi
            export Z23_PREPUSH_UCRT64=1 MSYSTEM=UCRT64
            export PATH="$windows_msys2_root/ucrt64/bin:$windows_msys2_root/usr/bin:$PATH"
            exec "$windows_msys2_bash" "$0" "$@"
        fi
        ;;
esac

if [ "${ZCL_SKIP_PREPUSH:-0}" = "1" ]; then
    echo "pre-push: ZCL_SKIP_PREPUSH=1 — skipping the local CI gate." >&2 || true
    exit 0
fi

remote_name="${1:-origin}"

# git feeds '<local ref> <local sha> <remote ref> <remote sha>' lines on stdin.
# If every ref is a deletion (local sha all-zero) there is nothing new to
# verify — allow the push without running CI.
z="0000000000000000000000000000000000000000"
updates="$(mktemp)"
changed_files="$(mktemp)"
trap 'rm -f "$updates" "$changed_files"' EXIT
have_update=0
while read -r _lref lsha rref rsha; do
    [ -n "${lsha:-}" ] || continue
    [ "$lsha" = "$z" ] && continue
    if [ "$rref" != "refs/heads/main" ]; then
        echo "pre-push: only origin main is allowed (got remote ref $rref)." >&2 || true
        exit 1
    fi
    have_update=1
    printf '%s %s %s\n' "$lsha" "${rsha:-$z}" "$rref" >> "$updates"
done
if [ "$have_update" = "0" ]; then
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

while read -r lsha rsha rref; do
    [ -n "${lsha:-}" ] || continue
    if [ "$rsha" = "$z" ]; then
        git diff-tree --no-commit-id --name-only -r "$lsha" >> "$changed_files"
    else
        # The remote SHA comes from this push's advertisement and may be newer
        # than the last local fetch. A raw diff against a missing object emits
        # only "bad object" and obscures the actual invariant. Fetch the
        # advertised branch, prove the exact tip is now present, and refuse
        # before expensive CI if the proposed update has not integrated it.
        if ! git cat-file -e "${rsha}^{commit}" 2>/dev/null; then
            echo "pre-push: advertised remote tip $rsha is absent locally; fetching $remote_name $rref." >&2 || true
            if ! git fetch --no-tags --quiet "$remote_name" "$rref" ||
               ! git cat-file -e "${rsha}^{commit}" 2>/dev/null; then
                echo "pre-push: remote-tip-unavailable — cannot prove the pushed range; push blocked." >&2 || true
                exit 1
            fi
        fi
        if ! git merge-base --is-ancestor "$rsha" "$lsha"; then
            echo "pre-push: remote-main-not-integrated — $rref advanced to $rsha; fetch/rebase main before running CI." >&2 || true
            exit 1
        fi
        git diff --name-only "$rsha" "$lsha" -- >> "$changed_files"
    fi
done < "$updates"
sort -u "$changed_files" -o "$changed_files"

# Git exports repository-local environment (GIT_DIR, GIT_WORK_TREE, object
# directories, and related variables) to hooks.  The CI suite intentionally
# creates throwaway repositories with `git -C <fixture> init`; forwarding the
# hook environment would redirect those commands back into this checkout's
# repository metadata.  Resolve the push while those variables are available,
# then clear them before any build or test process can inherit them.  Git
# commands below rediscover this worktree from REPO_ROOT.
git_local_env="$(git rev-parse --local-env-vars)"
for name in $git_local_env; do
    unset "$name"
done
unset git_local_env name

# Git for Windows launches hooks with a minimal MSYS environment that may not
# carry TEMP/TMP into the re-entered UCRT64 shell. Win32 tests and tools call
# GetTempPathW, which returns an empty path when neither variable is set and
# the fallback directory is unreachable. Ensure a writable temporary directory
# is always available.
if [ -z "${TEMP:-}" ] && [ -z "${TMP:-}" ]; then
    tmp_root="${TMPDIR:-/tmp}"
    mkdir -p "$tmp_root" 2>/dev/null || true
    export TEMP="$tmp_root"
    export TMP="$tmp_root"
fi

# Windows (MINGW/MSYS) is a supported native lane, but the full pre-push-ci
# focused-test set includes POSIX-only tools that do not yet build there.
# Default to the Windows acceptance gate on that lane; every other host keeps
# the full pre-push-ci gate. ZCL_PREPUSH_CMD still overrides either default.
default_cmd="make pre-push-ci"
case "$(uname -s 2>/dev/null || true)" in
    MINGW*|MSYS*)
        # Git for Windows can drop one-shot MAKEFLAGS/ZCL_PREPUSH_CMD values
        # while re-entering the canonical UCRT64 shell.  Keep the native gate
        # bounded but parallel by default: a cold node epoch otherwise pins
        # one core long enough for the already-open SSH transport to expire.
        windows_jobs="$(getconf _NPROCESSORS_ONLN 2>/dev/null || printf '4\n')"
        case "$windows_jobs" in
            ''|*[!0-9]*) windows_jobs=4 ;;
        esac
        [ "$windows_jobs" -ge 1 ] || windows_jobs=1
        [ "$windows_jobs" -le 8 ] || windows_jobs=8
        default_cmd="make -j$windows_jobs windows-acceptance"
        ;;
esac
CMD="${ZCL_PREPUSH_CMD:-$default_cmd}"
LOG_FILE="$REPO_ROOT/build/pre-push-ci.log"
mkdir -p "$REPO_ROOT/build" 2>/dev/null || true

echo "pre-push: running local CI gate ($CMD) before push to origin…" >&2 || true
echo "pre-push: semantic changed-file count: $(wc -l < "$changed_files" | tr -d ' ')." >&2 || true
if [ "$windows_hook_lane" = 1 ]; then
    echo "pre-push: fixed native Windows acceptance catalog; this is not exact-receipt admission." >&2 || true
else
    echo "pre-push: mapped focused tests for those files; unmapped code fails closed." >&2 || true
fi
echo "pre-push: full-suite/fuzz/coverage lanes run via 'make install-quality-linger'." >&2 || true
echo "pre-push: bypass one push with 'git push --no-verify' if you must." >&2 || true
echo "pre-push: verbose CI output -> $LOG_FILE (only a summary prints here)." >&2 || true

# Verbose CI output goes to a regular file, never straight to this hook's
# own stdout/stderr — see the SIGPIPE-safety note at the top of this file.
# A regular-file write can never EPIPE, so $CMD's real exit code is the
# only thing that decides the push, regardless of how this hook's own
# (small) output above/below gets consumed.
rc=0
ZCL_FAST_CHANGED_FILES_FILE="$changed_files" ZCL_FAST_CHANGED_FILES_ONLY=1 $CMD >"$LOG_FILE" 2>&1 || rc=$?

if [ "$rc" -ne 0 ]; then
    echo "" >&2 || true
    echo "pre-push: LOCAL CI FAILED (exit $rc) — push BLOCKED." >&2 || true
    echo "pre-push: last 60 lines of $LOG_FILE:" >&2 || true
    tail -n 60 "$LOG_FILE" >&2 2>/dev/null || true
    echo "" >&2 || true
    echo "pre-push: full log: $LOG_FILE" >&2 || true
    echo "pre-push: fix it, or override this one push with 'git push --no-verify'." >&2 || true
    exit 1
fi
echo "pre-push: local CI green (log: $LOG_FILE) — allowing push." >&2 || true
exit 0
