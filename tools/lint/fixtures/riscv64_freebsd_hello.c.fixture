/* Copyright 2026 Rhett Creighton - Licensed under Apache-2.0
 *
 * purpose: Fixture for the check-object-reproducible gate's riscv64-link
 * case (tools/lint/lintc/gate_object_reproducible.c). It is a freestanding
 * program with its own _start and no libc, no headers and no startup files,
 * for riscv64 FreeBSD. The gate compiles it and links it with the cross
 * linker under two checkout roots and requires byte-identical executables.
 *
 * System call convention (FreeBSD riscv64): the number goes in register t0,
 * the arguments in a0..a2, the trap is ecall, and the result comes back in a0.
 * Calls made: write(1, msg, len) is number 4 and exit(0) is number 1.
 *
 * The .c.fixture suffix keeps the *.c-scanning gates off this file (it is
 * inline assembly for another architecture, not tree code); the gate compiles
 * it with -x c. It is never built into any product.
 */

static long sys3(long n, long a, long b, long c)
{
    register long t0 __asm__("t0") = n;
    register long a0 __asm__("a0") = a;
    register long a1 __asm__("a1") = b;
    register long a2 __asm__("a2") = c;
    __asm__ volatile("ecall" : "+r"(a0), "+r"(t0) : "r"(a1), "r"(a2) : "memory");
    return a0;
}

void _start(void)
{
    static const char msg[] = "hello from z23 riscv64\n";
    (void)sys3(4, 1, (long)msg, sizeof(msg) - 1); /* write */
    (void)sys3(1, 0, 0, 0);                       /* exit */
    for (;;) { }
}
