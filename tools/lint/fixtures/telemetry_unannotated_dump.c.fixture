/* Copyright 2026 Rhett Creighton - Apache License 2.0
 *
 * Known-bad fixture for check-telemetry-ontology. NOT compiled — the
 * `.fixture` suffix keeps it out of every source glob; only the gate's awk
 * slicer ever reads it.
 *
 * It emits a network telemetry field that carries no meaning row in
 * platform/modules/util/include/util/telemetry_ontology.def. Pointing the gate at this
 * file through ZCL_TELEMETRY_SCAN_EXTRA_MANIFEST must make it FAIL and name
 * the field; that is the proof the gate is not hollow.
 */

bool telemetry_fixture_dump_state_json(struct json_value *out, const char *key)
{
    (void)key;
    json_set_object(out);
    json_push_kv_int(out, "field_that_ships_with_no_meaning", 27);
    return true;
}
