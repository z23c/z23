/* Copyright 2026 Rhett Creighton - Apache License 2.0
 *
 * purpose: the one registry of z23-lint gates. Include with LINT_GATE(name,
 * base) defined: lintc.h expands it to the `int base_run(int, char **)` and
 * `int base_selftest(void)` prototypes, main.c to the dispatch row. name is
 * the CLI gate name; base is the C identifier stem and may differ from the
 * name (check-stable-publish-contained -> check_stable_publish_containment).
 * Row order is the `--list` order. Add a gate by appending one row here; the
 * run and selftest functions must be named base_run and base_selftest.
 */

