BEGIN { n = 0; tree = "" }
/^SECTION[ \t]/ {
    hex = $4; plen = $3 + 0;
    idx = index($0, $4); rest = substr($0, idx + length($4));
    sub(/^[ \t]+/, "", rest);
    path = substr(rest, 1, plen);
    sec_path[n] = path; sec_hex[n] = hex; n++;
    next;
}
/^TREE[ \t]/ { tree = $2; next }
END {
    if (n == 0 || tree == "") { print "gen_core_seal_sections: no SECTION/TREE lines" > "/dev/stderr"; exit 1 }
    print "/* Copyright 2026 Rhett Creighton - Apache License 2.0";
    print " *";
    print " * ZCL_CORE_SEAL_TREE + ZCL_CORE_SEAL_SECTION_ROWS — the sealed consensus core's";
    print " * per-SECTION identity, as compile-time strings. AUTO-GENERATED by";
    print " * `make core-seal-sections` (and by `make core-seal`) from the SECTION/TREE";
    print " * lines of core/MANIFEST.sha3. Do not edit by hand.";
    print " *";
    print " * WHY IT IS NOT UNDER core/. Same reason as hotswap/core_seal_root.h: a mirror";
    print " * living inside the sealed set would be part of its own input. It lives beside";
    print " * the consumer, and test_hotswap_module's";
    print " * \"compiled section table matches core/MANIFEST.sha3\" case proves the two";
    print " * agree — a forgotten regeneration fails the hotswap_module test group.";
    print " *";
    print " * WHAT IT IS FOR. hotswap/core_seal_root.h carries ONE value: the flat ROOT";
    print " * fold over every sealed file. It is a whole-tree pin — every module is";
    print " * invalidated by a change to any of the 70 sealed files. These rows carry the";
    print " * SAME sealed set at directory granularity, in lib/codeindex's source Merkle";
    print " * dialect (a structurally different fold over the same bytes), so a module can";
    print " * RECORD which sections it actually compiled against and the resident can";
    print " * verify each of them IN ADDITION to ROOT.";
    print " *";
    print " * THIS FILE RELAXES NOTHING. The ROOT equality check is unchanged and still";
    print " * runs first. A module that declares sections must ALSO match every one of";
    print " * them and the TREE; a module that declares a section this resident does not";
    print " * have is refused. The section rows are strictly additional evidence.";
    print " *";
    print " * The N-ary node digest for a directory covers that directory RECURSIVELY, so";
    print " * an ancestor row (\"core\") subsumes its descendants. A module declares the";
    print " * DEEPEST section containing each sealed file in its compile closure and never";
    print " * its ancestors — an ancestor digest would pin sibling directories the module";
    print " * never saw, which is the opposite of what section granularity is for.";
    print " */";
    print "";
    print "#ifndef ZCL_HOTSWAP_CORE_SEAL_SECTIONS_H";
    print "#define ZCL_HOTSWAP_CORE_SEAL_SECTIONS_H";
    print "";
    print "/* Root node digest over the whole sealed set (dirpath \"\"). */";
    printf "#define ZCL_CORE_SEAL_TREE \\\n    \"%s\"\n", tree;
    print "";
    printf "/* SECTION lines in core/MANIFEST.sha3 at generation time. */\n";
    printf "#define ZCL_CORE_SEAL_SECTION_COUNT %du\n", n;
    print "";
    print "/* X-macro row list. The consumer supplies ZCL_HOTSWAP_SECTION_ROW(path, hex);";
    print " * hotswap/hotswap_module.h defines it as an initializer element. */";
    print "#define ZCL_CORE_SEAL_SECTION_ROWS \\";
    for (i = 0; i < n; i++) {
        printf "    ZCL_HOTSWAP_SECTION_ROW(\"%s\", \\\n        \"%s\")%s\n",
               sec_path[i], sec_hex[i], (i + 1 < n) ? " \\" : "";
    }
    print "";
    print "#endif /* ZCL_HOTSWAP_CORE_SEAL_SECTIONS_H */";
}
