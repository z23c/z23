# Copyright 2026 Rhett Creighton - Apache License 2.0
# zcl — Simple CLI for zclassic23 full node
#
# Usage:
#   zcl balance           Show transparent + shielded balance
#   zcl send ADDRESS AMT  Send transparent ZCL
#   zcl shield AMT        Shield transparent → shielded
#   zcl zsend ZADDR AMT   Send shielded ZCL (z→z)
#   zcl unshield AMT      Unshield to transparent (z→t)
#   zcl receive           Show deposit addresses
#   zcl history           Transaction history
#   zcl ledger            Full accounting ledger
#   zcl utxos             List unspent outputs
#   zcl peers             Show connected peers
#   zcl status            Node sync status
#   zcl hodlwave          UTXO age distribution
#   zcl audit             Wallet audit
#   zcl view HEIGHT [N]   View N block headers at HEIGHT
#   zcl stats [S] [E]     Chain statistics (optional range)
#   zcl txdetail TXID     UTXO detail for transaction
#   zcl tree              Sapling commitment tree state
#   zcl scan S E          Scan blocks for Sapling commitments
#   zcl verify S E        Verify Sapling tree against block headers
#   zcl rpc METHOD [ARGS] Raw RPC call
#   zcl help              Show this help

set -e

DATADIR="${ZCL_DATADIR:-$HOME/.zclassic-c23}"
PORT="${ZCL_RPCPORT:-18232}"
COOKIE_FILE="$DATADIR/.cookie"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
JSONQ="${JSONQ:-$REPO_ROOT/build/bin/jsonq}"

rpc() {
    local method="$1"
    shift
    local params=""
    if [ $# -gt 0 ]; then
        params="$*"
    fi

    if [ ! -f "$COOKIE_FILE" ]; then
        echo "Error: Node not running (no cookie at $COOKIE_FILE)" >&2
        exit 1
    fi

    local cookie
    cookie=$(cat "$COOKIE_FILE")

    local body
    if [ -z "$params" ]; then
        body="{\"method\":\"$method\"}"
    else
        body="{\"method\":\"$method\",\"params\":[$params]}"
    fi

    curl -s -u "$cookie" "http://127.0.0.1:$PORT/" \
        -d "$body" \
        -H "Content-Type: application/json"
}

require_jsonq() {
    if [ ! -x "$JSONQ" ]; then
        echo "Error: jsonq not found at $JSONQ" >&2
        exit 1
    fi
}

jget() {
    require_jsonq
    printf '%s' "$1" | "$JSONQ" get "$2"
}

jget_or() {
    require_jsonq
    printf '%s' "$1" | "$JSONQ" get "$2" 2>/dev/null || printf '%s' "${3-}"
}

jcount() {
    require_jsonq
    printf '%s' "$1" | "$JSONQ" count "$2"
}

jhas() {
    require_jsonq
    printf '%s' "$1" | "$JSONQ" has "$2" >/dev/null 2>&1
}

rpc_err() {
    jget_or "$1" error.message ""
}

amt_gt() {
    awk -v a="$1" -v b="$2" 'BEGIN { exit !(a + 0 > b + 0) }'
}

addr_with_max_amount() {
    local json="$1" n i addr amt best="" best_amt=""
    n=$(jcount "$json" result) || return 1
    [ "$n" -gt 0 ] || return 0
    declare -A sums=()
    i=0
    while [ "$i" -lt "$n" ]; do
        addr=$(jget "$json" "result[$i].address")
        amt=$(jget "$json" "result[$i].amount")
        if [ -n "${sums[$addr]+x}" ]; then
            sums[$addr]=$(awk -v a="${sums[$addr]}" -v b="$amt" 'BEGIN { printf "%.8f", a + b }')
        else
            sums[$addr]=$(awk -v b="$amt" 'BEGIN { printf "%.8f", b + 0 }')
        fi
        i=$((i + 1))
    done
    for addr in "${!sums[@]}"; do
        if [ -z "$best" ] || amt_gt "${sums[$addr]}" "$best_amt"; then
            best="$addr"
            best_amt="${sums[$addr]}"
        fi
    done
    printf '%s' "$best"
}

first_result_address() {
    local json="$1" n
    n=$(jcount "$json" result 2>/dev/null || printf '%s' 0)
    if [ "$n" -gt 0 ]; then
        jget "$json" 'result[0].address'
    fi
}

commify() {
    printf '%s' "$1" | awk '{
        s = $0
        sign = ""
        if (substr(s, 1, 1) == "-") {
            sign = "-"
            s = substr(s, 2)
        }
        n = length(s)
        out = ""
        for (i = n; i > 0; i--) {
            out = substr(s, i, 1) out
            if ((n - i + 1) % 3 == 0 && i > 1)
                out = "," out
        }
        print sign out
    }'
}

fmt_zcl() {
    echo "$1 ZCL"
}

cmd_balance() {
    local result
    result=$(rpc z_gettotalbalance)
    local t z total
    t=$(jget "$result" result.transparent)
    z=$(jget "$result" result.private)
    total=$(jget "$result" result.total)

    printf "\n  ZClassic Wallet Balance\n"
    printf "  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    printf "  Transparent:  %s ZCL\n" "$t"
    printf "  Shielded:     %s ZCL\n" "$z"
    printf "  ─────────────────────────────────\n"
    printf "  Total:        %s ZCL\n\n" "$total"
}

cmd_send() {
    local addr="$1" amount="$2"
    if [ -z "$addr" ] || [ -z "$amount" ]; then
        echo "Usage: zcl send <address> <amount>"
        echo "Example: zcl send t1ABC... 0.5"
        exit 1
    fi
    printf "\n  Sending %s ZCL → %s\n" "$amount" "$addr"
    local result
    result=$(rpc sendtoaddress "\"$addr\",$amount")
    local txid err
    txid=$(jget_or "$result" result "")
    err=$(rpc_err "$result")
    if [ -n "$err" ]; then
        printf "  ✗ Error: %s\n\n" "$err"
        exit 1
    fi
    printf "  ✓ Sent! txid: %s\n\n" "$txid"
}

cmd_shield() {
    local amount="$1"
    if [ -z "$amount" ]; then
        echo "Usage: zcl shield <amount>"
        echo "Shields transparent ZCL to your default shielded address."
        exit 1
    fi

    local from
    from=$(addr_with_max_amount "$(rpc listunspent)")

    local zaddr unspent
    unspent=$(rpc z_listunspent)
    zaddr=$(first_result_address "$unspent")
    if [ -z "$zaddr" ]; then
        zaddr=$(jget "$(rpc z_getnewaddress)" result)
    fi

    printf "\n  Shielding %s ZCL\n" "$amount"
    printf "  From: %s\n" "$from"
    printf "  To:   %s...\n" "${zaddr:0:30}"

    local result
    result=$(rpc z_sendmany "\"$from\",[{\"address\":\"$zaddr\",\"amount\":$amount}]")
    local opid err
    opid=$(jget_or "$result" result "")
    err=$(rpc_err "$result")
    if [ -n "$err" ]; then
        printf "  ✗ Error: %s\n\n" "$err"
        exit 1
    fi
    printf "  ✓ Shielding started! opid: %s\n\n" "$opid"
}

cmd_zsend() {
    local zaddr="$1" amount="$2"
    if [ -z "$zaddr" ] || [ -z "$amount" ]; then
        echo "Usage: zcl zsend <z-address> <amount>"
        echo "Example: zcl zsend zs1abc... 0.1"
        exit 1
    fi

    local from
    from=$(addr_with_max_amount "$(rpc z_listunspent)")
    if [ -z "$from" ]; then
        echo "  ✗ No shielded balance available"
        exit 1
    fi

    printf "\n  Sending %s ZCL (shielded)\n" "$amount"
    printf "  From: %s...\n" "${from:0:30}"
    printf "  To:   %s...\n" "${zaddr:0:30}"

    local result
    result=$(rpc z_sendmany "\"$from\",[{\"address\":\"$zaddr\",\"amount\":$amount}]")
    local opid err
    opid=$(jget_or "$result" result "")
    err=$(rpc_err "$result")
    if [ -n "$err" ]; then
        printf "  ✗ Error: %s\n\n" "$err"
        exit 1
    fi
    printf "  ✓ Shielded send started! opid: %s\n\n" "$opid"
}

cmd_unshield() {
    local amount="$1"
    if [ -z "$amount" ]; then
        echo "Usage: zcl unshield <amount>"
        echo "Unshields ZCL from shielded to a new transparent address."
        exit 1
    fi

    local from
    from=$(addr_with_max_amount "$(rpc z_listunspent)")

    local taddr
    taddr=$(jget "$(rpc getnewaddress)" result)

    printf "\n  Unshielding %s ZCL\n" "$amount"
    printf "  From: %s...\n" "${from:0:30}"
    printf "  To:   %s\n" "$taddr"

    local result
    result=$(rpc z_sendmany "\"$from\",[{\"address\":\"$taddr\",\"amount\":$amount}]")
    local opid err
    opid=$(jget_or "$result" result "")
    err=$(rpc_err "$result")
    if [ -n "$err" ]; then
        printf "  ✗ Error: %s\n\n" "$err"
        exit 1
    fi
    printf "  ✓ Unshielding started! opid: %s\n\n" "$opid"
}

cmd_receive() {
    printf "\n  Deposit Addresses\n"
    printf "  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"

    local taddr
    taddr=$(jget "$(rpc getnewaddress)" result)
    printf "\n  Transparent (t-address):\n"
    printf "    %s\n" "$taddr"

    local zaddr
    zaddr=$(first_result_address "$(rpc z_listunspent)" || true)
    if [ -n "$zaddr" ]; then
        printf "\n  Shielded (z-address):\n"
        printf "    %s\n\n" "$zaddr"
    else
        printf "\n  (No shielded address yet — use 'zcl shield' to create one)\n\n"
    fi
}

cmd_history() {
    local json n i h cat amt fee bal txid arrow
    json=$(rpc getbalanceflow)
    n=$(jcount "$json" result.flows)

    printf '\n  Transaction History\n'
    printf '  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n'
    printf '  %8s  %-8s  %14s  %12s  %14s  %s\n' Height Type Amount Fee Balance TxID
    printf '  '
    printf '%.0s─' {1..76}
    printf '\n'

    i=0
    while [ "$i" -lt "$n" ]; do
        h=$(jget_or "$json" "result.flows[$i].height" 0)
        cat=$(jget_or "$json" "result.flows[$i].category" '?')
        amt=$(jget_or "$json" "result.flows[$i].amount" 0)
        fee=$(jget_or "$json" "result.flows[$i].fee" 0)
        bal=$(jget_or "$json" "result.flows[$i].running_balance" 0)
        txid=$(jget_or "$json" "result.flows[$i].txid" '?')
        txid="${txid:0:12}..."
        case "$cat" in
            send) arrow='→' ;;
            receive) arrow='←' ;;
            *) arrow='↔' ;;
        esac
        awk -v h="$h" -v arrow="$arrow" -v cat="$cat" -v amt="$amt" \
            -v fee="$fee" -v bal="$bal" -v txid="$txid" 'BEGIN {
            printf "  %8s  %s %-6s  %+14.8f  %12.8f  %14.8f  %s\n",
                h, arrow, cat, amt + 0, fee + 0, bal + 0, txid
        }'
        i=$((i + 1))
    done

    printf '\n'
    awk -v r="$(jget "$json" result.summary.total_received)" \
        -v s="$(jget "$json" result.summary.total_sent)" \
        -v f="$(jget "$json" result.summary.total_fees)" \
        -v b="$(jget "$json" result.summary.final_balance)" 'BEGIN {
        printf "  Total received: %.8f ZCL\n", r + 0
        printf "  Total sent:     %.8f ZCL\n", s + 0
        printf "  Total fees:     %.8f ZCL\n", f + 0
        printf "  Final balance:  %.8f ZCL\n\n", b + 0
    }'
}

cmd_ledger() {
    local json n i h typ td tc zd zc fee total txid icon detail memo addr
    local tn zn
    json=$(rpc walletledger)
    n=$(jcount "$json" result.entries)

    printf '\n  ZClassic Full Wallet Ledger\n'
    printf '  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n'

    i=0
    while [ "$i" -lt "$n" ]; do
        h=$(jget_or "$json" "result.entries[$i].height" 0)
        typ=$(jget_or "$json" "result.entries[$i].type" '?')
        td=$(jget_or "$json" "result.entries[$i].t_debit" "")
        tc=$(jget_or "$json" "result.entries[$i].t_credit" "")
        zd=$(jget_or "$json" "result.entries[$i].z_debit" "")
        zc=$(jget_or "$json" "result.entries[$i].z_credit" "")
        fee=$(jget_or "$json" "result.entries[$i].fee" "")
        total=$(jget_or "$json" "result.entries[$i].total_balance" '?')
        txid=$(jget_or "$json" "result.entries[$i].txid" '?')
        txid="${txid:0:12}..."
        case "$typ" in
            receive) icon='  ←' ;;
            send) icon='  →' ;;
            shield) icon='  ⬡' ;;
            unshield) icon='  ⬢' ;;
            z_transfer) icon='  ◈' ;;
            z_receive) icon='  ◇' ;;
            z_send) icon='  ◆' ;;
            mixed) icon='  ◎' ;;
            *) icon='  ?' ;;
        esac
        detail=""
        [ -n "$td" ] && detail="${detail}${detail:+  }t-${td}"
        [ -n "$tc" ] && detail="${detail}${detail:+  }t+${tc}"
        [ -n "$zd" ] && detail="${detail}${detail:+  }z-${zd}"
        [ -n "$zc" ] && detail="${detail}${detail:+  }z+${zc}"
        [ -n "$fee" ] && detail="${detail}${detail:+  }fee=${fee}"
        awk -v h="$h" -v icon="$icon" -v typ="$typ" -v detail="$detail" \
            -v total="$total" -v txid="$txid" 'BEGIN {
            printf "  %8s %s %-12s %-50s  bal=%s  %s\n",
                h, icon, typ, detail, total, txid
        }'
        i=$((i + 1))
    done

    printf '\n  Current Holdings\n'
    printf '  ─────────────────────────────────────────────────\n'
    tn=$(jcount "$json" result.current_holdings.transparent 2>/dev/null || printf '%s' 0)
    i=0
    while [ "$i" -lt "$tn" ]; do
        printf '    T  %14s ZCL  %s\n' \
            "$(jget "$json" "result.current_holdings.transparent[$i].amount")" \
            "$(jget_or "$json" "result.current_holdings.transparent[$i].address" '?')"
        i=$((i + 1))
    done
    zn=$(jcount "$json" result.current_holdings.shielded 2>/dev/null || printf '%s' 0)
    i=0
    while [ "$i" -lt "$zn" ]; do
        addr=$(jget_or "$json" "result.current_holdings.shielded[$i].address" '?')
        memo=""
        if jhas "$json" "result.current_holdings.shielded[$i].memo"; then
            memo="  [$(jget "$json" "result.current_holdings.shielded[$i].memo")]"
        fi
        printf '    Z  %14s ZCL  %s...%s\n' \
            "$(jget "$json" "result.current_holdings.shielded[$i].amount")" \
            "${addr:0:40}" "$memo"
        i=$((i + 1))
    done

    printf '\n  Accounting\n'
    printf '  ─────────────────────────────────────────────────\n'
    printf '    Received (t):     %s ZCL\n' "$(jget "$json" result.accounting.total_t_received)"
    printf '    Received (z):     %s ZCL\n' "$(jget "$json" result.accounting.total_z_received)"
    printf '    Shielded (t→z):   %s ZCL\n' "$(jget "$json" result.accounting.total_shielded_t_to_z)"
    printf '    Total fees:       %s ZCL\n' "$(jget "$json" result.accounting.total_fees)"
    printf '    ─────────────────────────────────\n'
    printf '    Balance (t):      %s ZCL\n' "$(jget "$json" result.accounting.current_t_balance)"
    printf '    Balance (z):      %s ZCL\n' "$(jget "$json" result.accounting.current_z_balance)"
    printf '    Total:            %s ZCL\n' "$(jget "$json" result.accounting.current_total)"
    printf '    Unaccounted:      %s ZCL\n\n' "$(jget "$json" result.accounting.unaccounted)"
}

cmd_utxos() {
    printf "\n  Unspent Outputs\n"
    printf "  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"

    local json n i memo addr
    json=$(rpc listunspent)
    n=$(jcount "$json" result)
    printf '\n  Transparent UTXOs:\n'
    i=0
    while [ "$i" -lt "$n" ]; do
        awk -v amt="$(jget "$json" "result[$i].amount")" \
            -v addr="$(jget "$json" "result[$i].address")" \
            -v confs="$(jget "$json" "result[$i].confirmations")" 'BEGIN {
            printf "    %14.8f ZCL  %s  confs=%s\n", amt + 0, addr, confs
        }'
        i=$((i + 1))
    done

    json=$(rpc z_listunspent)
    n=$(jcount "$json" result)
    printf '\n  Shielded Notes:\n'
    i=0
    while [ "$i" -lt "$n" ]; do
        addr=$(jget "$json" "result[$i].address")
        memo=""
        if jhas "$json" "result[$i].memo"; then
            memo="  [$(jget "$json" "result[$i].memo")]"
        fi
        awk -v amt="$(jget "$json" "result[$i].amount")" \
            -v addr="${addr:0:40}" \
            -v h="$(jget "$json" "result[$i].block_height")" \
            -v memo="$memo" 'BEGIN {
            printf "    %14.8f ZCL  %s...  h=%s%s\n", amt + 0, addr, h, memo
        }'
        i=$((i + 1))
    done
    printf '\n'
}

cmd_peers() {
    local json n i direction
    json=$(rpc getpeerinfo)
    n=$(jcount "$json" result)
    printf '\n  Connected Peers\n'
    printf '  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n'
    if [ "$n" -eq 0 ]; then
        printf '  (no peers connected)\n'
    fi
    i=0
    while [ "$i" -lt "$n" ]; do
        if [ "$(jget_or "$json" "result[$i].inbound" false)" = true ]; then
            direction='←in'
        else
            direction='→out'
        fi
        awk -v dir="$direction" \
            -v addr="$(jget "$json" "result[$i].addr")" \
            -v subver="$(jget_or "$json" "result[$i].subver" '?')" \
            -v h="$(jget_or "$json" "result[$i].startingheight" 0)" 'BEGIN {
            printf "  %s  %-25s  %s  h=%s\n", dir, addr, subver, h
        }'
        i=$((i + 1))
    done
    printf '\n'
}

cmd_status() {
    local info balance peers
    info=$(rpc getblockchaininfo)
    balance=$(rpc z_gettotalbalance)
    peers=$(rpc getconnectioncount)

    local chain blocks headers synced p t z total
    chain=$(jget "$info" result.chain)
    blocks=$(jget "$info" result.blocks)
    headers=$(jget "$info" result.headers)
    if [ "$blocks" -ge $((headers - 1)) ]; then
        synced=Yes
    else
        synced=No
    fi
    p=$(jget "$peers" result)
    t=$(jget "$balance" result.transparent)
    z=$(jget "$balance" result.private)
    total=$(jget "$balance" result.total)

    printf '\n  Z23 Node Status\n'
    printf '  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n'
    printf '  Chain:        %s\n' "$chain"
    printf '  Height:       %s\n' "$blocks"
    printf '  Headers:      %s\n' "$headers"
    printf '  Synced:       %s\n' "$synced"
    printf '  Peers:        %s\n' "$p"
    printf '  T Balance:    %s ZCL\n' "$t"
    printf '  Z Balance:    %s ZCL\n' "$z"
    printf '  Total:        %s ZCL\n\n' "$total"
}

cmd_hodlwave() {
    local json n i age zcl pct cpct utxos bar utxo_value tip total_utxos
    json=$(rpc gethodlwave)

    utxo_value=$(jget_or "$json" result.transparent_utxo_value_zcl "")
    if [ -z "$utxo_value" ]; then
        utxo_value=$(jget_or "$json" result.total_supply_zcl "0.00000000")
    fi
    tip=$(jget "$json" result.tip_height)
    total_utxos=$(jget "$json" result.total_utxos)

    printf '\n  ZClassic HODL Wave — Cumulative Supply by Age\n'
    printf '  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n'
    printf '  Tip: %s  |  UTXOs: %s  |  Transparent UTXO value: %s ZCL\n\n' \
        "$(commify "$tip")" "$(commify "$total_utxos")" "$utxo_value"
    printf '  %12s  %-40s  %18s  %7s  %8s  %10s\n' \
        Age "Cumul Bar" "ZCL in bucket" Bucket Unmoved UTXOs
    printf '  '
    printf '%.0s─' {1..97}
    printf '\n'

    n=$(jcount "$json" result.buckets)
    i=0
    while [ "$i" -lt "$n" ]; do
        age=$(jget "$json" "result.buckets[$i].age")
        zcl=$(jget "$json" "result.buckets[$i].zcl")
        pct=$(jget "$json" "result.buckets[$i].pct")
        cpct=$(jget "$json" "result.buckets[$i].cumulative_pct_unmoved")
        utxos=$(jget "$json" "result.buckets[$i].utxos")
        bar=$(awk -v cpct="$cpct" 'BEGIN {
            n = int(cpct / 2.5)
            if (n > 40) n = 40
            bar = ""
            for (i = 0; i < n; i++) bar = bar "█"
            for (i = n; i < 40; i++) bar = bar "░"
            printf "%s", bar
        }')
        awk -v age="$age" -v bar="$bar" -v zcl="$zcl" -v pct="$pct" \
            -v cpct="$cpct" -v utxos="$(commify "$utxos")" 'BEGIN {
            printf "  %12s  %s  %18s ZCL  %6.2f%%  %7.2f%%  %10s\n",
                age, bar, zcl, pct + 0, cpct + 0, utxos
        }'
        i=$((i + 1))
    done

    printf '\n  Unmoved = cumulative %% of supply unmoved for at least this long\n\n'
}

cmd_audit() {
    local json n i
    json=$(rpc walletaudit)
    printf '\n  Wallet Audit\n'
    printf '  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n'
    printf '  Chain height:       %s\n' "$(jget "$json" result.chain_height)"
    printf '  Verified balance:   %s ZCL (%s UTXOs)\n' \
        "$(jget "$json" result.summary.verified_balance)" \
        "$(jget "$json" result.summary.verified_utxos)"
    printf '  Shielded balance:   %s ZCL (%s notes)\n' \
        "$(jget "$json" result.summary.shielded_balance)" \
        "$(jget "$json" result.summary.shielded_notes)"
    printf '  True total:         %s ZCL\n' "$(jget "$json" result.summary.true_total_balance)"
    printf '  Phantom balance:    %s ZCL (%s phantom)\n' \
        "$(jget "$json" result.summary.phantom_balance)" \
        "$(jget "$json" result.summary.phantom_utxos)"
    printf '  Discrepancy:        %s ZCL\n\n' "$(jget "$json" result.summary.discrepancy)"
    n=$(jcount "$json" result.addresses)
    i=0
    while [ "$i" -lt "$n" ]; do
        printf '    %s: %s ZCL (%s utxos)\n' \
            "$(jget "$json" "result.addresses[$i].address")" \
            "$(jget "$json" "result.addresses[$i].verified_balance")" \
            "$(jget "$json" "result.addresses[$i].verified_utxos")"
        i=$((i + 1))
    done
    printf '\n'
}

cmd_help() {
    cat <<'HELP'

  zcl — Z23 Command Line Interface

  TRANSACTIONS
    zcl send <addr> <amt>     Send transparent ZCL (t→t)
    zcl shield <amt>          Shield to z-address (t→z)
    zcl zsend <zaddr> <amt>   Shielded send (z→z or z→t)
    zcl unshield <amt>        Unshield to t-address (z→t)

  WALLET
    zcl balance               Show all balances
    zcl receive               Show deposit addresses
    zcl utxos                 List all unspent outputs
    zcl history               Transaction history
    zcl ledger                Full double-entry ledger
    zcl audit                 Wallet health check

  ANALYTICS
    zcl hodlwave              UTXO age distribution (cumulative)
    zcl status                Node sync status
    zcl peers                 Connected peers

  ENVIRONMENT
    ZCL_DATADIR               Data directory (default: ~/.zclassic-c23)
    ZCL_RPCPORT               RPC port (default: 18232)

HELP
}

# Main dispatch
case "${1:-help}" in
    balance)   cmd_balance ;;
    send)      cmd_send "$2" "$3" ;;
    shield)    cmd_shield "$2" ;;
    zsend)     cmd_zsend "$2" "$3" ;;
    unshield)  cmd_unshield "$2" ;;
    receive)   cmd_receive ;;
    history)   cmd_history ;;
    ledger)    cmd_ledger ;;
    utxos)     cmd_utxos ;;
    peers)     cmd_peers ;;
    status)    cmd_status ;;
    hodlwave)  cmd_hodlwave ;;
    audit)     cmd_audit ;;
    view)      rpc chainview "$2, ${3:-1}" ;;
    stats)
        if [ -n "$2" ] && [ -n "$3" ]; then
            rpc chainstats "$2, $3"
        elif [ -n "$2" ]; then
            rpc chainstats "$2"
        else
            rpc chainstats
        fi ;;
    txdetail)  rpc gettxdetail "\"$2\"" ;;
    tree)      rpc saplingtreeinfo ;;
    scan)      rpc scancommitments "$2, $3" ;;
    verify)    rpc verifychainroots "$2, $3" ;;
    rpc)       shift; rpc "$@" ;;
    help|--help|-h) cmd_help ;;
    *)
        echo "Unknown command: $1"
        cmd_help
        exit 1
        ;;
esac
