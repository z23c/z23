+/* ── Subsystem lifecycle (Tor main thread only) ────────────── */
+
+void
+dynhost_stream_init(void)
+{
+  ensure_mutex();
+  tor_mutex_acquire(&g_queue_mutex);
+  g_stopped = 0;
+  tor_mutex_release(&g_queue_mutex);
+}
 
 void
 dynhost_stream_cleanup(void)
 {
-  if (!g_mutex_initialized)
-    return;
+  ensure_mutex();
 
-  /* Cancel pending opens */
+  /* Refuse new opens and take the pending queue in one critical section:
+   * every open either landed on this queue or sees g_stopped. */
   tor_mutex_acquire(&g_queue_mutex);
+  g_stopped = 1;
   dynhost_stream_t *p = g_pending_head;
   g_pending_head = NULL;
   tor_mutex_release(&g_queue_mutex);
@@ -524,13 +546,11 @@
     p = next;
   }
 
-  /* Cancel active streams */
-  while (g_active_head) {
-    dynhost_stream_t *s = g_active_head;
-    /* Resolve by global id — Tor may already have freed the conn. */
-    connection_t *conn = connection_get_by_global_id(s->conn_gid);
-    if (conn && !conn->marked_for_close)
-      connection_mark_for_close(conn);
-    stream_terminal(&g_active_head, s, DYNHOST_STREAM_EVENT_CLOSED);
-  }
+  /* Tor has already freed every connection (connection_free_all runs
+   * before subsystems shut down) without unlinking it from the
+   * connection array, so a global-id lookup here would read freed
+   * memory. Only the stream records remain; end each one. */
+  while (g_active_head)
+    stream_terminal(&g_active_head, g_active_head,
+                    DYNHOST_STREAM_EVENT_CLOSED);
 }
