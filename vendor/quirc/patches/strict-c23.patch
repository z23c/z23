+/* Largest coordinate magnitude kept as is. 2^13 keeps every product of two differences of clamped
+ * coordinates inside int, so the unchecked int arithmetic on capstone centers and corners cannot overflow.
+ * Frames up to 8192 px a side are unaffected. */
+#define COORD_LIMIT (1 << 13)
+
+/* Rounds v to the nearest int. A NaN or a value beyond COORD_LIMIT becomes -COORD_LIMIT or COORD_LIMIT,
+ * since converting an out-of-range float to int is undefined. Callers that index pixels check the point
+ * against the frame (read_cell, fitness_cell, find_alignment_pattern). The capstone centers and the
+ * extracted corners are not checked; they are stored or used in int arithmetic that the limit bounds. */
+static int coord_round(quirc_float_t v)
+{
+	if (!(v >= -(quirc_float_t)COORD_LIMIT)) return -COORD_LIMIT;
+	if (v > (quirc_float_t)COORD_LIMIT) return COORD_LIMIT;
+	return (int)rint(v);
+}
