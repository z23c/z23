+/* Largest coordinate magnitude kept as is. Any frame is far smaller, so a larger one is off the frame. */
+#define COORD_LIMIT (1 << 20)
+
+/* Rounds v to the nearest int. A NaN or a value beyond COORD_LIMIT becomes -COORD_LIMIT or COORD_LIMIT,
+ * which the callers' bounds checks reject, since converting an out-of-range float to int is undefined. */
+static int coord_round(quirc_float_t v)
+{
+	if (!(v >= -(quirc_float_t)COORD_LIMIT)) return -COORD_LIMIT;
+	if (v > (quirc_float_t)COORD_LIMIT) return COORD_LIMIT;
+	return (int)rint(v);
+}
